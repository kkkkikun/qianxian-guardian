// 「牵线」聚会筹办守护 — script-app 主提交物（A 路线）
// 无 AI 完整可用：本地规则分诊 → 提案 → 确认 → 活动簿，全部确定性可复现。
// AI 仅为可选增强（有 octos.* 宿主服务时才出现按钮），不可用时明确降级。

let cases = []
let case_ids = []           // 每条 case 的 id 字符串（扁平化供 on_render 只读）
let case_lines = []         // 每条 case 的标题字符串（#N · 活动）
let case_text_lines = []    // 每条 case 的原文字符串
let case_statuses = []      // 每条 case 的状态字符串（"Proposing"/"Confirmed"/"Cancelled"）
let case_selected = []      // 每条 case 的选中标记字符串（"yes"/"no"）
let case_badge_text = []    // 每条 case 的徽章文字字符串
let case_receipt = []       // 每条 case 的回执四行（字符串数组，无回执为空数组 []）
let case_place_lines = []   // 每条 case 的地点字符串（供 on_render 读，避免闭包读对象字段）
// === #9 新增：每条 case 的内联展开态（"yes"/"no"），用字符串标记数组驱动 on_render ===
let case_expanded = []      // 点卡片 = 选中 + 切换该条的展开/折叠
let seq = 0
let selected_id = 0  // 选中态：0 表示无选中

// === #8 保留：取消二次确认 + 撤销态 ===
let cancel_pending_id = 0           // 第一次点取消时的目标 id（0 = 无待确认）
let cancel_prev_status = ""         // 取消前该条的状态（用于撤销恢复）
let cancel_pending_deadline = 0     // 取消二次确认的截止时刻（ms 级 epoch，由 start_timeout 推进）

// === #9 新增：撤销窗口标记 —— 防止 5 秒定时器在用户已撤销之后再次覆盖 hint 文案 ===
// 撤销窗口打开 = 撤销按钮可用；一旦撤销成功或窗口到期，必须把它关掉，
// 否则 5s 后那个 start_timeout 回调会把"已撤销 #N"的提示覆盖掉。
let undo_win_open = "no"
let cancel_pending_flag = "no"          // 取消待确认标记（供 on_render 渲染确认态按钮）
let undo_show_flag2 = "no"             // 撤销条可见标记（供 on_render 渲染撤销按钮）            // "yes"/"no"

// === #14 新增：示例填充 / 导出 / 清空全部 三个数据控制动作的状态 ===
// 清空走"两段式确认"复用 cancel_pending_flag 的 5s 思路：
//   第一次点：clear_pending_flag = "yes"，按钮文案变"再点一次清空（5s）"，hint 提示；
//   第二次点（5s 内）：fs.remove("cases.json") + 内存清空 + hint 明示条数；
//   超时 / 点别的按钮 → 放弃。
// 用**字符串标记**而非布尔，与 cancel_pending_flag 同源；本 runtime 下函数返回
// 布尔在调用点 == false 比较不可靠（黑板 #13 实证）。
let clear_pending_flag = "no"           // 清空待确认标记（"yes"/"no"）
let clear_pending_deadline = 0         // 清空确认的截止时刻（仅占位，不做时间比较，start_timeout 自身 5s 守护）
let clear_prev_count = 0               // 进入待确认态时记下当前条数，用于最终 hint 明示

// === #10 新增：筛选状态 + 计数（扁平字符串，不读 cases[i][...]） ===
// current_filter 是当前选中的筛选标签："all" / "Proposing" / "Confirmed" / "Cancelled"
// filtered_idxs 是按当前筛选过滤后的下标整数数组（驱动 on_render 列表，避免字符串→int 回转）
// filter_count_str 是右侧"共 N 条"的展示字符串（数字必须字符串化，#4/#5 实证）
// filter_total_str 是总条数（用于筛选空文案："共 X 条守护，筛选后 0 条"）
let current_filter = "all"
let filtered_idxs = []
let filter_count_str = "0"
let filter_total_str = "0"
// === #12 新增：搜索词状态（"all" 之外的第二维度，叠加在标签筛选之上） ===
// current_query 是搜索框当前文本（实时过滤触发源；空串=不过滤）
// matched_total_str 是「按当前标签的总命中数」（不含搜索词），即"共 N/M"中的 M
let current_query = ""
let matched_total_str = "0"

// === #9 新增：扁平字段——避免 on_render 闭包读 cases[i][...]（#4/#5/#7/#8 实证坑） ===
// 卡片内联展开后，"活动/地点/原文/状态" 这些原来只在详情层用的字段也要按行铺平，
// 否则 on_render 闭包要去摸对象字段，触发实证过的类型/作用域问题。
let case_activity_lines = []        // 每条 case 的活动字符串（无则"（未抽取到）"）
let case_place_full = []            // 每条 case 的地点字符串（无则"（未抽取到）"）
let case_status_text = []           // 每条 case 的状态中文（"待拍板"/"已确认"/"已取消"）

// 状态色：行首徽章文字色与底色（Proposing 灰 / Confirmed 绿 / Cancelled 红）
// 注：颜色必须是颜色字面量（#x…），不能返回字符串——draw_bg.color 期望 Vec4f
fn status_badge_bg(st){
    if st == "Confirmed" { return #xe6f7ec }
    if st == "Cancelled" { return #xfdecea }
    return #xefeff4  // Proposing / 兜底灰
}
fn status_badge_fg(st){
    if st == "Confirmed" { return #x1f8a3a }
    if st == "Cancelled" { return #xff3b30 }
    return #x6b6b73  // Proposing / 兜底灰
}
fn status_badge_text(st){
    if st == "Confirmed" { return "已确认" }
    if st == "Cancelled" { return "已取消" }
    if st == "Proposing" { return "待拍板" }
    return "" + st
}
fn status_bar_color(st){
    if st == "Confirmed" { return #x34c759 }
    if st == "Cancelled" { return #xff3b30 }
    return #xb0b0b8  // Proposing / 兜底
}

// 重建：把所有渲染所需的字段都扁平化为字符串/字符串数组，
// 让 on_render 闭包只读字符串数组，不读 cases[i][...]（#4/#5/#7/#8 实证坑）
fn rebuild_lines(){
    // === #10/#12 新增：筛选下标数组 + 计数串在这里重建（filter 逻辑放函数上下文，不进 on_render） ===
    // #12 叠加：先用 current_filter 过一遍得到「标签总数 M」与候选 idxs；
    //   再用 current_query（search(p)>=0，命中 activity/place/text 子串）
    //   在候选里二次过滤，最终 push 进 filtered_idxs 的就是"标签+搜索"两层之后的命中数 N。
    //   显示文案"共 N / M 条"：N=filter_count_str，M=matched_total_str（不含搜索词）。
    filtered_idxs.clear()
    let cf = "" + current_filter
    let q = "" + current_query
    let label_matched = 0
    let view_idxs = []
    for i in cases.len() {
        let st = "" + cases[i]["status"]
        let keep = false
        if cf == "all" { keep = true }
        else if cf == "Proposing" && st == "Proposing" { keep = true }
        else if cf == "Confirmed" && st == "Confirmed" { keep = true }
        else if cf == "Cancelled" && st == "Cancelled" { keep = true }
        if keep {
            view_idxs.push(i)
            label_matched = label_matched + 1
        }
    }
    matched_total_str = "" + label_matched
    filter_total_str = "" + label_matched
    // 第二层：搜索词叠加（在标签候选内命中 activity / place / 原文子串）
    let n = 0
    if q == "" {
        // 搜索词为空：直接全部保留（标签结果 = 实际渲染结果），保持创建序稳定
        for i in view_idxs.len() {
            filtered_idxs.push(view_idxs[i])
        }
        n = view_idxs.len()
    } else {
        for i in view_idxs.len() {
            let j = view_idxs[i]
            let act = "" + cases[j]["activity"]
            let pl = "" + cases[j]["place"]
            let txt = "" + cases[j]["text"]
            // search(p) >= 0：命中即返回 >=0，没命中返回 -1（照 #12 契约明示，不用 regex）
            let hit = (act.search(q) >= 0) || (pl.search(q) >= 0) || (txt.search(q) >= 0)
            if hit {
                filtered_idxs.push(j)
                n = n + 1
            }
        }
    }
    filter_count_str = "" + n
    case_ids.clear()
    case_lines.clear()
    case_text_lines.clear()
    case_statuses.clear()
    case_selected.clear()
    case_badge_text.clear()
    case_receipt.clear()
    case_place_lines.clear()
    case_activity_lines.clear()
    case_place_full.clear()
    case_status_text.clear()
    // 同步 case_expanded：保留已展开态，遇 selected_id 变更时不强制清空
    // （点同一张卡：折叠；点别的卡：保留各自展开态，保留用户的"展开阅读"行为）
    for i in cases.len() {
        let id_str = "" + cases[i]["id"]
        case_ids.push(id_str)
        let sel = "no"
        if cases[i]["id"] == selected_id { sel = "yes" }
        case_selected.push(sel)
        let st = "" + cases[i]["status"]
        case_statuses.push(st)
        case_badge_text.push(status_badge_text(st))
        let title_act = "" + cases[i]["activity"]
        if title_act == "" { title_act = "聚会" }
        case_lines.push("#" + id_str + " · " + title_act)
        case_text_lines.push("" + cases[i]["text"])

        // === #9 新增：扁平活动/地点/状态中文（供卡片内联展开块读） ===
        let act = "" + cases[i]["activity"]
        if act == "" { act = "（未抽取到）" }
        case_activity_lines.push(act)
        let pl = "" + cases[i]["place"]
        if pl == "" { pl = "（未抽取到）" }
        case_place_full.push(pl)
        case_status_text.push(status_badge_text(st))

        // === #9 新增：保持现有 case_expanded 长度与 cases 同步 ===
        if i >= case_expanded.len() {
            case_expanded.push("no")
        }
        // 已存在的展开态保持不动（用户切别的卡不强制收拢）

        // === #8 保留：place 给收起态 placeholder 用 ===
        let place_disp = "" + cases[i]["place"]
        if place_disp == "" { place_disp = "（未抽取到）" }
        case_place_lines.push(place_disp)

        // === #8 保留：Confirmed 才填回执四行（首次进入时快照，幂等） ===
        if st == "Confirmed" {
            if cases[i]["receipt_done"] != "yes" {
                cases[i]["receipt_activity"] = "" + cases[i]["activity"]
                cases[i]["receipt_place"] = "" + cases[i]["place"]
                cases[i]["receipt_text"] = "" + cases[i]["text"]
                cases[i]["receipt_done"] = "yes"
            }
            let ra = "" + cases[i]["receipt_activity"]
            let rp = "" + cases[i]["receipt_place"]
            let rt = "" + cases[i]["receipt_text"]
            let arr = []
            arr.push("活动：" + ra)
            arr.push("地点：" + rp)
            arr.push("原文：" + rt)
            arr.push("T-24h 提醒（本地提醒文本，需宿主定时能力）")
            case_receipt.push(arr)
        } else {
            case_receipt.push([])
        }
    }
    // 多余的展开态条目截断（cases 缩短时）
    while case_expanded.len() > cases.len() {
        case_expanded.pop()
    }
}

// #13：损坏兜底。cases.json 存在但内容不是预期结构（parse_json 失败 / v 为 nil /
//   cases 不是数组 / seq 不是数字），不覆盖现有数据，而是把坏文件改名为
//   cases.corrupt-<n>.json（<n> 用文件里的 seq；seq 不是数字时用固定名
//   cases.corrupt.json，允许覆盖上一次的备份），然后以空状态启动并在 hint 明示。
//   绝不 silently 丢掉用户数据——数据是本应用唯一资产。
fn load(){
    let hint = "已载入 " + "" + cases.len() + " 个聚会守护"
    let hint_suffix = ""
    if fs.exists("cases.json") {
        let raw = fs.read("cases.json")
        let v = raw.parse_json()
        let bad = (v == nil)
        let parsed_cases = []
        let parsed_seq = 0
        let seq_is_num = false
        if !bad {
            // 校验 v["cases"] 是数组、v["seq"] 是数字；任何一个不达标即视为损坏
            let raw_cases = v["cases"]
            let raw_seq = v["seq"]
            if raw_cases != nil {
                // 数组的真值特征：可取 .len()。非数组对象/字符串/数字在这里调用
                // .len() 在 Splash 不会报错，会返回不预期的值；改用 "长度 > 0 且
                // 第一项是字典" 这种保守判定（cases 至少有一个对象）。
                if raw_cases.len() > 0 {
                    let first = raw_cases[0]
                    if first != nil {
                        parsed_cases = raw_cases
                    }
                } else if raw_cases.len() == 0 {
                    // 空数组是合法状态（用户清空了），接纳
                    parsed_cases = raw_cases
                }
                // 注意：raw_cases.len() 对非数组可能不抛错，但后续 rebuild_lines
                // 会读到一致行为；如果 parsed_cases 保持 []，后面 bad 会被翻成 true
            }
            if raw_seq != nil {
                // 数字判定：加 0 后与原值一致；否则把 seq_is_num 留 false
                let as_num = raw_seq + 0
                if "" + as_num == "" + raw_seq {
                    seq_is_num = true
                    parsed_seq = as_num
                }
            }
            // 校验通过的条件：raw_cases != nil 且 raw_seq != nil 且 seq_is_num
            // parsed_cases 已经接受了空数组；非数组场景下 parsed_cases 仍为 []
            // 但 cases.len()=0 会让重建前后一致，行为也可接受——为安全起见，
            // 仍然以「cases 是数组且 seq 是数字」双门控判定损坏。
            if raw_cases == nil || !seq_is_num {
                bad = true
            }
        }
        if bad {
            // 备份坏文件：<n> 优先用文件里的 seq（即使非数字也允许为字串后缀），
            // 不可得时用固定名 cases.corrupt.json（覆盖上一次备份）
            let backup_name = "cases.corrupt.json"
            if raw_seq != nil {
                backup_name = "cases.corrupt-" + "" + raw_seq + ".json"
            }
            // 注：Splash 的 fs 无 rename（只有 exists/read/read_bytes/write/
            // append/list/mkdir/remove，见 SCRIPT-API §Storage）。改用
            // 「把原文写进备份文件」实现等效效果：不删原文件，内容不丢。
            let original_text = fs.read("cases.json")
            let _ = fs.write(backup_name, original_text)
            // 内存回到空态：cases=[], seq=0
            cases = []
            seq = 0
            hint = "发现损坏的守护数据，已备份为 " + backup_name + " 并重新开始"
            hint_suffix = ""
        } else {
            // 校验通过：正常载入
            cases = parsed_cases
            seq = parsed_seq
            hint = "已载入 " + "" + cases.len() + " 个聚会守护"
            // #13 第 4 条：列表较长时提示用筛选/搜索
            if cases.len() > 20 {
                hint_suffix = "，列表较长，建议用筛选或搜索"
            }
        }
    } else {
        // 首次启动：无文件，按空态走
        if cases.len() > 20 {
            hint_suffix = "，列表较长，建议用筛选或搜索"
        }
    }
    rebuild_lines()
    ui.case_list.render()
    ui.hint.set_text(hint + hint_suffix)
}

// #13：写入失败可见。fs.write 在出错时返回错误值（非 nil/非 true），save() 把这个
//   信号向上层返回：调用点根据返回值决定是否覆盖"成功"提示为失败提示，避免 silently
//   告诉用户「已保存」但实际没落盘——同样是不丢用户数据的兜底。
// 用**字符串标记**返回成败，不用布尔：#13 外环复验发现该 runtime 下
// 函数返回的 true/false 在调用点 `ok == false` 比较中不可靠（写入明明成功
// 却走进失败分支）。字符串比较已在多处验证可靠。
let save_result = "ok"
fn save(){
    let r = fs.write("cases.json", {cases: cases, seq: seq}.to_json())
    // SCRIPT-API §Storage：fs.write 成功返回 nil；失败返回一个错误值。
    if r == nil { save_result = "ok" }
    else {
        let msg = "" + r
        if msg == "" { save_result = "ok" } else { save_result = "fail" }
    }
}

// 解析"作用目标"：选中优先，否则最新一条并明示
fn target_id(){
    if selected_id > 0 {
        for i in cases.len() {
            if cases[i]["id"] == selected_id { return {id: selected_id, fallback: false} }
        }
        // 选中 id 已被删除/不存在：降级到最新一条
    }
    if cases.len() > 0 { return {id: cases[cases.len() - 1]["id"], fallback: true} }
    return {id: 0, fallback: true}
}

// === #8 保留：清除取消二次确认态（任何非「取消」按钮/动作都放弃确认） ===
fn clear_cancel_pending(hint_text){
    cancel_pending_id = 0
    cancel_prev_status = ""
    cancel_pending_deadline = 0
    if hint_text != "" {
        ui.hint.set_text(hint_text)
    }
}

// === #9 改造：点卡片 = 选中 + 切换该条的展开/折叠（取代 #8 的 open_detail） ===
fn toggle_case(id){
    if id == 0 {
        ui.hint.set_text("先选中一条守护再展开/折叠")
        return
    }
    // 切到其他行 → 放弃取消确认态（避免提示与展开态语义混淆）
    if cancel_pending_id != 0 && cancel_pending_id != id {
        clear_cancel_pending("")
    }
    selected_id = id
    // 切换该条的展开态
    for i in case_ids.len() {
        if case_ids[i] == ("" + id) {
            if case_expanded[i] == "yes" {
                case_expanded[i] = "no"
            } else {
                case_expanded[i] = "yes"
            }
            break
        }
    }
    rebuild_lines()
    ui.case_list.render()
    let idx = -1
    for i in case_ids.len() {
        if case_ids[i] == ("" + id) { idx = i; break }
    }
    let msg = "已选中 #" + "" + id
    if idx >= 0 && case_expanded[idx] == "yes" {
        msg = "已展开 #" + "" + id + "（再点一次可折叠）"
    } else if idx >= 0 {
        msg = "已折叠 #" + "" + id + "（点卡片可展开详情）"
    }
    ui.hint.set_text(msg)
}

// === #9 新增：点击单卡 = 切换该卡展开（用于卡片 GestureView on_tap） ===
fn on_tap_card(id){
    toggle_case(id)
}

// === #10 新增：切换筛选标签（GestureView on_tap 回调入口） ===
// 入口参数 ft 是目标筛选值字符串："all"/"Proposing"/"Confirmed"/"Cancelled"
// 逻辑放函数上下文（不放在 on_render 内），重建扁平字符串数组后驱动渲染
fn set_filter(ft){
    let prev = "" + current_filter
    current_filter = "" + ft
    rebuild_lines()
    ui.case_list.render()
    // hint 反馈：切了哪个标签 + 当前命中条数
    let label_all = "全部"
    if ft == "Proposing" { label_all = "待拍板" }
    if ft == "Confirmed" { label_all = "已确认" }
    if ft == "Cancelled" { label_all = "已取消" }
    ui.hint.set_text("筛选：" + label_all + " · 共 " + filter_count_str + " 条 / 总 " + filter_total_str + " 条")
}

// === #12 新增：搜索词入口（TextInput on_change 回调；与 set_filter 同样放函数上下文）
// q 是用户输入的搜索词（空串=清空）；逻辑放函数上下文才能在 cases[j]["activity/place/text"]
// 上调 search(p)>=0；on_render 闭包只读扁平字符串。set_query 只动 current_query + 触发重建 +
// 更新 hint，不动 current_filter，所以搜索词与标签是叠加而非替换。
fn set_query(q){
    current_query = "" + q
    rebuild_lines()
    ui.case_list.render()
    if current_query == "" {
        ui.hint.set_text("已清空搜索，按当前标签显示（" + filter_count_str + " / " + filter_total_str + " 条）")
    } else {
        ui.hint.set_text("搜索 " + current_query + " · 共 " + filter_count_str + " / " + filter_total_str + " 条")
    }
}

// 本地规则分诊：命中时间/地点/约定动词才值得建 Case；纯闲聊 → 澄清
fn triage(text){
    let hit_time = regex("周|明天|后天|今天|\\d+月\\d+|上午|下午|晚上|周末|\\d+号|\\d+点", "").test(text)
    let hit_verb = regex("聚|吃饭|骑车|爬山|看电影|约|唱歌|打球|露营|烧烤|逛街|喝茶", "").test(text)
    if hit_time { return "time" }
    if hit_verb { return "verb" }
    return "none"
}

// 极简抽取：只做关键词呈现，不编造结构化事实（防编造：抽不到就留空）
fn guess_activity(text){
    let words = ["骑车", "吃饭", "聚餐", "爬山", "看电影", "唱歌", "打球", "露营", "烧烤", "逛街", "喝茶", "聚会"]
    for w in words {
        if text.search(w) >= 0 { return w }
    }
    return "聚会"
}

fn guess_place(text){
    let spots = ["深圳湾", "莲花山", "梧桐山", "海岸城", "欢乐谷", "世界之窗", "大梅沙", "小梅沙", "东湖", "红树林"]
    for s in spots {
        if text.search(s) >= 0 { return s }
    }
    return ""
}

fn add_case(){
    // 建守护算"非取消按钮" → 放弃任何待确认 + 关掉撤销窗口
    clear_cancel_pending("")
    undo_win_open = "no"
    let text = ui.msg_input.text()
    if text == "" {
        ui.hint.set_text("先输入一条群消息，例如：周六上午去深圳湾骑车")
        return
    }
    let level = triage(text)
    if level == "none" {
        ui.hint.set_text("澄清卡：这条消息里没看到时间或聚会意图，不建守护（规则分诊未命中）")
        return
    }
    seq = seq + 1
    // #13 第 3 条：id 撞库守卫。load() 后异常场景下 cases 有内容而 seq == 0，
    //   上面 seq+1 得 1，会与已有 id=1 撞。这里取 max(seq, 已有最大 id) + 1，
    //   保证新 id 一定大于任何已有 id。
    let max_existing_id = 0
    for i in cases.len() {
        let cid = cases[i]["id"]
        if cid > max_existing_id { max_existing_id = cid }
    }
    if seq <= max_existing_id {
        seq = max_existing_id + 1
    }
    cases.push({"id": seq, "text": text, "activity": guess_activity(text), "place": guess_place(text), "status": "Proposing", "receipt_activity": "", "receipt_place": "", "receipt_text": "", "receipt_done": ""})
    selected_id = seq  // 新建后自动选中，体验闭环
    ui.msg_input.set_text("")
    rebuild_lines()
    save()   // 结果写入全局 save_result
    ui.case_list.render()
    if save_result == "fail" {
        ui.hint.set_text("保存失败：守护数据可能未落盘（已建守护 #" + "" + seq + "，分诊命中：" + level + "）")
    } else {
        ui.hint.set_text("已建守护 #" + "" + seq + "（分诊命中：" + level + "），已选中，点卡片可展开详情")
    }
}

fn confirm_case(){
    // 同意 → 放弃任何待确认 + 关掉撤销窗口（操作后用户应当看到最新状态）
    clear_cancel_pending("")
    undo_win_open = "no"
    let t = target_id()
    if t["id"] == 0 {
        ui.hint.set_text("列表为空：先建一条守护再拍板")
        return
    }
    for i in cases.len() {
        if cases[i]["id"] == t["id"] {
            if cases[i]["status"] == "Confirmed" {
                let tag = ""
                if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
                ui.hint.set_text("已确认，未重复（#" + "" + t["id"] + " 仍是 Confirmed）" + tag)
                return
            }
            if cases[i]["status"] == "Cancelled" {
                ui.hint.set_text("该守护已取消，不可确认（#" + "" + t["id"] + "）")
                return
            }
            cases[i]["status"] = "Confirmed"
            rebuild_lines()
            save()   // 结果写入全局 save_result
            ui.case_list.render()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            if save_result == "fail" {
                ui.hint.set_text("保存失败：守护数据可能未落盘（#已被改为 Confirmed in-memory；#" + "" + t["id"] + "）" + tag)
            } else {
                ui.hint.set_text("已确认 #" + "" + t["id"] + " → Confirmed（组织者拍板，读回一致）" + tag)
            }
            return
        }
    }
}

fn reschedule_case(){
    // 改口 → 放弃任何待确认 + 关掉撤销窗口
    clear_cancel_pending("")
    undo_win_open = "no"
    let t = target_id()
    if t["id"] == 0 {
        ui.hint.set_text("列表为空：先建一条守护再改口")
        return
    }
    for i in cases.len() {
        if cases[i]["id"] == t["id"] {
            if cases[i]["status"] == "Cancelled" {
                ui.hint.set_text("该守护已取消，改口无效（#" + "" + t["id"] + "）")
                return
            }
            cases[i]["status"] = "Proposing"
            rebuild_lines()
            save()   // 结果写入全局 save_result
            ui.case_list.render()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            if save_result == "fail" {
                ui.hint.set_text("保存失败：守护数据可能未落盘（#已回到 Proposing in-memory；#" + "" + t["id"] + "）" + tag)
            } else {
                ui.hint.set_text("改口：#" + "" + t["id"] + " 回到 Proposing，重新收敛（旧确认作废）" + tag)
            }
            return
        }
    }
}

// === #8 保留：取消二次确认（两段式按钮态，不用模态） ===
// 第一次点：进入"待确认"态，按钮文案变"再点一次取消（5s）"，hint 提示；
// 第二次点：在 5 秒内才执行真正的取消；超时/选其他卡/点其他按钮 → 放弃
fn cancel_case(){
    let t = target_id()
    if t["id"] == 0 {
        ui.hint.set_text("列表为空：先建一条守护再取消")
        return
    }
    let target = t["id"]

    // 当前已经在对该条目标等待二次确认 → 第二次点击，执行真正取消
    if cancel_pending_id == target {
        for i in cases.len() {
            if cases[i]["id"] == target {
                cancel_prev_status = "" + cases[i]["status"]
                cases[i]["status"] = "Cancelled"
                cancel_pending_id = 0
                cancel_pending_deadline = 0
                cancel_pending_flag = "no"  // #11：确认态按钮撤下
                // === #9：撤销窗口打开 —— 现在起 5 秒内可点「撤销取消」 ===
                undo_win_open = "yes"
                undo_show_flag2 = "yes"    // #11：让 on_render 渲染可点的「撤销取消」
                rebuild_lines()
                save()   // 结果写入全局 save_result
                ui.case_list.render()
                let tag = ""
                if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
                if save_result == "fail" {
                    ui.hint.set_text("保存失败：守护数据可能未落盘（#已取消 in-memory；#" + "" + target + "，5 秒内可尝试撤销）" + tag)
                } else {
                    ui.hint.set_text("已取消 #" + "" + target + "（5 秒内可点「撤销取消」）" + tag)
                }
                // 5 秒后撤销窗口到期：自动清掉 hint 文案里的"可撤销"暗示
                // === #9 修：守卫 undo_win_open —— 若用户已撤销则不再覆盖 ===
                start_timeout(5.0, || {
                    if undo_win_open == "yes" {
                        undo_show_flag2 = "no"          // #11：撤下撤销按钮
                    undo_win_open = "no"
                        cancel_prev_status = ""
                        rebuild_lines()
                        ui.case_list.render()
                        ui.hint.set_text("取消 #" + "" + target + " 已生效（撤销窗口已过）")
                    }
                })
                return
            }
        }
        return
    }

    // 第一次点击：进入待确认态（不执行任何状态变更）
    for i in cases.len() {
        if cases[i]["id"] == target {
            cancel_pending_id = target
            cancel_prev_status = "" + cases[i]["status"]
            cancel_pending_deadline = 1
            cancel_pending_flag = "yes"   // #11：让 on_render 渲染「确认取消（5s）」变体
            rebuild_lines()
            ui.case_list.render()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            ui.hint.set_text("再点一次「确认取消」才会真取消 #" + "" + target + "；5 秒内点别的按钮或选别的卡可放弃" + tag)
            // 5 秒后超时 → 放弃确认态
            start_timeout(5.0, || {
                if cancel_pending_id == target {
                    cancel_pending_id = 0
                    cancel_pending_deadline = 0
                    cancel_prev_status = ""
                    cancel_pending_flag = "no"
                    undo_show_flag2 = "no"
                    rebuild_lines()
                    ui.case_list.render()
                    ui.hint.set_text("已放弃取消 #" + "" + target + "（5 秒内未再点取消）")
                }
            })
            return
        }
    }
}

// === #8 保留 + #9 修：撤销刚发生的取消（5 秒窗口内） ===
fn undo_cancel(){
    if cancel_prev_status == "" || undo_win_open == "no" {
        ui.hint.set_text("没有可撤销的取消（5 秒窗口已过或未取消过）")
        return
    }
    let restored_id = "0"
    for i in cases.len() {
        if cases[i]["status"] == "Cancelled" {
            cases[i]["status"] = cancel_prev_status
            restored_id = "" + cases[i]["id"]
        }
    }
    cancel_pending_id = 0
    cancel_pending_deadline = 0
    let prev = cancel_prev_status
    cancel_prev_status = ""
    // === #9 关键：关撤销窗口 + 阻止 5s 定时器覆盖当前 hint ===
    undo_win_open = "no"
    undo_show_flag2 = "no"   // #11：撤下可点的撤销按钮
    cancel_pending_flag = "no"
    rebuild_lines()
    save()   // 结果写入全局 save_result
    ui.case_list.render()
    if save_result == "fail" {
        if restored_id != "0" && restored_id != "" {
            ui.hint.set_text("保存失败：守护数据可能未落盘（#已撤销取消 in-memory；#" + restored_id + " 恢复到 " + prev + "）")
        } else {
            ui.hint.set_text("保存失败：守护数据可能未落盘（已撤销取消 in-memory）")
        }
    } else if restored_id != "0" && restored_id != "" {
        ui.hint.set_text("已撤销取消 #" + restored_id + " → 恢复到 " + prev)
    } else {
        ui.hint.set_text("已撤销取消")
    }
}

// AI 增强（可选）：仅当宿主提供 octos.* 时才尝试，否则明确降级
fn ai_parse(){
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    ui.case_list.render()
    let caps = host.capabilities()
    let has_octos = false
    for c in caps {
        if c == "octos.turn.start" { has_octos = true }
    }
    if has_octos {
        let text = ui.msg_input.text()
        if text == "" {
            ui.hint.set_text("先输入一条群消息再试 AI 解析")
            return
        }
        ui.hint.set_text("AI 解析中…")
        host.request("octos.turn.start", {text: "从这条聚会消息提取活动/时间/地点，只回 JSON：" + text}, fn(r){
            if r.is_ok { ui.hint.set_text("AI 回复：" + r.data.text) }
            else { ui.hint.set_text("AI 不可用，已降级为本地规则（" + r.error + "）") }
        })
    } else {
        ui.hint.set_text("本设备无 AI 服务（no service answers \"octos\"），本地规则继续可用")
    }
}

// === #14 新增：示例一键填充（演示友好） ===
// 输入框为空时供用户点；点完只填输入框、**不自动建守护**——
// 仍需用户主动点"建守护"，符合规范第 2 条"用户主动"原则。
fn fill_example(){
    // 任何非取消按钮都视为"放弃取消确认"
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    // 点示例按钮本身也放弃清空确认
    clear_pending_flag = "no"
    clear_pending_deadline = 0
    let cur = ui.msg_input.text()
    if cur != "" {
        // 输入框已有内容就不再覆盖，避免误丢用户手打的稿子
        ui.hint.set_text("输入框已有内容，未替换；点「建守护」继续，或手动清空再点示例")
        return
    }
    ui.msg_input.set_text("周六上午去深圳湾骑车，大概两小时？")
    ui.hint.set_text("已填示例到输入框（不自动建守护），点「建守护」继续")
}

// === #14 新增：导出数据（cases.json 原文屏显在 hint 区） ===
// 本 runtime 无法调起系统分享/把数据写到 jail 外（PRIVACY.md 同样承诺不出网），
// 故只能屏显：用户可长按/手动复制下方文本备份。文案必须说明「复制可备份」。
fn export_data(){
    // 任何非取消按钮都视为"放弃取消确认"
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    // 点导出按钮也放弃清空确认（互斥语义：先看清楚再考虑删）
    clear_pending_flag = "no"
    clear_pending_deadline = 0
    if !fs.exists("cases.json") {
        ui.hint.set_text("暂无 cases.json（一条守护都没建），无可导出内容")
        return
    }
    let raw = fs.read("cases.json")
    // 原样屏显 + 引导用户复制备份。hint 区是单行 Label，长内容直接塞入会撑高；
    // 这里就是用单 Label 容纳多行文本，Splash Label 自身会自然换行。
    ui.hint.set_text("—— cases.json 原文（复制可备份）——\n" + raw + "\n—— 复制以上文本即可备份 ——")
}

// === #14 新增：清空全部（两段式确认，复用 cancel_pending_flag 的 5s 机制） ===
// 第一次点：clear_pending_flag = "yes"，记下当前条数，按钮文案切到 hint 提示
//           "再点一次清空（5s）"；hint 明示将清空 N 条守护。
// 第二次点（5s 内）：fs.remove("cases.json") + 内存清空（cases=[]、seq=0、
//           selected_id=0、扁平数组全部清掉、rebuild_lines）+ hint 明示
//           "已清空 N 条守护"。超时 / 点别的按钮 → 放弃。
// 5s 后清空确认态的回收用 start_timeout(5.0, ...) —— 与 cancel_case 同源。
fn clear_all_data(){
    // 互斥：清空流程中放弃取消确认 + 撤销窗口（场景不重叠，避免 hint 互相覆盖）
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    let cur_n = cases.len()
    // 第二次点（已在确认态 + 5s 内） → 真正执行清空
    if clear_pending_flag == "yes" {
        // fs.remove 在文件不存在时返回错误值（非 nil/非 true）；按 #13 字符串标记约定
        // 判成败：消息字符串非空视为失败。注意：fs 也没有 rename，不要尝试先备份
        // 再删——本动作是用户主动清空，无需保留副本。
        let removed_msg = ""
        if fs.exists("cases.json") {
            let rr = fs.remove("cases.json")
            if rr != nil {
                removed_msg = "" + rr
            }
        }
        // 内存清空：扁平数组也要清，否则 on_render 闭包会读到旧 case_lines 等残留
        cases = []
        seq = 0
        selected_id = 0
        case_ids = []
        case_lines = []
        case_text_lines = []
        case_statuses = []
        case_selected = []
        case_badge_text = []
        case_receipt = []
        case_place_lines = []
        case_expanded = []
        case_activity_lines = []
        case_place_full = []
        case_status_text = []
        case_counts = []
        filtered_idxs = []
        filter_count_str = "0"
        filter_total_str = "0"
        matched_total_str = "0"
        current_query = ""
        rebuild_lines()
        ui.case_list.render()
        clear_pending_flag = "no"
        clear_pending_deadline = 0
        if removed_msg != "" {
            ui.hint.set_text("清空完成（已移除 cases.json 失败：" + removed_msg + "），内存已清 0 条守护")
        } else {
            ui.hint.set_text("已清空 " + "" + clear_prev_count + " 条守护（cases.json 已移除，内存已重置）")
        }
        clear_prev_count = 0
        return
    }
    // 第一次点：进入待确认态（不执行任何数据变更）
    clear_pending_flag = "yes"
    clear_pending_deadline = 1
    clear_prev_count = cur_n
    ui.hint.set_text("再点一次「清空全部」才会真删 " + "" + cur_n + " 条守护（不可逆）；5 秒内点别的按钮可放弃")
    // 5 秒后超时 → 放弃确认态
    start_timeout(5.0, || {
        if clear_pending_flag == "yes" {
            clear_pending_flag = "no"
            clear_pending_deadline = 0
            clear_prev_count = 0
            ui.hint.set_text("清空确认已过期（5s 内未再点），未删除任何数据")
        }
    })
}

start_timeout(0.05, || load())

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #x007aff

// 组件工厂：第一方 RoundedView/徽章范式（#7 落实）
// show_bg:true 是必填，否则 RoundedView 不绘背景
let Card = RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 12 right: 12 top: 12 bottom: 12}
    show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 14.0}
let Badge = RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
    show_bg: true draw_bg.color: #xefeff4 draw_bg.border_radius: 7.0}
let BadgeText = Label{text: "" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 11}}
let TitleLine = Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 16}
let TextLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
let ReceiptLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}

// === #9 新增：内联展开用的小字段标签（次级色粗体 13），照 #8 DetailSection 范式 ===
let SectionLabel = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 13}}
let BodyLine = Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 14}
let MetaLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}

SolidView{width: Fill height: Fill flow: Down padding: 16 spacing: 12 draw_bg.color: #xffffff
    Label{text: "牵线 · 聚会守护" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
    Label{text: "群里说好的聚会，盯到人人到场、账目清零" draw_text.color: secondary draw_text.text_style.font_size: 13}
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        msg_input := TextInput{width: Fill height: 40 empty_text: "粘贴群消息，如：周六上午去深圳湾骑车"
            draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 10.0}
            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
        // === #14：示例一键填充按钮（演示友好）===
        // 放根组件静态位置——根组件 if 只在首次求值定型，这里是固定按钮；
        // fill_example() 内部用 "cur != "" 守卫避免覆盖用户手打稿子。
        ButtonFlat{text: "用示例试试" height: 40 padding: Inset{left: 12 right: 12} on_click: || fill_example()
            draw_bg +: {border_radius: 20.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
            draw_text +: {color: accent color_hover: accent color_down: accent}}
        ButtonFlat{text: "建守护" height: 40 padding: Inset{left: 16 right: 16} on_click: || add_case()
            draw_bg +: {border_radius: 20.0 color: accent color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
    }
    hint := Label{width: Fill text: "载入中…" draw_text.color: secondary draw_text.text_style.font_size: 13}
    case_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
        // === #12 新增：搜索框（放在筛选栏之上、确认取消变体之上；
        //   根组件 if 只在首次求值定型，所以搜索框必须放在 on_render 闭包内；
        //   闭包内只读 current_query 字符串，不读 cases[i][...]） ===
        // on_change 实时调 set_query(q)；× 用 GestureView on_tap 清空；空字符串不过滤。
        // 照第一方 news 搜索框写法：TextInput empty_text + on_change 触发布尔过滤。
        let q_now = "" + current_query
        View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
            // 搜索框本体（占满剩余宽度）
            TextInput{width: Fill height: 32 empty_text: "搜活动或地点，如：深圳湾"
                text: q_now
                on_change: |t| set_query("" + t)}
            // 清空按钮：有词才显示（用 q_now 字面量作可见性条件，闭包内可读全局字符串）
            if q_now != "" {
                GestureView{on_tap: |x, y| set_query("") height: 32
                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "× 清空" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
        }
        // === #11 外环修：取消确认态变体（根组件 if 不随状态重算，必须放闭包内）===
        if cancel_pending_flag == "yes" {
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                ButtonFlat{text: "确认取消（5s）" height: 32 padding: Inset{left: 14 right: 14} on_click: || cancel_case()
                    draw_bg +: {border_radius: 16.0 color: #xff3b30 color_hover: #xe6352b color_down: #xcc2f26 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
            }
        } else {
            View{width: Fill height: 1}
        }
        // === #10 新增：筛选标签栏 + 计数（必须放 on_render 内：根组件属性不随状态重算，#8 实证） ===
        // 照第一方 news:301-306 写法：if t.id == tab {TabButtonActive{}} else {TabButton{}}
        // 计数照 ai-providers:45 "N models" 写法。Tab 是 GestureView on_tap 触发 set_filter。
        let cf_now = "" + current_filter
        View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
            // 标签 1：全部
            GestureView{on_tap: |x, y| set_filter("all") height: 32
                if cf_now == "all" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: accent draw_bg.border_radius: 16.0
                        Label{text: "全部" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "全部" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
            // 标签 2：待拍板
            GestureView{on_tap: |x, y| set_filter("Proposing") height: 32
                if cf_now == "Proposing" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: accent draw_bg.border_radius: 16.0
                        Label{text: "待拍板" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "待拍板" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
            // 标签 3：已确认
            GestureView{on_tap: |x, y| set_filter("Confirmed") height: 32
                if cf_now == "Confirmed" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: accent draw_bg.border_radius: 16.0
                        Label{text: "已确认" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "已确认" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
            // 标签 4：已取消
            GestureView{on_tap: |x, y| set_filter("Cancelled") height: 32
                if cf_now == "Cancelled" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: accent draw_bg.border_radius: 16.0
                        Label{text: "已取消" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "已取消" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
            // 计数标签（照 ai-providers:45 "N models" 写法，靠右）
            // total = 0 时也显示"共 0 条"，不编造
            Label{width: Fill text: "共 " + filter_count_str + " / " + filter_total_str + " 条"
                draw_text.color: secondary draw_text.text_style.font_size: 12}
        }

        // 空态分流（照 ai-providers:242-248 三分支）：本来没有 vs 筛选后没有，文案必须不同
        // 分支 A：本来就没有任何守护 —— 引导用户建第一条
        if cases.len() == 0 {
            // === #11 新增：首用引导卡 —— 只用 seq==0 判断（seq 只在 add_case 成功后 +1）。
            //   只要用户成功建过一条守护（seq>0），这张卡就永远消失；
            //   即使用户后来删了所有守护（cases.len()==0），也不再回到首用引导，
            //   只显示原本的"还没有聚会守护"通用空态。
            //   写在 on_render 闭包里（#8/#10 实证：根组件属性不随状态重算）。
            if seq == 0 {
                Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 20 bottom: 20} spacing: 8
                    Label{text: "第一次用？三步起一条守护" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{text: "① 粘贴群里那条聚会消息" draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{text: "② 点「建守护」，牵线分诊后生成提案" draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{text: "③ 组织者点同意，回执与提醒就位" draw_text.color: ink draw_text.text_style.font_size: 14}
                }
            }
            Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 28 bottom: 28} spacing: 6
                Label{text: "还没有聚会守护" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                Label{text: "粘贴一条群消息开始（例如：周六上午去深圳湾骑车）。点建守护后，行可点选。" draw_text.color: secondary draw_text.text_style.font_size: 13}
            }
            // 空分支兜底：永远留 1px 占位，防上帧残留（ai-providers:241 注释范式）
            View{width: Fill height: 1}
        // 分支 B：有守护但当前筛选下 0 条 —— 引导用户换筛选或建新条
        } else if filtered_idxs.len() == 0 {
            Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 28 bottom: 28} spacing: 6
                Label{text: "这个筛选下还没有守护" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                Label{text: "换个标签看看，或粘贴一条群消息开始（当前筛选：" + (if cf_now == "all" { "全部" } else if cf_now == "Proposing" { "待拍板" } else if cf_now == "Confirmed" { "已确认" } else { "已取消" }) + "）。" draw_text.color: secondary draw_text.text_style.font_size: 13}
            }
            // 筛选空分支兜底：同样留 1px 占位
            View{width: Fill height: 1}
        } else {
            // === #9 新增：撤销条放在 on_render 内的 undo_bar View 中（根组件 if 不重算，#8 外环修） ===
            // 撤销条必须放在渲染闭包里——根组件属性只在首次定型，不随状态变。
            // undo_win_open 守卫防止 5s 定时器在用户已撤销后再次覆盖。
            if undo_win_open == "yes" {
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
                    show_bg: true draw_bg.color: #xf2efff draw_bg.border_radius: 12.0
                    Label{width: Fill text: "撤销窗口已开（点下方按钮恢复）" draw_text.color: #x5856d6 draw_text.text_style: theme.font_bold{font_size: 13}}
                    ButtonFlat{text: "撤销取消" height: 32 padding: Inset{left: 14 right: 14} on_click: || undo_cancel()
                        draw_bg +: {border_radius: 16.0 color: #x5856d6 color_hover: #x4e4dc2 color_down: #x4443ab border_size: 0.0}
                        draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
                }
            }

            // === #10 改造：列表循环改走 filtered_idxs，按当前筛选渲染 ===
            // on_render 闭包只读字符串数组（filtered_idxs[i] 是整数，作为 case_* 数组下标），
            // 筛选本身在 rebuild_lines() 函数上下文里完成（可读 cases[i]["status"]），
            // 这里不做判断、不读 cases[i][…]，完全合规 #4/#5/#7/#8 硬约束。
            for i in filtered_idxs.len() {
                let j = filtered_idxs[i]
                let cur_id = case_ids[j]
                let expanded = case_expanded[j]
                // 高亮条：选中态左侧 4pt 色条（保留 ▶ 兼顾读屏）
                let hi_color = status_bar_color(case_statuses[j])
                let hi_w = 4
                if case_selected[j] != "yes" { hi_w = 0 }
                // 注：on_tap 只属 GestureView（RoundedView/Card 没有此属性），
                // 照第一方 news:319 的 GestureView 包 Card 写法；
                // #9：点卡片 = 选中 + 切换展开（取代 #8 open_detail）
                GestureView{width: Fill height: Fit on_tap: |x, y| on_tap_card(cur_id)
                    Card{
                        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.0}
                        View{width: hi_w height: 56 draw_bg.color: hi_color}
                        View{width: Fill height: Fit flow: Down spacing: 6
                            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                // 标题：选中时前缀 ▶，展开时前缀 ▾（给折叠/展开一个视觉差）
                                let prefix = "  "
                                if case_selected[j] == "yes" { prefix = "▶ " }
                                let exp_prefix = "  "
                                if expanded == "yes" { exp_prefix = "▾ " }
                                Label{width: Fill text: prefix + exp_prefix + case_lines[j] draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                Badge{BadgeText{text: case_badge_text[j] draw_text.color: status_badge_fg(case_statuses[j])}
                                    draw_bg +: {color: status_badge_bg(case_statuses[j])}}
                            }
                            // === #9：卡片摘要折叠态只保留原文一行（活动在标题里） ===
                            TextLine{text: case_text_lines[j]}
                            // === #9：展开态内联详情块（状态/活动/地点/原文 + 回执四行） ===
                            if expanded == "yes" {
                                // 展开与摘要之间留一道细线（用次级色细 View 模拟）
                                View{width: Fill height: 1 draw_bg.color: #xefeff4}
                                // 状态
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    SectionLabel{text: "状态"}
                                    BodyLine{text: case_status_text[j]}
                                }
                                // 活动
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    SectionLabel{text: "活动"}
                                    BodyLine{text: case_activity_lines[j]}
                                }
                                // 地点
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    SectionLabel{text: "地点"}
                                    BodyLine{text: case_place_full[j]}
                                }
                                // 原文（已在摘要显示过，这里做"完整原文"占位，便于区分）
                                View{width: Fill height: Fit flow: Down spacing: 2
                                    SectionLabel{text: "原文"}
                                    MetaLine{text: case_text_lines[j]}
                                }
                                // 回执四行：仅 Confirmed 渲染（用 case_receipt[j].len() 守护）
                                if case_receipt[j].len() > 0 {
                                    View{width: Fill height: Fit flow: Down spacing: 2
                                        SectionLabel{text: "回执"}
                                        for j in case_receipt[i].len() {
                                            ReceiptLine{text: "  ↳ " + case_receipt[i][j]}
                                        }
                                    }
                                }
                                // 展开态兜底：1px 占位（防上帧残留）
                                View{width: Fill height: 1}
                            }
                        }
                    }
                }
                }
            }
            // 非空分支兜底：留 1px 占位（ai-providers:241 注释范式）
            View{width: Fill height: 1}
        }
    }}
    action_row := View{width: Fill height: Fit flow: Right spacing: 8
        // === #11 动词化文案：同意选中 → 确认这条守护（绿=主行动 #7 状态色） ===
        ButtonFlat{text: "确认这条守护" height: 32 padding: Inset{left: 14 right: 14} on_click: || confirm_case()
            draw_bg +: {border_radius: 16.0 color: #x34c759 color_hover: #x30b350 color_down: #x2a9e47 border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
        // === #11 动词化文案：改口 → 重新收敛（橙=警示 #7 状态色） ===
        ButtonFlat{text: "重新收敛" height: 32 padding: Inset{left: 14 right: 14} on_click: || reschedule_case()
            draw_bg +: {border_radius: 16.0 color: #xff9500 color_hover: #xf08a00 color_down: #xd67d00 border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
        // === #11 动词化文案 + 取消按钮降权（默认态：浅底红字，视觉弱化）===
        // 注：确认态的「确认取消（5s）」变体由 case_list 的 on_render 渲染
        // （根组件属性不随状态重算，#8 实证）；此处只保留固定的默认态按钮。
        ButtonFlat{text: "取消守护" height: 32 padding: Inset{left: 14 right: 14} on_click: || cancel_case()
            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
            draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30}}
        // #9：撤销按钮已移到 case_list on_render 内的 undo_bar，根组件不再放 if 块
        // （#8 外环复验：根组件属性不随状态重算，必须放闭包里）
    }
    // === #11 操作行 vs AI行 语义分组：拆成第二行（可选增强），与主行动拉开层级 ===
    ai_row := View{width: Fill height: Fit flow: Right spacing: 8
        // === #11 AI 按钮弱化：去掉"试用"+"(可选增强)" → "AI 解析（可选）"；
        //   视觉从实心紫底白字降为浅底 + accent 字（与主行 #x007aff 同系，深色）——
        //   与新增的"取消守护"降权是同一思路：让默认态不抢眼 ===
        ButtonFlat{text: "AI 解析（可选）" height: 32 padding: Inset{left: 14 right: 14} on_click: || ai_parse()
            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
            draw_text +: {color: accent color_hover: accent color_down: accent}}
        // === #14：导出数据按钮（cases.json 原文屏显到 hint） ===
        // 屏显而非系统分享——本 runtime 无法调起分享/jail 外写文件（PRIVACY.md 承诺不出网）。
        ButtonFlat{text: "导出数据" height: 32 padding: Inset{left: 14 right: 14} on_click: || export_data()
            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
            draw_text +: {color: secondary color_hover: secondary color_down: secondary}}
        // === #14：清空全部按钮（两段式确认，复用 cancel_pending_flag 机制） ===
        // 根组件属性只在首次求值定型 → 按钮文案无法随状态切换（参考 #8 实证的取消按钮，
        // 它的"确认取消（5s）"变体是放在 case_list on_render 内的；这里同样约束，
        // 但本条要求"放根组件静态位置"——故采用"单一按钮 + on_click 内按 clear_pending_flag
        // 分支切两段行为"的方案，文案/状态切换走 ui.hint.set_text，与 cancel_case 同源）。
        // 视觉：次级灰底 + 警示红字，与"取消守护"同色系但不抢眼。
        ButtonFlat{text: "清空全部" height: 32 padding: Inset{left: 14 right: 14} on_click: || clear_all_data()
            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
            draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30}}
    }
}
