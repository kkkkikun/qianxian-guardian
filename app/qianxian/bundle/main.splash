// 「牵线」聚会筹办守护 — script-app 主提交物（A 路线）
// 无 AI 完整可用：本地规则分诊 → 提案 → 确认 → 活动簿，全部确定性可复现。
// AI 仅为可选增强（有 octos.* 宿主服务时才出现按钮），不可用时明确降级。

let cases = []
let case_ids = []           // 每条 case 的 id 字符串（扁平化供 on_render 只读）
let case_lines = []         // 每条 case 的标题字符串（#N · 活动）
let case_text_lines = []    // 每条 case 的原文字符串
let case_statuses = []      // 每条 case 的状态字符串（"Proposing"/"Confirmed"/"Cancelled"）
let case_selected = []      // 每条 case 的选中标记字符串（"yes"/"no"）
let case_badge_text = []    // 每条 case 的徽章文字字符串
let case_receipt = []       // 每条 case 的回执四行（字符串数组，无回执为空数组 []）
let case_place_lines = []   // 每条 case 的地点字符串（供 on_render 读，避免闭包读对象字段）
// === #17b 新增：时间槽抽取 + 冲突检测（扁平字符串数组，供 on_render 只读） ===
// slot_day/slot_part 两者都抽到才有冲突检测意义；任一抽不到就留空，
// 即「宁可空着不猜」（防编造）。conflict 是 "yes"/"no"。
let case_slot_day = []      // 每条 case 的「星期几」字符串（"周一"…/"周日"/""）
let case_slot_part = []     // 每条 case 的「时段」字符串（"上午"/"中午"/"下午"/"晚上"/""）
let case_conflict = []      // 每条 case 的冲突标记（"yes"/"no"）
let case_people_line = []            // 每条 case 的参与人字符串（"未填写" 或 "小明、小红"）
let case_conflict_lines = []
let case_conflict_party = []   // 冲突双方整行（扁平字符串，单独存避免 split/嵌套）// 每条 case 的冲突卡内容字符串数组（双方拼成单个字符串，防陷阱 A）
// === #30 新增：AA 收账（均摊）— 每条 case 两条扁平字符串 ===
// bill_total_str  = "300" / "300.5" / ""（原样存用户输入，展示前再转 f64）
// bill_split_text = 已用 bill_display 算好的「约 ¥X.XX/人」或「未记账」（on_render 只读）
let case_bill_total_str = []
let case_bill_split_text = []
let bill_save_result = "ok"           // C7 字符串标记：保存失败可见
let ui_mode = "list"                   // #31f 外环修：列表/详情模式切换（flag+render 既有模式）
let ai_pending = "no"                  // #32：AI 回合进行中（回调可能不触发，start_timeout 兜底降级）
let people_draft = ""                  // #31f：参与人输入草稿（on_render 内输入行走草稿，免具名绑定）
let bill_draft = ""                    // #31f：AA总额输入草稿
fn set_people_draft(s){
    people_draft = s
}
fn set_bill_draft(s){
    bill_draft = s
}
// === #9 新增：每条 case 的内联展开态（"yes"/"no"），用字符串标记数组驱动 on_render ===
let case_expanded = []      // 点卡片 = 选中 + 切换该条的展开/折叠

// === #30 新增：AA 收账均摊（参考 evidence/probe30-float-paradigm.md 真机范式） ===
// 总额存原样字符串，展示前再 to_f64；人数复用 people 字段逗号计数。
//   0/负数/空/垃圾 → 由 bill_display 的 total_f > 0 正向守卫统一兜底为「未记账」。
//   不用 \n 换行（手册 B5）；不用嵌套数组（手册 C2/陷阱 A）。
fn cut2(x){
    let s = "" + x
    let cs = s.to_chars()
    let n = cs.len()
    let dot = -1
    for i in n {
        if cs[i] == 46 { dot = i }
    }
    let take = n
    if dot >= 0 {
        take = dot + 3
        if take > n { take = n }
    }
    let out = ""
    for i in take {
        if cs[i] == 46 { out = out + "." } else { out = out + ("" + (cs[i] - 48)) }
    }
    if dot < 0 { out = out + ".00" }
    if dot >= 0 {
        if (n - dot) == 2 { out = out + "0" }
    }
    return out
}
fn bill_display(total_str, n_f){
    let bt = "" + total_str
    let total_f = bt.to_f64()
    let out = "未记账"
    if total_f > 0 {
        if n_f > 0 {
            out = "约 ¥" + cut2(total_f / n_f) + "/人"
        }
    }
    return out
}
fn count_people(people_str){
    let s = "" + people_str
    let n = 0
    if s == "" { return 0 }
    for nm in s.split(",") {
        if nm.trim() != "" { n = n + 1 }
    }
    return n
}

let seq = 0
let selected_id = 0  // 选中态：0 表示无选中

// === #8 保留：取消二次确认 + 撤销态 ===
let cancel_pending_id = 0           // 第一次点取消时的目标 id（0 = 无待确认）
let cancel_prev_status = ""         // 取消前该条的状态（用于撤销恢复）
let cancel_pending_deadline = 0     // 取消二次确认的截止时刻（ms 级 epoch，由 start_timeout 推进）
// === #25 新增：撤销目标限定（解决 #24 自审 S8 + 外环复核 #25 实证 bug）===
// 原 undo_cancel 遍历所有 cases 把 status=="Cancelled" 的全恢复，导致
//「取消 #1 → 取消 #2 → 撤销」把 #1 也连带恢复，违反"撤销只针对刚发生的操作"。
// 修法 = 记录本次取消的那一条 id（cancelled_last_id，0 表示无），撤销时只恢复 id
// 与其相等的那一条，其余 Cancelled 维持原状；恢复成功后 cancelled_last_id=0。
let cancelled_last_id = 0           // 最近一次被取消的那条 id（0 = 无；撤销成功 / 放弃 / 5s 到期后归零）

// === #9 新增：撤销窗口标记 —— 防止 5 秒定时器在用户已撤销之后再次覆盖 hint 文案 ===
// 撤销窗口打开 = 撤销按钮可用；一旦撤销成功或窗口到期，必须把它关掉，
// 否则 5s 后那个 start_timeout 回调会把"已撤销 #N"的提示覆盖掉。
let undo_win_open = "no"
let cancel_pending_flag = "no"          // 取消待确认标记（供 on_render 渲染确认态按钮）
let undo_show_flag2 = "no"             // 撤销条可见标记（供 on_render 渲染撤销按钮）            // "yes"/"no"

// === #14 新增：示例填充 / 导出 / 清空全部 三个数据控制动作的状态 ===
// 清空走"两段式确认"复用 cancel_pending_flag 的 5s 思路：
//   第一次点：clear_pending_flag = "yes"，按钮文案变"再点一次清空（5s）"，hint 提示；
//   第二次点（5s 内）：fs.remove("cases.json") + 内存清空 + hint 明示条数；
//   超时 / 点别的按钮 → 放弃。
// 用**字符串标记**而非布尔，与 cancel_pending_flag 同源；本 runtime 下函数返回
// 布尔在调用点 == false 比较不可靠（黑板 #13 实证）。
let clear_pending_flag = "no"           // 清空待确认标记（"yes"/"no"）
let clear_pending_deadline = 0         // 清空确认的截止时刻（仅占位，不做时间比较，start_timeout 自身 5s 守护）
let clear_prev_count = 0               // 进入待确认态时记下当前条数，用于最终 hint 明示

// === #19 新增：「仍然建守护」二次确认态（分诊仅命中时间词时使用）===
// 当 triage 返回 "time_only"（仅命中时间词、缺活动/约定/聚会场景词），
// 不直接拦死用户——而是进入"待用户主动确认"态：force_create_pending = "yes"，
// force_create_text 记下首次按"建守护"时的输入原文；hint 文案明示
// "有时间，但这看起来不像聚会安排——要牵线跟这条吗？"并提示再点一次"建守护"即可。
// 第二次按"建守护"且原文未变 → 强制建守护（标记 level="force"，便于回执/hint 溯源）。
// 用户改了输入原文 / 5s 超时 / 点了别的按钮 → 放弃。
let force_create_pending = "no"
let force_create_text = ""
let force_create_deadline = 0

// === #10 新增：筛选状态 + 计数（扁平字符串，不读 cases[i][...]） ===
// current_filter 是当前选中的筛选标签："all" / "Proposing" / "Confirmed" / "Cancelled"
// filtered_idxs 是按当前筛选过滤后的下标整数数组（驱动 on_render 列表，避免字符串→int 回转）
// filter_count_str 是右侧"共 N 条"的展示字符串（数字必须字符串化，#4/#5 实证）
// filter_total_str 是总条数（用于筛选空文案："共 X 条守护，筛选后 0 条"）
let current_filter = "all"
let filtered_idxs = []
let filter_count_str = "0"
let filter_total_str = "0"

// === #16 新增：「怎么用」说明卡展开标记 ===
// 字符串标记（"yes"/"no"），与 cancel_pending_flag / undo_show_flag2 同源（本 runtime
//   函数返回布尔不可靠，#13 实证）。默认行为：seq == 0（从未建过守护）→ "yes" 自动展开；
//   seq > 0（建过守护）→ "no" 默认收起。用户点首屏底部「怎么用？」按钮可手动切换。
// 这里直接读顶层 seq 初值（load() 之前为 0；load() 完成后若 parsed_seq > 0 自动落到 "no"）。
let howto_show_flag = if seq == 0 { "yes" } else { "no" }
// === #12 新增：搜索词状态（"all" 之外的第二维度，叠加在标签筛选之上） ===
// current_query 是搜索框当前文本（实时过滤触发源；空串=不过滤）
// matched_total_str 是「按当前标签的总命中数」（不含搜索词），即"共 N/M"中的 M
let current_query = ""
let matched_total_str = "0"

// === #9 新增：扁平字段——避免 on_render 闭包读 cases[i][...]（#4/#5/#7/#8 实证坑） ===
// 卡片内联展开后，"活动/地点/原文/状态" 这些原来只在详情层用的字段也要按行铺平，
// 否则 on_render 闭包要去摸对象字段，触发实证过的类型/作用域问题。
let case_activity_lines = []        // 每条 case 的活动字符串（无则"（未抽取到）"）
let case_place_full = []            // 每条 case 的地点字符串（无则"（未抽取到）"）
let case_status_text = []           // 每条 case 的状态中文（"待拍板"/"已确认"/"已取消"）

// 状态色：行首徽章文字色与底色（Proposing 灰 / Confirmed 绿 / Cancelled 红）
// 注：颜色必须是颜色字面量（#x…），不能返回字符串——draw_bg.color 期望 Vec4f
fn status_badge_bg(st){
    if st == "Confirmed" { return #xe6f7ec }
    if st == "Cancelled" { return #xfdecea }
    return #xefeff4  // Proposing / 兜底灰
}
fn status_badge_fg(st){
    if st == "Confirmed" { return #x1f8a3a }
    if st == "Cancelled" { return #xff3b30 }
    return #x6b6b73  // Proposing / 兜底灰
}
fn status_badge_text(st){
    if st == "Confirmed" { return "已确认" }
    if st == "Cancelled" { return "已取消" }
    if st == "Proposing" { return "待拍板" }
    return "" + st
}
fn status_bar_color(st){
    if st == "Confirmed" { return #x34c759 }
    if st == "Cancelled" { return #xff3b30 }
    return #xb0b0b8  // Proposing / 兜底
}

// === #42 新增：AI 解析结果"建议卡"展示态（不直接写入输入框） ===
//   外环范式：官方 AI-SERVICES 强制模型文本只填文本槽、绝不参与动作接线；
//   shells 侧 kit 会自动画 sparkle+AI 眉标（OctoScript#53/#68），但本仓库 pinned runtime
//   （card-host）的 L0 checker 不认识——所以诚实降级形态 = app 自己画「✨ AI 生成」眉标。
//   ai_card_visible="yes" → on_render 列表分支顶部渲染「✨ AI 生成」建议卡
//     + BodyLine 汇总（活动/时间/地点，空字段显"未给出"）
//     + 「采纳到输入框」按钮（accent 蓝）→ 调 ai_adopt()，guard 后用既有 parse_apply 写入 msg_input
//     + 「忽略」按钮（灰 flat）→ 调 ai_dismiss()，仅翻标记 + 重渲染。
//   ai_act/ai_day/ai_part/ai_place = trim24 后的结构化字段，采纳时直接喂 parse_apply。
//   字符串标记（与 cancel_pending_flag / undo_show_flag2 同源；本 runtime 函数返回布尔在
//   调用点 == false 比较不可靠，黑板 #13 实证）。
let ai_card_visible = "no"
let ai_act = ""
let ai_day = ""
let ai_part = ""
let ai_place = ""
// AI 眉标配色（紫调）：底 #xf3e8ff（淡紫）/ 字 #x7c3aed（深紫）
// 照 status_badge_bg/fg 范式，draw_bg.color 期望颜色字面量（#x…），不能返回字符串
fn ai_badge_bg(){
    return #xf3e8ff
}
fn ai_badge_fg(){
    return #x7c3aed
}

// === #43 D 切片：回执模板三档可切换（standard/brief/emoji）+ pref.json 持久化 ===
// 字符串标记（与 howto_show_flag/ai_card_visible 同源；照 #13 实证范式）。
// 合法值三档，其他值一律按 standard 兜底（rebuild_lines 内归一化）。
// "app 记住人的偏好" 演示：点首屏底部「风格：X」按钮循环切换，写 pref.json，
// 重启后 load() 读回内存 → 已有守护立即按新风格重排（rebuild_lines 即时刷新）。
let receipt_style = "standard"
// pref.json 写入失败标记（照 save_result 范式字符串：调用点用 == "fail" 判定）。
// 与 save_result 不同：本任务不需返回值给调用点（hint 已内置两路文案），
// 留全局只为方便调试/未来追溯；hint 范式已要求 fs.write 返回非 nil = 失败。
let pref_save_result = "ok"

// 重建：把所有渲染所需的字段都扁平化为字符串/字符串数组，
// 让 on_render 闭包只读字符串数组，不读 cases[i][...]（#4/#5/#7/#8 实证坑）
fn rebuild_lines(){
    // === #10/#12 新增：筛选下标数组 + 计数串在这里重建（filter 逻辑放函数上下文，不进 on_render） ===
    // #12 叠加：先用 current_filter 过一遍得到「标签总数 M」与候选 idxs；
    //   再用 current_query（search(p)>=0，命中 activity/place/text 子串）
    //   在候选里二次过滤，最终 push 进 filtered_idxs 的就是"标签+搜索"两层之后的命中数 N。
    //   显示文案"共 N / M 条"：N=filter_count_str，M=matched_total_str（不含搜索词）。
    filtered_idxs.clear()
    let cf = "" + current_filter
    let q = "" + current_query
    let label_matched = 0
    let view_idxs = []
    for i in cases.len() {
        let st = "" + cases[i]["status"]
        let keep = false
        if cf == "all" { keep = true }
        else if cf == "Proposing" && st == "Proposing" { keep = true }
        else if cf == "Confirmed" && st == "Confirmed" { keep = true }
        else if cf == "Cancelled" && st == "Cancelled" { keep = true }
        if keep {
            view_idxs.push(i)
            label_matched = label_matched + 1
        }
    }
    matched_total_str = "" + label_matched
    filter_total_str = "" + label_matched
    // 第二层：搜索词叠加（在标签候选内命中 activity / place / 原文子串）
    let n = 0
    if q == "" {
        // 搜索词为空：直接全部保留（标签结果 = 实际渲染结果），保持创建序稳定
        for i in view_idxs.len() {
            filtered_idxs.push(view_idxs[i])
        }
        n = view_idxs.len()
    } else {
        for i in view_idxs.len() {
            let j = view_idxs[i]
            let act = "" + cases[j]["activity"]
            let pl = "" + cases[j]["place"]
            let txt = "" + cases[j]["text"]
            // search(p) >= 0：命中即返回 >=0，没命中返回 -1（照 #12 契约明示，不用 regex）
            let hit = (act.search(q) >= 0) || (pl.search(q) >= 0) || (txt.search(q) >= 0)
            if hit {
                filtered_idxs.push(j)
                n = n + 1
            }
        }
    }
    filter_count_str = "" + n
    case_ids.clear()
    case_lines.clear()
    case_text_lines.clear()
    case_statuses.clear()
    case_selected.clear()
    case_badge_text.clear()
    case_receipt.clear()
    case_place_lines.clear()
    case_activity_lines.clear()
    case_place_full.clear()
    case_status_text.clear()
    case_slot_day.clear()
    case_slot_part.clear()
    case_conflict.clear()
    case_people_line.clear()
    case_conflict_lines.clear()
    case_conflict_party.clear()
    case_bill_total_str.clear()
    case_bill_split_text.clear()
    // 同步 case_expanded：保留已展开态，遇 selected_id 变更时不强制清空
    // （点同一张卡：折叠；点别的卡：保留各自展开态，保留用户的"展开阅读"行为）
    for i in cases.len() {
        let id_str = "" + cases[i]["id"]
        case_ids.push(id_str)
        let sel = "no"
        if cases[i]["id"] == selected_id { sel = "yes" }
        case_selected.push(sel)
        let st = "" + cases[i]["status"]
        case_statuses.push(st)
        // === #18 新增：冲突时把「·冲突」追加到徽章文字（折叠态色点已让位给 status_bar_color，不再用红色点表冲突） ===
        let badge_t = status_badge_text(st)
        let cf_lab0 = "" + cases[i]["conflict"]
        if cf_lab0 == "yes" { badge_t = badge_t + "·冲突" }
        case_badge_text.push(badge_t)
        let title_act = "" + cases[i]["activity"]
        if title_act == "" { title_act = "聚会" }
        case_lines.push("#" + id_str + " · " + title_act)
        case_text_lines.push("" + cases[i]["text"])

        // === #9 新增：扁平活动/地点/状态中文（供卡片内联展开块读） ===
        let act = "" + cases[i]["activity"]
        if act == "" { act = "（未抽取到）" }
        case_activity_lines.push(act)
        let pl = "" + cases[i]["place"]
        if pl == "" { pl = "（未抽取到）" }
        case_place_full.push(pl)
        case_status_text.push(status_badge_text(st))
        let ppl = "" + cases[i]["people"]
        if ppl == "" { ppl = "未填写" }
        case_people_line.push(ppl)

        // === #30 新增：AA 均摊两列（扁平字符串，on_render 只读） ===
        let bt = "" + cases[i]["bill_total"]
        case_bill_total_str.push(bt)
        // #30b 外环修：splash 无三目运算符（真机 rebuild_lines 全 trap: unknown named arg），
        //   改单层 if 归一化（C9 边界内：循环内单层 if 赋值已实证安全，探针 v8 P4/P5）。
        let ppl_arg = ppl
        if ppl == "未填写" { ppl_arg = "" }
        let np_count = count_people(ppl_arg)
        case_bill_split_text.push(bill_display(bt, np_count))

        // === #17b 新增：扁平「星期几 / 时段 / 冲突标记」三字段（供 on_render 只读） ===
        // 对象字段访问在闭包里不稳，硬约束 #4/#5；预置到 push 字面量 + 重建时落到扁平数组。
        let sd = "" + cases[i]["slot_day"]
        let sp = "" + cases[i]["slot_part"]
        let cf_lab = "" + cases[i]["conflict"]
        case_slot_day.push(sd)
        case_slot_part.push(sp)
        case_conflict.push(cf_lab)
        // 冲突卡内容：双方拼成单个字符串（陷阱 A：不要嵌套数组）。
        // 没有冲突时留空数组（on_render 不渲染）。
        if cf_lab == "yes" {
            let slot_label = sd + "-" + sp
            let other_id = ""
            let other_slot = ""
            let other_act = ""
            // 在 cases 里找出冲突的对方（非 Cancelled 且同 slot），用 i_outer 避免内层 j 复用陷阱
            for ci in cases.len() {
                if ci == i { continue }
                if cases[ci]["status"] == "Cancelled" { continue }
                let osd = "" + cases[ci]["slot_day"]
                let osp = "" + cases[ci]["slot_part"]
                if osd == "" || osp == "" { continue }
                if osd == sd && osp == sp {
                    other_id = "" + cases[ci]["id"]
                    other_slot = osd + "-" + osp
                    other_act = "" + cases[ci]["activity"]
                    if other_act == "" { other_act = "（未抽取到）" }
                    break
                }
            }
            // 冲突卡：两行拼成**单个字符串**（陷阱 A：数组不可嵌套；
            // 陷阱 D：\n 在 Label 里不换行，故渲染端用两个 Label 拆开显示）。
            let head = "⚠ 时间冲突：#" + id_str + " · " + act + " 也占「" + slot_label + "」时段"
            let party = "要改期还是取消？冲突双方：#" + id_str + " · " + act + " · " + slot_label
            if other_id != "" {
                // #17b 外环修：原来错用 cases[i]（自己），应为冲突对方 cases[ci]
                party = party + "  ｜ #" + other_id + " · " + other_act + " · " + other_slot
            }
            case_conflict_lines.push(head)
            case_conflict_party.push(party)
        } else {
            case_conflict_lines.push("")
            case_conflict_party.push("")
        }

        // === #9 新增：保持现有 case_expanded 长度与 cases 同步 ===
        if i >= case_expanded.len() {
            case_expanded.push("no")
        }
        // 已存在的展开态保持不动（用户切别的卡不强制收拢）

        // === #8 保留：place 给收起态 placeholder 用 ===
        let place_disp = "" + cases[i]["place"]
        if place_disp == "" { place_disp = "（未抽取到）" }
        case_place_lines.push(place_disp)

        // === #8 保留：Confirmed 才填回执四行（首次进入时快照，幂等） ===
        if st == "Confirmed" {
            if cases[i]["receipt_done"] != "yes" {
                cases[i]["receipt_activity"] = "" + cases[i]["activity"]
                cases[i]["receipt_place"] = "" + cases[i]["place"]
                cases[i]["receipt_text"] = "" + cases[i]["text"]
                cases[i]["receipt_done"] = "yes"
            }
            let ra = "" + cases[i]["receipt_activity"]
            let rp = "" + cases[i]["receipt_place"]
            let rt = "" + cases[i]["receipt_text"]
            let arr = []
            // === #43 D 切片：按 receipt_style 渲染行（快照语义不变——ra/rp/rt 仍固定，
            //   风格只影响**渲染行**；切换风格立即 rebuild_lines，已有守护即按新风格重排）
            if receipt_style == "brief" {
                // 简短：合并活动+地点为一行 + 提醒行（地点为空时合并行只留活动）
                if rp != "" {
                    arr.push("活动：" + ra + " ｜ 地点：" + rp)
                } else {
                    arr.push("活动：" + ra)
                }
                arr.push("T-24h 提醒（本地提醒文本，需宿主定时能力）")
            } else if receipt_style == "emoji" {
                // 带 emoji：4 行各加前缀（与现状✨/⚠前缀一致——emoji 不增不减）
                arr.push("📌 活动：" + ra)
                arr.push("📍 地点：" + rp)
                arr.push("💬 原文：" + rt)
                arr.push("⏰ T-24h 提醒（本地提醒文本，需宿主定时能力）")
            } else {
                // standard（默认兜底；任何 receipt_style 非合法值都走这里）
                arr.push("活动：" + ra)
                arr.push("地点：" + rp)
                arr.push("原文：" + rt)
                arr.push("T-24h 提醒（本地提醒文本，需宿主定时能力）")
            }
            case_receipt.push(arr)
        } else {
            case_receipt.push([])
        }
    }
    // 多余的展开态条目截断（cases 缩短时）
    while case_expanded.len() > cases.len() {
        case_expanded.pop()
    }
    // #31f：详情面板已并入 case_list on_render（ui_mode 分支，随 render 自动刷新），
    //   不再需要命令式 update_detail_panel（其 set_text 依赖树外静态区，已证不可靠）。
}

// #13：损坏兜底。cases.json 存在但内容不是预期结构（parse_json 失败 / v 为 nil /
//   cases 不是数组 / seq 不是数字），不覆盖现有数据，而是把坏文件改名为
//   cases.corrupt-<n>.json（<n> 用文件里的 seq；seq 不是数字时用固定名
//   cases.corrupt.json，允许覆盖上一次的备份），然后以空状态启动并在 hint 明示。
//   绝不 silently 丢掉用户数据——数据是本应用唯一资产。
fn load(){
    let hint = "已载入 " + "" + cases.len() + " 个聚会守护"
    let hint_suffix = ""
    if fs.exists("cases.json") {
        let raw = fs.read("cases.json")
        let v = raw.parse_json()
        let bad = (v == nil)
        let parsed_cases = []
        let parsed_seq = 0
        let seq_is_num = false
        if !bad {
            // 校验 v["cases"] 是数组、v["seq"] 是数字；任何一个不达标即视为损坏
            let raw_cases = v["cases"]
            let raw_seq = v["seq"]
            if raw_cases != nil {
                // 数组的真值特征：可取 .len()。非数组对象/字符串/数字在这里调用
                // .len() 在 Splash 不会报错，会返回不预期的值；改用 "长度 > 0 且
                // 第一项是字典" 这种保守判定（cases 至少有一个对象）。
                if raw_cases.len() > 0 {
                    let first = raw_cases[0]
                    if first != nil {
                        parsed_cases = raw_cases
                    }
                } else if raw_cases.len() == 0 {
                    // 空数组是合法状态（用户清空了），接纳
                    parsed_cases = raw_cases
                }
                // 注意：raw_cases.len() 对非数组可能不抛错，但后续 rebuild_lines
                // 会读到一致行为；如果 parsed_cases 保持 []，后面 bad 会被翻成 true
            }
            if raw_seq != nil {
                // 数字判定：加 0 后与原值一致；否则把 seq_is_num 留 false
                let as_num = raw_seq + 0
                if "" + as_num == "" + raw_seq {
                    seq_is_num = true
                    parsed_seq = as_num
                }
            }
            // 校验通过的条件：raw_cases != nil 且 raw_seq != nil 且 seq_is_num
            // parsed_cases 已经接受了空数组；非数组场景下 parsed_cases 仍为 []
            // 但 cases.len()=0 会让重建前后一致，行为也可接受——为安全起见，
            // 仍然以「cases 是数组且 seq 是数字」双门控判定损坏。
            if raw_cases == nil || !seq_is_num {
                bad = true
            }
        }
        if bad {
            // 备份坏文件：<n> 优先用文件里的 seq（即使非数字也允许为字串后缀），
            // 不可得时用固定名 cases.corrupt.json（覆盖上一次备份）
            let backup_name = "cases.corrupt.json"
            if raw_seq != nil {
                backup_name = "cases.corrupt-" + "" + raw_seq + ".json"
            }
            // 注：Splash 的 fs 无 rename（只有 exists/read/read_bytes/write/
            // append/list/mkdir/remove，见 SCRIPT-API §Storage）。改用
            // 「把原文写进备份文件」实现等效效果：不删原文件，内容不丢。
            let original_text = fs.read("cases.json")
            let _ = fs.write(backup_name, original_text)
            // 内存回到空态：cases=[], seq=0
            cases = []
            seq = 0
            hint = "发现损坏的守护数据，已备份为 " + backup_name + " 并重新开始"
            hint_suffix = ""
        } else {
            // 校验通过：正常载入
            cases = parsed_cases
            seq = parsed_seq
            hint = "已载入 " + "" + cases.len() + " 个聚会守护"
            // #13 第 4 条：列表较长时提示用筛选/搜索
            if cases.len() > 20 {
                hint_suffix = "，列表较长，建议用筛选或搜索"
            }
        }
    } else {
        // 首次启动：无文件，按空态走
        if cases.len() > 20 {
            hint_suffix = "，列表较长，建议用筛选或搜索"
        }
    }
    // #43：载入 pref.json（与 cases.json 同一 fs.read/parse_json 范式）。
    // 内容 {"receipt_style": "standard|brief|emoji"}；文件不存在 / parse 失败 /
    // 字段非法一律回落到 "standard"，**不报错不归档**——preference 损坏不影响
    // 用户的聚会数据（与 cases 损坏的"备份改名"语义不同，preference 是偏好不是资产）。
    // 字段校验：仅三档合法（"standard"/"brief"/"emoji"），其他值按兜底走。
    if fs.exists("pref.json") {
        let praw = fs.read("pref.json")
        let pv = praw.parse_json()
        let pbad = (pv == nil)
        if !pbad {
            let prs = pv["receipt_style"]
            if prs != nil {
                let prs_str = "" + prs
                if prs_str == "standard" || prs_str == "brief" || prs_str == "emoji" {
                    receipt_style = prs_str
                }
                // 其他值（含空串）走兜底：receipt_style 保持 "standard"
            }
        }
        // pv == nil 或 prs == nil：同样兜底，不报错
    }
    // #44 外环修：根组件按钮文案在首次求值已定型（当时 receipt_style 还是 "standard"），
    //   load() 此刻读回的偏好不会反映到标签——重启后按钮显示「标准」实际却是 emoji 档
    //   （首次点击才自愈）。照 ui.hint.set_text 同范式命令式同步。
    ui.style_btn.set_text("风格：" + style_label_for(receipt_style))
    rebuild_lines()
    ui.case_list.render()
    ui.hint.set_text(hint + hint_suffix)
}

// #13：写入失败可见。fs.write 在出错时返回错误值（非 nil/非 true），save() 把这个
//   信号向上层返回：调用点根据返回值决定是否覆盖"成功"提示为失败提示，避免 silently
//   告诉用户「已保存」但实际没落盘——同样是不丢用户数据的兜底。
// 用**字符串标记**返回成败，不用布尔：#13 外环复验发现该 runtime 下
// 函数返回的 true/false 在调用点 `ok == false` 比较中不可靠（写入明明成功
// 却走进失败分支）。字符串比较已在多处验证可靠。
let save_result = "ok"
let brief_save_result = "ok"   // #45：agent-brief.json 落盘结果（独立标记，best-effort）
// #45 C 切片：agent 自适应提示——agent 优先读 agent-brief.json（紧凑摘要，省上下文）。
//   字段全部 "" + x 字符串化，与 cases.json 字段一一对应；status 保留以便 agent
//   区分 Confirmed / Proposing。**best-effort**：brief_save_result 失败只扁平落全局
//   字符串（照 save_result 范式），不打 hint、不影响 cases.json 保存语义——
//   brief 是辅助件，cases.json 才是事实源；与"错误不静默编造"不冲突（不编造、
//   只是辅助件降级，下次 save() 会自然重写）。
fn write_agent_brief(){
    let rows = []
    for i in cases.len() {
        let row = {
            id: "" + cases[i]["id"],
            activity: "" + cases[i]["activity"],
            slot_day: "" + cases[i]["slot_day"],
            slot_part: "" + cases[i]["slot_part"],
            place: "" + cases[i]["place"],
            status: "" + cases[i]["status"]
        }
        rows.push(row)
    }
    let payload = {seq: seq, cases: rows}.to_json()
    let br = fs.write("agent-brief.json", payload)
    if br == nil { brief_save_result = "ok" }
    else {
        let bm = "" + br
        if bm == "" { brief_save_result = "ok" } else { brief_save_result = "fail" }
    }
}
fn save(){
    let r = fs.write("cases.json", {cases: cases, seq: seq}.to_json())
    // SCRIPT-API §Storage：fs.write 成功返回 nil；失败返回一个错误值。
    if r == nil { save_result = "ok" }
    else {
        let msg = "" + r
        if msg == "" { save_result = "ok" } else { save_result = "fail" }
    }
    // #45：save() 是唯一落盘咽喉——建卡/改期/取消/AA/清空全部路径都过这里，
    //   因此在 save() 末尾同步刷一份 agent-brief.json，agent 就能拿到最新状态。
    //   brief 是辅助件（cases.json 才是事实源），失败不阻断、不打 hint。
    write_agent_brief()
}

// 解析"作用目标"：选中优先，否则最新一条并明示
fn target_id(){
    if selected_id > 0 {
        for i in cases.len() {
            if cases[i]["id"] == selected_id { return {id: selected_id, fallback: false} }
        }
        // 选中 id 已被删除/不存在：降级到最新一条
    }
    if cases.len() > 0 { return {id: cases[cases.len() - 1]["id"], fallback: true} }
    return {id: 0, fallback: true}
}

// === #8 保留：清除取消二次确认态（任何非「取消」按钮/动作都放弃确认） ===
// === #23：追加参与人（逗号分隔，上限 10 人） ===
//   C4 重建数组 / C6 闭包用 selected_id / C7 字符串标记
let people_save_result = "ok"
fn add_person(id_str, raw){
    if id_str == "" || id_str == "0" {
        ui.hint.set_text("先选中一条守护再添加参与人")
        return
    }
    let name = "" + raw
    name = name.trim()
    if name == "" {
        ui.hint.set_text("请先输入姓名（多个用逗号分隔）")
        return
    }
    let cur = -1
    for pi in cases.len() {
        if "" + cases[pi]["id"] == id_str { cur = pi }
    }
    if cur < 0 {
        ui.hint.set_text("找不到 #" + id_str + "，请重新选中")
        return
    }
    let old = "" + cases[cur]["people"]
    let added = []
    for nm in name.split(",") {
        let one = nm.trim()
        if one != "" { added.push(one) }
    }
    if added.len() == 0 {
        ui.hint.set_text("没解析到有效姓名（多个请用逗号分隔）")
        return
    }
    // 上限 10 人（手册纪律：先检查再写）
    let total = 0
    if old != "" {
        for ex in old.split(",") { if ex.trim() != "" { total = total + 1 } }
    }
    if total + added.len() > 10 {
        ui.hint.set_text("参与人已达上限 10 人，未添加")
        return
    }
    let merged = old
    for an in added {
        if merged == "" { merged = an } else { merged = merged + "," + an }
    }
// C4：重建数组（#38 修：必须保留 slot_init_asked，否则 add_person 会把
        //   首次点改时间的"再点一次才填"标记清掉，导致反复弹窗）
        let new_cases = []
        for qi in cases.len() {
            if qi == cur {
                new_cases.push({"id": cases[qi]["id"], "text": cases[qi]["text"],
                    "activity": cases[qi]["activity"], "place": cases[qi]["place"],
                    "status": cases[qi]["status"],
                    "slot_day": cases[qi]["slot_day"], "slot_part": cases[qi]["slot_part"],
                    "conflict": cases[qi]["conflict"], "people": merged,
                    "bill_total": cases[qi]["bill_total"],
                    "receipt_activity": cases[qi]["receipt_activity"],
                    "receipt_place": cases[qi]["receipt_place"],
                    "receipt_text": cases[qi]["receipt_text"],
                    "receipt_done": cases[qi]["receipt_done"],
                    "slot_init_asked": cases[qi]["slot_init_asked"]})
            } else {
                new_cases.push({"id": cases[qi]["id"], "text": cases[qi]["text"],
                    "activity": cases[qi]["activity"], "place": cases[qi]["place"],
                    "status": cases[qi]["status"],
                    "slot_day": cases[qi]["slot_day"], "slot_part": cases[qi]["slot_part"],
                    "conflict": cases[qi]["conflict"], "people": cases[qi]["people"],
                    "bill_total": cases[qi]["bill_total"],
                    "receipt_activity": cases[qi]["receipt_activity"],
                    "receipt_place": cases[qi]["receipt_place"],
                    "receipt_text": cases[qi]["receipt_text"],
                    "receipt_done": cases[qi]["receipt_done"],
                    "slot_init_asked": cases[qi]["slot_init_asked"]})
            }
        }
    cases = new_cases
    rebuild_lines()
    let r = fs.write("cases.json", {cases: cases, seq: seq}.to_json())
    people_save_result = "ok"
    if r != nil {
        let m = "" + r
        if m != "" { people_save_result = "fail" }
    }
    ui.case_list.render()
    people_draft = ""
    if people_save_result == "fail" {
        ui.hint.set_text("已加 " + "" + added.len() + " 人（保存失败，仅在内存）")
    } else {
        ui.hint.set_text("#" + id_str + " 参与人：" + merged)
    }
}

// === #30 新增：AA 收账总额（保存=原样写入 bill_total；展示由 bill_display 正向守卫兜底）
//   C4 重建数组 / C7 字符串标记 bill_save_result / 不在循环内嵌套 if 赋值（避 C9）
//   不做 trim 之外的格式校验——bill_display 的 total_f > 0 守卫天然处理空/0/负数/垃圾
fn update_bill_total(id_str, raw){
    if id_str == "" || id_str == "0" {
        ui.hint.set_text("先选中一条守护再记 AA 总额")
        return
    }
    let trimmed = ("" + raw).trim()
    let cur = -1
    for bi in cases.len() {
        if "" + cases[bi]["id"] == id_str { cur = bi }
    }
    if cur < 0 {
        ui.hint.set_text("找不到 #" + id_str + "，请重新选中")
        return
    }
// C4：重建数组（cur 分支写 trimmed，其余保留原 bill_total；#38 同 add_person 补 slot_init_asked）
        let new_cases = []
        for bi2 in cases.len() {
            if bi2 == cur {
                new_cases.push({"id": cases[bi2]["id"], "text": cases[bi2]["text"],
                    "activity": cases[bi2]["activity"], "place": cases[bi2]["place"],
                    "status": cases[bi2]["status"],
                    "slot_day": cases[bi2]["slot_day"], "slot_part": cases[bi2]["slot_part"],
                    "conflict": cases[bi2]["conflict"], "people": cases[bi2]["people"],
                    "bill_total": trimmed,
                    "receipt_activity": cases[bi2]["receipt_activity"],
                    "receipt_place": cases[bi2]["receipt_place"],
                    "receipt_text": cases[bi2]["receipt_text"],
                    "receipt_done": cases[bi2]["receipt_done"],
                    "slot_init_asked": cases[bi2]["slot_init_asked"]})
            } else {
                new_cases.push({"id": cases[bi2]["id"], "text": cases[bi2]["text"],
                    "activity": cases[bi2]["activity"], "place": cases[bi2]["place"],
                    "status": cases[bi2]["status"],
                    "slot_day": cases[bi2]["slot_day"], "slot_part": cases[bi2]["slot_part"],
                    "conflict": cases[bi2]["conflict"], "people": cases[bi2]["people"],
                    "bill_total": cases[bi2]["bill_total"],
                    "receipt_activity": cases[bi2]["receipt_activity"],
                    "receipt_place": cases[bi2]["receipt_place"],
                    "receipt_text": cases[bi2]["receipt_text"],
                    "receipt_done": cases[bi2]["receipt_done"],
                    "slot_init_asked": cases[bi2]["slot_init_asked"]})
            }
        }
    cases = new_cases
    rebuild_lines()
    let r = fs.write("cases.json", {cases: cases, seq: seq}.to_json())
    bill_save_result = "ok"
    if r != nil {
        let m = "" + r
        if m != "" { bill_save_result = "fail" }
    }
    ui.case_list.render()
    bill_draft = ""
    if bill_save_result == "fail" {
        ui.hint.set_text("#" + id_str + " AA 总额已记（保存失败，仅在内存）")
    } else if trimmed == "" {
        ui.hint.set_text("#" + id_str + " 已清空 AA 总额")
    } else {
        ui.hint.set_text("#" + id_str + " AA 总额：" + trimmed)
    }
}

// === #22 重启：改时间（5 个常见槽位轮换） ===
//   手册约束：C4 对象字段动态赋值不可靠 → **重建整个 cases 数组**再整体替换；
//   C7 布尔返回不可靠 → 字符串标记；C6 闭包不捕获循环变量 → 用 selected_id。
let cycle_save_result = "ok"
fn cycle_slot(id_str){
    if id_str == "" || id_str == "0" {
        ui.hint.set_text("先选中一条守护再改时间")
        return
    }
    let cur = -1
    for ci in cases.len() {
        if "" + cases[ci]["id"] == id_str { cur = ci }
    }
    if cur < 0 {
        ui.hint.set_text("找不到 #" + id_str + "，请重新选中")
        return
    }
    if cases[cur]["status"] == "Cancelled" {
        ui.hint.set_text("该守护已取消，改时间无效（#" + id_str + "）")
        return
    }
    // 5 个常见槽位序列（确定性，无日期计算——本 runtime 无时钟 API）
    let sd = "" + cases[cur]["slot_day"]
    let sp = "" + cases[cur]["slot_part"]
    // === #27：时段未抽取时不静默编造初值。
    //   sd/sp 任一为空 = 用户原话里没抽到时间点。如果直接走下面的轮换逻辑，
    //   会被强行写入"周六-上午"——这是替用户编造了一个时间。
    //   改为：第一次点只提示 + 翻 slot_init_asked="yes"（重建数组走 C4/C5），
    //   第二次点（sasked=="yes"）才真正写入；写入后顺手把标记归零（表示已接受）。
    let sasked = "" + cases[cur]["slot_init_asked"]
    if (sd == "" || sp == "") && sasked == "" {
        let new_cases_ask = []
        for ai in cases.len() {
            let mk = "" + cases[ai]["slot_init_asked"]
            if ai == cur { mk = "yes" }
            new_cases_ask.push({"id": cases[ai]["id"], "text": cases[ai]["text"],
                "activity": cases[ai]["activity"], "place": cases[ai]["place"],
                "status": cases[ai]["status"],
                "slot_day": cases[ai]["slot_day"], "slot_part": cases[ai]["slot_part"],
                "conflict": cases[ai]["conflict"], "people": cases[ai]["people"],
                "receipt_activity": cases[ai]["receipt_activity"],
                "receipt_place": cases[ai]["receipt_place"],
                "receipt_text": cases[ai]["receipt_text"],
                "receipt_done": cases[ai]["receipt_done"],
                "slot_init_asked": mk})
        }
        cases = new_cases_ask
        cycle_save_result = "ok"
        let ra = fs.write("cases.json", {cases: cases, seq: seq}.to_json())
        if ra != nil {
            let ma = "" + ra
            if ma != "" { cycle_save_result = "fail" }
        }
        ui.case_list.render()
        if cycle_save_result == "fail" {
            ui.hint.set_text("#" + id_str + " 还没抽到时段，点「改时间」将设为 周六-上午（可再点切换）（保存标记失败，仅在内存）")
        } else {
            ui.hint.set_text("#" + id_str + " 还没抽到时段，点「改时间」将设为 周六-上午（可再点切换）")
        }
        return
    }
    let nd = "周六"
    let np = "上午"
    if sd == "周六" && sp == "上午" { nd = "周六"  np = "下午" }
    if sd == "周六" && sp == "下午" { nd = "周六"  np = "晚上" }
    if sd == "周六" && sp == "晚上" { nd = "周日"  np = "上午" }
    if sd == "周日" && sp == "上午" { nd = "周日"  np = "下午" }
    if sd == "周日" && sp == "下午" { nd = "周六"  np = "上午" }
    // C4：重建整个数组（逐个 push 新对象，key 带引号）。
    //   #27 同步预置 slot_init_asked：当前这条刚走完首次确认→写入路径，
    //   把标记归零（""）表示「已接受默认值，不再追问」；其余保持原值。
    let new_cases = []
    for ri in cases.len() {
        if ri == cur {
            new_cases.push({"id": cases[ri]["id"], "text": cases[ri]["text"],
                "activity": cases[ri]["activity"], "place": cases[ri]["place"],
                "status": cases[ri]["status"],
                "slot_day": nd, "slot_part": np,
                "conflict": cases[ri]["conflict"], "people": cases[ri]["people"],
                "bill_total": cases[ri]["bill_total"],
                "receipt_activity": cases[ri]["receipt_activity"],
                "receipt_place": cases[ri]["receipt_place"],
                "receipt_text": cases[ri]["receipt_text"],
                "receipt_done": cases[ri]["receipt_done"],
                "slot_init_asked": ""})
        } else {
            new_cases.push({"id": cases[ri]["id"], "text": cases[ri]["text"],
                "activity": cases[ri]["activity"], "place": cases[ri]["place"],
                "status": cases[ri]["status"],
                "slot_day": cases[ri]["slot_day"], "slot_part": cases[ri]["slot_part"],
                "conflict": cases[ri]["conflict"], "people": cases[ri]["people"],
                "bill_total": cases[ri]["bill_total"],
                "receipt_activity": cases[ri]["receipt_activity"],
                "receipt_place": cases[ri]["receipt_place"],
                "receipt_text": cases[ri]["receipt_text"],
                "receipt_done": cases[ri]["receipt_done"],
                "slot_init_asked": cases[ri]["slot_init_asked"]})
        }
    }
    cases = new_cases
    // 重算冲突：先全置 no，再同槽互标 yes
    for a1 in cases.len() { if cases[a1]["status"] != "Cancelled" { cases[a1]["conflict"] = "no" } }
    for a2 in cases.len() {
        if cases[a2]["status"] == "Cancelled" { continue }
        let d2 = "" + cases[a2]["slot_day"]
        let p2 = "" + cases[a2]["slot_part"]
        if d2 == "" || p2 == "" { continue }
        for a3 in cases.len() {
            if a3 == a2 { continue }
            if cases[a3]["status"] == "Cancelled" { continue }
            let d3 = "" + cases[a3]["slot_day"]
            let p3 = "" + cases[a3]["slot_part"]
            if d3 == "" || p3 == "" { continue }
            if d3 == d2 && p3 == p2 {
                cases[a2]["conflict"] = "yes"
                cases[a3]["conflict"] = "yes"
            }
        }
    }
    let my_conflict = "" + cases[cur]["conflict"]
    rebuild_lines()
    let r = fs.write("cases.json", {cases: cases, seq: seq}.to_json())
    cycle_save_result = "ok"
    if r != nil {
        let m = "" + r
        if m != "" { cycle_save_result = "fail" }
    }
    ui.case_list.render()
    let label_new = nd + "-" + np
    if cycle_save_result == "fail" {
        ui.hint.set_text("#" + id_str + " 时间改为 " + label_new + "（保存失败，仅在内存）")
    } else if my_conflict == "yes" {
        ui.hint.set_text("#" + id_str + " 时间改为 " + label_new + "（与另一条同时段，仍冲突）")
    } else {
        ui.hint.set_text("#" + id_str + " 时间改为 " + label_new + "（已无冲突）")
    }
}

fn clear_cancel_pending(hint_text){
    cancel_pending_id = 0
    cancel_prev_status = ""
    cancel_pending_deadline = 0
    // === #25：撤销窗口也跟着归零，避免"换操作"后旧撤销目标还能被恢复 ===
    cancelled_last_id = 0
    if hint_text != "" {
        ui.hint.set_text(hint_text)
    }
}

// === #16 新增：切换「怎么用」说明卡的展开/收起 ===
// 用字符串标记（#13 实证：函数返回布尔在调用点 == false 不可靠）。
// 触发后再走 ui.case_list.render()，让 on_render 闭包按新 flag 重渲染。
fn toggle_howto(){
    if howto_show_flag == "yes" {
        howto_show_flag = "no"
        ui.hint.set_text("已收起「怎么用」说明卡")
    } else {
        howto_show_flag = "yes"
        ui.hint.set_text("已展开「怎么用」说明卡")
    }
    ui.case_list.render()
}

// === #31 新增：详情面板八项命令式刷新（hint 模式翻版）
//   根组件详情面板是「首次定型静态区」，不靠 on_render 重渲染（E1 实证：根属性不随状态重算）。
//   所以走：rebuild_lines() 末尾统一调用本函数，按 selected_id 找 j，从扁平数组
//   取值逐个 ui.detail_x.set_text(...)；无选中时统一显示「点选上方卡片查看详情」。
//   手册 B5（Label 内 \n 不换行） → 回执用固定 4 个 Label，不用换行符。
//   手册 A2（同父只渲染第一个同类子节点） → 每个详情 Label 都是各自一行的纯叶子。
//   手册 C9（嵌套 if 条件赋值变空） → 单层 if 归一化，绝不链式。
#31f：update_detail_panel 已删（面板并入 on_render，见 case_list ui_mode 分支）

// === #31 改造：点卡片 = 选中（详情面板就由选中驱动，卡内不再有长内容——
//   截断问题整体绕开；on_tap 设 selected_id 并进详情模式（#31f））
//   保留 #9 toggle_case 名称以减少跨片 diff（仅删分支，不删函数）。
fn toggle_case(id){
    if id == 0 {
        ui.hint.set_text("先选中一条守护再展开/折叠")
        return
    }
    // 切到其他行 → 放弃取消确认态（避免提示与展开态语义混淆）
    if cancel_pending_id != 0 && cancel_pending_id != id {
        clear_cancel_pending("")
    }
    selected_id = id
    // 切换该条的展开态
    for i in case_ids.len() {
        if case_ids[i] == ("" + id) {
            if case_expanded[i] == "yes" {
                case_expanded[i] = "no"
            } else {
                case_expanded[i] = "yes"
            }
            break
        }
    }
    rebuild_lines()
    ui.case_list.render()
    let idx = -1
    for i in case_ids.len() {
        if case_ids[i] == ("" + id) { idx = i; break }
    }
    let msg = "已选中 #" + "" + id
    if idx >= 0 && case_expanded[idx] == "yes" {
        msg = "已展开 #" + "" + id + "（再点一次可折叠）"
    } else if idx >= 0 {
        msg = "已折叠 #" + "" + id + "（点卡片可展开详情）"
    }
    ui.hint.set_text(msg)
}

// === #9 新增：点击单卡 = 切换该卡展开（用于卡片 GestureView on_tap） ===
fn on_tap_card(id){
    // #31f：选中即进详情模式（列表/详情互斥渲染，无高度竞争）
    if id == 0 {
        ui.hint.set_text("先建一条守护")
        return
    }
    if cancel_pending_id != 0 && cancel_pending_id != id {
        clear_cancel_pending("")
    }
    selected_id = id
    ui_mode = "detail"
    rebuild_lines()
    ui.case_list.render()
    ui.hint.set_text("已选中 #" + "" + id + "，详情见下方；「返回列表」回到全部守护")
}

// === #31f：返回列表模式 ===
fn back_to_list(){
    ui_mode = "list"
    ui.case_list.render()
    ui.hint.set_text("已返回列表；点卡片看单条详情")
}

// === #10 新增：切换筛选标签（GestureView on_tap 回调入口） ===
// 入口参数 ft 是目标筛选值字符串："all"/"Proposing"/"Confirmed"/"Cancelled"
// 逻辑放函数上下文（不放在 on_render 内），重建扁平字符串数组后驱动渲染
fn set_filter(ft){
    let prev = "" + current_filter
    current_filter = "" + ft
    rebuild_lines()
    ui.case_list.render()
    // hint 反馈：切了哪个标签 + 当前命中条数
    let label_all = "全部"
    if ft == "Proposing" { label_all = "待拍板" }
    if ft == "Confirmed" { label_all = "已确认" }
    if ft == "Cancelled" { label_all = "已取消" }
    ui.hint.set_text("筛选：" + label_all + " · 共 " + filter_count_str + " 条 / 总 " + filter_total_str + " 条")
}

// === #12 新增：搜索词入口（TextInput on_change 回调；与 set_filter 同样放函数上下文）
// q 是用户输入的搜索词（空串=清空）；逻辑放函数上下文才能在 cases[j]["activity/place/text"]
// 上调 search(p)>=0；on_render 闭包只读扁平字符串。set_query 只动 current_query + 触发重建 +
// 更新 hint，不动 current_filter，所以搜索词与标签是叠加而非替换。
fn set_query(q){
    current_query = "" + q
    rebuild_lines()
    ui.case_list.render()
    if current_query == "" {
        ui.hint.set_text("已清空搜索，按当前标签显示（" + filter_count_str + " / " + filter_total_str + " 条）")
    } else {
        ui.hint.set_text("搜索 " + current_query + " · 共 " + filter_count_str + " / " + filter_total_str + " 条")
    }
}

// === #43 D 切片：回执风格切换（循环 standard→brief→emoji→standard）
//   1. 翻转 receipt_style（按当前值决定下一档）；
//   2. 写 pref.json {"receipt_style": <new>}——fs.write 返回非 nil = 失败（照 #13 save() 范式）；
//      失败也要在**本次会话**让 receipt_style 生效（用户视觉立刻变），仅 hint 明示「偏好保存失败
//      （风格本次会话仍生效）」——会话内不影响体验，重启才丢档；
//   3. rebuild_lines 让已有守护的 case_receipt 立即按新风格重排（快照语义不变——ra/rp/rt 不动）；
//   4. ui.style_btn.set_text(...) 命令式更新底部按钮文案（照 ui.hint.set_text 范式，根组件静态区
//      靠 imperative set_text 而非 on_render 重算——task 明确允许此路径）；
//   5. ui.hint.set_text(...) 给用户反馈（成功/失败两路）。
//   注：style_btn 是根组件 ButtonFlat 的具名绑定（详见根组件布局），set_text 范式已在
//      ui.hint 上多次实证（line 493, 504 等），runtime 可靠。
fn set_receipt_style(){
    let next = "standard"
    if receipt_style == "standard" { next = "brief" }
    else if receipt_style == "brief" { next = "emoji" }
    else if receipt_style == "emoji" { next = "standard" }
    // 其他值（理论上 load() 已兜底，但保险起见）→ 回 standard
    receipt_style = next
    // 写 pref.json（to_json 把字符串包成 {"receipt_style":"brief"} 形式）
    let pw = fs.write("pref.json", {receipt_style: receipt_style}.to_json())
    let write_ok = true
    if pw != nil {
        let pwmsg = "" + pw
        if pwmsg != "" { write_ok = false }
    }
    rebuild_lines()
    ui.case_list.render()
    // 按钮文案命令式更新：根组件 if 不重算，但 on_click 事件回调内 imperative set_text 可靠
    if ui.style_btn != nil {
        ui.style_btn.set_text("风格：" + style_label_for(receipt_style))
    }
    let label_cn = style_label_for(receipt_style)
    if write_ok {
        // 成功：明示持久化+已有守护立即生效
        ui.hint.set_text("回执风格已切换为 " + label_cn + "（已有守护的回执立即按新风格重排）")
    } else {
        // 失败：本次会话仍生效（receipt_style 已翻，case_receipt 已 rebuild），仅持久化未落盘
        ui.hint.set_text("偏好保存失败（风格本次会话仍生效）：" + label_cn)
    }
}

// === #43 辅助：把 receipt_style 内部值映射成按钮文案用的中文短词
//   三档分别显示「标准 / 简短 / 带emoji」——按钮文字 + hint 反馈共用此映射
//   （与 receipt_style 三合法值一一对应；其他值兜底返回「标准」）
fn style_label_for(s){
    if s == "brief" { return "简短" }
    if s == "emoji" { return "带emoji" }
    return "标准"
}

// 本地规则分诊：命中时间/地点/约定动词才值得建 Case；纯闲聊 → 澄清
// === #19 修改：加「约定/聚会语气」门槛
//   时间词 + 活动词 / 约定语气词 / 聚会场景词 才自动建守护。
//   只有时间词（如"3月15日下午"可能是工作/政务安排）→ "time_only"：
//   走到 add_case 里的澄清卡分支，给「仍然建守护」入口，绝不直接拦死用户。
//   三档返回："time"=完整命中自动建；"verb"=只有活动词无时间（保留旧行为）；
//   "time_only"=只有时间词需澄清；"none"=既无时间也无意图。
fn triage(text){
    let hit_time = regex("周|明天|后天|今天|\\d+月\\d+|上午|下午|晚上|周末|\\d+号|\\d+点", "").test(text)
    // 活动词（保留原词表）
    let hit_act = regex("聚|吃饭|骑车|爬山|看电影|约|唱歌|打球|露营|烧烤|逛街|喝茶", "").test(text)
    // 约定语气词：约/一起/咱们/大家/集合/报名/接龙/约吗/来吗/安排
    let hit_commit = regex("约|一起|咱们|大家|集合|报名|接龙|约吗|来吗|安排", "").test(text)
    // 聚会场景词：聚餐/团建/生日/聚会/聚会吧
    let hit_scene = regex("聚餐|团建|生日|聚会|聚会吧", "").test(text)
    let hit_verb = hit_act || hit_commit || hit_scene
    if hit_time && hit_verb { return "time" }
    if hit_time { return "time_only" }
    if hit_verb { return "verb" }
    return "none"
}

// 极简抽取：只做关键词呈现，不编造结构化事实（防编造：抽不到就留空）
// === #19 修改：删除 "聚会" 兜底——抽不到就返回空串
//   「卡片」与「回执」的活动字段随后落到 case_activity_lines 既有占位逻辑
//   （"（未抽取到）"）——绝不编造一个看似合理的活动名。
fn guess_activity(text){
    let words = ["骑车", "吃饭", "聚餐", "爬山", "看电影", "唱歌", "打球", "露营", "烧烤", "逛街", "喝茶", "聚会"]
    for w in words {
        if text.search(w) >= 0 { return w }
    }
    return ""
}

fn guess_place(text){
    let spots = ["深圳湾", "莲花山", "梧桐山", "海岸城", "欢乐谷", "世界之窗", "大梅沙", "小梅沙", "东湖", "红树林"]
    for s in spots {
        if text.search(s) >= 0 { return s }
    }
    return ""
}

// === #17b 新增：抽取「星期几」=== 命中「周一/周二/周三/周四/周五/周六/周日」
//   或「今天/明天/后天」（按序列映射）。
// 抽不到留 ""，不编造。
fn guess_slot_day(text){
    // 注：search 是子串匹配，故「星期一/星期天」也能命中「周一」/「周日」。
    let days = ["周一", "周二", "周三", "周四", "周五", "周六", "周日"]
    for d in days {
        if text.search(d) >= 0 { return d }
    }
    // 「今天/明天/后天」是相对时间，本 runtime 无时钟 API，无 anchor「今天」返回，
    // 所以也留空——宁可空着不猜。
    return ""
}

// === #17b 新增：抽取「时段」=== 命中「上午/中午/下午/晚上」之一即返回；抽不到留 ""。
fn guess_slot_part(text){
    let parts = ["上午", "中午", "下午", "晚上"]
    for p in parts {
        if text.search(p) >= 0 { return p }
    }
    return ""
}

fn add_case(){
    // 建守护算"非取消按钮" → 放弃任何待确认 + 关掉撤销窗口
    clear_cancel_pending("")
    undo_win_open = "no"
    let text = ui.msg_input.text()
    if text == "" {
        ui.hint.set_text("先输入一条群消息，例如：周六上午去深圳湾骑车")
        return
    }
    // === #19 新增：「仍然建守护」二次确认态的第二次按压
    //   若首次按下后已落在 force_create_pending="yes" 且原文未改，
    //   则此次直接落库（按用户主动意图走）。用 force 作为 level 标签便于
    //   后续 hint / 日志溯源，但本质上仍按完整 case 走。
    if force_create_pending == "yes" && text == force_create_text {
        force_create_pending = "no"
        force_create_text = ""
        force_create_deadline = 0
        build_case_from_text(text, "force")
        return
    }
    // 原文变了 / 超时已自动清空 → 重新走分诊（不沿用旧 force_create_text）
    if force_create_pending == "yes" {
        force_create_pending = "no"
        force_create_text = ""
        force_create_deadline = 0
    }
    let level = triage(text)
    if level == "time_only" {
        // === #19 新增：仅命中时间词 → 澄清卡（不直接拦死）
        //   「有时间，但这看起来不像聚会安排——要牵线跟这条吗？」
        //   + 给「仍然建守护」入口：用户再点一次「建守护」即按 force 走。
        //   不清空 msg_input（让用户能直接看到原文 + 二次按压）。
        force_create_pending = "yes"
        force_create_text = text
        force_create_deadline = 1
        ui.hint.set_text("有时间，但这看起来不像聚会安排——要牵线跟这条吗？再点一次「建守护」即可（仍是您主动）")
        start_timeout(5.0, || {
            if force_create_pending == "yes" {
                force_create_pending = "no"
                force_create_text = ""
                force_create_deadline = 0
                ui.hint.set_text("「仍然建守护」确认已过期（5s 内未再点），未建守护")
            }
        })
        return
    }
    if level == "none" {
        ui.hint.set_text("澄清卡：这条消息里没看到时间或聚会意图，不建守护（规则分诊未命中）")
        return
    }
    build_case_from_text(text, level)
}

// === #19 新增：建守护的实际落库逻辑（拆出来供 add_case 复用）
//   把「时间词+约定词」自动建 与 「仍然建守护」用户主动强制建 两条路径
//   共享同一段落库代码，避免双份冲突检测 / 落盘逻辑漂移。
//   level 入参保留 "time" / "verb" / "force" 三种标签，
//   仅用于 hint 文案溯源——业务行为完全相同（不编造、不漏存）。
fn build_case_from_text(text, level){
    seq = seq + 1
    // #13 第 3 条：id 撞库守卫。load() 后异常场景下 cases 有内容而 seq == 0，
    //   上面 seq+1 得 1，会与已有 id=1 撞。这里取 max(seq, 已有最大 id) + 1，
    //   保证新 id 一定大于任何已有 id。
    let max_existing_id = 0
    for i in cases.len() {
        let cid = cases[i]["id"]
        if cid > max_existing_id { max_existing_id = cid }
    }
    if seq <= max_existing_id {
        seq = max_existing_id + 1
    }
    // === #27：slot_init_asked 字段预置（C5）。case 对象带这个标记后，cycle_slot
    //   才能在「时段未抽取」时进入二次确认：第一次点只翻标记 + 提示，第二次点
    //   才真正写入「周六-上午」初值。初值 "" 表示从未问过。
    cases.push({"id": seq, "text": text, "activity": guess_activity(text), "place": guess_place(text), "status": "Proposing", "people": "", "bill_total": "", "receipt_activity": "", "receipt_place": "", "receipt_text": "", "receipt_done": "", "slot_day": guess_slot_day(text), "slot_part": guess_slot_part(text), "conflict": "no", "slot_init_asked": ""})
    // === #17b：新建后做冲突检测（不阻断用户，照常往下推进）===
    // 双方 slot_day + slot_part 都非空 + 相同 → 新条目标 conflict:"yes"。
    // 同时把已有那一条也翻成 conflict:"yes"（互相知道对方在）。
    let new_day = "" + cases[cases.len() - 1]["slot_day"]
    let new_part = "" + cases[cases.len() - 1]["slot_part"]
    if new_day != "" && new_part != "" {
        for ci in cases.len() - 1 {
            if cases[ci]["status"] == "Cancelled" { continue }
            let od = "" + cases[ci]["slot_day"]
            let op = "" + cases[ci]["slot_part"]
            if od == "" || op == "" { continue }
            if od == new_day && op == new_part {
                cases[cases.len() - 1]["conflict"] = "yes"
                cases[ci]["conflict"] = "yes"
                break
            }
        }
    }
    selected_id = seq  // 新建后自动选中，体验闭环
    ui.msg_input.set_text("")
    rebuild_lines()
    save()   // 结果写入全局 save_result
    ui.case_list.render()
    if save_result == "fail" {
        ui.hint.set_text("保存失败：守护数据可能未落盘（已建守护 #" + "" + seq + "，分诊命中：" + level + "）")
    } else {
        ui.hint.set_text("已建守护 #" + "" + seq + "（分诊命中：" + level + "），已选中，点卡片可展开详情")
    }
}

fn confirm_case(){
    // 同意 → 放弃任何待确认 + 关掉撤销窗口（操作后用户应当看到最新状态）
    clear_cancel_pending("")
    undo_win_open = "no"
    let t = target_id()
    if t["id"] == 0 {
        ui.hint.set_text("列表为空：先建一条守护再拍板")
        return
    }
    for i in cases.len() {
        if cases[i]["id"] == t["id"] {
            if cases[i]["status"] == "Confirmed" {
                let tag = ""
                if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
                ui.hint.set_text("已确认，未重复（#" + "" + t["id"] + " 仍是 Confirmed）" + tag)
                return
            }
            if cases[i]["status"] == "Cancelled" {
                ui.hint.set_text("该守护已取消，不可确认（#" + "" + t["id"] + "）")
                return
            }
            cases[i]["status"] = "Confirmed"
            rebuild_lines()
            save()   // 结果写入全局 save_result
            ui.case_list.render()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            if save_result == "fail" {
                ui.hint.set_text("保存失败：守护数据可能未落盘（#已被改为 Confirmed in-memory；#" + "" + t["id"] + "）" + tag)
            } else {
                ui.hint.set_text("已确认 #" + "" + t["id"] + " → Confirmed（组织者拍板，读回一致）" + tag)
            }
            return
        }
    }
}

fn reschedule_case(){
    // 改口 → 放弃任何待确认 + 关掉撤销窗口
    clear_cancel_pending("")
    undo_win_open = "no"
    let t = target_id()
    if t["id"] == 0 {
        ui.hint.set_text("列表为空：先建一条守护再改口")
        return
    }
    for i in cases.len() {
        if cases[i]["id"] == t["id"] {
            if cases[i]["status"] == "Cancelled" {
                ui.hint.set_text("该守护已取消，改口无效（#" + "" + t["id"] + "）")
                return
            }
            cases[i]["status"] = "Proposing"
            // === #18 新增：改口后让回执随下次确认刷新；receipt_done 置 ""，
            //   rebuild_lines 里 Confirmed 分支的幂等判断就会重新填充 receipt_* ===
            cases[i]["receipt_activity"] = ""
            cases[i]["receipt_place"] = ""
            cases[i]["receipt_text"] = ""
            cases[i]["receipt_done"] = ""
            rebuild_lines()
            save()   // 结果写入全局 save_result
            ui.case_list.render()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            if save_result == "fail" {
                ui.hint.set_text("保存失败：守护数据可能未落盘（#已回到 Proposing in-memory；#" + "" + t["id"] + "）" + tag)
            } else {
                ui.hint.set_text("改口：#" + "" + t["id"] + " 回到 Proposing，重新收敛（旧确认作废）" + tag)
            }
            return
        }
    }
}

// === #8 保留：取消二次确认（两段式按钮态，不用模态） ===
// 第一次点：进入"待确认"态，按钮文案变"再点一次取消（5s）"，hint 提示；
// 第二次点：在 5 秒内才执行真正的取消；超时/选其他卡/点其他按钮 → 放弃
fn cancel_case(){
    let t = target_id()
    if t["id"] == 0 {
        ui.hint.set_text("列表为空：先建一条守护再取消")
        return
    }
    let target = t["id"]

    // 当前已经在对该条目标等待二次确认 → 第二次点击，执行真正取消
    if cancel_pending_id == target {
        for i in cases.len() {
            if cases[i]["id"] == target {
                cancel_prev_status = "" + cases[i]["status"]
                cases[i]["status"] = "Cancelled"
                // === #18 新增：取消后回执无意义，连同 receipt_done 一起清空；
                //   若后续撤销恢复状态，下次确认时 rebuild_lines 会重新快照 ===
                cases[i]["receipt_activity"] = ""
                cases[i]["receipt_place"] = ""
                cases[i]["receipt_text"] = ""
                cases[i]["receipt_done"] = ""
                cancel_pending_id = 0
                cancel_pending_deadline = 0
                cancel_pending_flag = "no"  // #11：确认态按钮撤下
                // === #25：记录本次被取消的那条 id；undo_cancel 据此只恢复这一条，
                //   不会把更早被取消的别的条连带恢复（#24 自审 S8 实证 bug）
                cancelled_last_id = target
                // === #9：撤销窗口打开 —— 现在起 5 秒内可点「撤销取消」 ===
                undo_win_open = "yes"
                undo_show_flag2 = "yes"    // #11：让 on_render 渲染可点的「撤销取消」
                rebuild_lines()
                save()   // 结果写入全局 save_result
                ui.case_list.render()
                let tag = ""
                if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
                if save_result == "fail" {
                    ui.hint.set_text("保存失败：守护数据可能未落盘（#已取消 in-memory；#" + "" + target + "，5 秒内可尝试撤销）" + tag)
                } else {
                    ui.hint.set_text("已取消 #" + "" + target + "（5 秒内可点「撤销取消」）" + tag)
                }
                // 5 秒后撤销窗口到期：自动清掉 hint 文案里的"可撤销"暗示
                // === #9 修：守卫 undo_win_open —— 若用户已撤销则不再覆盖 ===
                start_timeout(5.0, || {
                    if undo_win_open == "yes" {
                        undo_show_flag2 = "no"          // #11：撤下撤销按钮
                    undo_win_open = "no"
                        cancel_prev_status = ""
                        // === #25：撤销窗口到期，撤销目标也归零；
                        //   之后任何 undo_cancel 都找不到目标（C4 重建 + 全局数字标记）
                        cancelled_last_id = 0
                        rebuild_lines()
                        ui.case_list.render()
                        ui.hint.set_text("取消 #" + "" + target + " 已生效（撤销窗口已过）")
                    }
                })
                return
            }
        }
        return
    }

    // 第一次点击：进入待确认态（不执行任何状态变更）
    for i in cases.len() {
        if cases[i]["id"] == target {
            cancel_pending_id = target
            cancel_prev_status = "" + cases[i]["status"]
            cancel_pending_deadline = 1
            cancel_pending_flag = "yes"   // #11：让 on_render 渲染「确认取消（5s）」变体
            rebuild_lines()
            ui.case_list.render()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            ui.hint.set_text("再点一次「确认取消」才会真取消 #" + "" + target + "；5 秒内点别的按钮或选别的卡可放弃" + tag)
            // 5 秒后超时 → 放弃确认态
            start_timeout(5.0, || {
                if cancel_pending_id == target {
                    cancel_pending_id = 0
                    cancel_pending_deadline = 0
                    cancel_prev_status = ""
                    cancel_pending_flag = "no"
                    undo_show_flag2 = "no"
                    rebuild_lines()
                    ui.case_list.render()
                    ui.hint.set_text("已放弃取消 #" + "" + target + "（5 秒内未再点取消）")
                }
            })
            return
        }
    }
}

// === #8 保留 + #9 修 + #25 修：撤销刚发生的取消（5 秒窗口内，仅恢复刚取消的那一条） ===
fn undo_cancel(){
    if cancel_prev_status == "" || undo_win_open == "no" || cancelled_last_id == 0 {
        ui.hint.set_text("没有可撤销的取消（5 秒窗口已过或未取消过）")
        return
    }
    let restored_id = "0"
    let target_id_str = "" + cancelled_last_id
    // === #25：只恢复 id==cancelled_last_id 的那一条，其余 Cancelled 不动 ===
    for i in cases.len() {
        if ("" + cases[i]["id"]) == target_id_str {
            if cases[i]["status"] == "Cancelled" {
                cases[i]["status"] = cancel_prev_status
                // === #18：恢复状态后让回执重新快照（之前清掉的字段保留空，
                //   下次确认/重建时由 rebuild_lines 兜底拉新值） ===
                restored_id = "" + cases[i]["id"]
            } else {
                // 防御性分支：id 命中但状态已经不是 Cancelled（极端时序错位），
                // 也提示用户并清掉撤销目标，避免悬空
                restored_id = "0"
            }
            break   // #25：id 唯一，找到即可跳出（C4 重写法：不重建数组，只改一条）
        }
    }
    cancel_pending_id = 0
    cancel_pending_deadline = 0
    let prev = cancel_prev_status
    cancel_prev_status = ""
    // === #25：撤销成功后归零，避免后续 undo_cancel 重复恢复同一目标 ===
    cancelled_last_id = 0
    // === #9 关键：关撤销窗口 + 阻止 5s 定时器覆盖当前 hint ===
    undo_win_open = "no"
    undo_show_flag2 = "no"   // #11：撤下可点的撤销按钮
    cancel_pending_flag = "no"
    rebuild_lines()
    save()   // 结果写入全局 save_result
    ui.case_list.render()
    if save_result == "fail" {
        if restored_id != "0" && restored_id != "" {
            ui.hint.set_text("保存失败：守护数据可能未落盘（#已撤销取消 in-memory；#" + restored_id + " 恢复到 " + prev + "）")
        } else {
            ui.hint.set_text("保存失败：守护数据可能未落盘（已撤销取消 in-memory）")
        }
    } else if restored_id != "0" && restored_id != "" {
        ui.hint.set_text("已撤销取消 #" + restored_id + " → 恢复到 " + prev + "（仅本次，其他已取消条目维持）")
    } else {
        ui.hint.set_text("已撤销取消（但目标条目已不在 Cancelled 状态，未改动）")
    }
}

// AI 增强（可选）：双通道 #37（外环派·复赛切片，原则第2条）
// 首选：host.has("model") → model.complete 一次性 schema 校验，输出 {activity, slot_day,
//   slot_part, place} 四字段（字符串、长度 ≤24、无JSON残留照 #30 范式）。走 AI-SERVICES 闭环。
// 降级：card-host 无 model → host.request("octos.turn.start", ...) 对话式peer；
//   首次会弹"等人允许"，30s 缓冲区分授权等待 vs 实际超时（#32/#26 实证）。
// LLM 不碰状态机：解析结果仅经 parse_apply 规范化写入 msg_input，hint 明示「AI 已建议
//   活动/时间/地点，请过目后点建守护」。本地分诊仍是唯一事实源。
fn ai_parse(){
    // === #32 外环修：重复点防护 ===
    if ai_pending == "yes" {
        ui.hint.set_text("AI 仍在解析中，请稍候（30 秒无响应会自动降级）")
        return
    }
    let text = ui.msg_input.text()
    if text == "" {
        ui.hint.set_text("先输入一条群消息再试 AI 解析")
        return
    }
    ai_pending = "yes"
    ui.hint.set_text("AI 解析中…（约 30 秒，无响应自动降级本地规则）")
    // 30s 兜底（turn.start 首次需等"允许"，8s 太短见 #37；model.complete 通常秒级）
    start_timeout(30.0, || {
        if ai_pending == "yes" {
            ai_pending = "no"
            ui.hint.set_text("AI 无响应（30 秒），已降级本地规则——直接点「建守护」即可")
        }
    })
    // === 通道 1：首选 model.complete（一次性 schema 校验）===
    if host.has("model") {
        host.request("model.complete", {
            schema: {activity: "string", slot_day: "string", slot_part: "string", place: "string"},
            prompt: "从这条聚会消息提取活动/时间/地点，字段长度 ≤24，只回 JSON：" + text
        }, fn(r){
            ai_pending = "no"
            if r.is_ok {
                // === #42 改造：成功路径不再直接写 msg_input，先填四字段 + 翻 ai_card_visible，
            //   让用户在「✨ AI 生成」建议卡上点「采纳到输入框」才会写到 msg_input。
            //   字段合法性由 ai_adopt() 内 parse_apply() 兜底（活动/地点至少其一非空）。
                let _a = "" + r.data.activity
                let _d = "" + r.data.slot_day
                let _p = "" + r.data.slot_part
                let _l = "" + r.data.place
                if _a == "" && _l == "" {
                    ui.hint.set_text("AI 返回格式不合规，已降级为本地规则")
                } else {
                    ai_act = _a
                    ai_day = _d
                    ai_part = _p
                    ai_place = _l
                    ai_card_visible = "yes"
                    ui.case_list.render()
                    ui.hint.set_text("AI 已给出建议卡，过目后点「采纳到输入框」")
                }
            } else {
                ui.hint.set_text("AI 不可用，已降级为本地规则（" + r.error + "）")
            }
        })
        return
    }
    // === 通道 2：降级 octos.turn.start（card-host 无 model 时）===
    if host.has("octos.turn.start") {
        host.request("octos.turn.start", {text: "从这条聚会消息提取活动/时间/地点，只回 JSON：" + text}, fn(r){
            ai_pending = "no"
            if r.is_ok {
                // turn.start 回包非 schema 化，走宽松抽取；不再裸 set_text r.data.text
                let parsed = parse_loose("" + r.data.text)
                let _a = parsed[0]
                let _d = parsed[1]
                let _p = parsed[2]
                let _l = parsed[3]
                // === #42 改造：与通道 1 同策略——成功且字段合规时填四字段 + 翻标记；
                //   失败/字段为空仍走旧 hint，不渲染建议卡（防用户看到空卡）。
                if _a == "" && _l == "" {
                    ui.hint.set_text("AI 返回格式不合规，已降级为本地规则")
                } else {
                    ai_act = _a
                    ai_day = _d
                    ai_part = _p
                    ai_place = _l
                    ai_card_visible = "yes"
                    ui.case_list.render()
                    ui.hint.set_text("AI 已给出建议卡，过目后点「采纳到输入框」（turn.start 首次会等授权）")
                }
            } else {
                ui.hint.set_text("AI 不可用，已降级为本地规则（" + r.error + "）")
            }
        })
        return
    }
    // 双通道皆无服务
    ai_pending = "no"
    ui.hint.set_text("本设备无 AI 服务（no service answers \"model/octos\"），本地规则继续可用")
}

// === #42 新增：ai_adopt —— 把「✨ AI 生成」建议卡四字段采纳到 msg_input ===
//   guard：ai_card_visible=="yes" 才执行（防 on_click 闭包被多次触发的幻读）；
//   parse_apply 内部已经做了「活动或地点至少其一」字段合法性校验与 trim24 截断。
//   成功：翻 ai_card_visible="no" + render + hint「已采纳 AI 建议，核对后点「建守护」」。
//   失败（字段不全，已被 ai_parse() 上游过滤，此处为兜底）：
//     保留卡片可见，hint「AI 建议字段不全，已保留输入框原样」（不覆盖 msg_input）。
//   与 ai_parse() 改造配套：现在 AI 结果先停在建议卡，必须用户点按钮才落地——这是
//   官方 AI-SERVICES「模型文本只填文本槽、绝不参与动作接线」的 App 侧落点（shells 侧 kit
//   会画 sparkle+AI 眉标；card-host 不识别，故 App 自绘「✨ AI 生成」眉标）。
fn ai_adopt(){
    if ai_card_visible != "yes" { return }
    if parse_apply(ai_act, ai_day, ai_part, ai_place) {
        ai_card_visible = "no"
        ui.case_list.render()
        ui.hint.set_text("已采纳 AI 建议，核对后点「建守护」")
    } else {
        // 兜底分支：理论上 ai_parse() 已在通道回调内做过活动或地点非空判断，
        // 这里 parse_apply 仍失败说明 trim24 后变成空串；保留卡让用户继续看。
        ui.hint.set_text("AI 建议字段不全，已保留输入框原样")
    }
}

// === #42 新增：ai_dismiss —— 忽略「✨ AI 生成」建议卡，不写 msg_input ===
//   仅翻标记 + 重渲染 + 友好 hint；不改 msg_input（用户原文原样保留在输入框）。
fn ai_dismiss(){
    if ai_card_visible != "yes" { return }
    ai_card_visible = "no"
    ui.case_list.render()
    ui.hint.set_text("已忽略 AI 建议")
}

// === #37 parse_apply：把 AI 抽出的 4 字段规范化到 msg_input ===
//   字段长度硬限 ≤24（无 JSON 残留照 #30 范式）；活动/时段/地点/星期几分别填入输入框草稿位置。
//   msg_input 单输入框策略——按"活动 · 星期几-时段 · 地点"合成可读文本；本地分诊仍按原
//   文本走（cases 字段以「点建守护」时的输入为事实源）。
//   返回 true = 规范化成功，false = 字段不全或格式不合规（hint 已在外层写）。
fn parse_apply(act, sd, sp, pl){
    let a = trim24(act)
    let d = trim24(sd)
    let p = trim24(sp)
    let l = trim24(pl)
    // 至少要活动或地点其一
    if a == "" && l == "" {
        return false
    }
    let composed = a
    if d != "" || p != "" {
        composed = composed + " · " + d + "-" + p
    }
    if l != "" {
        composed = composed + " · " + l
    }
    ui.msg_input.set_text(composed)
    return true
}

// === #37 parse_loose：turn.start 回包宽松抽取 ——
    //   回包通常是自由文本含 JSON，扫首段 {…} 取四字段；取不到则按已知关键词扫描。
    //   返回 [activity, slot_day, slot_part, place] 数组。
fn parse_loose(raw){
    let act = ""
    let sd = ""
    let sp = ""
    let pl = ""
    // 尝试取首段 JSON
    let lb = raw.index_of("{")
    let rb = raw.last_index_of("}")
    if lb >= 0 && rb > lb {
        let js = raw[lb:rb+1]
        act = json_field(js, "activity")
        sd = json_field(js, "slot_day")
        sp = json_field(js, "slot_part")
        pl = json_field(js, "place")
    }
    // 兜底扫描（按本地规则词表），缺啥补啥
    if act == "" {
        let parts = ["聚会", "聚餐", "骑车", "徒步", "爬山", "打球", "唱歌", "电影", "桌游", "烧烤"]
        for k in parts { if raw.contains(k) { break } }
    }
    if sd == "" {
        let days = ["周一", "周二", "周三", "周四", "周五", "周六", "周日", "周末"]
        for k in days { if raw.contains(k) { sd = k; break } }
    }
    if sp == "" {
        let parts = ["上午", "中午", "下午", "晚上"]
        for k in parts { if raw.contains(k) { sp = k; break } }
    }
    return [act, sd, sp, pl]
}

// === #37 辅助：trim24 截到 ≤24 字 + json_field 提字段 ===
fn trim24(s){
    let r = "" + s
    if r.len() > 24 { r = r[0:24] }
    return r
}
fn json_field(js, key){
    let kq = "\"" + key + "\""
    let idx = js.index_of(kq)
    if idx < 0 { return "" }
    let rest = js[idx + kq.len():]
    let colon = rest.index_of(":")
    if colon < 0 { return "" }
    let after = rest[colon+1:]
    // 跳过空白
    let start = 0
    while start < after.len() {
        let ch = after[start:start+1]
        if ch != " " && ch != "\n" && ch != "\t" { break }
        start = start + 1
    }
    after = after[start:]
    // 字符串值
    if after.len() > 0 && after[0:1] == "\"" {
        let end = after.index_of("\"", 1)
        if end < 0 { return "" }
        return after[1:end]
    }
    // 非字符串（罕见），截到 ,/}/空白
    let end = after.len()
    for ci in after.len() {
        let ch = after[ci:ci+1]
        if ch == "," || ch == "}" || ch == " " || ch == "\n" { end = ci; break }
    }
    return after[0:end]
}

// === #37 publish_glance：向 glance 屏发「今晚聚会 T-X 提醒」L0卡 ===
//   人触发（仅当 status==Confirmed 且当前时刻在约定时段前 5/30/60 分钟区间内）。
//   card-host 无 glance 服务时按"已降级本地规则"友好提示；glance capability 已在
//   manifest 封闭清单（#37 三件套②）。默认不主动调，仅"发布到 glance 屏"按钮触发。
// #40 hub 现实封闭清单无 glance，本函数在 card-host 永远降级；保留以备官方实现 glance 能力后启用
fn publish_glance(){
    // 任何低频按钮都视为"放弃取消/清空/AI 等待"
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    clear_pending_flag = "no"
    clear_pending_deadline = 0
    if ai_pending == "yes" {
        ui.hint.set_text("AI 还在跑，等解析完再发 glance 提醒")
        return
    }
    if !host.has("glance") {
        ui.hint.set_text("本宿主无 glance 服务（card-host），无法投递 L0 卡；外环真机可跑")
        return
    }
    // 找一条 Confirmed 的守护做投递目标；按 selected_id 优先，否则取第一条 Confirmed
    let target = -1
    if selected_id > 0 {
        for qi in cases.len() {
            if cases[qi]["id"] == selected_id {
                if "" + cases[qi]["status"] == "Confirmed" {
                    target = qi
                }
                break
            }
        }
    }
    if target < 0 {
        for qi in cases.len() {
            if "" + cases[qi]["status"] == "Confirmed" {
                target = qi
                break
            }
        }
    }
    if target < 0 {
        ui.hint.set_text("暂无「已确认」守护可发 glance 提醒（先确认一条守护）")
        return
    }
    let act = "" + cases[target]["activity"]
    let sd = "" + cases[target]["slot_day"]
    let sp = "" + cases[target]["slot_part"]
    let pl = "" + cases[target]["place"]
    let summary = "聚会提醒：" + act + " · " + sd + "-" + sp + " · " + pl
    host.request("glance.publish", {
        level: "L0",
        title: "牵线 · 守护提醒",
        body: summary
    }, fn(r){
        if r.is_ok {
            ui.hint.set_text("已投递 glance 屏（" + summary + "）")
        } else {
            ui.hint.set_text("glance 投递失败（" + r.error + "），外环真机可排查")
        }
    })
}

// === #14 新增：示例一键填充（演示友好） ===
// 输入框为空时供用户点；点完只填输入框、**不自动建守护**——
// 仍需用户主动点"建守护"，符合规范第 2 条"用户主动"原则。
fn fill_example(){
    // 任何非取消按钮都视为"放弃取消确认"
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    // 点示例按钮本身也放弃清空确认
    clear_pending_flag = "no"
    clear_pending_deadline = 0
    let cur = ui.msg_input.text()
    if cur != "" {
        // 输入框已有内容就不再覆盖，避免误丢用户手打的稿子
        ui.hint.set_text("输入框已有内容，未替换；点「建守护」继续，或手动清空再点示例")
        return
    }
    ui.msg_input.set_text("周六上午去深圳湾骑车，大概两小时？")
    ui.hint.set_text("已填示例到输入框（不自动建守护），点「建守护」继续")
}

// === #14 新增：导出数据（cases.json 原文屏显在 hint 区） ===
// 本 runtime 无法调起系统分享/把数据写到 jail 外（PRIVACY.md 同样承诺不出网），
// 故只能屏显：用户可长按/手动复制下方文本备份。文案必须说明「复制可备份」。
fn export_data(){
    // 任何非取消按钮都视为"放弃取消确认"
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    // 点导出按钮也放弃清空确认（互斥语义：先看清楚再考虑删）
    clear_pending_flag = "no"
    clear_pending_deadline = 0
    if !fs.exists("cases.json") {
        ui.hint.set_text("暂无 cases.json（一条守护都没建），无可导出内容")
        return
    }
    let raw = fs.read("cases.json")
    // 原样屏显 + 引导用户复制备份。hint 区是单行 Label，长内容直接塞入会撑高；
    // 这里就是用单 Label 容纳多行文本，Splash Label 自身会自然换行。
    ui.hint.set_text("—— cases.json 原文（复制可备份）——\n" + raw + "\n—— 复制以上文本即可备份 ——")
}

// === #14 新增：清空全部（两段式确认，复用 cancel_pending_flag 的 5s 机制） ===
// 第一次点：clear_pending_flag = "yes"，记下当前条数，按钮文案切到 hint 提示
//           "再点一次清空（5s）"；hint 明示将清空 N 条守护。
// 第二次点（5s 内）：fs.remove("cases.json") + 内存清空（cases=[]、seq=0、
//           selected_id=0、扁平数组全部清掉、rebuild_lines）+ hint 明示
//           "已清空 N 条守护"。超时 / 点别的按钮 → 放弃。
// 5s 后清空确认态的回收用 start_timeout(5.0, ...) —— 与 cancel_case 同源。
fn clear_all_data(){
    // 互斥：清空流程中放弃取消确认 + 撤销窗口（场景不重叠，避免 hint 互相覆盖）
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    let cur_n = cases.len()
    // 第二次点（已在确认态 + 5s 内） → 真正执行清空
    if clear_pending_flag == "yes" {
        // fs.remove 在文件不存在时返回错误值（非 nil/非 true）；按 #13 字符串标记约定
        // 判成败：消息字符串非空视为失败。注意：fs 也没有 rename，不要尝试先备份
        // 再删——本动作是用户主动清空，无需保留副本。
        // === #27：失败判定改严格——`rr != nil` 只排除了 nil，但 #13 实证过
        //   "" + rr 可能为空（rr 是 true/空字符串等）会被误判成功；要求 **字符串
        //   文本非空** 才算失败，与本文件其它 fs 调用（cycle_slot/save）同源。
        let removed_msg = ""
        if fs.exists("cases.json") {
            let rr = fs.remove("cases.json")
            if rr != nil {
                let m = "" + rr
                if m != "" { removed_msg = m }
            }
        }
        // 内存清空：扁平数组也要清，否则 on_render 闭包会读到旧 case_lines 等残留
        cases = []
        seq = 0
        selected_id = 0
        case_ids = []
        case_lines = []
        case_text_lines = []
        case_statuses = []
        case_selected = []
        case_badge_text = []
        case_receipt = []
        case_place_lines = []
        case_expanded = []
        case_activity_lines = []
        case_place_full = []
        case_status_text = []
        filtered_idxs = []
        filter_count_str = "0"
        filter_total_str = "0"
        matched_total_str = "0"
        current_query = ""
        rebuild_lines()
        ui.case_list.render()
        clear_pending_flag = "no"
        clear_pending_deadline = 0
        if removed_msg != "" {
            // 内存已清、但 cases.json 还在盘上（下次启动会再读回）——明示失败，
            // 不让用户误以为数据真的删了
            ui.hint.set_text("清空未完成：" + removed_msg)
        } else {
            ui.hint.set_text("已清空 " + "" + clear_prev_count + " 条守护（cases.json 已移除，内存已重置）")
        }
        clear_prev_count = 0
        return
    }
    // 第一次点：进入待确认态（不执行任何数据变更）
    clear_pending_flag = "yes"
    clear_pending_deadline = 1
    clear_prev_count = cur_n
    ui.hint.set_text("再点一次「清空全部」才会真删 " + "" + cur_n + " 条守护（不可逆）；5 秒内点别的按钮可放弃")
    // 5 秒后超时 → 放弃确认态
    start_timeout(5.0, || {
        if clear_pending_flag == "yes" {
            clear_pending_flag = "no"
            clear_pending_deadline = 0
            clear_prev_count = 0
            ui.hint.set_text("清空确认已过期（5s 内未再点），未删除任何数据")
        }
    })
}

start_timeout(0.05, || load())

let ink = #x1c1c1e
let secondary = #x8e8e93
let accent = #x007aff

// 组件工厂：第一方 RoundedView/徽章范式（#7 落实）
// show_bg:true 是必填，否则 RoundedView 不绘背景
let Card = RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 12 right: 12 top: 12 bottom: 12}
    show_bg: true draw_bg.color: #xffffff draw_bg.border_radius: 14.0}
let Badge = RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 4 bottom: 4}
    show_bg: true draw_bg.color: #xefeff4 draw_bg.border_radius: 7.0}
let BadgeText = Label{text: "" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 11}}
let TitleLine = Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 16}
let TextLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}
let ReceiptLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 12}

// === #9 新增：内联展开用的小字段标签（次级色粗体 13），照 #8 DetailSection 范式 ===
let SectionLabel = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 13}}
let BodyLine = Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 14}
let MetaLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 13}

SolidView{width: Fill height: Fill flow: Down padding: 16 spacing: 12 draw_bg.color: #xffffff
    Label{text: "牵线 · 聚会守护" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 26}}
    Label{text: "群里说好的聚会，盯到人人到场、账目清零" draw_text.color: secondary draw_text.text_style.font_size: 13}
    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            msg_input := TextInput{width: Fill height: 44 empty_text: "粘贴群消息，如：周六上午去深圳湾骑车"
            draw_bg +: {color: #xf2f2f7 color_hover: #xf2f2f7 color_focus: #xf2f2f7 color_empty: #xf2f2f7 border_radius: 10.0}
            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: secondary color_empty_hover: secondary}}
        // === #14：示例一键填充按钮（演示友好）===
        // 放根组件静态位置——根组件 if 只在首次求值定型，这里是固定按钮；
        // fill_example() 内部用 "cur != "" 守卫避免覆盖用户手打稿子。
        ButtonFlat{text: "用示例试试" height: 44 padding: Inset{left: 12 right: 12} on_click: || fill_example()
            draw_bg +: {border_radius: 20.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
            draw_text +: {color: accent color_hover: accent color_down: accent}}
        ButtonFlat{text: "建守护" height: 44 padding: Inset{left: 16 right: 16} on_click: || add_case()
            draw_bg +: {border_radius: 20.0 color: accent color_hover: #x0a84ff color_down: #x0062cc border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
    }
    hint := Label{width: Fill text: "载入中…" draw_text.color: secondary draw_text.text_style.font_size: 13}
    case_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
        // === #31f：详情模式分支（列表/详情互斥，同一 ScrollY 内无高度竞争）===
        if ui_mode == "detail" {
            let sel = -1
            for si in case_ids.len() {
                if case_ids[si] == ("" + selected_id) { sel = si; break }
            }
            if sel < 0 {
                Card{Label{width: Fill text: "还没有选中的守护——返回列表点选一条" draw_text.color: secondary}}
            } else {
                Card{
                    let slot_now = case_slot_day[sel] + "-" + case_slot_part[sel]
                    if slot_now == "-" { slot_now = "未抽取" }
                    BodyLine{text: "状态：" + case_status_text[sel] + " ｜ 时间：" + slot_now}
                    BodyLine{text: "参与人：" + case_people_line[sel] + " ｜ AA：" + case_bill_split_text[sel]}
                    BodyLine{text: "活动：" + case_activity_lines[sel] + " ｜ 地点：" + case_place_full[sel]}
                    // #31g：原文行删（回执与折叠摘要已含）；返回列表上移——详情卡总高必须
                    //   ≤ case_list 盒高（~480px），超出部分零布局（#31 实测机制）。
                    ButtonFlat{text: "← 返回列表" height: 44 on_click: || back_to_list()
                        draw_bg +: {border_radius: 13.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
                        draw_text +: {color: accent color_hover: accent color_down: accent}}
                    if case_receipt[sel].len() > 0 {
                        for _ri in case_receipt[sel].len() {
                            ReceiptLine{text: "  ↳ " + case_receipt[sel][_ri]}
                        }
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        TextInput{width: Fill height: 44 empty_text: "加参与人（逗号分隔）"
                            on_change: |txt| set_people_draft("" + txt)}
                        ButtonFlat{text: "添加" height: 44 padding: Inset{left: 10 right: 10} on_click: || add_person("" + selected_id, people_draft)
                            draw_bg +: {border_radius: 13.0 color: #x007aff color_hover: #x0060dd color_down: #x0055cc border_size: 0.0}
                            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: theme.font_bold{font_size: 12}}}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        TextInput{width: Fill height: 44 empty_text: "记 AA 总额，如300（选填）"
                            on_change: |txt| set_bill_draft("" + txt)}
                        ButtonFlat{text: "记一笔" height: 44 padding: Inset{left: 10 right: 10} on_click: || update_bill_total("" + selected_id, bill_draft)
                            draw_bg +: {border_radius: 13.0 color: #x34c759 color_hover: #x2ba84a color_down: #x278f40 border_size: 0.0}
                            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: theme.font_bold{font_size: 12}}}
                    }
                }
            }
            // 详情模式兜底占位（#5 空分支范式）
            View{width: Fill height: 1}
        } else {
        // === #42 新增：「✨ AI 生成」建议卡（AI 解析成功后停在列表分支顶部）——
        //   ai_parse() 两条通道成功后填 ai_act/ai_day/ai_part/ai_place + 翻 ai_card_visible="yes"；
        //   此处只读 ai_card_visible 字符串标记 + 四字段（闭包外已规范化，不再读 ai_pending）。
        //   零渲染零占位（ai_card_visible=="no" 时留 1px，#5 空分支硬约束范式）。
        //   按钮文案是静态 copy——模型文本绝不参与动作接线，只进文本槽（官方 AI-SERVICES 约束）。
        if ai_card_visible == "yes" {
            // 字段显示：空字段显「未给出」，避免空槽让用户疑惑（照 #34 demo 实证）。
            let _act_disp = "" + ai_act
            if _act_disp == "" { _act_disp = "未给出" }
            let _day_disp = "" + ai_day
            let _part_disp = "" + ai_part
            let _slot_disp = ""
            if _day_disp != "" && _part_disp != "" {
                _slot_disp = _day_disp + "-" + _part_disp
            } else if _day_disp != "" {
                _slot_disp = _day_disp
            } else if _part_disp != "" {
                _slot_disp = _part_disp
            } else {
                _slot_disp = "未给出"
            }
            let _place_disp = "" + ai_place
            if _place_disp == "" { _place_disp = "未给出" }
            Card{padding: Inset{left: 12 right: 12 top: 12 bottom: 12} spacing: 8
                Badge{show_bg: true draw_bg.color: ai_badge_bg()
                    BadgeText{text: "✨ AI 生成" draw_text.color: ai_badge_fg() draw_text.text_style: theme.font_bold{font_size: 11}}
                }
                BodyLine{text: "活动：" + _act_disp + " ｜ 时间：" + _slot_disp + " ｜ 地点：" + _place_disp}
                View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                    ButtonFlat{text: "采纳到输入框" height: 44 padding: Inset{left: 14 right: 14} on_click: || ai_adopt()
                        draw_bg +: {border_radius: 16.0 color: #x007aff color_hover: #x0060dd color_down: #x0055cc border_size: 0.0}
                        draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: theme.font_bold{font_size: 13}}}
                    ButtonFlat{text: "忽略" height: 44 padding: Inset{left: 14 right: 14} on_click: || ai_dismiss()
                        draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
                        draw_text +: {color: secondary color_hover: secondary color_down: secondary}}
                }
            }
        } else {
            // 无 AI 建议卡时 1px 占位（#5 硬约束：on_render 空分支至少一个子节点）
            View{width: Fill height: 1}
        }
        // === #12 新增：搜索框（放在筛选栏之上、确认取消变体之上；
        //   根组件 if 只在首次求值定型，所以搜索框必须放在 on_render 闭包内；
        //   闭包内只读 current_query 字符串，不读 cases[i][...]） ===
        // on_change 实时调 set_query(q)；× 用 GestureView on_tap 清空；空字符串不过滤。
        // 照第一方 news 搜索框写法：TextInput empty_text + on_change 触发布尔过滤。
        let q_now = "" + current_query
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            // 搜索框本体（占满剩余宽度）
            TextInput{width: Fill height: 44 empty_text: "搜活动或地点，如：深圳湾"
                text: q_now
                on_change: |t| set_query("" + t)}
            // 清空按钮：有词才显示（用 q_now 字面量作可见性条件，闭包内可读全局字符串）
            if q_now != "" {
                GestureView{on_tap: |x, y| set_query("") height: 32
                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "× 清空" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
        }
        // === #11 外环修：取消确认态变体（根组件 if 不随状态重算，必须放闭包内）===
        if cancel_pending_flag == "yes" {
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                ButtonFlat{text: "确认取消（5s）" height: 44 padding: Inset{left: 14 right: 14} on_click: || cancel_case()
                    draw_bg +: {border_radius: 16.0 color: #xff3b30 color_hover: #xe6352b color_down: #xcc2f26 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
            }
        } else {
            View{width: Fill height: 1}
        }
        // === #10 新增：筛选标签栏 + 计数（必须放 on_render 内：根组件属性不随状态重算，#8 实证） ===
        // 照第一方 news:301-306 写法：if t.id == tab {TabButtonActive{}} else {TabButton{}}
        // 计数照 ai-providers:45 "N models" 写法。Tab 是 GestureView on_tap 触发 set_filter。
        let cf_now = "" + current_filter
        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
            // 标签 1：全部
            GestureView{on_tap: |x, y| set_filter("all") height: 32
                if cf_now == "all" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: accent draw_bg.border_radius: 16.0
                        Label{text: "全部" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "全部" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
            // 标签 2：待拍板
            GestureView{on_tap: |x, y| set_filter("Proposing") height: 32
                if cf_now == "Proposing" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: accent draw_bg.border_radius: 16.0
                        Label{text: "待拍板" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "待拍板" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
            // 标签 3：已确认
            GestureView{on_tap: |x, y| set_filter("Confirmed") height: 32
                if cf_now == "Confirmed" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: accent draw_bg.border_radius: 16.0
                        Label{text: "已确认" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "已确认" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
            // 标签 4：已取消
            GestureView{on_tap: |x, y| set_filter("Cancelled") height: 32
                if cf_now == "Cancelled" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: accent draw_bg.border_radius: 16.0
                        Label{text: "已取消" draw_text.color: #xffffff draw_text.text_style: theme.font_bold{font_size: 13}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 12 right: 12 top: 6 bottom: 6}
                        show_bg: true draw_bg.color: #xf2f2f7 draw_bg.border_radius: 16.0
                        Label{text: "已取消" draw_text.color: secondary draw_text.text_style.font_size: 13}
                    }
                }
            }
            // 计数标签（照 ai-providers:45 "N models" 写法，靠右）
            // total = 0 时也显示"共 0 条"，不编造
            Label{width: Fill text: "共 " + filter_count_str + " / " + filter_total_str + " 条"
                draw_text.color: secondary draw_text.text_style.font_size: 12}
        }

        // 空态分流（照 ai-providers:242-248 三分支）：本来没有 vs 筛选后没有，文案必须不同
        // 分支 A：本来就没有任何守护 —— 引导用户建第一条
        if cases.len() == 0 {
            // === #11 新增：首用引导卡 —— 只用 seq==0 判断（seq 只在 add_case 成功后 +1）。
            //   只要用户成功建过一条守护（seq>0），这张卡就永远消失；
            //   即使用户后来删了所有守护（cases.len()==0），也不再回到首用引导，
            //   只显示原本的"还没有聚会守护"通用空态。
            //   写在 on_render 闭包里（#8/#10 实证：根组件属性不随状态重算）。
            if seq == 0 {
                Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 20 bottom: 20} spacing: 8
                    Label{text: "第一次用？三步起一条守护" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{text: "① 粘贴群里那条聚会消息" draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{text: "② 点「建守护」，牵线分诊后生成提案" draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{text: "③ 组织者点同意，回执与提醒就位" draw_text.color: ink draw_text.text_style.font_size: 14}
                }
            }
            // === #36：「怎么用」说明卡已移出空列表分支 → 列表模式公共尾部（见下方）。
            //   #29 把 4 个低频键（改时间/AI解析/导出/清空全部）折叠进本卡后，
            //   卡却只在本空态分支渲染——「有守护在册」时四键全部不可达：
            //   清空全部永远删不到数据，演示剧本 8/18/19/20 步不可执行（#34 真机复验抓到）。
            Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 28 bottom: 28} spacing: 6
                Label{text: "还没有聚会守护" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                Label{text: "粘贴一条群消息开始（例如：周六上午去深圳湾骑车）。点建守护后，行可点选。" draw_text.color: secondary draw_text.text_style.font_size: 13}
            }
            // 空分支兜底：永远留 1px 占位，防上帧残留（ai-providers:241 注释范式）
            View{width: Fill height: 1}
        // 分支 B：有守护但当前筛选下 0 条 —— 引导用户换筛选或建新条
        } else if filtered_idxs.len() == 0 {
            Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 28 bottom: 28} spacing: 6
                Label{text: "这个筛选下还没有守护" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                Label{text: "换个标签看看，或粘贴一条群消息开始（当前筛选：" + (if cf_now == "all" { "全部" } else if cf_now == "Proposing" { "待拍板" } else if cf_now == "Confirmed" { "已确认" } else { "已取消" }) + "）。" draw_text.color: secondary draw_text.text_style.font_size: 13}
            }
            // 筛选空分支兜底：同样留 1px 占位
            View{width: Fill height: 1}
        } else {
            // === #9 新增：撤销条放在 on_render 内的 undo_bar View 中（根组件 if 不重算，#8 外环修） ===
            // 撤销条必须放在渲染闭包里——根组件属性只在首次定型，不随状态变。
            // undo_win_open 守卫防止 5s 定时器在用户已撤销后再次覆盖。
            if undo_win_open == "yes" {
                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
                    show_bg: true draw_bg.color: #xf2efff draw_bg.border_radius: 12.0
                    Label{width: Fill text: "撤销窗口已开（点下方按钮恢复）" draw_text.color: #x5856d6 draw_text.text_style: theme.font_bold{font_size: 13}}
                    ButtonFlat{text: "撤销取消" height: 44 padding: Inset{left: 14 right: 14} on_click: || undo_cancel()
                        draw_bg +: {border_radius: 16.0 color: #x5856d6 color_hover: #x4e4dc2 color_down: #x4443ab border_size: 0.0}
                        draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
                }
            }

            // === #10 改造：列表循环改走 filtered_idxs，按当前筛选渲染 ===
            // on_render 闭包只读字符串数组（filtered_idxs[i] 是整数，作为 case_* 数组下标），
            // 筛选本身在 rebuild_lines() 函数上下文里完成（可读 cases[i]["status"]），
            // 这里不做判断、不读 cases[i][…]，完全合规 #4/#5/#7/#8 硬约束。
            for i in filtered_idxs.len() {
                let j = filtered_idxs[i]
                let cur_id = case_ids[j]
                let expanded = case_expanded[j]
                // 高亮条：选中态左侧 4pt 色条（保留 ▶ 兼顾读屏）
                let hi_color = status_bar_color(case_statuses[j])
                let hi_w = 4
                if case_selected[j] != "yes" { hi_w = 0 }
                // 注：on_tap 只属 GestureView（RoundedView/Card 没有此属性），
                // 照第一方 news:319 的 GestureView 包 Card 写法；
                // #9：点卡片 = 选中 + 切换展开（取代 #8 open_detail）
                GestureView{width: Fill height: Fit on_tap: |x, y| on_tap_card(cur_id)
                    Card{
                        View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.0}
                        View{width: hi_w height: 56 draw_bg.color: hi_color}
                        View{width: Fill height: Fit flow: Down spacing: 6
                            View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                // === #16 新增：标题行最左 10×10 状态色点 ===
                                // RoundedView + show_bg:true + border_radius:5.0 → 圆角色块。
                                // 颜色由 status_bar_color(status) 直接给（颜色字面量，不经字符串）。
                                // 选中态时左侧另有 hi_w 色条，二者并存不冲突（#16 契约）。
                                RoundedView{width: 10 height: 10
                                    show_bg: true draw_bg.color: status_bar_color(case_statuses[j]) draw_bg.border_radius: 5.0}
                                // 标题：选中时前缀 ▶，展开时前缀 ▾（给折叠/展开一个视觉差）
                                let prefix = "  "
                                if case_selected[j] == "yes" { prefix = "▶ " }
                                let exp_prefix = "  "
                                if expanded == "yes" { exp_prefix = "▾ " }
                                Label{width: Fill text: prefix + exp_prefix + case_lines[j] draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                                Badge{BadgeText{text: case_badge_text[j] draw_text.color: status_badge_fg(case_statuses[j])}
                                    draw_bg +: {color: status_badge_bg(case_statuses[j])}}
                                // === #18：折叠态冲突改在徽章文字体现（「待拍板·冲突」等），不再单独渲染冲突红点；
                                //   标题行最左的 10×10 状态色点（status_bar_color）已经承担状态视觉。 ===
                            }
                            // === #15：折叠态三行（标题+徽章 / 活动·地点 / 原文截断24字+…）
                            //   第二行末尾追加「· 共 N 字」（N = case_text_lines[j].len() 真实计算）。
                            //   本 runtime 无时钟 API，按外环契约不做假时间。
                            //   原文超过 24 字则截断并加 …（截断长度不含 …）；
                            //   24 字及以内原样显示，无 … 后缀。
                            //   地点为「（未抽取到）」时折叠态显示「地点未抽取到」。
                            let _act_full = "" + case_activity_lines[j]
                            let _pl_disp = "" + case_place_lines[j]
                            if _pl_disp == "（未抽取到）" { _pl_disp = "地点未抽取到" }
                            let _full_text = "" + case_text_lines[j]
                            let _text_len = _full_text.len()
                            // 截断：Splash 的字符串**不能下标取字符**、数组**没有 join**
                            // （SCRIPT-API §Data and strings / §Limits）。唯一可用的切分是
                            // `split(p)`（按分隔符切成数组），故用"逐字符 split 再拼回"实现截断。
                            let _shown_text = _full_text
                            if _text_len > 24 {
                                let _kept = ""
                                let _parts = _full_text.split("")
                                for _pi in _parts.len() {
                                    if _pi >= 24 { break }
                                    _kept = _kept + _parts[_pi]
                                }
                                _shown_text = _kept + "…"
                            }
                            TextLine{text: _act_full + " · " + _pl_disp + " · 共 " + "" + _text_len + " 字"}
                            TextLine{text: _shown_text}
                            // === #31 改造：卡内不再有展开态（截断问题整体绕开）；
                            //   完整详情见根组件「详情面板」（rebuild_lines 末尾 update_detail_panel 刷新）。
                            //   这里只保留折叠态三行（标题+徽章 / 活动·地点 / 原文截断24字+…）。
                            // 折叠态冲突摘要（移到此处，因为展开态已删 — 见 #31 留出的折叠态唯一一处冲突可见位置）
                            if case_conflict[j] == "yes" {
                                TextLine{text: case_conflict_lines[j]}
                            }
                        }
                    }
                }
                }
            }
            // 非空分支兜底：留 1px 占位（ai-providers:241 注释范式）
            View{width: Fill height: 1}
        }
            // === #36：「怎么用」说明卡（自空列表分支移此）——
            //   写在 case_list.on_render 闭包里（根组件属性不随状态重算，#8 硬约束外环修）。
            //   显隐走 howto_show_flag（字符串标记，#13 实证布尔不可靠）："yes" 才渲染整张卡；
            //   折叠时只留 1px 占位，防上帧残留（ai-providers:241 兜底范式）。
            //   默认展开策略：未建过守护（seq==0）→ 第一次启动自动展开；
            //   建过守护（seq>0）→ 默认收起，不打扰老用户。点首屏底部「怎么用？」按钮可手动切。
            //   只读 howto_show_flag / seq 两个字符串/整数，不读 cases[i][...]（符合硬约束 #2）。
            //   #36 位置语义：列表模式三分支（空态/筛选空/有卡）共用此尾部，
            //   展开后滚动到底即达——#29 的低频键在有数据时重新可达。
            if howto_show_flag == "yes" {
                Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 20 bottom: 20} spacing: 8
                    Label{text: "怎么用？" draw_text.color: ink draw_text.text_style: theme.font_bold{font_size: 16}}
                    Label{text: "1. 粘贴群里那条聚会消息，或点「用示例试试」" draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{text: "2. 点建守护——牵线会分诊，命中时间/约定才生成提案" draw_text.color: ink draw_text.text_style.font_size: 14}
                    Label{text: "3. 点卡片展开详情，组织者点「确认这条守护」，回执与提醒就位" draw_text.color: ink draw_text.text_style.font_size: 14}
                    // === #42 新增：AI 解析成功会先停在建议卡上，等用户点头才落地 ——
                    //   与上一步「点 AI 解析」配套：建议卡显示「活动/时间/地点」汇总，
                    //   「采纳到输入框」后写回 msg_input，再点「建守护」即走分诊。
                    //   「忽略」按钮只翻标记，msg_input 原样保留（用户原文不动）。
                    Label{text: "4. AI 解析成功会先出「✨ AI 生成」建议卡，过目后点「采纳到输入框」" draw_text.color: ink draw_text.text_style.font_size: 14}
                    // === #45 C 切片：app 不能自驱唤醒 agent（无 needs/triggers），
                    // 宿主「Ask 牵线」面板问我任何问题时，我会主动带出临期/待拍板提醒
                    // （详见 AGENT.md "主动提示行为"小节）。
                    Label{text: "5. 在宿主「Ask 牵线」面板可以问：「周六有什么安排？」——已确认的守护临期时我会主动提醒你" draw_text.color: ink draw_text.text_style.font_size: 14}
                    // === #29（外环派）：低频操作折叠区 ——
                    //   原 ai_row 的 4 个按钮（改时间 / AI 解析 / 导出数据 / 清空全部）
                    //   从根组件搬到「怎么用？」说明卡内,只在卡片展开时可见。
                    //   写在 on_render 闭包里,符合硬约束 #1(根组件属性不随状态重算,
                    //   闭包内可重渲染);on_click 直接调既有 fn(cycle_slot/ai_parse/
                    //   export_data/clear_all_data),无新逻辑、无新状态。
                    //   height: 44 与主区三键对齐,触控目标达 HIG 44pt 标准。
                    Label{text: "低频操作（点下方按钮）" draw_text.color: secondary draw_text.text_style: theme.font_bold{font_size: 13}}
                    // 复用 #11 AI 按钮弱化风格 + #14 灰底色,与主区三键视觉拉开层级
                    // （次级灰底 + accent/secondary 字,不抢眼）。
                    // #44 外环修：五键原单行 flow:Right 总宽 ~500px > 容器 ~380px，第 5 键
                    //   （清空全部）被布局丢弃出控件树——#37 加 glance 键后清空全部不可达
                    //   （回归 R-13 真机实锤：按钮不在 /snap 树）。拆两行根治。
                    View{width: Fill height: Fit flow: Right spacing: 6
                        ButtonFlat{text: "改时间（5 槽）" height: 44 padding: Inset{left: 10 right: 10} on_click: || cycle_slot("" + selected_id)
                            draw_bg +: {border_radius: 16.0 color: #xff9500 color_hover: #xe68600 color_down: #xcc7700 border_size: 0.0}
                            draw_text +: {color: #ffffff color_hover: #ffffff color_down: #xffffff}}
                        ButtonFlat{text: "AI 解析" height: 44 padding: Inset{left: 10 right: 10} on_click: || ai_parse()
                            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
                            draw_text +: {color: accent color_hover: accent color_down: accent}}
                        ButtonFlat{text: "导出数据" height: 44 padding: Inset{left: 10 right: 10} on_click: || export_data()
                            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
                            draw_text +: {color: secondary color_hover: secondary color_down: secondary}}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6
                        // === #37「发布到 glance 屏」按钮（人触发，与导出/清空同级灰底）===
                        ButtonFlat{text: "发布到 glance 屏" height: 44 padding: Inset{left: 10 right: 10} on_click: || publish_glance()
                            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
                            draw_text +: {color: secondary color_hover: secondary color_down: secondary}}
                        ButtonFlat{text: "清空全部" height: 44 padding: Inset{left: 10 right: 10} on_click: || clear_all_data()
                            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
                            draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30}}
                    }
                }
            } else {
                // 折叠时留 1px 占位（on_render 空分支硬约束 #5：至少一个子节点）
                View{width: Fill height: 1}
            }
        }
    }}
    // #31f：根静态详情面板已删除——面板并入 case_list on_render 的 ui_mode="detail" 分支
    action_row := View{width: Fill height: Fit flow: Right spacing: 8

        // === #11 动词化文案：同意选中 → 确认这条守护（绿=主行动 #7 状态色） ===
        ButtonFlat{text: "确认这条守护" height: 44 padding: Inset{left: 14 right: 14} on_click: || confirm_case()
            draw_bg +: {border_radius: 16.0 color: #x34c759 color_hover: #x30b350 color_down: #x2a9e47 border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
        // === #11 动词化文案：改口 → 重新收敛（橙=警示 #7 状态色） ===
        ButtonFlat{text: "重新收敛" height: 44 padding: Inset{left: 14 right: 14} on_click: || reschedule_case()
            draw_bg +: {border_radius: 16.0 color: #xff9500 color_hover: #xf08a00 color_down: #xd67d00 border_size: 0.0}
            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
        // === #11 动词化文案 + 取消按钮降权（默认态：浅底红字，视觉弱化）===
        // 注：确认态的「确认取消（5s）」变体由 case_list 的 on_render 渲染
        // （根组件属性不随状态重算，#8 实证）；此处只保留固定的默认态按钮。
        ButtonFlat{text: "取消守护" height: 44 padding: Inset{left: 14 right: 14} on_click: || cancel_case()
            draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
            draw_text +: {color: #xff3b30 color_hover: #xff3b30 color_down: #xff3b30}}
        // #9：撤销按钮已移到 case_list on_render 内的 undo_bar，根组件不再放 if 块
        // （#8 外环复验：根组件属性不随状态重算，必须放闭包里）
    }
    // === #29（外环派）：低频操作（改时间/AI解析/导出数据/清空全部）已从根组件第二行
    //   折叠进「怎么用？」说明卡——按钮升 44pt 后，根组件底部从 3 行 132pt 收缩到 2 行 88pt，
    //   主区只留高频三键（确认/重新收敛/取消 + 怎么用？开关），ScrollYView 不再被挤压溢出。
    // ai_row 兜底占位（1px），与 on_render 空分支的 #5 硬约束范式对齐（ai-providers:241）。
    View{width: Fill height: 1}
    // === #16 新增：首屏底部可点「怎么用？」—— 放在 ai_row 下方、整屏最底 ===
    // 文本按钮（次级灰底 + accent 蓝字，视觉弱化但不抢眼）；
    // 点击触发 toggle_howto() 翻转 howto_show_flag，再走 ui.case_list.render() 重渲染说明卡。
    // 根组件属性只在首次求值定型——但按钮本身的 on_click 是事件回调，不依赖 if 重算；
    //   说明卡的显隐走 on_render 闭包内的 howto_show_flag 判断，符合硬约束 #1。
    ButtonFlat{text: "怎么用？" height: 44 padding: Inset{left: 14 right: 14} on_click: || toggle_howto()
        draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
        draw_text +: {color: accent color_hover: accent color_down: accent}}
    // === #43 D 切片：底部「风格：X」按钮（与「怎么用？」同行，文字按钮样式）===
    //   具名 style_btn → ui.style_btn.set_text(...) 命令式更新（根组件 if 只在首次定型，
    //   on_render 重算不可靠——实证范式见 ui.hint.set_text line 493/504 等，已多次回归通过）。
    //   文案随 receipt_style 变（标准/简短/带emoji），on_click 走 set_receipt_style()
    //   循环切换。详见 set_receipt_style 内调用 ui.style_btn.set_text(...)。
    style_btn := ButtonFlat{text: "风格：" + style_label_for(receipt_style) height: 44 padding: Inset{left: 14 right: 14} on_click: || set_receipt_style()
        draw_bg +: {border_radius: 16.0 color: #xf2f2f7 color_hover: #xe5e5ea color_down: #xd8d8dd border_size: 0.0}
        draw_text +: {color: accent color_hover: accent color_down: accent}}
}
