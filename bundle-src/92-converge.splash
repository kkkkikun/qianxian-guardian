// ═══ 部件 13/16：群智收敛（WP3-A 降级路径）/ 结案分享到群 / 确认后动作（ICS+日历写入链）
// ═══ 源文件 bundle-src/92-converge.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// === 决赛 v0.4.0 S6：确认后动作（ICS 自动导出 + 群分享 + 提醒登记提示） ===
// v0.10.0 WP5：分享结案回顾到群（matrix.send_message 真发；数字全来自审计字段）
// === v0.10.0 WP3-A：群智收敛三动作（降级路径） ===
// ① 发投票到群：文字投票卡（matrix.send_message 真发）；非 Rinx 宿主诚实降级文案可复制。
fn converge_slots_text(){
    return "A. 周六-上午    B. 周六-下午    C. 周六-晚上\n       D. 周日-上午    E. 周日-下午"
}
fn start_converge(){
    let ci = -1
    for i in cases.len() {
        if cases[i]["id"] == selected_id { ci = i }
    }
    if ci < 0 { set_hint("先选中一条守护再发投票"); return }
    let id_str = "" + cases[ci]["id"]
    let act = "" + cases[ci]["activity"]
    if act == "" { act = "聚会" }
    let place = "" + cases[ci]["place"]
    let ppl = "" + cases[ci]["people"]
    if ppl == "" { ppl = "（暂无名单——先加参与人再发投票更准确）" }
    let body = "📋 时间收敛投票：#" + id_str + " " + act + " · " + place
        + "\n候选时段（回复对应字母即投票）：\n" + converge_slots_text()
        + "\n回复如「A」或「AB」（多选按整票计）。参与人：" + ppl
        + "。\n当前已收到 0 票（成员回复后请组织者到牵线里点「刷新计票」）。"
    converge_case_id = id_str
    if host.has("matrix.send_message") {
        host.request("matrix.send_message", {body: body}, fn(r){
            if r.is_ok {
                set_hint("投票卡已发到群 ✓——成员回复字母后，回来点「刷新计票」")
                audit("converge_start", "#" + converge_case_id + "（文字投票卡）")
            } else {
                set_hint("发投票失败：" + r.error + "（可用下方文案手动转发）")
            }
        })
    } else {
        // 诚实降级：无 matrix 服务→屏显文案供手动转发
        ui.msg_input.set_text(body)
        set_hint("本宿主无 matrix 服务——投票文案已填入输入框，复制转发到群即可（成员回复后回这里刷新计票）")
    }
    audit("converge_start", "#" + id_str + "（文字投票卡发起）")
    render_views()
}
// ② 刷新计票：读伴生进程写的 converge.json（进程读房间消息归票；无文件=提示先跑伴生进程）
fn refresh_converge(){
    if !fs.exists("converge.json") {
        set_hint("还没有计票数据——先跑伴生进程：python3 tools/qx-converge-bridge.py --room '<房间>' --jail <jail>（它会读群消息归票）")
        return
    }
    let v = ("" + fs.read("converge.json")).parse_json()
    if v == nil {
        set_hint("converge.json 解析失败（伴生进程写入中？稍后再试）")
        return
    }
    if converge_case_id == "" {
        converge_case_id = "" + v["case_id"]
    }
    if ("" + v["case_id"]) != converge_case_id {
        set_hint("计票文件属于另一场投票（#" + ("" + v["case_id"]) + "）——先完成那场或重新发起")
        return
    }
    converge_summary = "" + v["summary"]
    converge_winner = "" + v["winner"]
    converge_winner_slot = "" + v["winner_slot"]
    render_views()
    set_hint("计票：" + converge_summary)
}
// ③ 管家收敛：把计票注入 turn，让模型出 reschedule PLAN（白名单拍板链）
fn converge_butler(){
    if converge_winner_slot == "" {
        // 兜底：直接从 converge.json 读（重启后 converge_case_id 全局初值为空）
        if fs.exists("converge.json") {
            let v2 = ("" + fs.read("converge.json")).parse_json()
            if v2 != nil {
                converge_case_id = "" + v2["case_id"]
                converge_summary = "" + v2["summary"]
                converge_winner = "" + v2["winner"]
                converge_winner_slot = "" + v2["winner_slot"]
            }
        }
    }
    if converge_case_id == "" || converge_winner_slot == "" {
        set_hint("先「刷新计票」拿到票数分布（平票/零票时请人工定夺，不收敛）")
        return
    }
    let id_str = converge_case_id
    let ci = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { ci = i }
    }
    if ci < 0 { set_hint("找不到 #" + id_str); return }
    // 直接用确定性白名单构造提案（不经模型——计票收敛是纯确定性场景；
    //   「票数不足的时段」记沉默留痕）
    plan_op = "reschedule"
    plan_id = id_str
    let sd = converge_winner_slot.split("-")
    plan_day = sd[0]
    plan_part = sd[1]
    plan_summary = "按群投票收敛：#" + id_str + " 改到票数最高的 " + converge_winner_slot + "（" + converge_summary + "）"
    plan_lines = []
    plan_check = ""
    let old_disp = ("" + cases[ci]["slot_day"]) + "-" + ("" + cases[ci]["slot_part"])
    plan_lines.push("op：改期 ｜ 目标：#" + id_str + " " + ("" + cases[ci]["activity"]))
    plan_lines.push("时间：" + old_disp + " ──▶ " + converge_winner_slot + "（群投票收敛：" + converge_summary + "）")
    plan_lines.push("冲突预演：改后由拍板时全量重算")
    plan_check = "ok"
    plan_pending = "yes"
    // 沉默留痕：考虑过但票数不足的时段
    if fs.exists("suppressed.json") {
        let sv = ("" + fs.read("suppressed.json")).parse_json()
        if sv != nil {
            let arr = sv["entries"]
            if arr == nil { arr = [] }
            arr.push({ts: "", kind: "converge", detail: "#" + id_str + " 收敛到 " + converge_winner_slot + "——其余时段票数不足（" + converge_summary + "）"})
            fs.write("suppressed.json", {entries: arr}.to_json())
        }
    }
    audit("converge_plan", "#" + id_str + " → " + converge_winner_slot + "（" + converge_summary + "）")
    enter_chat()
    set_hint("管家已按群投票出提案——过目后点「拍板」")
}

fn share_fin_report(){
    let ci = -1
    for i in cases.len() {
        if cases[i]["id"] == selected_id { ci = i }
    }
    if ci < 0 { return }
    let id_str = "" + cases[ci]["id"]
    let act = "" + cases[ci]["activity"]
    if act == "" { act = "聚会" }
    let slot = ("" + cases[ci]["slot_day"]) + "-" + ("" + cases[ci]["slot_part"])
    let place = "" + cases[ci]["place"]
    let ppl = "" + cases[ci]["people"]
    let body = "🎉 聚会回顾：#" + id_str + " " + act + "（" + slot + " · " + place + "）已圆满收尾！"
        + "到场 " + fin_stat_people + "，人均 " + fin_stat_per + "，周期 " + fin_stat_days
        + "（数据由牵线守护从审计链导出）。"
    audit("share_fin", "#" + id_str)
    if host.has("matrix.send_message") {
        host.request("matrix.send_message", {body: body}, fn(r){
            if r.is_ok {
                set_hint("聚会回顾已分享到群 ✓")
            } else {
                set_hint("分享失败：" + r.error + "（回顾卡已在详情页，可手动复制转发）")
            }
        })
    } else {
        set_hint("本宿主无 matrix 服务，无法发群——回顾卡已在详情页，可手动复制转发")
    }
}

fn post_confirm_actions(id_str){
    // ① ICS 自动生成（本机可验证的日历写入路径）
    let cur = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { cur = i }
    }
    if cur >= 0 {
        let ics = build_ics(cur)
        if ics != "" {
            fs.write("calendar/qianxian-" + id_str + ".ics", ics)
        }
    }
    // ② 群分享（Rinx 宿主真发；card-host 无此服务 → 46b 诚实降级）
    if host.has("matrix.send_message") {
        let cur2 = -1
        for i in cases.len() {
            if "" + cases[i]["id"] == id_str { cur2 = i }
        }
        if cur2 >= 0 {
            let act = "" + cases[cur2]["activity"]
            if act == "" { act = "聚会" }
            let body = "✅ 牵线确认：#" + id_str + " " + act + "（" + ("" + cases[cur2]["slot_day"]) + "-" + ("" + cases[cur2]["slot_part"]) + "）· " + ("" + cases[cur2]["place"]) + " —— T-24h 提醒已登记"
            host.request("matrix.send_message", {body: body}, fn(r){
                if r.is_ok {
                    set_hint("群分享：已发送到授权房间 ✓（T-24h 提醒已登记）")
                } else {
                    // 46b 诚实可见性：透出真实失败原因，不吞错误
                    set_hint("群分享失败：" + r.error + " —— 提醒已在本机登记，ICS 已生成")
                }
            })
        }
    }
    // ③ 本机日历写入（v0.8.0：RC2 device_calendar 官方通路）。启发式：拍板确认后
    //    app 自动走「授权→选日历→原生面板写入」，人在原生面板上只做物理确认；
    //    events.create 由宿主原生 review 兜底，本 app 无任何静默写。Linux 宿主无此
    //    服务 → host.has 门检跳过（ICS 已在①生成，任何日历软件可导入，诚实降级）。
    if host.has("device_calendar") {
        calendar_write_case(id_str)
    }
}

// === v0.8.0：device_calendar 写链（RC2 官方协议；参数名/校验与
//    OctoSense crates/shell/src/device_calendar 逐字对齐） ===
// 链：permission.request（原生授权）→ calendars.list → 取第一个可写日历 →
//     calendars.select（原生 review，回 handle）→ events.create（原生面板物理确认，
//     all-day 事件 UTC 零点边界）。每一步失败都真实原因透出 + ICS 兜底提示。
let cal_write_id = ""
let cal_handle = ""
fn cal_degrade(stage, err){
    set_hint("本机日历：" + stage + "失败（" + err + "）——已生成 ICS，可导入任何日历软件")
}
fn calendar_write_case(id_str){
    cal_write_id = id_str
    cal_handle = ""
    let cur = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { cur = i }
    }
    if cur < 0 { return }
    // all-day 事件需要绝对日期（no-facts：相对词对不上日历就不写，不发明）
    let td = "" + cases[cur]["target_date"]
    if td == "" {
        set_hint("本机日历：活动日期未解析到（" + ("" + cases[cur]["slot_day"]) + " 对不上具体日期）——已生成 ICS，可手动导入")
        return
    }
    host.request("device_calendar.permission.request", {}, fn(r){
        if !r.is_ok {
            cal_degrade("授权", r.error)
            return
        }
        // 非日历平台（Linux 桌面等）会回 supported:false——如实降级，不装成功
        if r.data != nil {
            if ("" + r.data["supported"]) == "false" {
                cal_degrade("本宿主", "此系统不支持日历读写（supported:false）")
                return
            }
        }
        host.request("device_calendar.calendars.list", {}, fn(r2){
            if !r2.is_ok {
                cal_degrade("读日历列表", r2.error)
                return
            }
            // 取第一个可写日历（ writable=false 只读不可建事件——服务端也会拒）
            let cid = ""
            if r2.data != nil {
                let cals = r2.data["calendars"]
                if cals != nil {
                    for ci2 in cals.len() {
                        if cid == "" {
                            if cals[ci2]["writable"] { cid = "" + cals[ci2]["id"] }
                        }
                    }
                }
            }
            if cid == "" {
                cal_degrade("选日历", "没有可写的系统日历")
                return
            }
            host.request("device_calendar.calendars.select", {calendar_id: cid}, fn(r3){
                if !r3.is_ok {
                    cal_degrade("选定日历", r3.error)
                    return
                }
                if r3.data == nil {
                    cal_degrade("选定日历", "未返回 handle")
                    return
                }
                cal_handle = "" + r3.data["handle"]
                if cal_handle == "" {
                    cal_degrade("选定日历", "handle 为空")
                    return
                }
                // 组装 all-day 事件（title ≤512 / UTC 零点边界 / 下一天零点为 end）
                let cur2 = -1
                for i2 in cases.len() {
                    if "" + cases[i2]["id"] == cal_write_id { cur2 = i2 }
                }
                if cur2 < 0 { return }
                let td2 = "" + cases[cur2]["target_date"]
                let dt = td2.split("-")
                if dt.len() != 3 {
                    cal_degrade("写入", "日期解析失败：" + td2)
                    return
                }
                let z = days_from_civil(dt[0].to_f64(), dt[1].to_f64(), dt[2].to_f64())
                // 本历法 z 以 0000-03-01 为原点（无 +719468 偏移）：Unix 纪元 1970-01-01
                // 的 z=719468 → start_ms = (z-719468)*86400000（all-day 的 UTC 零点）
                let start_ms = (z - 719468) * 86400000
                let act2 = "" + cases[cur2]["activity"]
                if act2 == "" { act2 = "聚会" }
                let title2 = "【牵线】#" + cal_write_id + " " + act2
                let loc2 = "" + cases[cur2]["place"]
                let notes2 = "聚会守护 #" + cal_write_id + "｜原文：" + trim_n("" + cases[cur2]["text"], 60) + "｜由牵线确认拍板后写入（原生面板人工确认）"
                host.request("device_calendar.events.create", {handle: cal_handle, event: {title: title2, start_ms: start_ms, end_ms: start_ms + 86400000, timezone: "UTC", all_day: true, location: loc2, notes: notes2}}, fn(r4){
                    if r4.is_ok {
                        audit("calendar_write", "#" + cal_write_id + " → 系统日历（原生面板确认）")
                        set_hint("本机日历：已写入系统日历 ✓（你在原生面板按了确认）——提醒与 ICS 同步在案")
                    } else {
                        cal_degrade("写入", r4.error)
                    }
                })
            })
        })
    })
}

