// ═══ 部件 8/16：管家回合：probe_ai_cap / ai_timeout / chat_push / build_agent_turn / butler_send
// ═══ 源文件 bundle-src/80-butler-turn.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// === 决赛 S3：管家模式 —— agent 驱动全流程，人只拍板 ===
// 唯一 AI 通道：octos.turn.start（Rinx 宿主仅接受 {text} 单参数，其他键直接报错——源码级核实）。
// 回包自由文本：尾部带 PLAN{...}（单行 JSON，扁平字符串字段）即为机器提案，
// 解析进 plan_* 全局 + plan_pending="yes"，聊天视图渲染「拍板/放弃」；
// 人点「拍板」才走白名单动作（create/confirm/reschedule/cancel/add_people/set_bill）。
// card-host 无服务 → 诚实降级：sys 气泡明示，本地规则路径（建守护）原样可用。

// #46 A切片（S3 改版）：AI 通道可见性——只探测管家通道（turn.start）
// v0.10.2：死亡闩锁优先——实测失败过的通道不再报「可用」
fn probe_ai_cap(){
    if ai_dead == "yes" {
        return "AI：通道实测无响应，本地规则兜底（对话里可「重试 AI」）"
    }
    if host.has("octos.turn.start") {
        return "AI：管家对话通道可用（首次需宿主允许）"
    }
    return "AI：本机无管家服务，本地规则兜底"
}

// v0.10.2：摘除悬挂的「思考中」气泡——它永远是最后一条（回合间无其他入栈；
// 用户发送被 ai_pending 挡住），结果到达时 pop 掉由结果气泡替代，不再满屏残留。
fn resolve_thinking(){
    if thinking_open == "yes" {
        chat_role.pop()
        chat_text.pop()
        thinking_open = "no"
    }
}

// v0.10.2：通道死亡闩锁置位 + 持久化（jail ai_state.json）——一次实测失败，
//   之后每条消息不再白等 45 秒；用户可点「重试 AI」手动复位。
fn mark_ai_dead(why){
    ai_dead = "yes"
    let _w = fs.write("ai_state.json", {dead: "yes", reason: "" + why}.to_json())
    ui.ai_cap_label.set_text(probe_ai_cap())
}

// 决赛改进②（S3 改版）：45s 降级定时器，带代际核对 + 聊天面同步
fn ai_timeout(my){
    if my == ai_seq && ai_pending == "yes" {
        ai_pending = "no"
        resolve_thinking()
        chat_push("sys", "管家无响应（45 秒）——已降级本地规则，点下方「用本地规则建守护」即可")
        mark_ai_dead("timeout")
        render_views()
        set_hint("AI 无响应（45 秒），已降级本地规则——点对话下方「用本地规则建守护」")
    }
}
// 对话气泡入栈（role: "me"/"ai"/"sys"）；聊天视图可见时即时重渲染
fn chat_push(role, text){
    chat_role.push("" + role)
    chat_text.push("" + text)
    if ui_mode == "chat" {
        ui.chat_list.render()
    }
}

// 管家回合提示词：静态角色前导（含 PLAN 协议）+ 当前守护快照 + 用户消息。
// Rinx 不给 mini-app 注入 AGENT.md（宿主侧 turn_input 无 guidance 分支，源码级核实），
// 所以角色与协议必须由 app 自己嵌入 turn 文本——与 AGENT.md v3 同文，双处一致。
fn build_agent_turn(user_text){
    let pre = "你是「牵线」聚会守护管家，帮组织者把群消息变成照顾到收尾的聚会。依据【当前守护】与【用户消息】工作。规则：1)只从消息原文抽取字段，抽不到就留空并说明「未抽取到」，绝不编造时间/地点/人物；2)你没有执行权——凡涉及新建/确认/改期/取消/加人/记账/收款/撤销/清空/导出，先用一两句人话说明，然后另起一行输出机器提案，格式固定单行：PLAN{\"op\":\"create\",\"text\":\"消息原文\",\"activity\":\"\",\"slot_day\":\"\",\"slot_part\":\"\",\"place\":\"\",\"people\":\"\",\"bill_total\":\"\"}。op 全集：create(text 必填原文)/confirm/reschedule(+slot_day+slot_part)/cancel/add_people(+people)/set_bill(+bill_total)/complete/draft_dunning（催收草稿，数字由 app 算）/mark_paid(+who+amount 记某人已付款)/undo（撤销刚取消的守护，5 秒窗内）/clear（清空全部，危险，两段确认）/export（导出数据，可带 id 导出单条证据包）——除 create/clear/export 外都必须包含 \"id\":\"<目标守护数字>\"（例：{\"op\":\"confirm\",\"id\":\"2\"}；{\"op\":\"mark_paid\",\"id\":\"1\",\"who\":\"张三\",\"amount\":\"100\"}），缺 id 会被拒；字段值全部双引号字符串，值内禁用双引号与换行，未抽取到留空，每次回复最多一个 PLAN；3)绝不声称已改状态，用户点「拍板」后才算数；4)答疑直接回答不带 PLAN；5)发现同时段冲突要提醒；6)天气/时间等实时信息必须调用工具（get_weather/clock）查询，工具不可用或查询失败就明确说「暂无法查询实时数据」，禁止凭记忆编造任何数字；7)若本回合带【上次提案被拒】，必须按该理由调整方案，不许原样重提。回复中文、简短（≤120字）。"
    let st = pre + "\n\n【当前守护】\n"
    if cases.len() == 0 {
        st = st + "（还没有守护）"
    } else {
        for i in cases.len() {
            st = st + "#" + ("" + cases[i]["id"]) + " " + ("" + cases[i]["activity"])
            st = st + "｜" + ("" + cases[i]["slot_day"]) + "-" + ("" + cases[i]["slot_part"])
            st = st + "｜" + ("" + cases[i]["place"])
            st = st + "｜" + ("" + cases[i]["status"])
            // v0.8.0 W1 快照富化：管家能看到人与账，才能答「张三交了吗」这类问题
            st = st + "｜人:" + ("" + cases[i]["people"])
            st = st + "｜账:" + ("" + cases[i]["bill_total"])
            if ("" + cases[i]["bill_cleared"]) == "yes" { st = st + "(已收齐)" }
            if ("" + cases[i]["conflict"]) == "yes" { st = st + "｜⚡冲突" }
            st = st + "\n"
        }
    }
    // v0.8.0 W1：拍板反馈回路——拒绝理由一次性注入（调用方 build 后立即清空）
    if decline_feedback != "" {
        st = st + "\n【上次提案被拒】" + decline_feedback
    }
    return st + "\n【用户消息】\n" + user_text
}

// v0.10.2：回合尝试抽成独立函数（butler_send 与「重试 AI」共用）——
//   只发回合，不再推 me 气泡（重试不重复刷屏）。
fn ai_attempt(text){
    ai_pending = "yes"
    ai_seq = ai_seq + 1
    let my = ai_seq
    chat_push("sys", "管家思考中…")
    thinking_open = "yes"
    // 15s 进度反馈：原地替换思考气泡文案（pop+push），不新增悬挂气泡
    start_timeout(15.0, || {
        if my == ai_seq && ai_pending == "yes" && thinking_open == "yes" {
            resolve_thinking()
            chat_push("sys", "管家还在思考…（模型响应较慢；45 秒无响应自动降级本地规则）")
            thinking_open = "yes"
        }
    })
    // v0.8.0 W1：拒绝理由一次性反馈——先注入进 turn 文本再清空（只影响本回合）
    let turn_text = build_agent_turn(text)
    decline_feedback = ""
    start_timeout(45.0, || ai_timeout(my))
    host.request("octos.turn.start", {text: turn_text}, fn(r){
        // 决赛改进②：迟到回调按序号丢弃——已被新回合取代时不动任何 UI 状态
        if my != ai_seq { return }
        ai_pending = "no"
        resolve_thinking()
        if r.is_ok {
            let reply = "" + r.data.text
            if reply == "" { reply = "（管家返回了空回复）" }
            plan_parse(reply)

            // 评委硬伤修复：彻底杜绝原始协议泄漏（PLAN{...} 严禁进入用户可见气泡）
            let bubble_text = reply
            let rparts = reply.split("PLAN{")
            if rparts.len() > 1 {
                let human = rparts[0].trim()
                if human != "" {
                    bubble_text = human
                } else {
                    bubble_text = default_human_reply(plan_op)
                }
            }
            chat_push("ai", bubble_text)
            if plan_pending == "yes" {
                set_hint("管家出了提案——过目后点「拍板」执行")
            } else {
                set_hint("管家已回复（见对话）")
            }
        } else {
            // #46b 诚实可见性：host.has 只证「已注册」，实测失败要把「可用」字样撤下
            // v0.10.2：实测失败 → 死亡闩锁（后续发送即时降级，不再逐条白等 45 秒）
            chat_push("sys", "AI 通道无响应（" + r.error + "）——已降级本地规则：点下方「用本地规则建守护」即可")
            mark_ai_dead(r.error)
            set_hint("AI 不可用，已降级为本地规则（" + r.error + "）")
        }
        render_views()
    })
}

// v0.10.2：降级快捷动作——用本地规则处理上一条消息（分诊/二次确认/落库全走既有路径）
fn butler_local_fallback(){
    if last_me_text == "" {
        set_hint("没有可建的原文——把群消息粘贴到输入框，再点「建守护」")
        return
    }
    ui.msg_input.set_text(last_me_text)
    add_case()
    chat_push("sys", "已把上一条交给本地规则分诊（结果见提示与守护列表）")
    render_views()
}

// v0.10.2：重试 AI 通道——清闩锁 + 有原文则直接重发上一条（不重复推 me 气泡）
fn butler_retry_ai(){
    if ai_pending == "yes" {
        set_hint("管家还在思考，请稍候")
        return
    }
    ai_dead = "no"
    let _w = fs.write("ai_state.json", {dead: "no"}.to_json())
    ui.ai_cap_label.set_text(probe_ai_cap())
    if last_me_text != "" {
        ai_attempt(last_me_text)
    } else {
        chat_push("sys", "已重置 AI 通道——粘贴消息后再点「交给管家」")
        render_views()
    }
}

// 管家入口：输入框文本 → 聊天视图 → turn.start（死亡闩锁/无服务则诚实降级，零等待）
fn butler_send(){
    if ai_pending == "yes" {
        set_hint("管家还在思考，请稍候（45 秒无响应自动降级）")
        return
    }
    let text = ui.msg_input.text()
    if text == "" {
        set_hint("先粘贴一条群消息，再点「交给管家」")
        return
    }
    chat_push("me", text)
    last_me_text = text
    ui.msg_input.set_text("")
    enter_chat()
    // v0.10.2：死亡闩锁——通道已知不可用时不白等，即时给本地出口 + 重试入口
    if ai_dead == "yes" {
        chat_push("sys", "AI 通道当前不可用（上次实测失败）——点下方「用本地规则建守护」直接落地，或「重试 AI」再试一次")
        ui.ai_cap_label.set_text(probe_ai_cap())
        render_views()
        return
    }
    if host.has("octos.turn.start") {
        ai_attempt(text)
    } else {
        // 诚实降级：无 AI 服务——不假装管家在听；同样置闩锁（本机会话内不再逐条重试空通道）
        chat_push("sys", "本机没有管家服务（host 无 octos.turn.start）——点下方「用本地规则建守护」走分诊建卡")
        mark_ai_dead("no-service")
        set_hint("本机无 AI 服务，已降级本地规则——点对话下方「用本地规则建守护」")
        render_views()
    }
}

// 评委硬伤修复：杜绝原始协议泄漏——缺省自然语言时，由管家补齐有温度的说明
fn default_human_reply(op){
    if op == "create" { return "为您起草了聚会方案，请在下方提案卡过目并拍板。" }
    if op == "confirm" { return "信息已齐备，已为您起草确认提案。" }
    if op == "reschedule" { return "好的，已为您起草改期方案，请过目下方提案卡。" }
    if op == "cancel" { return "明白，已起草取消方案，拍板后有 5 秒撤销窗口。" }
    if op == "set_bill" { return "账目已记录，按参与人均摊，请在下方提案卡拍板。" }
    if op == "add_people" { return "已添加新成员，请在下方提案卡拍板。" }
    if op == "complete" { return "聚会圆满收官，已起草结案归档提案。" }
    if op == "draft_dunning" { return "已起草催款私信草稿，请在下方过目。" }
    if op == "mark_paid" { return "已登记付款标记，请在下方提案卡拍板。" }
    if op == "undo" { return "已执行紧急撤销提案，请在下方拍板生效。" }
    if op == "clear" { return "已起草清空提案，此操作需两段确认。" }
    if op == "export" { return "已生成日程卡片导出提案，请在下方拍板。" }
    return "为您起草了方案，请过目下方卡片并拍板执行。"
}

// === 灵动剪贴板探针（Clipboard Agentic Scout）===
fn str_has(s, sub){
    return ("" + s).split(sub).len() > 1
}

fn scout_inspect(text){
    let raw = ("" + text).trim()
    if raw == "" || raw == scout_last_seen { return }

    // 聚会意图关键词探测
    let is_party = false
    let kw = ["周", "聚会", "骑车", "羽毛球", "打球", "吃饭", "火锅", "奥森", "去吗", "约", "集合", "bike", "badminton", "party"]
    for k in kw {
        if str_has(raw, k) {
            is_party = true
        }
    }
    if !is_party { return }

    scout_raw_text = raw
    scout_summary = trim_n(raw, 26)
    scout_visible = "yes"
    render_views()
}

fn scout_adopt(){
    if scout_raw_text != "" {
        ui.msg_input.set_text(scout_raw_text)
        scout_last_seen = scout_raw_text
        scout_visible = "no"
        set_hint("已一键采纳剪贴板邀约，正在交由管家起草方案…")
        render_views()
        butler_send()
    }
}

fn scout_dismiss(){
    scout_last_seen = scout_raw_text
    scout_visible = "no"
    let _ = fs.write("scout_last.json", {last: scout_last_seen}.to_json())
    render_views()
}

// 模拟复制微信群聊消息，一键触发探针演示
fn scout_demo_trigger(){
    scout_inspect("周六下午奥森南门集合骑车，小明和小红都去！")
}

// 轮询剪贴板（宿主能力或沙箱通道）
fn scout_poll(){
    if host.has("qianxian.clipboard.read") {
        host.request("qianxian.clipboard.read", {}, fn(r){
            if r.is_ok {
                let txt = "" + r.data.text
                if txt != "" {
                    scout_inspect(txt)
                }
            }
        })
    } else if fs.exists("clipboard.txt") {
        let txt = "" + fs.read("clipboard.txt")
        if txt != "" {
            scout_inspect(txt)
        }
    }
}

// === 突发异动主动打扰与抢救预案（Proactive Crisis Resolver）===

fn sync_notification_capsule(){
    let title = "🛡 牵线 · 实时活动守护中"
    let body = guard_title
    if crisis_open == "yes" {
        title = "⛈️ 牵线 · 突发天气异变预警！"
        body = "【抢救预案待决断】#" + crisis_case_id + " " + crisis_activity + " 原定日程受暴雨阻碍，管家已拟好A/B顺延方案！"
    } else if cases.len() > 0 {
        body = "" + cases.len() + " 条聚会守护中 · " + guard_chips_text
    }
    let payload = {
        title: title,
        body: body,
        ongoing: true,
        crisis: crisis_open
    }
    let _ = fs.write("capsule-last.json", payload.to_json())
    if host.has("qianxian.notify") {
        host.request("qianxian.notify", payload, fn(r){})
    }
}

// 模拟触发恶劣天气突变打扰
fn crisis_demo_trigger(){
    let target_idx = -1
    let act = "骑车"
    let cid = "1"
    for ci in cases.len() {
        if target_idx < 0 {
            let st = "" + cases[ci]["status"]
            if st == "Confirmed" || st == "Proposing" {
                target_idx = ci
                cid = "" + cases[ci]["id"]
                act = "" + cases[ci]["activity"]
                if act == "" { act = "聚会活动" }
            }
        }
    }
    if target_idx < 0 {
        add_case("周六下午奥森骑车", "time_act", "ai")
        target_idx = 0
        cid = "" + cases[0]["id"]
        act = "骑车"
    }
    crisis_open = "yes"
    crisis_case_id = cid
    crisis_activity = act
    crisis_reason = "检测到 #" + cid + " · " + act + " 活动日（周六15:00）暴雨黄色预警（降水概率85%+伴随强阵风），原定室外活动受阻。"
    crisis_opt_a_text = "【方案A】顺延至周日同一时间（周日多云22℃ 适宜户外）"
    crisis_opt_b_text = "【方案B】转为室内替代方案（奥森南门室内羽毛球馆）"

    chat_role.push("ai")
    chat_text.push("⚠️【突发异动主动打扰】监测到 #" + cid + " · " + act + " 活动时段出现暴雨红色预警，户外安全风险极高！管家已为您生成抢救预案（方案A顺延 / 方案B转室内），请尽快决策。")

    audit("crisis_triggered", "#" + cid + " " + act + " 天气异变预警")
    rebuild_lines()
    render_views()
    set_hint("⛈️ 突发异变打扰已激活：已生成针对 #" + cid + " 的管家抢救预案！")
    sync_notification_capsule()
}

// 采纳方案 A：顺延至周日同一时间
fn crisis_adopt_a(){
    if crisis_case_id != "" {
        set_slot(crisis_case_id, "周日", "下午")
    }
    crisis_open = "no"
    chat_role.push("ai")
    chat_text.push("✅【管家抢救广播】已执行方案A：已将 #" + crisis_case_id + " · " + crisis_activity + " 顺延至周日下午（周日多云22℃），ICS日历回执已重新同步，危机成功抢救！")
    audit("crisis_adopt_a", "#" + crisis_case_id + " 顺延至周日")
    rebuild_lines()
    render_views()
    set_hint("🎉 方案A已生效：活动已顺延至周日同一时间，警报解除！")
    sync_notification_capsule()
}

// 采纳方案 B：转为室内活动
fn crisis_adopt_b(){
    let cid_num = crisis_case_id.to_f64()
    for ci in cases.len() {
        if ("" + cases[ci]["id"]).to_f64() == cid_num {
            cases[ci]["activity"] = "室内羽毛球"
            cases[ci]["place"] = "奥森室内羽毛球馆"
            cases[ci]["text"] = "周六下午奥森室内羽毛球馆聚会"
        }
    }
    crisis_open = "no"
    chat_role.push("ai")
    chat_text.push("✅【管家抢救广播】已执行方案B：已将 #" + crisis_case_id + " 转为室内羽毛球活动，避开室外降雨，场地预订提醒已派发，危机成功抢救！")
    audit("crisis_adopt_b", "#" + crisis_case_id + " 转为室内羽毛球")
    save()
    rebuild_lines()
    render_views()
    set_hint("🎉 方案B已生效：活动已转为室内羽毛球方案，警报解除！")
    sync_notification_capsule()
}

// 暂不处理
fn crisis_dismiss(){
    crisis_open = "no"
    set_hint("已暂缓抢救预案卡片展示（可通过守护灯随时重新唤起）")
    rebuild_lines()
    render_views()
    sync_notification_capsule()
}

