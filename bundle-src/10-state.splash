// 状态色：行首徽章文字色与底色（Proposing 灰 / Confirmed 绿 / Cancelled 红）
// 注：颜色必须是颜色字面量（#x…），不能返回字符串——draw_bg.color 期望 Vec4f
fn status_badge_bg(st){
    if st == "Confirmed" { return #xe8f3ec }
    if st == "Cancelled" { return #xf6e8e3 }
    return #xf1ece4  // Proposing / 兜底灰
}
fn status_badge_fg(st){
    if st == "Confirmed" { return #x2f7d4f }
    if st == "Cancelled" { return #xa14d3c }
    return #x6e675e  // Proposing / 兜底灰
}
fn status_badge_text(st){
    if st == "Confirmed" { return "已确认" }
    if st == "Completed" { return "已完成" }
    if st == "Cancelled" { return "已取消" }
    if st == "Proposing" { return "待拍板" }
    return "" + st
}
fn status_bar_color(st){
    if st == "Confirmed" { return #x2f7d4f }
    if st == "Cancelled" { return #xa14d3c }
    return #xc9bfb2  // Proposing / 兜底
}

