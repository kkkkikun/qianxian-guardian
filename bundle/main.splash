// === v0.10.2：hint 空文时隐藏（实测：空 Label 仍占 20px 行高幻影，破坏 HTML 紧凑节奏）===
//   set_hint 是唯一入口：非空才可见。Label 是叶子控件，set_visible 对叶子可靠
//   （#48b 的 set_visible 不可靠教训针对的是复合 View 容器）。
fn set_hint(t){
    ui.hint.set_text(t)
    if t == "" { ui.hint.set_visible(false) } else { ui.hint.set_visible(true) }
}
fn audit(action, detail){
    let t = local_time()
    let ts = ("" + t.year) + "-" + pad2(t.month) + "-" + pad2(t.day) + "T" + pad2(t.hour) + ":" + pad2(t.minute) + ":" + pad2(t.second) + "Z+8"
    audit_log.push(ts + " | " + last_actor + " | " + action + " | " + ("" + detail))
    // v0.10.0 WP5：审计链持久化（结案报告时间线 + Evidence Pack 重启后仍可用）。
    //   截尾 200 防文件无界增长；best-effort（写失败不打断动作本身，下条会自然重写）。
    while audit_log.len() > 200 { audit_log.pop() }
    fs.write("audit.json", {audit: audit_log}.to_json())
}

// === #30 新增：AA 收账均摊（参考 evidence/probe30-float-paradigm.md 真机范式） ===
// 总额存原样字符串，展示前再 to_f64；人数复用 people 字段逗号计数。
//   0/负数/空/垃圾 → 由 bill_display 的 total_f > 0 正向守卫统一兜底为「未记账」。
//   不用 \n 换行（手册 B5）；不用嵌套数组（手册 C2/陷阱 A）。
fn cut2(x){
    let s = "" + x
    let cs = s.to_chars()
    let n = cs.len()
    let dot = -1
    for i in n {
        if cs[i] == 46 { dot = i }
    }
    let take = n
    if dot >= 0 {
        take = dot + 3
        if take > n { take = n }
    }
    let out = ""
    for i in take {
        if cs[i] == 46 { out = out + "." } else { out = out + ("" + (cs[i] - 48)) }
    }
    if dot < 0 { out = out + ".00" }
    if dot >= 0 {
        if (n - dot) == 2 { out = out + "0" }
    }
    return out
}
fn bill_display(total_str, n_f){
    let bt = "" + total_str
    let total_f = bt.to_f64()
    let out = "未记账"
    if total_f > 0 {
        if n_f > 0 {
            out = "约 ¥" + cut2(total_f / n_f) + "/人"
        }
    }
    return out
}
fn count_people(people_str){
    let s = "" + people_str
    let n = 0
    if s == "" { return 0 }
    for nm in s.split(",") {
        if nm.trim() != "" { n = n + 1 }
    }
    return n
}

