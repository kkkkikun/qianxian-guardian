let guard_chip_text = []
let guard_chip_kind = []
let guard_title = "守护中"
let guard_chips_text = ""
let case_stage = []          // 生命周期阶段：-1=已取消（不画线）0=待拍板 1=已确认 2=已完成未收尾 3=已收尾
let case_bill_cleared = []   // 每条守护的 bill_cleared（chips「待收尾」与红线收尾段用）
let case_conflict_with = []  // v0.9.0 WP2：冲突横幅紧凑文案「与 #N·活动」（闭包只读）
let case_conflict_other = [] // v0.10.1：冲突对方「#N·活动」单独扁平化——横幅按 HTML 分段（加粗对方）
// ═══ 部件 2/16：rebuild_lines：cases → 扁平数组投影（on_render 只读这些，硬约束 #4/#5）
// ═══ 源文件 bundle-src/20-rebuild.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
fn rebuild_lines(){
    // === #10/#12 新增：筛选下标数组 + 计数串在这里重建（filter 逻辑放函数上下文，不进 on_render） ===
    // #12 叠加：先用 current_filter 过一遍得到「标签总数 M」与候选 idxs；
    //   再用 current_query（search(p)>=0，命中 activity/place/text 子串）
    //   在候选里二次过滤，最终 push 进 filtered_idxs 的就是"标签+搜索"两层之后的命中数 N。
    //   显示文案"共 N / M 条"：N=filter_count_str，M=matched_total_str（不含搜索词）。
    filtered_idxs.clear()
    let cf = "" + current_filter
    let q = "" + current_query
    let label_matched = 0
    let view_idxs = []
    for i in cases.len() {
        let st = "" + cases[i]["status"]
        let keep = false
        if cf == "all" { keep = true }
        else if cf == "Proposing" && st == "Proposing" { keep = true }
        else if cf == "Confirmed" && st == "Confirmed" { keep = true }
        else if cf == "Completed" && st == "Completed" { keep = true }
        else if cf == "Cancelled" && st == "Cancelled" { keep = true }
        if keep {
            view_idxs.push(i)
            label_matched = label_matched + 1
        }
    }
    matched_total_str = "" + label_matched
    filter_total_str = "" + label_matched
    // 第二层：搜索词叠加（在标签候选内命中 activity / place / 原文子串）
    let n = 0
    if q == "" {
        // 搜索词为空：最新在前（HTML .frame-grid 卡片降序——#3 最新在上）；
        //   id 大=新建，倒序遍历 view_idxs。
        for i in view_idxs.len() {
            filtered_idxs.push(view_idxs[view_idxs.len() - 1 - i])
        }
        n = view_idxs.len()
    } else {
        // 搜索分支同样最新在前（与空搜索同源：倒序）
        for i in view_idxs.len() {
            let j = view_idxs[view_idxs.len() - 1 - i]
            let act = "" + cases[j]["activity"]
            let pl = "" + cases[j]["place"]
            let txt = "" + cases[j]["text"]
            let hit = (act.search(q) >= 0) || (pl.search(q) >= 0) || (txt.search(q) >= 0)
            if hit {
                filtered_idxs.push(j)
                n = n + 1
            }
        }
    }
    // === v0.8.0 W4（调研报告 P1）：守护灯常驻条——主动信息的固定入口 ===
    //   灵动岛同款「家」：全部待办一眼可见，防 Google Now 式「主动卡片没有家而消亡」。
    //   全部确定性推导（与徽章/筛选同源语义），零 AI 参与；异常缺失时明说「无异常」。
    let light_proposing = 0
    let light_conflict = 0
    let light_tailing = 0
    for li2 in cases.len() {
        let st2 = "" + cases[li2]["status"]
        if st2 == "Proposing" { light_proposing = light_proposing + 1 }
        if ("" + cases[li2]["conflict"]) == "yes" && st2 != "Cancelled" && st2 != "Completed" { light_conflict = light_conflict + 1 }
        if (st2 == "Confirmed" || st2 == "Completed") && ("" + cases[li2]["bill_total"]) != "" && ("" + cases[li2]["bill_cleared"]) != "yes" {
            light_tailing = light_tailing + 1
        }
    }
    // v0.10.1 WP3：计数同时落全局（glance 速览卡的数据源——与守护灯 chips 同一处推导）
    guard_n_propose = light_proposing
    guard_n_conflict = light_conflict
    guard_n_tail = light_tailing
    guard_light = "🛡 守护中 · 共 " + ("" + cases.len()) + " 条守护"
    if light_proposing > 0 { guard_light = guard_light + " · " + ("" + light_proposing) + " 待拍板" }
    if light_conflict > 0 { guard_light = guard_light + " · ⚡" + ("" + light_conflict) + " 冲突" }
    if light_tailing > 0 { guard_light = guard_light + " · " + ("" + light_tailing) + " 待收尾" }
    if light_proposing == 0 && light_conflict == 0 && light_tailing == 0 {
        guard_light = guard_light + " · 无异常"
    }
    // v0.10.2 WP1：成员端投票状态随每次重建刷新（伴生进程写文件 → UI 即见）
    load_member_vote()
    // === v0.9.0 WP2：守护灯 chips（标题行 + 分色计数 chips，HTML 规范 01 屏） ===
    guard_chip_text.clear()
    guard_chip_kind.clear()
    if crisis_open == "yes" {
        guard_title = "⛈️ 突发异变打扰 · 抢救中"
        guard_chip_text.push("1 危机需抢救")
        guard_chip_kind.push("danger")
    } else {
        guard_title = "守护中 · 共 " + ("" + cases.len()) + " 条"
    }
    if light_proposing > 0 {
        guard_chip_text.push("" + ("" + light_proposing) + " 待拍板")
        guard_chip_kind.push("neutral")
    }
    if light_conflict > 0 {
        guard_chip_text.push("⚡ " + ("" + light_conflict) + " 冲突")
        guard_chip_kind.push("amber")
    }
    if light_tailing > 0 {
        guard_chip_text.push("" + ("" + light_tailing) + " 待收尾")
        guard_chip_kind.push("amber")
    }
    if light_proposing == 0 && light_conflict == 0 && light_tailing == 0 && crisis_open != "yes" {
        guard_chip_text.push("无异常")
        guard_chip_kind.push("jade")
    }
    filter_count_str = "" + n
    case_ids.clear()
    case_lines.clear()
    case_text_lines.clear()
    case_statuses.clear()
    case_selected.clear()
    case_badge_text.clear()
    case_stage.clear()
    case_bill_cleared.clear()
    case_receipt.clear()
    case_place_lines.clear()
    case_activity_lines.clear()
    case_place_full.clear()
    case_status_text.clear()
    case_slot_day.clear()
    case_slot_part.clear()
    case_conflict.clear()
    case_people_line.clear()
    case_conflict_lines.clear()
    case_conflict_party.clear()
    case_conflict_with.clear()
    case_conflict_other.clear()
    case_bill_total_str.clear()
    case_bill_split_text.clear()
    // 同步 case_expanded：保留已展开态，遇 selected_id 变更时不强制清空
    // （点同一张卡：折叠；点别的卡：保留各自展开态，保留用户的"展开阅读"行为）
    for i in cases.len() {
        let id_str = "" + cases[i]["id"]
        case_ids.push(id_str)
        let sel = "no"
        if cases[i]["id"] == selected_id { sel = "yes" }
        case_selected.push(sel)
        let st = "" + cases[i]["status"]
        case_statuses.push(st)
        // === #18 新增：冲突时把「·冲突」追加到徽章文字（折叠态色点已让位给 status_bar_color，不再用红色点表冲突） ===
        let badge_t = status_badge_text(st)
        let cf_lab0 = "" + cases[i]["conflict"]
        if cf_lab0 == "yes" { badge_t = badge_t + "·冲突" }
        // S4：AA 记了账没收齐 → 待收尾徽章（活动全生命周期到收尾）
        if (st == "Confirmed" || st == "Completed") && ("" + cases[i]["bill_total"]) != "" && ("" + cases[i]["bill_cleared"]) != "yes" {
            badge_t = badge_t + "·待收尾"
        }
        case_badge_text.push(badge_t)
        // === v0.9.0 WP2：红线生命周期阶段 + bill_cleared 扁平化 ===
        case_bill_cleared.push("" + cases[i]["bill_cleared"])
        let stg = 0
        if st == "Confirmed" { stg = 1 }
        if st == "Completed" { stg = 2 }
        if st == "Completed" && ("" + cases[i]["bill_cleared"]) == "yes" { stg = 3 }
        if st == "Cancelled" { stg = -1 }
        case_stage.push(stg)
        let title_act = "" + cases[i]["activity"]
        if title_act == "" { title_act = "聚会" }
        case_lines.push("#" + id_str + " · " + title_act)
        case_text_lines.push("" + cases[i]["text"])

        // === #9 新增：扁平活动/地点/状态中文（供卡片内联展开块读） ===
        let act = "" + cases[i]["activity"]
        if act == "" { act = "（未抽取到）" }
        case_activity_lines.push(act)
        let pl = "" + cases[i]["place"]
        if pl == "" { pl = "（未抽取到）" }
        case_place_full.push(pl)
        case_status_text.push(status_badge_text(st))
        let ppl = "" + cases[i]["people"]
        if ppl == "" { ppl = "未填写" }
        case_people_line.push(ppl)

        // === #30 新增：AA 均摊两列（扁平字符串，on_render 只读） ===
        let bt = "" + cases[i]["bill_total"]
        case_bill_total_str.push(bt)
        // #30b 外环修：splash 无三目运算符（真机 rebuild_lines 全 trap: unknown named arg），
        //   改单层 if 归一化（C9 边界内：循环内单层 if 赋值已实证安全，探针 v8 P4/P5）。
        let ppl_arg = ppl
        if ppl == "未填写" { ppl_arg = "" }
        let np_count = count_people(ppl_arg)
        case_bill_split_text.push(bill_display(bt, np_count))

        // === #17b 新增：扁平「星期几 / 时段 / 冲突标记」三字段（供 on_render 只读） ===
        // 对象字段访问在闭包里不稳，硬约束 #4/#5；预置到 push 字面量 + 重建时落到扁平数组。
        let sd = "" + cases[i]["slot_day"]
        let sp = "" + cases[i]["slot_part"]
        let cf_lab = "" + cases[i]["conflict"]
        case_slot_day.push(sd)
        case_slot_part.push(sp)
        case_conflict.push(cf_lab)
        // 冲突卡内容：双方拼成单个字符串（陷阱 A：不要嵌套数组）。
        // 没有冲突时留空数组（on_render 不渲染）。
        if cf_lab == "yes" {
            let slot_label = sd + "-" + sp
            let other_id = ""
            let other_slot = ""
            let other_act = ""
            // 在 cases 里找出冲突的对方（非 Cancelled 且同 slot），用 i_outer 避免内层 j 复用陷阱
            for ci in cases.len() {
                if ci == i { continue }
                if cases[ci]["status"] == "Cancelled" { continue }
                let osd = "" + cases[ci]["slot_day"]
                let osp = "" + cases[ci]["slot_part"]
                if osd == "" || osp == "" { continue }
                if osd == sd && osp == sp {
                    other_id = "" + cases[ci]["id"]
                    other_slot = osd + "-" + osp
                    other_act = "" + cases[ci]["activity"]
                    if other_act == "" { other_act = "（未抽取到）" }
                    break
                }
            }
            // 冲突卡：两行拼成**单个字符串**（陷阱 A：数组不可嵌套；
            // 陷阱 D：\n 在 Label 里不换行，故渲染端用两个 Label 拆开显示）。
            let head = "⚠ 时间冲突：#" + id_str + " · " + act + " 也占「" + slot_label + "」时段"
            let party = "要改期还是取消？冲突双方：#" + id_str + " · " + act + " · " + slot_label
            if other_id != "" {
                // #17b 外环修：原来错用 cases[i]（自己），应为冲突对方 cases[ci]
                party = party + "  ｜ #" + other_id + " · " + other_act + " · " + other_slot
            }
            case_conflict_lines.push(head)
            case_conflict_party.push(party)
            // v0.9.0 WP2：横幅紧凑版（「与 #N·活动 同占「周六-上午」」）
            let with2 = "另一条守护"
            if other_id != "" {
                with2 = "与 #" + other_id + "·" + other_act
            }
            case_conflict_with.push(with2 + " 同占「" + slot_label + "」")
            // v0.10.1：对方单独存（横幅分段加粗用；找不到对方时留空，渲染端回退单 Label）
            if other_id != "" {
                case_conflict_other.push("#" + other_id + "·" + other_act)
            } else {
                case_conflict_other.push("")
            }
        } else {
            case_conflict_lines.push("")
            case_conflict_party.push("")
            case_conflict_with.push("")
            case_conflict_other.push("")
        }

        // === #9 新增：保持现有 case_expanded 长度与 cases 同步 ===
        if i >= case_expanded.len() {
            case_expanded.push("no")
        }
        // 已存在的展开态保持不动（用户切别的卡不强制收拢）

        // === #8 保留：place 给收起态 placeholder 用 ===
        let place_disp = "" + cases[i]["place"]
        if place_disp == "" { place_disp = "（未抽取到）" }
        case_place_lines.push(place_disp)

        // === #8 保留：Confirmed 才填回执四行（首次进入时快照，幂等） ===
        if st == "Confirmed" {
            if cases[i]["receipt_done"] != "yes" {
                cases[i]["receipt_activity"] = "" + cases[i]["activity"]
                cases[i]["receipt_place"] = "" + cases[i]["place"]
                cases[i]["receipt_text"] = "" + cases[i]["text"]
                cases[i]["receipt_done"] = "yes"
            }
            let ra = "" + cases[i]["receipt_activity"]
            let rp = "" + cases[i]["receipt_place"]
            let rt = "" + cases[i]["receipt_text"]
            let arr = []
            // === #43 D 切片：按 receipt_style 渲染行（快照语义不变——ra/rp/rt 仍固定，
            //   风格只影响**渲染行**；切换风格立即 rebuild_lines，已有守护即按新风格重排）
            if receipt_style == "brief" {
                // 简短：合并活动+地点为一行 + 提醒行（地点为空时合并行只留活动）
                if rp != "" {
                    arr.push("活动：" + ra + " ｜ 地点：" + rp)
                } else {
                    arr.push("活动：" + ra)
                }
                arr.push("T-24h 提醒：已登记（伴生服务投递）")
            } else if receipt_style == "emoji" {
                // 带 emoji：4 行各加前缀（与现状✨/⚠前缀一致——emoji 不增不减）
                arr.push("📌 活动：" + ra)
                arr.push("📍 地点：" + rp)
                arr.push("💬 原文：" + rt)
                arr.push("⏰ T-24h 提醒：已登记（伴生服务投递）")
            } else {
                // standard（默认兜底；任何 receipt_style 非合法值都走这里）
                arr.push("活动：" + ra)
                arr.push("地点：" + rp)
                arr.push("原文：" + rt)
                arr.push("T-24h 提醒：已登记（伴生服务投递）")
            }
            case_receipt.push(arr)
        } else {
            case_receipt.push([])
        }
    }
    // 多余的展开态条目截断（cases 缩短时）
    while case_expanded.len() > cases.len() {
        case_expanded.pop()
    }
    // #31f：详情面板已并入 case_list on_render（ui_mode 分支，随 render 自动刷新），
    //   不再需要命令式 update_detail_panel（其 set_text 依赖树外静态区，已证不可靠）。
    // v0.6.0：选中守护的确定性对账（含 bill_cleared 自动推导）
    rebuild_selected_ledger()
    // v0.10.0 WP5：结案报告卡（完成+账清=已收尾）
    rebuild_fin_report()
    // v0.10.0：根区守护灯命令式更新（照 hint 范式 set_text）
    // v0.10.0：守护灯文本写全局（home_chrome 的 on_render 闭包每次 render 重建时
    //   读全局——无需命令式 set_text，控件不在树也不报错）
    guard_chips_text = ""
    for gi in guard_chip_text.len() {
        if guard_chips_text != "" { guard_chips_text = guard_chips_text + "  " }
        guard_chips_text = guard_chips_text + guard_chip_text[gi]
    }
}

// ═══ 部件 3/16：持久化：load（损坏兜底）/ write_agent_brief / save（唯一落盘咽喉）
// ═══ 源文件 bundle-src/30-persist.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// #13：损坏兜底。cases.json 存在但内容不是预期结构（parse_json 失败 / v 为 nil /
//   cases 不是数组 / seq 不是数字），不覆盖现有数据，而是把坏文件改名为
//   cases.corrupt-<n>.json（<n> 用文件里的 seq；seq 不是数字时用固定名
//   cases.corrupt.json，允许覆盖上一次的备份），然后以空状态启动并在 hint 明示。
//   绝不 silently 丢掉用户数据——数据是本应用唯一资产。
fn load(){
    let hint = "已载入 " + "" + cases.len() + " 个聚会守护"
    let hint_suffix = ""
    if fs.exists("cases.json") {
        let raw = fs.read("cases.json")
        let v = raw.parse_json()
        let bad = (v == nil)
        let parsed_cases = []
        let parsed_seq = 0
        let seq_is_num = false
        if !bad {
            // 校验 v["cases"] 是数组、v["seq"] 是数字；任何一个不达标即视为损坏
            let raw_cases = v["cases"]
            let raw_seq = v["seq"]
            if raw_cases != nil {
                // 数组的真值特征：可取 .len()。非数组对象/字符串/数字在这里调用
                // .len() 在 Splash 不会报错，会返回不预期的值；改用 "长度 > 0 且
                // 第一项是字典" 这种保守判定（cases 至少有一个对象）。
                if raw_cases.len() > 0 {
                    let first = raw_cases[0]
                    if first != nil {
                        parsed_cases = raw_cases
                    }
                } else if raw_cases.len() == 0 {
                    // 空数组是合法状态（用户清空了），接纳
                    parsed_cases = raw_cases
                }
                // 注意：raw_cases.len() 对非数组可能不抛错，但后续 rebuild_lines
                // 会读到一致行为；如果 parsed_cases 保持 []，后面 bad 会被翻成 true
            }
            if raw_seq != nil {
                // 数字判定：加 0 后与原值一致；否则把 seq_is_num 留 false
                let as_num = raw_seq + 0
                if "" + as_num == "" + raw_seq {
                    seq_is_num = true
                    parsed_seq = as_num
                }
            }
            // 校验通过的条件：raw_cases != nil 且 raw_seq != nil 且 seq_is_num
            // parsed_cases 已经接受了空数组；非数组场景下 parsed_cases 仍为 []
            // 但 cases.len()=0 会让重建前后一致，行为也可接受——为安全起见，
            // 仍然以「cases 是数组且 seq 是数字」双门控判定损坏。
            if raw_cases == nil || !seq_is_num {
                bad = true
            }
        }
        if bad {
            // 备份坏文件：<n> 优先用文件里的 seq（即使非数字也允许为字串后缀），
            // 不可得时用固定名 cases.corrupt.json（覆盖上一次备份）
            let backup_name = "cases.corrupt.json"
            if raw_seq != nil {
                backup_name = "cases.corrupt-" + "" + raw_seq + ".json"
            }
            // 注：Splash 的 fs 无 rename（只有 exists/read/read_bytes/write/
            // append/list/mkdir/remove，见 SCRIPT-API §Storage）。改用
            // 「把原文写进备份文件」实现等效效果：不删原文件，内容不丢。
            let original_text = fs.read("cases.json")
            let _ = fs.write(backup_name, original_text)
            // 内存回到空态：cases=[], seq=0
            cases = []
            seq = 0
            hint = "发现损坏的守护数据，已备份为 " + backup_name + " 并重新开始"
            hint_suffix = ""
        } else {
            // 校验通过：正常载入
            cases = parsed_cases
            seq = parsed_seq
            hint = "已载入 " + "" + cases.len() + " 个聚会守护"
            // #13 第 4 条：列表较长时提示用筛选/搜索
            if cases.len() > 20 {
                hint_suffix = "，列表较长，建议用筛选或搜索"
            }
        }
    } else {
        // 首次启动：无文件，按空态走
        if cases.len() > 20 {
            hint_suffix = "，列表较长，建议用筛选或搜索"
        }
    }
    // #43：载入 pref.json（与 cases.json 同一 fs.read/parse_json 范式）。
    // 内容 {"receipt_style": "standard|brief|emoji"}；文件不存在 / parse 失败 /
    // 字段非法一律回落到 "standard"，**不报错不归档**——preference 损坏不影响
    // 用户的聚会数据（与 cases 损坏的"备份改名"语义不同，preference 是偏好不是资产）。
    // 字段校验：仅三档合法（"standard"/"brief"/"emoji"），其他值按兜底走。
    if fs.exists("pref.json") {
        let praw = fs.read("pref.json")
        let pv = praw.parse_json()
        let pbad = (pv == nil)
        if !pbad {
            let prs = pv["receipt_style"]
            if prs != nil {
                let prs_str = "" + prs
                if prs_str == "standard" || prs_str == "brief" || prs_str == "emoji" {
                    receipt_style = prs_str
                }
                // 其他值（含空串）走兜底：receipt_style 保持 "standard"
            }
        }
        // pv == nil 或 prs == nil：同样兜底，不报错
    }
    // v0.10.2 WP1：成员端投票状态读回（member-vote.json；伴生进程写入）
    load_member_vote()
    // v0.10.2：AI 通道死亡闩锁读回（ai_state.json {"dead":"yes"}；缺失/损坏=通道未知，按活处理）
    if fs.exists("ai_state.json") {
        let araw = fs.read("ai_state.json")
        let av = araw.parse_json()
        if av != nil {
            if ("" + av["dead"]) == "yes" { ai_dead = "yes" }
        }
    }
    // #48b：detail_list 初始隐藏（命令式，声明里写 visible:false 会被 render() 的
    //   声明 re-apply 覆盖回去——见 detail_list 声明处注释）
    ui.detail_list.set_visible(false)
    // v0.10.2：hint 初始为空 → 启动即隐藏（空 Label 也占 20px 行高幻影，实测）
    ui.hint.set_visible(false)
    // v0.6.0：读 payments.json（按人收款，独立文件）
    // v0.8.0 修真实 bug：这里原写成 to_json()（字符串→json 字符串），payments 字段
    //   取不到 → 重启后收款记录静默丢失、对账归零。与 cases.json 同款 parse_json。
    if fs.exists("payments.json") {
        let praw = fs.read("payments.json")
        let pdata = praw.parse_json()
        if pdata != nil && pdata.payments != nil {
            for pi in pdata.payments.len() {
                pay_case.push("" + pdata.payments[pi])
                pay_person.push("" + pdata.persons[pi])
                pay_amount.push("" + pdata.amounts[pi])
            }
        }
    }
    // v0.10.0 WP5：读 audit.json（审计链持久化；parse 失败→空，不报错不归档）
    if fs.exists("audit.json") {
        let araw = fs.read("audit.json")
        let av = araw.parse_json()
        if av != nil && av.audit != nil {
            audit_log = []
            for ei in av.audit.len() {
                audit_log.push("" + av.audit[ei])
            }
        }
    }
    // S3：chat_list 同款初始隐藏 + 管家欢迎语（仅首次，重启不重复）
    ui.chat_list.set_visible(false)
    // UI 改版：状态三键初始隐藏（列表模式下无目标语境；进详情时命令式显示）
    ui.action_row.set_visible(false)
    if chat_text.len() == 0 {
        chat_role.push("sys")
        chat_text.push("把群消息丢给管家：我来分诊、查冲突、出提案，你只管拍板。（无 AI 服务时自动降级本地规则）")
    }
    // #44 外环修：根组件按钮文案在首次求值已定型（当时 receipt_style 还是 "standard"），
    //   load() 此刻读回的偏好不会反映到标签——重启后按钮显示「标准」实际却是 emoji 档
    //   （首次点击才自愈）。照 ui.hint.set_text 同范式命令式同步。
    ui.style_btn.set_text("风格：" + style_label_for(receipt_style))
    // #46 A切片：根组件 ai_cap_label 首次定型为静态 placeholder，
    //   load() 末尾用 probe_ai_cap() 命令式同步真实 host 探测文案（照 #44 范式）。
    ui.ai_cap_label.set_text(probe_ai_cap())
    // 灵动剪贴板探针：读回已忽略记录并探测剪贴板
    if fs.exists("scout_last.json") {
        let sraw = fs.read("scout_last.json")
        let sv = sraw.parse_json()
        if sv != nil && sv["last"] != nil {
            scout_last_seen = "" + sv["last"]
        }
    }
    scout_poll()
    start_scout_watchdog()
    rebuild_lines()
    render_views()
    // v0.10.0：载入完成不写 hint（静默——守护灯卡已显示「共 N 条」，无需重复）
    if hint_suffix != "" {
        set_hint(hint_suffix)
    }
}

// #13：写入失败可见。fs.write 在出错时返回错误值（非 nil/非 true），save() 把这个
//   信号向上层返回：调用点根据返回值决定是否覆盖"成功"提示为失败提示，避免 silently
//   告诉用户「已保存」但实际没落盘——同样是不丢用户数据的兜底。
// 用**字符串标记**返回成败，不用布尔：#13 外环复验发现该 runtime 下
// 函数返回的 true/false 在调用点 `ok == false` 比较中不可靠（写入明明成功
// 却走进失败分支）。字符串比较已在多处验证可靠。
let save_result = "ok"
let brief_save_result = "ok"   // #45：agent-brief.json 落盘结果（独立标记，best-effort）
// #45 C 切片：agent 自适应提示——agent 优先读 agent-brief.json（紧凑摘要，省上下文）。
//   字段全部 "" + x 字符串化，与 cases.json 字段一一对应；status 保留以便 agent
//   区分 Confirmed / Proposing。**best-effort**：brief_save_result 失败只扁平落全局
//   字符串（照 save_result 范式），不打 hint、不影响 cases.json 保存语义——
//   brief 是辅助件，cases.json 才是事实源；与"错误不静默编造"不冲突（不编造、
//   只是辅助件降级，下次 save() 会自然重写）。
fn write_agent_brief(){
    let rows = []
    for i in cases.len() {
        let row = {
            id: "" + cases[i]["id"],
            activity: "" + cases[i]["activity"],
            slot_day: "" + cases[i]["slot_day"],
            slot_part: "" + cases[i]["slot_part"],
            place: "" + cases[i]["place"],
            status: "" + cases[i]["status"]
        }
        rows.push(row)
    }
    let payload = {seq: seq, cases: rows}.to_json()
    let br = fs.write("agent-brief.json", payload)
    if br == nil { brief_save_result = "ok" }
    else {
        let bm = "" + br
        if bm == "" { brief_save_result = "ok" } else { brief_save_result = "fail" }
    }
    // === 决赛 S2：宿主 agent 的 files.* 只读 accounts/<hash>/（默认 accounts/device/），
    //   官方模式是 app 把给 agent 看的数据写到该子目录（AI-SERVICES email-action 范式）。
    //   同一份 brief 双写到 accounts/device/ ——失败 best-effort（目录可能不被 jail 自动创建），
    //   不改根下副本（根副本供调试/直接查看）。AGENT.md v3 指面板 agent 优先读 accounts/device/。
    fs.write("accounts/device/agent-brief.json", payload)
}
fn save(){
    let r = fs.write("cases.json", {cases: cases, seq: seq}.to_json())
    // SCRIPT-API §Storage：fs.write 成功返回 nil；失败返回一个错误值。
    if r == nil { save_result = "ok" }
    else {
        let msg = "" + r
        if msg == "" { save_result = "ok" } else { save_result = "fail" }
    }
    // #45：save() 是唯一落盘咽喉——建卡/改期/取消/AA/清空全部路径都过这里，
    //   因此在 save() 末尾同步刷一份 agent-brief.json，agent 就能拿到最新状态。
    //   brief 是辅助件（cases.json 才是事实源），失败不阻断、不打 hint。
    write_agent_brief()
}


// v0.10.2 WP1：member-vote.json → 扁平显示串（load 与 rebuild_lines 双调用，
//   伴生进程写新票后 UI 滚动即刷新；缺失/损坏 → 隐藏横幅，不报错不归档）
fn load_member_vote(){
    if !fs.exists("member-vote.json") { return }
    let mraw = fs.read("member-vote.json")
    let mv = mraw.parse_json()
    if mv == nil { return }
    let mletter = "" + mv["letter"]
    if mletter == "" { return }
    member_vote_flag = "yes"
    let mauto = "管家替你投了"
    if ("" + mv["auto"]) == "False" || ("" + mv["auto"]) == "false" { mauto = "你手动改投了" }
    member_vote_text = mauto + "「" + mletter + "」（" + ("" + mv["slot"]) + "）——" + ("" + mv["reason"])
}
// ═══ 部件 4/16：条目编辑：target_id / add_person / update_bill_total / cycle_slot / clear_cancel_pending
// ═══ 源文件 bundle-src/40-case-edits.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// 解析"作用目标"：选中优先，否则最新一条并明示
fn target_id(){
    if selected_id > 0 {
        for i in cases.len() {
            if cases[i]["id"] == selected_id { return {id: selected_id, fallback: false} }
        }
        // 选中 id 已被删除/不存在：降级到最新一条
    }
    if cases.len() > 0 { return {id: cases[cases.len() - 1]["id"], fallback: true} }
    return {id: 0, fallback: true}
}

// === #8 保留：清除取消二次确认态（任何非「取消」按钮/动作都放弃确认） ===
// === #23：追加参与人（逗号分隔，上限 10 人） ===
//   C4 重建数组 / C6 闭包用 selected_id / C7 字符串标记
let people_save_result = "ok"
fn add_person(id_str, raw){
    if id_str == "" || id_str == "0" {
        set_hint("先选中一条守护再添加参与人")
        return
    }
    let name = "" + raw
    name = name.trim()
    if name == "" {
        set_hint("请先输入姓名（多个用逗号分隔）")
        return
    }
    let cur = -1
    for pi in cases.len() {
        if "" + cases[pi]["id"] == id_str { cur = pi }
    }
    if cur < 0 {
        set_hint("找不到 #" + id_str + "，请重新选中")
        return
    }
    let old = "" + cases[cur]["people"]
    // v0.9.0 WP1：分隔符归一（、，;；→ 逗号）——与 plan_parse 同源，防中文名单断裂
    let name2 = norm_people_list("" + name)
    let added = []
    for nm in name2.split(",") {
        let one = nm.trim()
        if one != "" { added.push(one) }
    }
    if added.len() == 0 {
        set_hint("没解析到有效姓名（多个请用逗号分隔）")
        return
    }
    // 上限 10 人（手册纪律：先检查再写）
    let total = 0
    if old != "" {
        for ex in old.split(",") { if ex.trim() != "" { total = total + 1 } }
    }
    if total + added.len() > 10 {
        set_hint("参与人已达上限 10 人，未添加")
        return
    }
    let merged = old
    for an in added {
        if merged == "" { merged = an } else { merged = merged + "," + an }
    }
// C4：重建数组（#38 修：必须保留 slot_init_asked，否则 add_person 会把
        //   首次点改时间的"再点一次才填"标记清掉，导致反复弹窗）
        let new_cases = []
        for qi in cases.len() {
            if qi == cur {
                new_cases.push({"id": cases[qi]["id"], "text": cases[qi]["text"],
                    "activity": cases[qi]["activity"], "place": cases[qi]["place"],
                    "status": cases[qi]["status"],
                    "slot_day": cases[qi]["slot_day"], "slot_part": cases[qi]["slot_part"],
                    "conflict": cases[qi]["conflict"], "people": merged,
                    "bill_total": cases[qi]["bill_total"],
                    "receipt_activity": cases[qi]["receipt_activity"],
                    "receipt_place": cases[qi]["receipt_place"],
                    "receipt_text": cases[qi]["receipt_text"],
                    "receipt_done": cases[qi]["receipt_done"],
                    "slot_init_asked": cases[qi]["slot_init_asked"], "bill_cleared": cases[qi]["bill_cleared"]})
            } else {
                new_cases.push({"id": cases[qi]["id"], "text": cases[qi]["text"],
                    "activity": cases[qi]["activity"], "place": cases[qi]["place"],
                    "status": cases[qi]["status"],
                    "slot_day": cases[qi]["slot_day"], "slot_part": cases[qi]["slot_part"],
                    "conflict": cases[qi]["conflict"], "people": cases[qi]["people"],
                    "bill_total": cases[qi]["bill_total"],
                    "receipt_activity": cases[qi]["receipt_activity"],
                    "receipt_place": cases[qi]["receipt_place"],
                    "receipt_text": cases[qi]["receipt_text"],
                    "receipt_done": cases[qi]["receipt_done"],
                    "slot_init_asked": cases[qi]["slot_init_asked"], "bill_cleared": cases[qi]["bill_cleared"]})
            }
        }
    cases = new_cases
    rebuild_lines()
    // 决赛 S1：收口唯一落盘咽喉（原直写 fs.write 绕过 write_agent_brief，
    //   导致参与人变更后 agent 拿到的 brief 滞后一步）
    save()
    people_save_result = save_result
    render_views()
    people_draft = ""
    if people_save_result == "fail" {
        set_hint("已加 " + "" + added.len() + " 人（保存失败，仅在内存）")
    } else {
        set_hint("#" + id_str + " 参与人：" + merged)
    }
}

// === #30 新增：AA 收账总额（保存=原样写入 bill_total；展示由 bill_display 正向守卫兜底）
//   C4 重建数组 / C7 字符串标记 bill_save_result / 不在循环内嵌套 if 赋值（避 C9）
//   不做 trim 之外的格式校验——bill_display 的 total_f > 0 守卫天然处理空/0/负数/垃圾
fn update_bill_total(id_str, raw){
    if id_str == "" || id_str == "0" {
        set_hint("先选中一条守护再记 AA 总额")
        return
    }
    let trimmed = ("" + raw).trim()
    let cur = -1
    for bi in cases.len() {
        if "" + cases[bi]["id"] == id_str { cur = bi }
    }
    if cur < 0 {
        set_hint("找不到 #" + id_str + "，请重新选中")
        return
    }
// C4：重建数组（cur 分支写 trimmed，其余保留原 bill_total；#38 同 add_person 补 slot_init_asked）
        let new_cases = []
        for bi2 in cases.len() {
            if bi2 == cur {
                new_cases.push({"id": cases[bi2]["id"], "text": cases[bi2]["text"],
                    "activity": cases[bi2]["activity"], "place": cases[bi2]["place"],
                    "status": cases[bi2]["status"],
                    "slot_day": cases[bi2]["slot_day"], "slot_part": cases[bi2]["slot_part"],
                    "conflict": cases[bi2]["conflict"], "people": cases[bi2]["people"],
                    "bill_total": trimmed,
                    "receipt_activity": cases[bi2]["receipt_activity"],
                    "receipt_place": cases[bi2]["receipt_place"],
                    "receipt_text": cases[bi2]["receipt_text"],
                    "receipt_done": cases[bi2]["receipt_done"],
                    "slot_init_asked": cases[bi2]["slot_init_asked"], "bill_cleared": cases[bi2]["bill_cleared"]})
            } else {
                new_cases.push({"id": cases[bi2]["id"], "text": cases[bi2]["text"],
                    "activity": cases[bi2]["activity"], "place": cases[bi2]["place"],
                    "status": cases[bi2]["status"],
                    "slot_day": cases[bi2]["slot_day"], "slot_part": cases[bi2]["slot_part"],
                    "conflict": cases[bi2]["conflict"], "people": cases[bi2]["people"],
                    "bill_total": cases[bi2]["bill_total"],
                    "receipt_activity": cases[bi2]["receipt_activity"],
                    "receipt_place": cases[bi2]["receipt_place"],
                    "receipt_text": cases[bi2]["receipt_text"],
                    "receipt_done": cases[bi2]["receipt_done"],
                    "slot_init_asked": cases[bi2]["slot_init_asked"], "bill_cleared": cases[bi2]["bill_cleared"]})
            }
        }
    cases = new_cases
    rebuild_lines()
    // 决赛 S1：同 add_person，收口 save() 咽喉
    save()
    bill_save_result = save_result
    render_views()
    bill_draft = ""
    if bill_save_result == "fail" {
        set_hint("#" + id_str + " AA 总额已记（保存失败，仅在内存）")
    } else if trimmed == "" {
        set_hint("#" + id_str + " 已清空 AA 总额")
    } else {
        set_hint("#" + id_str + " AA 总额：" + trimmed)
    }
}

// === #22 重启：改时间（5 个常见槽位轮换） ===
//   手册约束：C4 对象字段动态赋值不可靠 → **重建整个 cases 数组**再整体替换；
//   C7 布尔返回不可靠 → 字符串标记；C6 闭包不捕获循环变量 → 用 selected_id。
let cycle_save_result = "ok"
fn cycle_slot(id_str){
    if id_str == "" || id_str == "0" {
        set_hint("先选中一条守护再改时间")
        return
    }
    let cur = -1
    for ci in cases.len() {
        if "" + cases[ci]["id"] == id_str { cur = ci }
    }
    if cur < 0 {
        set_hint("找不到 #" + id_str + "，请重新选中")
        return
    }
    if cases[cur]["status"] == "Cancelled" {
        set_hint("该守护已取消，改时间无效（#" + id_str + "）")
        return
    }
    // 5 个常见槽位序列（确定性，无日期计算——本 runtime 无时钟 API）
    let sd = "" + cases[cur]["slot_day"]
    let sp = "" + cases[cur]["slot_part"]
    // === #27：时段未抽取时不静默编造初值。
    //   sd/sp 任一为空 = 用户原话里没抽到时间点。如果直接走下面的轮换逻辑，
    //   会被强行写入"周六-上午"——这是替用户编造了一个时间。
    //   改为：第一次点只提示 + 翻 slot_init_asked="yes"（重建数组走 C4/C5），
    //   第二次点（sasked=="yes"）才真正写入；写入后顺手把标记归零（表示已接受）。
    let sasked = "" + cases[cur]["slot_init_asked"]
    if (sd == "" || sp == "") && sasked == "" {
        let new_cases_ask = []
        for ai in cases.len() {
            let mk = "" + cases[ai]["slot_init_asked"]
            if ai == cur { mk = "yes" }
            new_cases_ask.push({"id": cases[ai]["id"], "text": cases[ai]["text"],
                "activity": cases[ai]["activity"], "place": cases[ai]["place"],
                "status": cases[ai]["status"],
                "slot_day": cases[ai]["slot_day"], "slot_part": cases[ai]["slot_part"],
                "conflict": cases[ai]["conflict"], "people": cases[ai]["people"],
                "receipt_activity": cases[ai]["receipt_activity"],
                "receipt_place": cases[ai]["receipt_place"],
                "receipt_text": cases[ai]["receipt_text"],
                "receipt_done": cases[ai]["receipt_done"],
                "slot_init_asked": mk, "bill_cleared": cases[ai]["bill_cleared"]})
        }
        cases = new_cases_ask
        // 决赛 S1：收口 save() 咽喉（原直写 fs.write）
        save()
        cycle_save_result = save_result
        render_views()
        if cycle_save_result == "fail" {
            set_hint("#" + id_str + " 还没抽到时段，点「改时间」将设为 周六-上午（可再点切换）（保存标记失败，仅在内存）")
        } else {
            set_hint("#" + id_str + " 还没抽到时段，点「改时间」将设为 周六-上午（可再点切换）")
        }
        return
    }
    let nd = "周六"
    let np = "上午"
    if sd == "周六" && sp == "上午" { nd = "周六"  np = "下午" }
    if sd == "周六" && sp == "下午" { nd = "周六"  np = "晚上" }
    if sd == "周六" && sp == "晚上" { nd = "周日"  np = "上午" }
    if sd == "周日" && sp == "上午" { nd = "周日"  np = "下午" }
    if sd == "周日" && sp == "下午" { nd = "周六"  np = "上午" }
    // C4：重建整个数组（逐个 push 新对象，key 带引号）。
    //   #27 同步预置 slot_init_asked：当前这条刚走完首次确认→写入路径，
    //   把标记归零（""）表示「已接受默认值，不再追问」；其余保持原值。
    let new_cases = []
    for ri in cases.len() {
        if ri == cur {
            new_cases.push({"id": cases[ri]["id"], "text": cases[ri]["text"],
                "activity": cases[ri]["activity"], "place": cases[ri]["place"],
                "status": cases[ri]["status"],
                "slot_day": nd, "slot_part": np,
                "conflict": cases[ri]["conflict"], "people": cases[ri]["people"],
                "bill_total": cases[ri]["bill_total"],
                "receipt_activity": cases[ri]["receipt_activity"],
                "receipt_place": cases[ri]["receipt_place"],
                "receipt_text": cases[ri]["receipt_text"],
                "receipt_done": cases[ri]["receipt_done"],
                "slot_init_asked": "", "bill_cleared": cases[ri]["bill_cleared"]})
        } else {
            new_cases.push({"id": cases[ri]["id"], "text": cases[ri]["text"],
                "activity": cases[ri]["activity"], "place": cases[ri]["place"],
                "status": cases[ri]["status"],
                "slot_day": cases[ri]["slot_day"], "slot_part": cases[ri]["slot_part"],
                "conflict": cases[ri]["conflict"], "people": cases[ri]["people"],
                "bill_total": cases[ri]["bill_total"],
                "receipt_activity": cases[ri]["receipt_activity"],
                "receipt_place": cases[ri]["receipt_place"],
                "receipt_text": cases[ri]["receipt_text"],
                "receipt_done": cases[ri]["receipt_done"],
                "slot_init_asked": cases[ri]["slot_init_asked"], "bill_cleared": cases[ri]["bill_cleared"]})
        }
    }
    cases = new_cases
    // 重算冲突：先全置 no，再同槽互标 yes（S4：Completed 不参与）
    for a1 in cases.len() { if cases[a1]["status"] != "Cancelled" && cases[a1]["status"] != "Completed" { cases[a1]["conflict"] = "no" } }
    for a2 in cases.len() {
        if cases[a2]["status"] == "Cancelled" || cases[a2]["status"] == "Completed" { continue }
        let d2 = "" + cases[a2]["slot_day"]
        let p2 = "" + cases[a2]["slot_part"]
        if d2 == "" || p2 == "" { continue }
        for a3 in cases.len() {
            if a3 == a2 { continue }
            if cases[a3]["status"] == "Cancelled" { continue }
            let d3 = "" + cases[a3]["slot_day"]
            let p3 = "" + cases[a3]["slot_part"]
            if d3 == "" || p3 == "" { continue }
            if d3 == d2 && p3 == p2 {
                cases[a2]["conflict"] = "yes"
                cases[a3]["conflict"] = "yes"
            }
        }
    }
    let my_conflict = "" + cases[cur]["conflict"]
    rebuild_lines()
    // 决赛 S1：收口 save() 咽喉（原直写 fs.write）
    save()
    cycle_save_result = save_result
    render_views()
    let label_new = nd + "-" + np
    if cycle_save_result == "fail" {
        set_hint("#" + id_str + " 时间改为 " + label_new + "（保存失败，仅在内存）")
    } else if my_conflict == "yes" {
        set_hint("#" + id_str + " 时间改为 " + label_new + "（与另一条同时段，仍冲突）")
    } else {
        set_hint("#" + id_str + " 时间改为 " + label_new + "（已无冲突）")
    }
}

fn clear_cancel_pending(hint_text){
    cancel_pending_id = 0
    cancel_prev_status = ""
    cancel_pending_deadline = 0
    // === #25：撤销窗口也跟着归零，避免"换操作"后旧撤销目标还能被恢复 ===
    cancelled_last_id = 0
    if hint_text != "" {
        set_hint(hint_text)
    }
}

// ═══ 部件 5/16：视图导航与筛选：render_views / on_tap_card / 列表-详情-聊天进出 / 筛选 / 搜索 / 回执风格
// ═══ 源文件 bundle-src/50-navigation.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// === #16 新增：切换「怎么用」说明卡的展开/收起 ===
// 用字符串标记（#13 实证：函数返回布尔在调用点 == false 不可靠）。
// 触发后再走 render_views()，让 on_render 闭包按新 flag 重渲染。
fn toggle_howto(){
    if howto_show_flag == "yes" {
        howto_show_flag = "no"
        set_hint("已收起「怎么用」说明卡")
    } else {
        howto_show_flag = "yes"
        set_hint("已展开「怎么用」说明卡")
    }
    render_views()
}

// === #31 新增：详情面板八项命令式刷新（hint 模式翻版）
//   根组件详情面板是「首次定型静态区」，不靠 on_render 重渲染（E1 实证：根属性不随状态重算）。
//   所以走：rebuild_lines() 末尾统一调用本函数，按 selected_id 找 j，从扁平数组
//   取值逐个 ui.detail_x.set_text(...)；无选中时统一显示「点选上方卡片查看详情」。
//   手册 B5（Label 内 \n 不换行） → 回执用固定 4 个 Label，不用换行符。
//   手册 A2（同父只渲染第一个同类子节点） → 每个详情 Label 都是各自一行的纯叶子。
//   手册 C9（嵌套 if 条件赋值变空） → 单层 if 归一化，绝不链式。
#31f：update_detail_panel 已删（面板并入 on_render，见 case_list ui_mode 分支）

// === #31 改造：点卡片 = 选中（详情面板就由选中驱动，卡内不再有长内容——
//   截断问题整体绕开；on_tap 设 selected_id 并进详情模式（#31f））
//   保留 #9 toggle_case 名称以减少跨片 diff（仅删分支，不删函数）。
fn toggle_case(id){
    if id == 0 {
        set_hint("先选中一条守护再展开/折叠")
        return
    }
    // 切到其他行 → 放弃取消确认态（避免提示与展开态语义混淆）
    if cancel_pending_id != 0 && cancel_pending_id != id {
        clear_cancel_pending("")
    }
    selected_id = id
    // 切换该条的展开态
    for i in case_ids.len() {
        if case_ids[i] == ("" + id) {
            if case_expanded[i] == "yes" {
                case_expanded[i] = "no"
            } else {
                case_expanded[i] = "yes"
            }
            break
        }
    }
    rebuild_lines()
    render_views()
    let idx = -1
    for i in case_ids.len() {
        if case_ids[i] == ("" + id) { idx = i; break }
    }
    let msg = "已选中 #" + "" + id
    if idx >= 0 && case_expanded[idx] == "yes" {
        msg = "已展开 #" + "" + id + "（再点一次可折叠）"
    } else if idx >= 0 {
        msg = "已折叠 #" + "" + id + "（点卡片可展开详情）"
    }
    set_hint(msg)
}

// === #9 新增：点击单卡 = 切换该卡展开（用于卡片 GestureView on_tap） ===
fn render_views(){
    // #48b（S3 扩为三视图）：按 ui_mode 只刷当前可见视图
    //   （多个都刷会在单次 eval 内成倍 on_render 指令，实测超 instruction limit；
    //    且此处若递归调用自身=无限循环，黑板 #48 引以为戒）
    // v0.10.0：home_chrome 也是 on_render 容器——需同步 render（初始 list 态+模式切换）。
    if ui_mode == "detail" {
        ui.home_chrome.render()
        ui.detail_list.render()
    } else if ui_mode == "chat" {
        ui.home_chrome.render()
        ui.chat_list.render()
    } else {
        ui.home_chrome.render()
        ui.case_list.render()
    }
}
fn on_tap_card(id){
    // 决赛修：cur_id 来自 case_ids 扁平数组（字符串 id）。字符串落进 selected_id
    // 会让 target_id 的 `> 0` 判假 → 确认/改期/取消静默回退「最新一条」（多卡下
    // 确认错卡的实锤 bug）。统一在函数体内转数值（to_f64 放闭包内会中断渲染）。
    id = ("" + id).to_f64()
    // #31f：选中即进详情模式（#48b 起列表/详情双 ScrollY 互斥——详情视图重显从
    //   scroll=0 起步，深位点卡详情必在视口内）
    if id == 0 {
        set_hint("先建一条守护")
        return
    }
    if cancel_pending_id != 0 && cancel_pending_id != id {
        clear_cancel_pending("")
    }
    selected_id = id
    ui_mode = "detail"
    rebuild_lines()
    ui.case_list.set_visible(false)
    ui.chat_list.set_visible(false)
    ui.detail_list.set_visible(true)
    // v0.10.0：详情态主页 chrome 也隐藏（详情有自己的返回键+标题）
    ui.home_chrome.set_visible(false)
    // v0.10.2：详情态输入行+AI 行一并隐藏（HTML 02 屏顶部无输入区；
    //   详情有自己的参与人/AA/收款输入行。RoundedView 容器 set_visible 实证可靠——
    //   #48b 不可靠教训针对的是 plain View 容器；composer 是 RoundedView）
    ui.composer.set_visible(false)
    ui.cap_row.set_visible(false)
    // UI 改版（card-ux：操作就近分组）：状态三键只在详情模式显示——
    //   列表/聊天模式下「确认这条守护」没有目标语境，隐藏而非常驻
    ui.action_row.set_visible(true)
    render_views()
    set_hint("已选中 #" + "" + id + "，详情见下方；「返回列表」回到全部守护")
}

// === #31f：返回列表模式 ===
fn back_to_list(){
    ui_mode = "list"
    ui.detail_list.set_visible(false)
    ui.chat_list.set_visible(false)
    ui.case_list.set_visible(true)
    ui.action_row.set_visible(false)
    // 回列表：主页 chrome + 输入区恢复
    ui.home_chrome.set_visible(true)
    ui.composer.set_visible(true)
    ui.cap_row.set_visible(true)
    render_views()
    set_hint("已返回列表；点卡片看单条详情")
}

// === 决赛 S3：管家对话视图进出 ===
// === v0.8.0 W5（调研报告 P1）：沉默留痕——「AI 考虑过但没说的事，你都能回看」 ===
//   守护伴生进程（qx-group-butler）每轮检查后，把「条件未满足、决定不打扰」的决策
//   追加进 jail 的 suppressed.json；app 进聊天视图时读回展示。全场独有的差异化：
//   别的 agent 炫耀做了什么，这里的 agent 能交代「为什么没做」（arXiv 2605.06717
//   「被压下的候选推送也要记录，事后可审计」）。解析失败/缺文件 → 诚实显示暂无留痕。
let suppressed_lines = []
// === v0.10.0 WP3-A：群智收敛（降级路径：文字投票卡+手动刷新） ===
//   会话存 jail converge.json（伴生进程读房间消息归票后写入）；
//   app 只发起投票（matrix.send_message 真发文字卡）+ 读计票显示 + 管家收敛出 PLAN。
let converge_case_id = ""     // 当前投票会话目标守护 id（""=无会话）
let converge_summary = ""     // 计票摘要（伴生进程写 converge.json 后 app 读入）
let converge_winner = ""      // 票数最高字母（平票/零票为 ""）
let converge_winner_slot = "" // 对应时段（"周日-下午"）
let suppressed_count = 0
fn suppressed_kind_label(k){
    if k == "weather_ok" { return "☀ 天气复核：无雨，未发预警" }
    if k == "weather_unknown" { return "☁ 天气复核：未查到，提醒照发不带天气" }
    if k == "not_due" { return "⏳ 提醒未到期" }
    if k == "dunning" { return "💰 催收未到档" }
    if k == "conflict_watch" { return "👀 冲突观察" }
    return k
}
fn load_suppressed(){
    suppressed_lines = []
    suppressed_count = 0
    if fs.exists("suppressed.json") {
        let raw = fs.read("suppressed.json")
        let v = raw.parse_json()
        if v != nil {
            // v = {"entries":[{ts,kind,detail},…]}（bridge 追加写；对象包裹与 cases.json
            // 同范式——parse_json 只吃对象。只展示最近 5 条防列表撑爆）
            let arr = v["entries"]
            if arr == nil { arr = [] }
            let n5 = arr.len()
            let start = 0
            if n5 > 5 { start = n5 - 5 }
            for i in n5 {
                if i >= start {
                    let e = arr[i]
                    if e != nil {
                        let dt = "" + e["detail"]
                        if dt != "" {
                            suppressed_lines.push(("" + e["ts"]) + " ｜ " + suppressed_kind_label("" + e["kind"]) + " ｜ " + dt)
                            suppressed_count = suppressed_count + 1
                        }
                    }
                }
            }
        }
    }
    // 空态占位行统一在这里保证（含文件缺失/解析失败的所有早退路径——闭包只做
    // 无条件 for，防闭包内 if/else+嵌套 for 组合的 pop_stack 渲染崩）
    if suppressed_count == 0 {
        suppressed_lines.push("暂无留痕记录——伴生守护进程运行后，未触发的提醒/预警都会记在这里")
    }
}
// === v0.10.0 WP4：主动提案接入（守护进程「到点醒来干活」写进 jail 的改期提案） ===
//   qx-proactive-butler.py 在 T-24h 降水 ≥60% 时把模型起草的 PLAN 写进 pending_plan.json；
//   进聊天视图时读入并复用 plan_parse 解析进提案卡——人拍板后走既有白名单链，
//   随后清除文件（一次性提案；放弃则改由用户对管家说怎么改）。
fn load_pending_plan(){
    if !fs.exists("pending_plan.json") { return }
    let v = ("" + fs.read("pending_plan.json")).parse_json()
    if v == nil { return }
    let reply = "" + v["reply"]
    if reply == "" { return }
    // 提案卡接入（plan_parse 内含合法性校验 + diff 行构建 + plan_pending=yes）
    plan_parse(reply)
    if plan_pending == "yes" {
        let rain = "" + v["precip"]
        if rain == "" { rain = "≥60" }
        chat_push("sys", "⛈ 主动预警：管家凌晨复核发现活动日降水概率 " + rain + "%（open-meteo）——已备好改期提案，请拍板")
    }
}
fn enter_chat(){
    ui_mode = "chat"
    load_suppressed()
    load_pending_plan()
    ui.case_list.set_visible(false)
    ui.detail_list.set_visible(false)
    ui.chat_list.set_visible(true)
    ui.action_row.set_visible(false)
    // v0.10.0：主页 chrome（标题/守护灯卡）聊天态隐藏——管家页有自己的标题区
    ui.home_chrome.set_visible(false)
    // 聊天输入依赖 composer：从详情（输入区隐藏）进入时强制恢复
    ui.composer.set_visible(true)
    ui.cap_row.set_visible(true)
    render_views()
}
fn back_from_chat(){
    ui_mode = "list"
    ui.chat_list.set_visible(false)
    ui.composer.set_visible(true)
    ui.cap_row.set_visible(true)
    ui.case_list.set_visible(true)
    ui.action_row.set_visible(false)
    // 回列表：主页 chrome + 输入区恢复
    ui.home_chrome.set_visible(true)
    ui.composer.set_visible(true)
    ui.cap_row.set_visible(true)
    render_views()
    set_hint("已回到守护列表；点卡片看单条详情")
}

// === #10 新增：切换筛选标签（GestureView on_tap 回调入口） ===
// 入口参数 ft 是目标筛选值字符串："all"/"Proposing"/"Confirmed"/"Cancelled"
// 逻辑放函数上下文（不放在 on_render 内），重建扁平字符串数组后驱动渲染
fn set_filter(ft){
    let prev = "" + current_filter
    current_filter = "" + ft
    rebuild_lines()
    render_views()
    // hint 反馈：切了哪个标签 + 当前命中条数
    let label_all = "全部"
    if ft == "Proposing" { label_all = "待拍板" }
    if ft == "Confirmed" { label_all = "已确认" }
    if ft == "Cancelled" { label_all = "已取消" }
    set_hint("筛选：" + label_all + " · 共 " + filter_count_str + " 条 / 总 " + filter_total_str + " 条")
}

// === #12 新增：搜索词入口（TextInput on_change 回调；与 set_filter 同样放函数上下文）
// q 是用户输入的搜索词（空串=清空）；逻辑放函数上下文才能在 cases[j]["activity/place/text"]
// 上调 search(p)>=0；on_render 闭包只读扁平字符串。set_query 只动 current_query + 触发重建 +
// 更新 hint，不动 current_filter，所以搜索词与标签是叠加而非替换。
fn set_query(q){
    current_query = "" + q
    rebuild_lines()
    render_views()
    if current_query == "" {
        set_hint("已清空搜索，按当前标签显示（" + filter_count_str + " / " + filter_total_str + " 条）")
    } else {
        set_hint("搜索 " + current_query + " · 共 " + filter_count_str + " / " + filter_total_str + " 条")
    }
}

// === #43 D 切片：回执风格切换（循环 standard→brief→emoji→standard）
//   1. 翻转 receipt_style（按当前值决定下一档）；
//   2. 写 pref.json {"receipt_style": <new>}——fs.write 返回非 nil = 失败（照 #13 save() 范式）；
//      失败也要在**本次会话**让 receipt_style 生效（用户视觉立刻变），仅 hint 明示「偏好保存失败
//      （风格本次会话仍生效）」——会话内不影响体验，重启才丢档；
//   3. rebuild_lines 让已有守护的 case_receipt 立即按新风格重排（快照语义不变——ra/rp/rt 不动）；
//   4. ui.style_btn.set_text(...) 命令式更新底部按钮文案（照 ui.hint.set_text 范式，根组件静态区
//      靠 imperative set_text 而非 on_render 重算——task 明确允许此路径）；
//   5. set_hint(...) 给用户反馈（成功/失败两路）。
//   注：style_btn 是根组件 ButtonFlat 的具名绑定（详见根组件布局），set_text 范式已在
//      ui.hint 上多次实证（line 493, 504 等），runtime 可靠。
fn set_receipt_style(){
    let next = "standard"
    if receipt_style == "standard" { next = "brief" }
    else if receipt_style == "brief" { next = "emoji" }
    else if receipt_style == "emoji" { next = "standard" }
    // 其他值（理论上 load() 已兜底，但保险起见）→ 回 standard
    receipt_style = next
    // 写 pref.json（to_json 把字符串包成 {"receipt_style":"brief"} 形式）
    let pw = fs.write("pref.json", {receipt_style: receipt_style}.to_json())
    let write_ok = true
    if pw != nil {
        let pwmsg = "" + pw
        if pwmsg != "" { write_ok = false }
    }
    rebuild_lines()
    render_views()
    // 按钮文案命令式更新：根组件 if 不重算，但 on_click 事件回调内 imperative set_text 可靠
    if ui.style_btn != nil {
        ui.style_btn.set_text("风格：" + style_label_for(receipt_style))
    }
    let label_cn = style_label_for(receipt_style)
    if write_ok {
        // 成功：明示持久化+已有守护立即生效
        set_hint("回执风格已切换为 " + label_cn + "（已有守护的回执立即按新风格重排）")
    } else {
        // 失败：本次会话仍生效（receipt_style 已翻，case_receipt 已 rebuild），仅持久化未落盘
        set_hint("偏好保存失败（风格本次会话仍生效）：" + label_cn)
    }
}

// === #43 辅助：把 receipt_style 内部值映射成按钮文案用的中文短词
//   三档分别显示「标准 / 简短 / 带emoji」——按钮文字 + hint 反馈共用此映射
//   （与 receipt_style 三合法值一一对应；其他值兜底返回「标准」）
fn style_label_for(s){
    if s == "brief" { return "简短" }
    if s == "emoji" { return "带emoji" }
    return "标准"
}

// ═══ 部件 6/16：本地规则分诊与建守护：triage / guess_* / add_case / build_case_from_text
// ═══ 源文件 bundle-src/60-triage.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// 本地规则分诊：命中时间/地点/约定动词才值得建 Case；纯闲聊 → 澄清
// === #19 修改：加「约定/聚会语气」门槛
//   时间词 + 活动词 / 约定语气词 / 聚会场景词 才自动建守护。
//   只有时间词（如"3月15日下午"可能是工作/政务安排）→ "time_only"：
//   走到 add_case 里的澄清卡分支，给「仍然建守护」入口，绝不直接拦死用户。
//   三档返回："time"=完整命中自动建；"verb"=只有活动词无时间（保留旧行为）；
//   "time_only"=只有时间词需澄清；"none"=既无时间也无意图。
fn triage(text){
    let hit_time = regex("周|明天|后天|今天|\\d+月\\d+|上午|下午|晚上|周末|\\d+号|\\d+点", "").test(text)
    // 活动词（保留原词表）
    let hit_act = regex("聚|吃饭|骑车|爬山|看电影|约|唱歌|打球|露营|烧烤|逛街|喝茶", "").test(text)
    // 约定语气词：约/一起/咱们/大家/集合/报名/接龙/约吗/来吗/安排
    let hit_commit = regex("约|一起|咱们|大家|集合|报名|接龙|约吗|来吗|安排", "").test(text)
    // 聚会场景词：聚餐/团建/生日/聚会/聚会吧
    let hit_scene = regex("聚餐|团建|生日|聚会|聚会吧", "").test(text)
    let hit_verb = hit_act || hit_commit || hit_scene
    if hit_time && hit_verb { return "time" }
    if hit_time { return "time_only" }
    if hit_verb { return "verb" }
    return "none"
}

// 极简抽取：只做关键词呈现，不编造结构化事实（防编造：抽不到就留空）
// === #19 修改：删除 "聚会" 兜底——抽不到就返回空串
//   「卡片」与「回执」的活动字段随后落到 case_activity_lines 既有占位逻辑
//   （"（未抽取到）"）——绝不编造一个看似合理的活动名。
fn guess_activity(text){
    let words = ["骑车", "吃饭", "聚餐", "爬山", "看电影", "唱歌", "打球", "露营", "烧烤", "逛街", "喝茶", "聚会"]
    for w in words {
        if text.search(w) >= 0 { return w }
    }
    return ""
}

fn guess_place(text){
    let spots = ["深圳湾", "莲花山", "梧桐山", "海岸城", "欢乐谷", "世界之窗", "大梅沙", "小梅沙", "东湖", "红树林"]
    for s in spots {
        if text.search(s) >= 0 { return s }
    }
    return ""
}

// === #17b 新增：抽取「星期几」=== 命中「周一/周二/周三/周四/周五/周六/周日」
//   或「今天/明天/后天」（按序列映射）。
// 抽不到留 ""，不编造。
fn guess_slot_day(text){
    // 注：search 是子串匹配，故「星期一/星期天」也能命中「周一」/「周日」。
    let days = ["周一", "周二", "周三", "周四", "周五", "周六", "周日"]
    for d in days {
        if text.search(d) >= 0 { return d }
    }
    // 「今天/明天/后天」是相对时间，本 runtime 无时钟 API，无 anchor「今天」返回，
    // 所以也留空——宁可空着不猜。
    return ""
}

// === #17b 新增：抽取「时段」=== 命中「上午/中午/下午/晚上」之一即返回；抽不到留 ""。
fn guess_slot_part(text){
    let parts = ["上午", "中午", "下午", "晚上"]
    for p in parts {
        if text.search(p) >= 0 { return p }
    }
    return ""
}

fn add_case(){
    // 建守护算"非取消按钮" → 放弃任何待确认 + 关掉撤销窗口
    clear_cancel_pending("")
    undo_win_open = "no"
    let text = ui.msg_input.text()
    if text == "" {
        set_hint("先输入一条群消息，例如：周六上午去深圳湾骑车")
        return
    }
    // === #19 新增：「仍然建守护」二次确认态的第二次按压
    //   若首次按下后已落在 force_create_pending="yes" 且原文未改，
    //   则此次直接落库（按用户主动意图走）。用 force 作为 level 标签便于
    //   后续 hint / 日志溯源，但本质上仍按完整 case 走。
    if force_create_pending == "yes" && text == force_create_text {
        force_create_pending = "no"
        force_create_text = ""
        force_create_deadline = 0
        build_case_from_text(text, "force")
        return
    }
    // 原文变了 / 超时已自动清空 → 重新走分诊（不沿用旧 force_create_text）
    if force_create_pending == "yes" {
        force_create_pending = "no"
        force_create_text = ""
        force_create_deadline = 0
    }
    let level = triage(text)
    if level == "time_only" {
        // === #19 新增：仅命中时间词 → 澄清卡（不直接拦死）
        //   「有时间，但这看起来不像聚会安排——要牵线跟这条吗？」
        //   + 给「仍然建守护」入口：用户再点一次「建守护」即按 force 走。
        //   不清空 msg_input（让用户能直接看到原文 + 二次按压）。
        force_create_pending = "yes"
        force_create_text = text
        force_create_deadline = 1
        set_hint("有时间，但这看起来不像聚会安排——要牵线跟这条吗？再点一次「建守护」即可（仍是您主动）")
        start_timeout(5.0, || {
            if force_create_pending == "yes" {
                force_create_pending = "no"
                force_create_text = ""
                force_create_deadline = 0
                set_hint("「仍然建守护」确认已过期（5s 内未再点），未建守护")
            }
        })
        return
    }
    if level == "none" {
        set_hint("澄清卡：这条消息里没看到时间或聚会意图，不建守护（规则分诊未命中）")
        return
    }
    build_case_from_text(text, level)
}

// === #19 新增：建守护的实际落库逻辑（拆出来供 add_case 复用）
//   把「时间词+约定词」自动建 与 「仍然建守护」用户主动强制建 两条路径
//   共享同一段落库代码，避免双份冲突检测 / 落盘逻辑漂移。
//   level 入参保留 "time" / "verb" / "force" 三种标签，
//   仅用于 hint 文案溯源——业务行为完全相同（不编造、不漏存）。
fn build_case_from_text(text, level){
    seq = seq + 1
    // #13 第 3 条：id 撞库守卫。load() 后异常场景下 cases 有内容而 seq == 0，
    //   上面 seq+1 得 1，会与已有 id=1 撞。这里取 max(seq, 已有最大 id) + 1，
    //   保证新 id 一定大于任何已有 id。
    let max_existing_id = 0
    for i in cases.len() {
        let cid = cases[i]["id"]
        if cid > max_existing_id { max_existing_id = cid }
    }
    if seq <= max_existing_id {
        seq = max_existing_id + 1
    }
    // === #27：slot_init_asked 字段预置（C5）。case 对象带这个标记后，cycle_slot
    //   才能在「时段未抽取」时进入二次确认：第一次点只翻标记 + 提示，第二次点
    //   才真正写入「周六-上午」初值。初值 "" 表示从未问过。
    cases.push({"id": seq, "text": text, "activity": guess_activity(text), "place": guess_place(text), "status": "Proposing", "people": "", "bill_total": "", "receipt_activity": "", "receipt_place": "", "receipt_text": "", "receipt_done": "", "slot_day": guess_slot_day(text), "slot_part": guess_slot_part(text), "conflict": "no", "slot_init_asked": "", "bill_cleared": "no"})
    audit("create", "槽位=" + guess_slot_day(text) + "-" + guess_slot_part(text) + " level=" + level)
    // === #17b：新建后做冲突检测（不阻断用户，照常往下推进）===
    // 双方 slot_day + slot_part 都非空 + 相同 → 新条目标 conflict:"yes"。
    // 同时把已有那一条也翻成 conflict:"yes"（互相知道对方在）。
    let new_day = "" + cases[cases.len() - 1]["slot_day"]
    let new_part = "" + cases[cases.len() - 1]["slot_part"]
    if new_day != "" && new_part != "" {
        for ci in cases.len() - 1 {
            if cases[ci]["status"] == "Cancelled" { continue }
            let od = "" + cases[ci]["slot_day"]
            let op = "" + cases[ci]["slot_part"]
            if od == "" || op == "" { continue }
            if od == new_day && op == new_part {
                cases[cases.len() - 1]["conflict"] = "yes"
                cases[ci]["conflict"] = "yes"
                break
            }
        }
    }
    selected_id = seq  // 新建后自动选中，体验闭环
    ui.msg_input.set_text("")
    rebuild_lines()
    save()   // 结果写入全局 save_result
    render_views()
    if save_result == "fail" {
        set_hint("保存失败：守护数据可能未落盘（已建守护 #" + "" + seq + "，分诊命中：" + level + "）")
    } else {
        set_hint("已建守护 #" + "" + seq + "（分诊命中：" + level + "），已选中，点卡片可展开详情")
    }
}

// ═══ 部件 7/16：生命周期动作：confirm / reschedule / cancel / undo_cancel（白名单动作端）
// ═══ 源文件 bundle-src/70-lifecycle.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
fn confirm_case(){
    // 同意 → 放弃任何待确认 + 关掉撤销窗口（操作后用户应当看到最新状态）
    clear_cancel_pending("")
    undo_win_open = "no"
    let t = target_id()
    if t["id"] == 0 {
        set_hint("列表为空：先建一条守护再拍板")
        return
    }
    for i in cases.len() {
        if cases[i]["id"] == t["id"] {
            if cases[i]["status"] == "Confirmed" {
                let tag = ""
                if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
                set_hint("已确认，未重复（#" + "" + t["id"] + " 仍是 Confirmed）" + tag)
                return
            }
            if cases[i]["status"] == "Cancelled" {
                set_hint("该守护已取消，不可确认（#" + "" + t["id"] + "）")
                return
            }
            cases[i]["status"] = "Confirmed"
            audit("confirm", "#" + "" + t["id"] + " slot=" + cases[i]["slot_day"] + "-" + cases[i]["slot_part"])
            rebuild_lines()
            save()   // 结果写入全局 save_result
            render_views()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            if save_result == "fail" {
                set_hint("保存失败：守护数据可能未落盘（#已被改为 Confirmed in-memory；#" + "" + t["id"] + "）" + tag)
            } else {
                set_hint("已确认 #" + "" + t["id"] + " → Confirmed（组织者拍板，读回一致）" + tag)
                // v0.4.0：确认后动作——ICS 自动生成 + 群分享尝试（回调覆盖 hint 为终态文案）
                post_confirm_actions("" + t["id"])
            }
            return
        }
    }
}

fn reschedule_case(){
    // 改口 → 放弃任何待确认 + 关掉撤销窗口
    clear_cancel_pending("")
    undo_win_open = "no"
    let t = target_id()
    if t["id"] == 0 {
        set_hint("列表为空：先建一条守护再改口")
        return
    }
    for i in cases.len() {
        if cases[i]["id"] == t["id"] {
            if cases[i]["status"] == "Cancelled" {
                set_hint("该守护已取消，改口无效（#" + "" + t["id"] + "）")
                return
            }
            cases[i]["status"] = "Proposing"
            // === #18 新增：改口后让回执随下次确认刷新；receipt_done 置 ""，
            //   rebuild_lines 里 Confirmed 分支的幂等判断就会重新填充 receipt_* ===
            cases[i]["receipt_activity"] = ""
            cases[i]["receipt_place"] = ""
            cases[i]["receipt_text"] = ""
            cases[i]["receipt_done"] = ""
            rebuild_lines()
            save()   // 结果写入全局 save_result
            render_views()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            if save_result == "fail" {
                set_hint("保存失败：守护数据可能未落盘（#已回到 Proposing in-memory；#" + "" + t["id"] + "）" + tag)
            } else {
                set_hint("改口：#" + "" + t["id"] + " 回到 Proposing，重新收敛（旧确认作废）" + tag)
            }
            return
        }
    }
}

// === #8 保留：取消二次确认（两段式按钮态，不用模态） ===
// 第一次点：进入"待确认"态，按钮文案变"再点一次取消（5s）"，hint 提示；
// 第二次点：在 5 秒内才执行真正的取消；超时/选其他卡/点其他按钮 → 放弃
fn cancel_case(){
    let t = target_id()
    if t["id"] == 0 {
        set_hint("列表为空：先建一条守护再取消")
        return
    }
    let target = t["id"]

    // 当前已经在对该条目标等待二次确认 → 第二次点击，执行真正取消
    if cancel_pending_id == target {
        for i in cases.len() {
            if cases[i]["id"] == target {
                cancel_prev_status = "" + cases[i]["status"]
                cases[i]["status"] = "Cancelled"
                audit("cancel", "#" + "" + target)
                // === #18 新增：取消后回执无意义，连同 receipt_done 一起清空；
                //   若后续撤销恢复状态，下次确认时 rebuild_lines 会重新快照 ===
                cases[i]["receipt_activity"] = ""
                cases[i]["receipt_place"] = ""
                cases[i]["receipt_text"] = ""
                cases[i]["receipt_done"] = ""
                cancel_pending_id = 0
                cancel_pending_deadline = 0
                cancel_pending_flag = "no"  // #11：确认态按钮撤下
                // === #25：记录本次被取消的那条 id；undo_cancel 据此只恢复这一条，
                //   不会把更早被取消的别的条连带恢复（#24 自审 S8 实证 bug）
                cancelled_last_id = target
                // === #9：撤销窗口打开 —— 现在起 5 秒内可点「撤销取消」 ===
                undo_win_open = "yes"
                undo_show_flag2 = "yes"    // #11：让 on_render 渲染可点的「撤销取消」
                rebuild_lines()
                save()   // 结果写入全局 save_result
                render_views()
                let tag = ""
                if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
                if save_result == "fail" {
                    set_hint("保存失败：守护数据可能未落盘（#已取消 in-memory；#" + "" + target + "，5 秒内可尝试撤销）" + tag)
                } else {
                    set_hint("已取消 #" + "" + target + "（5 秒内可点「撤销取消」）" + tag)
                }
                // 5 秒后撤销窗口到期：自动清掉 hint 文案里的"可撤销"暗示
                // === #9 修：守卫 undo_win_open —— 若用户已撤销则不再覆盖 ===
                start_timeout(5.0, || {
                    if undo_win_open == "yes" {
                        undo_show_flag2 = "no"          // #11：撤下撤销按钮
                    undo_win_open = "no"
                        cancel_prev_status = ""
                        // === #25：撤销窗口到期，撤销目标也归零；
                        //   之后任何 undo_cancel 都找不到目标（C4 重建 + 全局数字标记）
                        cancelled_last_id = 0
                        rebuild_lines()
                        render_views()
                        set_hint("取消 #" + "" + target + " 已生效（撤销窗口已过）")
                    }
                })
                return
            }
        }
        return
    }

    // 第一次点击：进入待确认态（不执行任何状态变更）
    for i in cases.len() {
        if cases[i]["id"] == target {
            cancel_pending_id = target
            cancel_prev_status = "" + cases[i]["status"]
            cancel_pending_deadline = 1
            cancel_pending_flag = "yes"   // #11：让 on_render 渲染「确认取消（5s）」变体
            rebuild_lines()
            render_views()
            let tag = ""
            if t["fallback"] { tag = "（作用于最新一条，因未选中）" }
            set_hint("再点一次「确认取消」才会真取消 #" + "" + target + "；5 秒内点别的按钮或选别的卡可放弃" + tag)
            // 5 秒后超时 → 放弃确认态
            start_timeout(5.0, || {
                if cancel_pending_id == target {
                    cancel_pending_id = 0
                    cancel_pending_deadline = 0
                    cancel_prev_status = ""
                    cancel_pending_flag = "no"
                    undo_show_flag2 = "no"
                    rebuild_lines()
                    render_views()
                    set_hint("已放弃取消 #" + "" + target + "（5 秒内未再点取消）")
                }
            })
            return
        }
    }
}

// === #8 保留 + #9 修 + #25 修：撤销刚发生的取消（5 秒窗口内，仅恢复刚取消的那一条） ===
fn undo_cancel(){
    if cancel_prev_status == "" || undo_win_open == "no" || cancelled_last_id == 0 {
        set_hint("没有可撤销的取消（5 秒窗口已过或未取消过）")
        return
    }
    let restored_id = "0"
    let target_id_str = "" + cancelled_last_id
    // === #25：只恢复 id==cancelled_last_id 的那一条，其余 Cancelled 不动 ===
    for i in cases.len() {
        if ("" + cases[i]["id"]) == target_id_str {
            if cases[i]["status"] == "Cancelled" {
                cases[i]["status"] = cancel_prev_status
                // === #18：恢复状态后让回执重新快照（之前清掉的字段保留空，
                //   下次确认/重建时由 rebuild_lines 兜底拉新值） ===
                restored_id = "" + cases[i]["id"]
            } else {
                // 防御性分支：id 命中但状态已经不是 Cancelled（极端时序错位），
                // 也提示用户并清掉撤销目标，避免悬空
                restored_id = "0"
            }
            break   // #25：id 唯一，找到即可跳出（C4 重写法：不重建数组，只改一条）
        }
    }
    cancel_pending_id = 0
    cancel_pending_deadline = 0
    let prev = cancel_prev_status
    cancel_prev_status = ""
    // === #25：撤销成功后归零，避免后续 undo_cancel 重复恢复同一目标 ===
    cancelled_last_id = 0
    // === #9 关键：关撤销窗口 + 阻止 5s 定时器覆盖当前 hint ===
    undo_win_open = "no"
    undo_show_flag2 = "no"   // #11：撤下可点的撤销按钮
    cancel_pending_flag = "no"
    rebuild_lines()
    save()   // 结果写入全局 save_result
    render_views()
    if save_result == "fail" {
        if restored_id != "0" && restored_id != "" {
            set_hint("保存失败：守护数据可能未落盘（#已撤销取消 in-memory；#" + restored_id + " 恢复到 " + prev + "）")
        } else {
            set_hint("保存失败：守护数据可能未落盘（已撤销取消 in-memory）")
        }
    } else if restored_id != "0" && restored_id != "" {
        set_hint("已撤销取消 #" + restored_id + " → 恢复到 " + prev + "（仅本次，其他已取消条目维持）")
    } else {
        set_hint("已撤销取消（但目标条目已不在 Cancelled 状态，未改动）")
    }
}

// ═══ 部件 8/16：管家回合：probe_ai_cap / ai_timeout / chat_push / build_agent_turn / butler_send
// ═══ 源文件 bundle-src/80-butler-turn.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// === 决赛 S3：管家模式 —— agent 驱动全流程，人只拍板 ===
// 唯一 AI 通道：octos.turn.start（Rinx 宿主仅接受 {text} 单参数，其他键直接报错——源码级核实）。
// 回包自由文本：尾部带 PLAN{...}（单行 JSON，扁平字符串字段）即为机器提案，
// 解析进 plan_* 全局 + plan_pending="yes"，聊天视图渲染「拍板/放弃」；
// 人点「拍板」才走白名单动作（create/confirm/reschedule/cancel/add_people/set_bill）。
// card-host 无服务 → 诚实降级：sys 气泡明示，本地规则路径（建守护）原样可用。

// #46 A切片（S3 改版）：AI 通道可见性——只探测管家通道（turn.start）
// v0.10.2：死亡闩锁优先——实测失败过的通道不再报「可用」
fn probe_ai_cap(){
    if ai_dead == "yes" {
        return "AI：通道实测无响应，本地规则兜底（对话里可「重试 AI」）"
    }
    if host.has("octos.turn.start") {
        return "AI：管家对话通道可用（首次需宿主允许）"
    }
    return "AI：本机无管家服务，本地规则兜底"
}

// v0.10.2：摘除悬挂的「思考中」气泡——它永远是最后一条（回合间无其他入栈；
// 用户发送被 ai_pending 挡住），结果到达时 pop 掉由结果气泡替代，不再满屏残留。
fn resolve_thinking(){
    if thinking_open == "yes" {
        chat_role.pop()
        chat_text.pop()
        thinking_open = "no"
    }
}

// v0.10.2：通道死亡闩锁置位 + 持久化（jail ai_state.json）——一次实测失败，
//   之后每条消息不再白等 45 秒；用户可点「重试 AI」手动复位。
fn mark_ai_dead(why){
    ai_dead = "yes"
    let _w = fs.write("ai_state.json", {dead: "yes", reason: "" + why}.to_json())
    ui.ai_cap_label.set_text(probe_ai_cap())
}

// 决赛改进②（S3 改版）：45s 降级定时器，带代际核对 + 聊天面同步
fn ai_timeout(my){
    if my == ai_seq && ai_pending == "yes" {
        ai_pending = "no"
        resolve_thinking()
        chat_push("sys", "管家无响应（45 秒）——已降级本地规则，点下方「用本地规则建守护」即可")
        mark_ai_dead("timeout")
        render_views()
        set_hint("AI 无响应（45 秒），已降级本地规则——点对话下方「用本地规则建守护」")
    }
}
// 对话气泡入栈（role: "me"/"ai"/"sys"）；聊天视图可见时即时重渲染
fn chat_push(role, text){
    chat_role.push("" + role)
    chat_text.push("" + text)
    if ui_mode == "chat" {
        ui.chat_list.render()
    }
}

// 管家回合提示词：静态角色前导（含 PLAN 协议）+ 当前守护快照 + 用户消息。
// Rinx 不给 mini-app 注入 AGENT.md（宿主侧 turn_input 无 guidance 分支，源码级核实），
// 所以角色与协议必须由 app 自己嵌入 turn 文本——与 AGENT.md v3 同文，双处一致。
fn build_agent_turn(user_text){
    let pre = "你是「牵线」聚会守护管家，帮组织者把群消息变成照顾到收尾的聚会。依据【当前守护】与【用户消息】工作。规则：1)只从消息原文抽取字段，抽不到就留空并说明「未抽取到」，绝不编造时间/地点/人物；2)你没有执行权——凡涉及新建/确认/改期/取消/加人/记账/收款/撤销/清空/导出，先用一两句人话说明，然后另起一行输出机器提案，格式固定单行：PLAN{\"op\":\"create\",\"text\":\"消息原文\",\"activity\":\"\",\"slot_day\":\"\",\"slot_part\":\"\",\"place\":\"\",\"people\":\"\",\"bill_total\":\"\"}。op 全集：create(text 必填原文)/confirm/reschedule(+slot_day+slot_part)/cancel/add_people(+people)/set_bill(+bill_total)/complete/draft_dunning（催收草稿，数字由 app 算）/mark_paid(+who+amount 记某人已付款)/undo（撤销刚取消的守护，5 秒窗内）/clear（清空全部，危险，两段确认）/export（导出数据，可带 id 导出单条证据包）——除 create/clear/export 外都必须包含 \"id\":\"<目标守护数字>\"（例：{\"op\":\"confirm\",\"id\":\"2\"}；{\"op\":\"mark_paid\",\"id\":\"1\",\"who\":\"张三\",\"amount\":\"100\"}），缺 id 会被拒；字段值全部双引号字符串，值内禁用双引号与换行，未抽取到留空，每次回复最多一个 PLAN；3)绝不声称已改状态，用户点「拍板」后才算数；4)答疑直接回答不带 PLAN；5)发现同时段冲突要提醒；6)天气/时间等实时信息必须调用工具（get_weather/clock）查询，工具不可用或查询失败就明确说「暂无法查询实时数据」，禁止凭记忆编造任何数字；7)若本回合带【上次提案被拒】，必须按该理由调整方案，不许原样重提。回复中文、简短（≤120字）。"
    let st = pre + "\n\n【当前守护】\n"
    if cases.len() == 0 {
        st = st + "（还没有守护）"
    } else {
        for i in cases.len() {
            st = st + "#" + ("" + cases[i]["id"]) + " " + ("" + cases[i]["activity"])
            st = st + "｜" + ("" + cases[i]["slot_day"]) + "-" + ("" + cases[i]["slot_part"])
            st = st + "｜" + ("" + cases[i]["place"])
            st = st + "｜" + ("" + cases[i]["status"])
            // v0.8.0 W1 快照富化：管家能看到人与账，才能答「张三交了吗」这类问题
            st = st + "｜人:" + ("" + cases[i]["people"])
            st = st + "｜账:" + ("" + cases[i]["bill_total"])
            if ("" + cases[i]["bill_cleared"]) == "yes" { st = st + "(已收齐)" }
            if ("" + cases[i]["conflict"]) == "yes" { st = st + "｜⚡冲突" }
            st = st + "\n"
        }
    }
    // v0.8.0 W1：拍板反馈回路——拒绝理由一次性注入（调用方 build 后立即清空）
    if decline_feedback != "" {
        st = st + "\n【上次提案被拒】" + decline_feedback
    }
    return st + "\n【用户消息】\n" + user_text
}

// v0.10.2：回合尝试抽成独立函数（butler_send 与「重试 AI」共用）——
//   只发回合，不再推 me 气泡（重试不重复刷屏）。
fn ai_attempt(text){
    ai_pending = "yes"
    ai_seq = ai_seq + 1
    let my = ai_seq
    chat_push("sys", "管家思考中…")
    thinking_open = "yes"
    // 15s 进度反馈：原地替换思考气泡文案（pop+push），不新增悬挂气泡
    start_timeout(15.0, || {
        if my == ai_seq && ai_pending == "yes" && thinking_open == "yes" {
            resolve_thinking()
            chat_push("sys", "管家还在思考…（模型响应较慢；45 秒无响应自动降级本地规则）")
            thinking_open = "yes"
        }
    })
    // v0.8.0 W1：拒绝理由一次性反馈——先注入进 turn 文本再清空（只影响本回合）
    let turn_text = build_agent_turn(text)
    decline_feedback = ""
    start_timeout(45.0, || ai_timeout(my))
    host.request("octos.turn.start", {text: turn_text}, fn(r){
        // 决赛改进②：迟到回调按序号丢弃——已被新回合取代时不动任何 UI 状态
        if my != ai_seq { return }
        ai_pending = "no"
        resolve_thinking()
        if r.is_ok {
            let reply = "" + r.data.text
            if reply == "" { reply = "（管家返回了空回复）" }
            plan_parse(reply)

            // 评委硬伤修复：彻底杜绝原始协议泄漏（PLAN{...} 严禁进入用户可见气泡）
            let bubble_text = reply
            let rparts = reply.split("PLAN{")
            if rparts.len() > 1 {
                let human = rparts[0].trim()
                if human != "" {
                    bubble_text = human
                } else {
                    bubble_text = default_human_reply(plan_op)
                }
            }
            chat_push("ai", bubble_text)
            if plan_pending == "yes" {
                set_hint("管家出了提案——过目后点「拍板」执行")
            } else {
                set_hint("管家已回复（见对话）")
            }
        } else {
            // #46b 诚实可见性：host.has 只证「已注册」，实测失败要把「可用」字样撤下
            // v0.10.2：实测失败 → 死亡闩锁（后续发送即时降级，不再逐条白等 45 秒）
            chat_push("sys", "AI 通道无响应（" + r.error + "）——已降级本地规则：点下方「用本地规则建守护」即可")
            mark_ai_dead(r.error)
            set_hint("AI 不可用，已降级为本地规则（" + r.error + "）")
        }
        render_views()
    })
}

// v0.10.2：降级快捷动作——用本地规则处理上一条消息（分诊/二次确认/落库全走既有路径）
fn butler_local_fallback(){
    if last_me_text == "" {
        set_hint("没有可建的原文——把群消息粘贴到输入框，再点「建守护」")
        return
    }
    ui.msg_input.set_text(last_me_text)
    add_case()
    chat_push("sys", "已把上一条交给本地规则分诊（结果见提示与守护列表）")
    render_views()
}

// v0.10.2：重试 AI 通道——清闩锁 + 有原文则直接重发上一条（不重复推 me 气泡）
fn butler_retry_ai(){
    if ai_pending == "yes" {
        set_hint("管家还在思考，请稍候")
        return
    }
    ai_dead = "no"
    let _w = fs.write("ai_state.json", {dead: "no"}.to_json())
    ui.ai_cap_label.set_text(probe_ai_cap())
    if last_me_text != "" {
        ai_attempt(last_me_text)
    } else {
        chat_push("sys", "已重置 AI 通道——粘贴消息后再点「交给管家」")
        render_views()
    }
}

// 管家入口：输入框文本 → 聊天视图 → turn.start（死亡闩锁/无服务则诚实降级，零等待）
fn butler_send(){
    if ai_pending == "yes" {
        set_hint("管家还在思考，请稍候（45 秒无响应自动降级）")
        return
    }
    let text = ui.msg_input.text()
    if text == "" {
        set_hint("先粘贴一条群消息，再点「交给管家」")
        return
    }
    chat_push("me", text)
    last_me_text = text
    ui.msg_input.set_text("")
    enter_chat()
    // v0.10.2：死亡闩锁——通道已知不可用时不白等，即时给本地出口 + 重试入口
    if ai_dead == "yes" {
        chat_push("sys", "AI 通道当前不可用（上次实测失败）——点下方「用本地规则建守护」直接落地，或「重试 AI」再试一次")
        ui.ai_cap_label.set_text(probe_ai_cap())
        render_views()
        return
    }
    if host.has("octos.turn.start") {
        ai_attempt(text)
    } else {
        // 诚实降级：无 AI 服务——不假装管家在听；同样置闩锁（本机会话内不再逐条重试空通道）
        chat_push("sys", "本机没有管家服务（host 无 octos.turn.start）——点下方「用本地规则建守护」走分诊建卡")
        mark_ai_dead("no-service")
        set_hint("本机无 AI 服务，已降级本地规则——点对话下方「用本地规则建守护」")
        render_views()
    }
}

// 评委硬伤修复：杜绝原始协议泄漏——缺省自然语言时，由管家补齐有温度的说明
fn default_human_reply(op){
    if op == "create" { return "为您起草了聚会方案，请在下方提案卡过目并拍板。" }
    if op == "confirm" { return "信息已齐备，已为您起草确认提案。" }
    if op == "reschedule" { return "好的，已为您起草改期方案，请过目下方提案卡。" }
    if op == "cancel" { return "明白，已起草取消方案，拍板后有 5 秒撤销窗口。" }
    if op == "set_bill" { return "账目已记录，按参与人均摊，请在下方提案卡拍板。" }
    if op == "add_people" { return "已添加新成员，请在下方提案卡拍板。" }
    if op == "complete" { return "聚会圆满收官，已起草结案归档提案。" }
    if op == "draft_dunning" { return "已起草催款私信草稿，请在下方过目。" }
    if op == "mark_paid" { return "已登记付款标记，请在下方提案卡拍板。" }
    if op == "undo" { return "已执行紧急撤销提案，请在下方拍板生效。" }
    if op == "clear" { return "已起草清空提案，此操作需两段确认。" }
    if op == "export" { return "已生成日程卡片导出提案，请在下方拍板。" }
    return "为您起草了方案，请过目下方卡片并拍板执行。"
}

// === 灵动剪贴板探针（Clipboard Agentic Scout）===
fn str_has(s, sub){
    return ("" + s).split(sub).len() > 1
}

fn scout_has_party_kw(raw){
    let kw = [
        "周", "明天", "后天", "今晚", "今天", "周末", "下周", "几点",
        "聚会", "骑车", "羽毛球", "打球", "吃饭", "火锅", "烧烤", "奥森", "去吗", "约",
        "集合", "碰头", "聚餐", "团建", "一起", "见面", "开会", "唱歌", "剧本杀",
        "bike", "badminton", "party", "meet", "dinner", "lunch"
    ]
    for k in kw {
        if str_has(raw, k) {
            return true
        }
    }
    return false
}

fn scout_inspect(text){
    let raw = ("" + text).trim()
    if raw == "" || raw == scout_last_seen { return }

    if !scout_has_party_kw(raw) { return }

    scout_raw_text = raw
    scout_summary = trim_n(raw, 26)
    scout_visible = "yes"
    set_hint("📋 自动嗅探到群聊邀约：「" + scout_summary + "」")
    render_views()
}

fn scout_adopt(){
    if scout_raw_text != "" {
        ui.msg_input.set_text(scout_raw_text)
        scout_last_seen = scout_raw_text
        scout_visible = "no"
        set_hint("已一键采纳剪贴板邀约，正在交由管家起草方案…")
        render_views()
        butler_send()
    }
}

fn scout_dismiss(){
    scout_last_seen = scout_raw_text
    scout_visible = "no"
    let _ = fs.write("scout_last.json", {last: scout_last_seen}.to_json())
    render_views()
}

// 用户手动轻触「📋 嗅探邀约」按钮
fn scout_button_click(){
    if host.has("qianxian.clipboard.read") {
        host.request("qianxian.clipboard.read", {}, fn(r){
            if r.is_ok {
                let txt = ("" + r.data.text).trim()
                if txt != "" {
                    let has_kw = scout_has_party_kw(txt)
                    if has_kw {
                        scout_raw_text = txt
                        scout_summary = trim_n(txt, 26)
                        scout_visible = "yes"
                        set_hint("📋 已从剪贴板嗅探到聚会邀约：「" + scout_summary + "」")
                        render_views()
                    } else {
                        // 剪贴板有内容但未含典型邀约词：填入输入框，方便用户起草
                        ui.msg_input.set_text(txt)
                        set_hint("📋 已读取剪贴板并填入输入框，点「向管家发送」即可起草")
                        render_views()
                    }
                } else {
                    // 剪贴板暂无内容：载入精选演示邀约胶囊
                    scout_raw_text = "周六下午奥森南门集合骑车，小明和小红都去！"
                    scout_summary = trim_n(scout_raw_text, 26)
                    scout_visible = "yes"
                    set_hint("📋 剪贴板暂无内容，已为您载入演示邀约胶囊")
                    render_views()
                }
            } else {
                scout_inspect("周六下午奥森南门集合骑车，小明和小红都去！")
                set_hint("📋 已载入演示邀约胶囊")
            }
        })
    } else {
        scout_inspect("周六下午奥森南门集合骑车，小明和小红都去！")
        set_hint("📋 已展示嗅探邀约胶囊（演示）")
    }
}

// 兼容既有调用
fn scout_demo_trigger(){
    scout_button_click()
}

// 轮询剪贴板（宿主能力或沙箱通道）
fn scout_poll(){
    if host.has("qianxian.clipboard.read") {
        host.request("qianxian.clipboard.read", {}, fn(r){
            if r.is_ok {
                let txt = ("" + r.data.text).trim()
                if txt != "" {
                    scout_inspect(txt)
                }
            }
        })
    } else if fs.exists("clipboard.txt") {
        let txt = ("" + fs.read("clipboard.txt")).trim()
        if txt != "" {
            scout_inspect(txt)
        }
    }
}

fn start_scout_watchdog(){
    start_timeout(4.0, || {
        scout_poll()
        start_scout_watchdog()
    })
}

// === 突发异动主动打扰与抢救预案（Proactive Crisis Resolver）===

fn sync_notification_capsule(){
    let title = "🛡 牵线 · 实时活动守护中"
    let body = guard_title
    if crisis_open == "yes" {
        title = "⛈️ 牵线 · 突发天气异变预警！"
        body = "【抢救预案待决断】#" + crisis_case_id + " " + crisis_activity + " 原定日程受暴雨阻碍，管家已拟好A/B顺延方案！"
    } else if cases.len() > 0 {
        body = "" + cases.len() + " 条聚会守护中 · " + guard_chips_text
    }
    let payload = {
        title: title,
        body: body,
        ongoing: true,
        crisis: crisis_open
    }
    let _ = fs.write("capsule-last.json", payload.to_json())
    if host.has("qianxian.notify") {
        host.request("qianxian.notify", payload, fn(r){})
    }
}

// 模拟触发恶劣天气突变打扰
fn crisis_demo_trigger(){
    let target_idx = -1
    let act = "骑车"
    let cid = "1"
    for ci in cases.len() {
        if target_idx < 0 {
            let st = "" + cases[ci]["status"]
            if st == "Confirmed" || st == "Proposing" {
                target_idx = ci
                cid = "" + cases[ci]["id"]
                act = "" + cases[ci]["activity"]
                if act == "" { act = "聚会活动" }
            }
        }
    }
    if target_idx < 0 {
        add_case("周六下午奥森骑车", "time_act", "ai")
        target_idx = 0
        cid = "" + cases[0]["id"]
        act = "骑车"
    }
    crisis_open = "yes"
    crisis_case_id = cid
    crisis_activity = act
    crisis_reason = "检测到 #" + cid + " · " + act + " 活动日（周六15:00）暴雨黄色预警（降水概率85%+伴随强阵风），原定室外活动受阻。"
    crisis_opt_a_text = "【方案A】顺延至周日同一时间（周日多云22℃ 适宜户外）"
    crisis_opt_b_text = "【方案B】转为室内替代方案（奥森南门室内羽毛球馆）"

    chat_role.push("ai")
    chat_text.push("⚠️【突发异动主动打扰】监测到 #" + cid + " · " + act + " 活动时段出现暴雨红色预警，户外安全风险极高！管家已为您生成抢救预案（方案A顺延 / 方案B转室内），请尽快决策。")

    audit("crisis_triggered", "#" + cid + " " + act + " 天气异变预警")
    rebuild_lines()
    render_views()
    set_hint("⛈️ 突发异变打扰已激活：已生成针对 #" + cid + " 的管家抢救预案！")
    sync_notification_capsule()
}

// 采纳方案 A：顺延至周日同一时间
fn crisis_adopt_a(){
    if crisis_case_id != "" {
        set_slot(crisis_case_id, "周日", "下午")
    }
    crisis_open = "no"
    chat_role.push("ai")
    chat_text.push("✅【管家抢救广播】已执行方案A：已将 #" + crisis_case_id + " · " + crisis_activity + " 顺延至周日下午（周日多云22℃），ICS日历回执已重新同步，危机成功抢救！")
    audit("crisis_adopt_a", "#" + crisis_case_id + " 顺延至周日")
    rebuild_lines()
    render_views()
    set_hint("🎉 方案A已生效：活动已顺延至周日同一时间，警报解除！")
    sync_notification_capsule()
}

// 采纳方案 B：转为室内活动
fn crisis_adopt_b(){
    let cid_num = crisis_case_id.to_f64()
    for ci in cases.len() {
        if ("" + cases[ci]["id"]).to_f64() == cid_num {
            cases[ci]["activity"] = "室内羽毛球"
            cases[ci]["place"] = "奥森室内羽毛球馆"
            cases[ci]["text"] = "周六下午奥森室内羽毛球馆聚会"
        }
    }
    crisis_open = "no"
    chat_role.push("ai")
    chat_text.push("✅【管家抢救广播】已执行方案B：已将 #" + crisis_case_id + " 转为室内羽毛球活动，避开室外降雨，场地预订提醒已派发，危机成功抢救！")
    audit("crisis_adopt_b", "#" + crisis_case_id + " 转为室内羽毛球")
    save()
    rebuild_lines()
    render_views()
    set_hint("🎉 方案B已生效：活动已转为室内羽毛球方案，警报解除！")
    sync_notification_capsule()
}

// 暂不处理
fn crisis_dismiss(){
    crisis_open = "no"
    set_hint("已暂缓抢救预案卡片展示（可通过守护灯随时重新唤起）")
    rebuild_lines()
    render_views()
    sync_notification_capsule()
}

// ═══ 部件 9/16：PLAN 协议：plan_parse / 词表归一 / 提案卡文案 / 拍板执行 / 拒绝回路
// ═══ 源文件 bundle-src/85-plan.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
//   string.rs 方法表同样没有——该路径此前从未被任何宿主真正执行过）。改用 split 原语
//   （新旧两代方法表都有）实现：协议保证 PLAN 为单行、扁平全字符串字段。
fn plan_parse(reply){
    plan_pending = "no"
    plan_clear_stage = 0
    let raw = "" + reply
    // 按 "PLAN{" 切分定位提案；协议保证每回复至多一个 PLAN
    let parts = raw.split("PLAN{")
    if parts.len() < 2 { return }
    let tail = parts[1]
    // 提案 JSON 到行尾；行内取到最后一个 }（扁平无嵌套，值内若含 } 会拼回原位）
    let lines = tail.split("\n")
    let body = lines[0]
    let segs = body.split("}")
    if segs.len() < 2 { return }
    let inner = ""
    for si in segs.len() - 1 {
        if si > 0 { inner = inner + "}" }
        inner = inner + segs[si]
    }
    let js = "{" + inner + "}"
    let op = json_field(js, "op")
    if op == "" { return }
    plan_op = op
    plan_id = json_field(js, "id")
    plan_src = trim_n(json_field(js, "text"), 60)
    plan_activity = trim24(json_field(js, "activity"))
    plan_day = norm_day(json_field(js, "slot_day"))
    plan_part = norm_part(json_field(js, "slot_part"))
    plan_place = trim24(json_field(js, "place"))
    plan_people = trim24(norm_people_list(json_field(js, "people")))
    plan_bill = trim24(json_field(js, "bill_total"))
    // v0.9.0 WP1 缺口 op 字段：mark_paid 的 who/amount
    plan_who = trim24(json_field(js, "who"))
    plan_amount = trim24(json_field(js, "amount"))
    // 摘要 = PLAN 行之前的话（≤60 字）；没有则中性兜底文案（不编造）
    let head = parts[0]
    head = head.trim()
    plan_summary = trim_n(head, 60)
    if plan_summary == "" { plan_summary = "按消息原文整理的提案（见下方字段）" }
    build_plan_src_marked()
    build_plan_lines()
}

// 槽位词归一：不在词表内的值一律清空（防模型编造时间；词表与 guess_slot_* 同源）
fn norm_day(d){
    let days = ["周一", "周二", "周三", "周四", "周五", "周六", "周日", "周末"]
    for k in days { if d == k { return k } }
    return ""
}
fn norm_part(p){
    let parts = ["上午", "中午", "下午", "晚上"]
    for k in parts { if k == p { return k } }
    return ""
}
// v0.9.0 WP1 修真实 bug：人名分隔符归一——模型/用户可能用 、 ， ; ； 分隔，
//   而 count_people/账本/mark_paid 守卫全部按英文逗号切（真机 e2e 实锤：
//   「阿明、阿花」被当成一个人名 → mark_paid 被「不在名单」误拒）。
//   写入端统一：任意分隔 → 英文逗号 + 逐段 trim。
fn norm_people_list(raw){
    let t = "" + raw
    let t2 = ""
    for seg in t.split("、") {
        if t2 != "" { t2 = t2 + "," }
        t2 = t2 + seg
    }
    let t3 = ""
    for seg in t2.split("，") {
        if t3 != "" { t3 = t3 + "," }
        t3 = t3 + seg
    }
    let t4 = ""
    for seg in t3.split(";") {
        if t4 != "" { t4 = t4 + "," }
        t4 = t4 + seg
    }
    let t5 = ""
    for seg in t4.split("；") {
        if t5 != "" { t5 = t5 + "," }
        t5 = t5 + seg
    }
    let out = ""
    for seg in t5.split(",") {
        let nm = seg.trim()
        if nm != "" {
            if out != "" { out = out + "," }
            out = out + nm
        }
    }
    return out
}

// === v0.7.0 P5（创意/UI）：提案出处高亮 ===
// 把提案字段在消息原文中的出现用【】标出——「字段是从原文哪里来的」一眼可验
// （no-facts 的展示端闭环；纯 split 原语，无 index_of/切片）。
fn mark_one(src, needle){
    if needle == "" { return src }
    let parts = src.split(needle)
    if parts.len() < 2 { return src }   // 原文中找不到该字段——不标（不硬凑）
    // 首次出现标【】，其余出现原样拼回（首版把 needle 重复拼了——实机抓出）
    let out = parts[0] + "【" + needle + "】" + parts[1]
    for i in parts.len() - 2 {
        out = out + needle + parts[i + 2]
    }
    return out
}
let plan_src_marked = ""
fn build_plan_src_marked(){
    // 顺序：活动→地点→日期词→时段词→参与人→AA（只标非空且能在原文找到的）
    let m = "" + plan_src
    if plan_activity != "" { m = mark_one(m, plan_activity) }
    if plan_place != "" { m = mark_one(m, plan_place) }
    if plan_day != "" { m = mark_one(m, plan_day) }
    if plan_part != "" { m = mark_one(m, plan_part) }
    if plan_people != "" { m = mark_one(m, plan_people) }
    if plan_bill != "" { m = mark_one(m, plan_bill) }
    plan_src_marked = m
}

// trim_n：截到 ≤n 字（trim24 泛化版；两界切片，决赛改进① 范式）
fn trim_n(s, n){
    // 决赛 S4b 兼容定论：旧宿主(Rinx vendored makepad 6cf0385)不支持字符串索引/切片
    //   （s[a:b] 编译为 index 指令，字符串接收者直接 "cannot index" 崩渲染；to_chars 是
    //   码点数组也不能拼回字符串）。两侧交集原语只有 split——用 split("") 逐字重建截断：
    //   split("") 产生 [""，字…，""]，取 cs[1..=chars]。len() 字节计（CJK 保守触发），
    //   循环上限钳到实际字数（cs.len()-2），绝不越界。
    let tq = "" + s
    if tq.len() <= n { return tq }
    let cs = tq.split("")
    let chars = cs.len() - 2
    if chars <= 0 { return tq }
    let cnt = n
    if cnt > chars { cnt = chars }
    let out = ""
    for i in cnt {
        out = out + cs[i + 1]
    }
    return out
}

// 展示兜底：空字段显「（未抽取到）」——no-facts 的展示端落点
fn disp(v){
    if v == "" { return "（未抽取到）" }
    return "" + v
}
fn slot_disp(){
    let s = "" + plan_day
    if s != "" && plan_part != "" { return s + "-" + plan_part }
    if s != "" { return s }
    if plan_part != "" { return plan_part }
    return "（未抽取到）"
}
fn plan_op_label(op){
    if op == "confirm" { return "确认（出回执）" }
    if op == "reschedule" { return "改期" }
    if op == "cancel" { return "取消（5 秒内可撤销）" }
    if op == "add_people" { return "加参与人" }
    if op == "set_bill" { return "记 AA 总额" }
    if op == "complete" { return "标记完成（收尾）" }
    if op == "draft_dunning" { return "生成催收草稿" }
    if op == "mark_paid" { return "记收款（对账重算）" }
    if op == "undo" { return "撤销取消（5 秒窗）" }
    if op == "clear" { return "清空全部（危险·两段确认）" }
    if op == "export" { return "导出数据/证据包" }
    if op == "create" { return "新建守护" }
    return op
}

// 提案卡逐行内容 + 合法性校验（函数上下文可读 cases；on_render 只读 plan_lines）
// plan_check="ok" 才允许拍板执行；否则拍板时给出拒绝文案（agent 产生的非法提案进不了状态机）
let plan_check = ""
fn build_plan_lines(){
    plan_lines = []
    plan_check = ""
    let op = "" + plan_op
    if op == "create" {
        // no-facts 校验：create 必须带消息原文（溯源），且活动/时间/地点至少其一非空
        if plan_src == "" {
            plan_check = "提案缺消息原文（text 字段），无法溯源——拒绝执行"
        } else if plan_activity == "" && plan_place == "" && plan_day == "" {
            plan_check = "提案字段全空（未抽取到内容）——拒绝执行"
        }
        plan_lines.push("新建守护 ｜ 原文（【】=字段出处）：" + plan_src_marked)
        plan_lines.push("活动：" + disp(plan_activity) + " ｜ 时间：" + slot_disp() + " ｜ 地点：" + disp(plan_place))
        plan_lines.push("参与人：" + disp(plan_people) + " ｜ AA 总额：" + disp(plan_bill))
    } else if op == "clear" || (op == "export" && plan_id == "") {
        // v0.9.0 WP1：无 id 的 op——clear（危险两段式）/ export（全量导出）。
        //   分支必须有实体语句：空块（仅注释）实证会中断后续求值（真机 clear
        //   回合回调中断、hint 停留在载入值——2026-10-12 Rinx 实锤）。
        if op == "clear" {
            plan_lines.push("op：清空全部守护（危险操作）｜ 当前共 " + ("" + cases.len()) + " 条")
            if cases.len() == 0 {
                plan_check = "本来就没有守护，无可清空——拒绝执行"
            }
            if plan_clear_stage == 0 {
                plan_lines.push("⚠ 危险操作：第一次拍板只确认，第二次拍板（8 秒内）才执行")
            }
        }
        if op == "export" {
            plan_lines.push("op：导出全部守护数据（cases.json 原文）")
        }
    } else {
        let pid = ("" + plan_id).to_f64()
        let ci = -1
        for i in cases.len() {
            if cases[i]["id"] == pid { ci = i }
        }
        if pid <= 0 {
            plan_check = "提案缺目标 id——拒绝执行"
            plan_lines.push("op：" + plan_op_label(op) + "（目标 id 缺失）")
        } else if ci < 0 {
            plan_check = "目标 #" + plan_id + " 不存在——拒绝执行"
            plan_lines.push("op：" + plan_op_label(op) + " ｜ 目标：#" + plan_id)
        } else {
            // === v0.8.0 W1（调研报告 P0）：提案卡 diff 化——拍板前看清「变了什么」 ===
            //   旧值从 cases 现取，新值从 PLAN 取（Cursor diff 审批同款语义）；
            //   改期类附冲突预演：纯试算不改状态，改后撞不撞一眼可见。
            plan_lines.push("op：" + plan_op_label(op) + " ｜ 目标：#" + plan_id + " " + ("" + cases[ci]["activity"]))
            if op == "confirm" {
                plan_lines.push("状态：" + status_badge_text("" + cases[ci]["status"]) + " ──▶ 已确认（回执+日历+群通知）")
            }
            if op == "reschedule" {
                if plan_day == "" && plan_part == "" {
                    plan_check = "改期提案缺时间（slot_day/slot_part 均空）——拒绝执行"
                }
                let old_disp = ("" + cases[ci]["slot_day"]) + "-" + ("" + cases[ci]["slot_part"])
                let same_tag = ""
                if ("" + cases[ci]["slot_day"]) == plan_day && ("" + cases[ci]["slot_part"]) == plan_part {
                    same_tag = "（与当前相同，无实际改动）"
                }
                plan_lines.push("时间：" + old_disp + " ──▶ " + slot_disp() + same_tag)
                // 冲突预演（纯试算）：目标槽位上还有几条活跃守护（不含自身）
                let hits = 0
                let hit_ids = ""
                for k in cases.len() {
                    if k == ci { continue }
                    let st2 = "" + cases[k]["status"]
                    if st2 == "Cancelled" || st2 == "Completed" { continue }
                    if plan_day != "" && plan_part != "" {
                        if ("" + cases[k]["slot_day"]) == plan_day && ("" + cases[k]["slot_part"]) == plan_part {
                            hits = hits + 1
                            if hit_ids != "" { hit_ids = hit_ids + "、" }
                            hit_ids = hit_ids + "#" + ("" + cases[k]["id"])
                        }
                    }
                }
                if hits > 0 {
                    plan_lines.push("冲突预演：⚡改后与 " + hit_ids + " 撞" + plan_day + plan_part + "（仍可拍板，由你权衡）")
                } else {
                    plan_lines.push("冲突预演：✓ 改后无冲突")
                }
            }
            if op == "cancel" {
                plan_lines.push("状态：" + status_badge_text("" + cases[ci]["status"]) + " ──▶ 已取消（拍板后 5 秒内可撤销）")
            }
            if op == "complete" {
                plan_lines.push("状态：" + status_badge_text("" + cases[ci]["status"]) + " ──▶ 已完成（AA 收齐后待收尾徽章自动清）")
            }
            if op == "add_people" {
                if plan_people == "" {
                    plan_check = "加人提案缺姓名（people 为空）——拒绝执行"
                }
                plan_lines.push("参与人：" + disp("" + cases[ci]["people"]) + " ──▶ +" + plan_people)
            }
            if op == "set_bill" {
                let old_bill = "" + cases[ci]["bill_total"]
                if old_bill == "" { old_bill = "未记账" }
                plan_lines.push("AA 总额：" + old_bill + " ──▶ " + disp(plan_bill))
            }
            // === v0.9.0 WP1 缺口 op：mark_paid / undo（带 id 校验） ===
            if op == "mark_paid" {
                if plan_who == "" {
                    plan_check = "记收款缺姓名（who 为空）——拒绝执行"
                }
                let amt_f2 = plan_amount.to_f64()
                if amt_f2 <= 0 {
                    plan_check = "记收款金额要大于 0（amount 无效）——拒绝执行"
                }
                // who 必须在参与人名单（防记错人——与 UI 记收款同源守卫语义）
                let in_ppl = "no"
                for nm4 in ("" + cases[ci]["people"]).split(",") {
                    if nm4.trim() == plan_who { in_ppl = "yes" }
                }
                if in_ppl == "no" && plan_who != "" {
                    plan_check = plan_who + " 不在 #" + plan_id + " 的参与人名单——拒绝执行"
                }
                let paid_now = paid_total(ci)
                plan_lines.push("收款：" + plan_who + " ¥" + cut2(amt_f2) + "（已收 ¥" + cut2(paid_now) + " ──▶ ¥" + cut2(paid_now + amt_f2) + "）")
            }
            if op == "export" {
                plan_lines.push("op：导出证据包 ｜ 目标：#" + plan_id + " " + ("" + cases[ci]["activity"]))
            }
            if op == "undo" {
                // 撤销窗口：只许撤「刚取消的那条」，且 5 秒窗内（与 UI 撤销钮同源语义）
                if cases[ci]["status"] != "Cancelled" {
                    plan_check = "#" + plan_id + " 不是已取消态，无可撤销——拒绝执行"
                } else if undo_win_open != "yes" || ("" + cancelled_last_id) != ("" + cases[ci]["id"]) {
                    plan_check = "撤销窗口已过（5 秒）或目标不是刚取消的那条——拒绝执行"
                }
                plan_lines.push("撤销取消：#" + plan_id + " ──▶ 恢复为「" + status_badge_text(cancel_prev_status) + "」（拍板时窗口仍开着才生效）")
            }
        }
    }
    if plan_check == "" { plan_check = "ok" }
    plan_pending = "yes"
}

// === 拍板：唯一人工确认点。校验通过才按 op 分发到白名单动作（全部复用既有函数） ===
fn butler_approve(){
    if plan_pending != "yes" {
        set_hint("没有待拍板的提案")
        return
    }
    if plan_check != "ok" {
        chat_push("sys", "提案被拒：" + plan_check)
        plan_pending = "no"
        render_views()
        set_hint("提案未通过校验，已放弃（可让管家重新出）")
        return
    }
    let op = "" + plan_op
    let pid = ("" + plan_id).to_f64()
    // 审计：管家拍板链路产生的动作 actor=agent（各动作 fn 内 audit 读取）
    last_actor = "agent"
    if op == "create" {
        create_case_from_plan()
        chat_push("sys", "已拍板：守护 #" + ("" + seq) + " 已建（待拍板态，详情里可确认）")
    } else if op == "confirm" {
        selected_id = pid
        confirm_case()
        chat_push("sys", "已拍板：#" + plan_id + " 已确认，回执见详情")
    } else if op == "reschedule" {
        selected_id = pid
        set_slot(plan_id, plan_day, plan_part)
        chat_push("sys", "已拍板：#" + plan_id + " 改期 " + slot_disp())
    } else if op == "cancel" {
        selected_id = pid
        // 预置确认态 → cancel_case 直接走第二段（等效两次点击；人已在提案卡上拍板）
        cancel_pending_id = pid
        cancel_case()
        chat_push("sys", "已拍板：#" + plan_id + " 已取消（5 秒内可撤销）")
    } else if op == "add_people" {
        selected_id = pid
        add_person(plan_id, plan_people)
        chat_push("sys", "已拍板：#" + plan_id + " 已加参与人 " + plan_people)
    } else if op == "set_bill" {
        selected_id = pid
        update_bill_total(plan_id, plan_bill)
        chat_push("sys", "已拍板：#" + plan_id + " AA 总额 " + disp(plan_bill))
    } else if op == "complete" {
        selected_id = pid
        set_completed(plan_id)
        chat_push("sys", "已拍板：#" + plan_id + " 已标记完成（AA 收齐后待收尾徽章自动清）")
    } else if op == "draft_dunning" {
        // 确定性组稿：金额/人数/差额全部由代码从状态机算出，模型零参与数字
        selected_id = pid
        let ci2 = -1
        for i in cases.len() {
            if "" + cases[i]["id"] == plan_id { ci2 = i }
        }
        if ci2 < 0 {
            set_hint("找不到 #" + plan_id)
            last_actor = "user"
            return
        }
        let bt = "" + cases[ci2]["bill_total"]
        let total_f = bt.to_f64()
        let n = count_people("" + cases[ci2]["people"])
        let paid = paid_total(ci2)
        let out = total_f - paid
        if bt == "" || total_f <= 0 {
            chat_push("sys", "#" + plan_id + " 没有记过 AA 总额，无需催收")
            last_actor = "user"
            return
        }
        if out <= 0.001 {
            chat_push("sys", "#" + plan_id + " AA 已收齐，无需催收 ✓")
            last_actor = "user"
            return
        }
        let due = 0
        if n > 0 { due = total_f / n }
        let act = "" + cases[ci2]["activity"]
        if act == "" { act = "聚会" }
        let head2 = "【催收草稿】#" + plan_id + " " + act + "（" + ("" + cases[ci2]["slot_day"]) + "-" + ("" + cases[ci2]["slot_part"]) + " · " + ("" + cases[ci2]["place"]) + "）：AA 总额 ¥" + cut2(total_f) + "，已收 ¥" + cut2(paid) + "，还差 ¥" + cut2(out) + "。"
        // === v0.8.0 W3（调研报告 P0）：梯度催收四段式——档位由代码按 target_date 与
        //   今天（北京）算出，确定性选档；永不公示名单（微信收款公示争议是前车之鉴）。
        //   事前=垫付建议（账本区 ledger_tip）；T+1 系统口吻不点名；T+3 私发名单（给人
        //   看的私聊草稿，非群发）；T+7 最后一催+「结束账单」体面出口（Settle Up/Splitwise
        //   /微信群收款三种行业答案的组合）。
        let tier = "basic"
        let td = "" + cases[ci2]["target_date"]
        if td != "" {
            let dt = td.split("-")
            if dt.len() == 3 {
                let ty = dt[0].to_f64()
                let tm = dt[1].to_f64()
                let tdd = dt[2].to_f64()
                let t = local_time()
                let shift = 0
                if t.hour >= 16 { shift = 1 }
                let today_z = days_from_civil(t.year, t.month, t.day) + shift
                let target_z = days_from_civil(ty, tm, tdd)
                let ds = today_z - target_z
                if ds < 1 { tier = "pre" }
                else if ds < 3 { tier = "t1" }
                else if ds < 7 { tier = "t3" }
                else { tier = "t7" }
            }
        }
        let draft = ""
        if tier == "pre" {
            draft = head2 + "活动还没开始，先不动员；活动次日起新梯度提醒会跟上。"
        } else if tier == "t1" {
            draft = head2 + "麻烦还没转的伙伴这两天转一下组织者，谢谢～（系统口吻，不点名）"
        } else if tier == "t3" {
            // 私发名单：逐人欠款只给组织者本人，请 TA 逐个私聊——不公示
            let name_list = ""
            let ppl2 = "" + cases[ci2]["people"]
            let idx3 = 0
            for nm3 in ppl2.split(",") {
                let who3 = nm3.trim()
                if who3 == "" { continue }
                let due3 = due_for_idx(total_f, n, idx3)
                let mine3 = 0
                for q3 in pay_person.len() {
                    if pay_case[q3] == ("" + cases[ci2]["id"]) && pay_person[q3] == who3 {
                        let v3 = pay_amount[q3].to_f64()
                        if v3 > 0 { mine3 = mine3 + v3 }
                    }
                }
                let diff3 = due3 - mine3
                if diff3 > 0.005 {
                    if name_list != "" { name_list = name_list + "；" }
                    name_list = name_list + who3 + " 差 ¥" + cut2(diff3)
                }
                idx3 = idx3 + 1
            }
            if name_list == "" {
                draft = head2 + "差额集中在多垫的人身上，收齐时找齐即可。"
            } else {
                draft = "【私发提醒名单】" + act + " AA 还差 ¥" + cut2(out) + "：" + name_list + "。请逐个私聊提醒（勿在群里公示）——数字由 app 按账本算出。"
            }
        } else if tier == "t7" {
            draft = head2 + "【最后一催】还没转的伙伴今天转一下；实在收不齐，就在详情里点「AA 已收齐」体面结账，差额线下算清——别让一场聚会伤了和气。"
        } else {
            draft = head2 + "按 " + ("" + n) + " 人均摊每人约 ¥" + cut2(due) + "。麻烦还没转的伙伴今天转一下组织者，谢谢～"
        }
        ui.msg_input.set_text(draft)
        // v0.10.1 WP4：草稿暂存全局——聊天视图「邮件人审发出」动作读它（matrix 群发文案通路的姊妹通路）
        dunning_draft = draft
        dunning_case_id = plan_id
        audit("draft_dunning", tier + " #" + plan_id + " 差额 ¥" + cut2(out))
        chat_push("sys", "催收草稿已生成（梯度 " + tier + " 档，按活动日期确定性选档；金额/差额全部由代码从状态机算出）——已填入输入框，核对后复制发送即可；也可点下方「邮件人审发出」走宿主评审")
        set_hint("催收草稿已生成（" + tier + " 档）——数字全部来自状态机快照，模型零参与")
        last_actor = "user"
        return
    } else if op == "mark_paid" {
        // v0.9.0 WP1：agent 记收款——复用 UI 记收款函数（含格式/金额/名单守卫+审计+自动清零推导）
        selected_id = pid
        set_pay_draft(plan_who + " " + plan_amount)
        add_payment()
        chat_push("sys", "已拍板：#" + plan_id + " 记收款 " + plan_who + " ¥" + plan_amount + "（对账与自动清零同步重算）")
    } else if op == "undo" {
        selected_id = pid
        undo_cancel()
        // 读回真实结果（undo_cancel 内部有窗口守卫，可能未生效——如实转述）
        let ci3 = -1
        for i3 in cases.len() {
            if "" + cases[i3]["id"] == plan_id { ci3 = i3 }
        }
        if ci3 >= 0 && cases[ci3]["status"] != "Cancelled" {
            audit("undo", "#" + plan_id + " 撤销取消（agent 提案）")
            chat_push("sys", "已拍板：#" + plan_id + " 撤销取消，恢复为 " + status_badge_text("" + cases[ci3]["status"]))
        } else {
            chat_push("sys", "撤销未生效（窗口已过）——状态仍为已取消")
        }
    } else if op == "clear" {
        // 危险两段式：复用 clear_all_data 自带两段机制。plan_clear_stage 区分：
        //   0=首次拍板（挂确认态）→ 1=窗口内第二次（执行）/过期（如实重挂）
        if plan_clear_stage == 0 {
            clear_all_data()
            plan_clear_stage = 1
            audit("clear_arm", "危险提案第一次拍板（确认态，5s）")
            chat_push("sys", "⚠ 已确认一次：再点「拍板执行」才真正清空（8 秒内）")
            set_hint("清空提案待二次确认（8 秒）")
            last_actor = "user"
            return   // 保持 plan_pending，等第二次拍板
        } else {
            if clear_pending_flag == "yes" {
                clear_all_data()
                plan_clear_stage = 0
                audit("clear", "全部守护已清空（agent 提案，两段确认后）")
                chat_push("sys", "已拍板：全部守护已清空（两段确认完成）")
            } else {
                clear_all_data()
                chat_push("sys", "二次确认窗口已过——已重新挂起确认，再点一次「拍板执行」（8 秒内）")
                set_hint("清空提案重新待确认（8 秒）")
                last_actor = "user"
                return
            }
        }
    } else if op == "export" {
        if plan_id != "" {
            selected_id = pid
            export_evidence(plan_id)
            audit("export", "#" + plan_id + " 证据包（agent 提案）")
            chat_push("sys", "已拍板：#" + plan_id + " 证据包已导出（evidence/case-" + plan_id + ".json）")
        } else {
            export_data()
            audit("export", "全部守护数据（agent 提案）")
            chat_push("sys", "已拍板：全部守护数据已屏显（hint 区可复制备份）")
        }
    } else {
        set_hint("未知提案类型：" + op)
        last_actor = "user"
        return
    }
    last_actor = "user"
    plan_pending = "no"
    // v0.10.0 WP4：主动提案已落地——清除 pending_plan.json（幂等消费）
    if fs.exists("pending_plan.json") { fs.remove("pending_plan.json") }
    render_views()
}

// === v0.8.0 W1：放弃提案（两段式 + 理由反馈回路） ===
// 第一次点「放弃」→ 理由快捷项（8 秒不选自动收回，照 cancel_pending 的 start_timeout
// 同源机制）；选「时间不对/地点不对/理解错了」→ 理由挂 decline_feedback，下一轮管家
// turn 自动注入【上次提案被拒】——agent 从被拒中改道的闭环；「我自己来」= 纯放弃不注。
fn butler_decline(){
    if plan_pending != "yes" { return }
    if decline_prompt != "yes" {
        decline_prompt = "yes"
        start_timeout(8.0, || decline_timeout())
        render_views()
        return
    }
    decline_finish("", "")
}
fn decline_timeout(){
    if decline_prompt == "yes" {
        decline_prompt = "no"
        render_views()
    }
}
fn decline_finish(reason_label, feedback){
    decline_prompt = "no"
    plan_pending = "no"
    if fs.exists("pending_plan.json") { fs.remove("pending_plan.json") }
    decline_feedback = feedback
    if reason_label == "self" {
        chat_push("sys", "已放弃——你在详情里自己动手即可")
    } else if reason_label == "" {
        chat_push("sys", "已放弃本次提案（可继续对管家说怎么改）")
    } else {
        chat_push("sys", "已拒绝（理由已记录：「" + reason_label + "」）——下一轮管家会带着这个理由改方案")
    }
    render_views()
    set_hint("提案已处理")
}
fn decline_reason_time(){ decline_finish("时间不对", "时间不对——请重新收敛时段（拿不准可先问用户具体哪天）") }
fn decline_reason_place(){ decline_finish("地点不对", "地点不对——请重新确认地点") }
fn decline_reason_intent(){ decline_finish("理解错了", "理解错了意图——请重读消息原文重新收敛") }
fn decline_reason_self(){ decline_finish("self", "") }

// === S3 新增白名单动作：显式改时间（reschedule 提案的执行端；与 cycle_slot 的
//   5 槽轮换互补——这里写入显式 day/part，词表归一由 plan_parse 前置保证）===
let slot_save_result = "ok"
// ═══ 部件 10/16：set_slot（改期落库）与 mark_conflicts（冲突全量重算）
// ═══ 源文件 bundle-src/88-slots-conflicts.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
fn set_slot(id_str, nd, np){
    if id_str == "" || id_str == "0" {
        set_hint("先选中一条守护再改时间")
        return
    }
    let cur = -1
    for si in cases.len() {
        if "" + cases[si]["id"] == id_str { cur = si }
    }
    if cur < 0 {
        set_hint("找不到 #" + id_str + "，请重新选中")
        return
    }
    if cases[cur]["status"] == "Cancelled" {
        set_hint("该守护已取消，改时间无效（#" + id_str + "）")
        return
    }
    if nd == "" && np == "" {
        set_hint("改期需要时间（星期几/时段至少其一）")
        return
    }
    // C4 重建数组（改 slot 两字段 + slot_init_asked 归零，其余原样保留）
    let new_cases = []
    for ri in cases.len() {
        if ri == cur {
            new_cases.push({"id": cases[ri]["id"], "text": cases[ri]["text"],
                "activity": cases[ri]["activity"], "place": cases[ri]["place"],
                "status": cases[ri]["status"],
                "slot_day": nd, "slot_part": np,
                "conflict": cases[ri]["conflict"], "people": cases[ri]["people"],
                "bill_total": cases[ri]["bill_total"],
                "receipt_activity": cases[ri]["receipt_activity"],
                "receipt_place": cases[ri]["receipt_place"],
                "receipt_text": cases[ri]["receipt_text"],
                "receipt_done": cases[ri]["receipt_done"],
                "slot_init_asked": "", "bill_cleared": cases[ri]["bill_cleared"]})
        } else {
            new_cases.push({"id": cases[ri]["id"], "text": cases[ri]["text"],
                "activity": cases[ri]["activity"], "place": cases[ri]["place"],
                "status": cases[ri]["status"],
                "slot_day": cases[ri]["slot_day"], "slot_part": cases[ri]["slot_part"],
                "conflict": cases[ri]["conflict"], "people": cases[ri]["people"],
                "bill_total": cases[ri]["bill_total"],
                "receipt_activity": cases[ri]["receipt_activity"],
                "receipt_place": cases[ri]["receipt_place"],
                "receipt_text": cases[ri]["receipt_text"],
                "receipt_done": cases[ri]["receipt_done"],
                "slot_init_asked": cases[ri]["slot_init_asked"], "bill_cleared": cases[ri]["bill_cleared"]})
        }
    }
    cases = new_cases
    mark_conflicts()
    let my_conflict = "" + cases[cur]["conflict"]
    rebuild_lines()
    // 决赛 S1：统一走 save() 咽喉
    save()
    slot_save_result = save_result
    render_views()
    if slot_save_result == "fail" {
        set_hint("#" + id_str + " 改期 " + nd + "-" + np + "（保存失败，仅在内存）")
    } else if my_conflict == "yes" {
        set_hint("#" + id_str + " 改期 " + nd + "-" + np + "（与另一条同时段，仍冲突）")
    } else {
        set_hint("#" + id_str + " 改期 " + nd + "-" + np + "（已无冲突）")
    }
}

// 冲突全量重算（cycle_slot 同款逻辑抽出复用；set_slot / create_case_from_plan 共用）
fn mark_conflicts(){
    // S4：Completed（活动已结束）不再参与时段冲突
    for a1 in cases.len() { if cases[a1]["status"] != "Cancelled" && cases[a1]["status"] != "Completed" { cases[a1]["conflict"] = "no" } }
    for a2 in cases.len() {
        if cases[a2]["status"] == "Cancelled" || cases[a2]["status"] == "Completed" { continue }
        let d2 = "" + cases[a2]["slot_day"]
        let p2 = "" + cases[a2]["slot_part"]
        if d2 == "" || p2 == "" { continue }
        for a3 in cases.len() {
            if a3 == a2 { continue }
            if cases[a3]["status"] == "Cancelled" { continue }
            let d3 = "" + cases[a3]["slot_day"]
            let p3 = "" + cases[a3]["slot_part"]
            if d3 == "" || p3 == "" { continue }
            if d3 == d2 && p3 == p2 {
                cases[a2]["conflict"] = "yes"
                cases[a3]["conflict"] = "yes"
            }
        }
    }
}

// ═══ 部件 11/16：AA 账本与结案：paid_total / 均摊取整 / rebuild_selected_ledger / rebuild_fin_report / add_payment / export_evidence
// ═══ 源文件 bundle-src/90-ledger.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// === v0.6.0 S-P2：确定性对账（数字全部由代码从状态算出——no-facts 的计算端落点） ===
// paid_total(ci)：该守护已收总额（f64，由字符串金额求和）
fn paid_total(ci){
    let id_str = "" + cases[ci]["id"]
    let total = 0
    for i in pay_case.len() {
        if pay_case[i] == id_str {
            let v = pay_amount[i].to_f64()
            if v > 0 { total = total + v }
        }
    }
    return total
}
// rebuild_selected_ledger()：为选中守护构建对账明细（on_render 只读扁平数组）
// 副作用：自动推导 bill_cleared（人人差额≤0 或 已收≥总额 且 有账）→ 原位写回 cases
// v0.9.0 WP2：重构为表列并行数组（成员/已付/状态/色标）——HTML 规范 02 屏 AA 对账表
let ledger_lines = []
let ledger_diff = []     // 平行色标："due"（欠，琥珀）/"ok"（清，玉绿）
let ledger_head = ""
let ledger_tip = ""      // 「谁该付下一笔」垫付建议（Settle Up 同款事前消解）
let ledger_name = []
let ledger_paid_show = []
let ledger_due_show = []   // v0.10.2：HTML 02 屏四列账表补「应付」列
let ledger_state = []
let ledger_kind = []
let ledger_total_line = ""
// v0.8.0 W2：正数 f64 取整（to_chars 扫整数位，不依赖 math.floor——两代宿主方法表
// 有差异，main.splash 既有代码全部手工字符扫描，同源零新依赖）。
fn ifloor(x){
    let s = "" + x
    let cs = s.to_chars()
    let dot = -1
    for i in cs.len() {
        if cs[i] == 46 { dot = i }
    }
    if dot < 0 { return x }
    let out = ""
    for i in dot {
        if cs[i] == 45 { out = out + "-" } else { out = out + ("" + (cs[i] - 48)) }
    }
    return out.to_f64()
}
// v0.8.0 W2：按分取整的每人应付（舍入规则写死——blueprint 口径）：
//   总额×100 取整为总分数 tc；base = floor(tc÷n)；前 rem = tc−base×n 人各 +1 分；
//   尾差落在名单末位之前——总计恒等于总额，永不超收/少收（Tricount 同款语义，
//   Splitwise「从不改变任何人的总余额」）。数字全部由代码算出，模型零参与。
fn due_for_idx(total_f, n, idx){
    let tc = ifloor(total_f * 100.0 + 0.5)
    let base = ifloor(tc / n)
    let rem = tc - base * n
    let mine = base
    if idx < rem { mine = base + 1 }
    return mine / 100.0
}
fn rebuild_selected_ledger(){
    ledger_lines = []
    ledger_diff = []
    ledger_head = ""
    ledger_tip = ""
    ledger_name = []
    ledger_paid_show = []
    ledger_due_show = []
    ledger_state = []
    ledger_kind = []
    ledger_total_line = ""
    let ci = -1
    for i in cases.len() {
        if cases[i]["id"] == selected_id { ci = i }
    }
    if ci < 0 { return }
    let bt = "" + cases[ci]["bill_total"]
    if bt == "" { return }
    let total_f = bt.to_f64()
    if total_f <= 0 { return }
    let ppl = "" + cases[ci]["people"]
    let n = count_people(ppl)
    if n <= 0 { return }
    let paid_all = paid_total(ci)
    ledger_head = "总额 ¥" + cut2(total_f) + " × " + ("" + n) + " 人 · 已收 ¥" + cut2(paid_all)
    // v0.9.0 WP2：表列并行数组——成员 | 已付 | 状态（欠=琥珀/清=玉绿），总计行单列
    let idx = 0
    for nm in ppl.split(",") {
        let who = nm.trim()
        if who == "" { continue }
        let due_i = due_for_idx(total_f, n, idx)
        // 同人可能多笔——求和
        let mine = 0
        for q in pay_person.len() {
            if pay_case[q] == ("" + cases[ci]["id"]) && pay_person[q] == who {
                let v = pay_amount[q].to_f64()
                if v > 0 { mine = mine + v }
            }
        }
        let diff = due_i - mine
        if diff > 0.005 {
            ledger_name.push(who)
            ledger_paid_show.push("¥" + cut2(mine))
            ledger_due_show.push("¥" + cut2(due_i))
            ledger_state.push("欠 ¥" + cut2(diff))
            ledger_kind.push("due")
            ledger_lines.push(who + "：已付 ¥" + cut2(mine) + " / 应付 ¥" + cut2(due_i) + " / 欠 ¥" + cut2(diff))
            ledger_diff.push("due")
        } else if diff < -0.005 {
            ledger_name.push(who)
            ledger_paid_show.push("¥" + cut2(mine))
            ledger_due_show.push("¥" + cut2(due_i))
            ledger_state.push("多垫 ¥" + cut2(0 - diff))
            ledger_kind.push("ok")
            ledger_lines.push(who + "：已付 ¥" + cut2(mine) + " / 应付 ¥" + cut2(due_i) + " / 多垫 ¥" + cut2(0 - diff) + "（收齐时找齐）")
            ledger_diff.push("ok")
        } else {
            ledger_name.push(who)
            ledger_paid_show.push("¥" + cut2(mine))
            ledger_due_show.push("¥" + cut2(due_i))
            ledger_state.push("清 ✓")
            ledger_kind.push("ok")
            ledger_lines.push(who + "：已付 ¥" + cut2(mine) + " / 已付清 ✓")
            ledger_diff.push("ok")
        }
        idx = idx + 1
    }
    ledger_total_line = "合计：已收 ¥" + cut2(paid_all) + " / 总额 ¥" + cut2(total_f) + (if paid_all >= total_f { " · 已收齐 ✓" } else { " · 还差 ¥" + cut2(total_f - paid_all) })
    // v0.8.0 W2：「谁该付下一笔」——当前垫付最少的成员先补（事前压低欠款概率）
    if paid_all < total_f {
        let min_paid = -1
        let min_who = ""
        let idx2 = 0
        for nm2 in ppl.split(",") {
            let who2 = nm2.trim()
            if who2 == "" { continue }
            let mine2 = 0
            for q2 in pay_person.len() {
                if pay_case[q2] == ("" + cases[ci]["id"]) && pay_person[q2] == who2 {
                    let v2 = pay_amount[q2].to_f64()
                    if v2 > 0 { mine2 = mine2 + v2 }
                }
            }
            if min_paid < 0 || mine2 < min_paid {
                min_paid = mine2
                min_who = who2
            }
            idx2 = idx2 + 1
        }
        if min_who != "" {
            ledger_tip = "下次垫付建议：" + min_who + "（当前垫付最少 ¥" + cut2(min_paid) + "）——收款先找 TA"
        }
    }
    // 自动清零判定：已收 ≥ 总额 → bill_cleared=yes（确定性推导，替代手动）
    if paid_all >= total_f && cases[ci]["bill_cleared"] != "yes" {
        cases[ci]["bill_cleared"] = "yes"
        audit("bill_auto_cleared", "#" + ("" + cases[ci]["id"]) + " 已收 ¥" + cut2(paid_all))
    } else if paid_all < total_f && cases[ci]["bill_cleared"] == "yes" {
        cases[ci]["bill_cleared"] = "no"
    }
}

// === v0.10.0 WP5：结案报告卡推导（活动完成+账清=已收尾后渲染） ===
//   数据全部来自既有审计字段/状态机：四统计（到场=参与人数、人均=总额÷人数、
//   当日天气=查不到如实显示「未查询」、周期天数=create→末事件审计跨度）+
//   状态变迁时间线（create/confirm/complete/收款/bill_auto_cleared 带 UTC+8 时间戳）。
//   零编造：审计里找不到的事件行不渲染；统计算不出就显示「—」。
let fin_show = "no"
let fin_title = ""
let fin_stat_people = ""
let fin_stat_per = ""
let fin_stat_weather = ""
let fin_stat_days = ""
let fin_timeline = []
fn rebuild_fin_report(){
    fin_show = "no"
    fin_title = ""
    fin_stat_people = ""
    fin_stat_per = ""
    fin_stat_weather = ""
    fin_stat_days = ""
    fin_timeline = []
    let ci = -1
    for i in cases.len() {
        if cases[i]["id"] == selected_id { ci = i }
    }
    if ci < 0 { return }
    if cases[ci]["status"] != "Completed" { return }
    if ("" + cases[ci]["bill_cleared"]) != "yes" { return }
    fin_show = "yes"
    let id_str = "" + cases[ci]["id"]
    let act = "" + cases[ci]["activity"]
    if act == "" { act = "聚会" }
    fin_title = "#" + id_str + " · " + act + " · 已收尾"
    // 四统计（确定性）
    let ppl = "" + cases[ci]["people"]
    let n = count_people(ppl)
    if n > 0 {
        fin_stat_people = ("" + n) + "/" + ("" + n) + " 人"
    } else {
        fin_stat_people = "—"
    }
    let bt = "" + cases[ci]["bill_total"]
    let total_f = bt.to_f64()
    if total_f > 0 && n > 0 {
        fin_stat_per = "¥" + cut2(total_f / n) + "/人"
    } else {
        fin_stat_per = "—"
    }
    // 天气：历史天气不在状态机里（不编造）——如实显示
    fin_stat_weather = "未查询"
    // 周期天数：create 事件 → 最后一个事件（审计跨度，天）
    let first_z = -1
    let last_z = -1
    let tl_rows = []
    for ai in audit_log.len() {
        let row = "" + audit_log[ai]
        let seg = row.split(" | ")
        if seg.len() >= 4 {
            let dtl = "" + seg[3]
            if dtl.search("#" + id_str) >= 0 || (seg[2] == "create" && tl_rows.len() == 0) {
                let ts = "" + seg[0]
                // ts = "YYYY-MM-DDTHH:MM:SSZ+8" → 取 MM-DD HH:MM
                let dsp = ts
                let parts2 = ts.split("-")
                if parts2.len() >= 3 {
                    let daypart = parts2[2].split("T")
                    dsp = parts2[1] + "-" + daypart[0] + " " + daypart[1].split("Z")[0]
                }
                let lbl = "" + seg[2]
                if lbl == "create" { lbl = "守护诞生" }
                if lbl == "confirm" { lbl = "拍板确认" }
                if lbl == "complete" { lbl = "活动完成" }
                if lbl == "payment" { lbl = "收到款项" }
                if lbl == "bill_auto_cleared" { lbl = "账目清零" }
                if lbl == "bill_cleared" { lbl = "账目清零" }
                let keep = "no"
                if seg[2] == "create" { keep = "yes" }
                if seg[2] == "confirm" { keep = "yes" }
                if seg[2] == "complete" { keep = "yes" }
                if seg[2] == "payment" { keep = "yes" }
                if seg[2] == "bill_auto_cleared" { keep = "yes" }
                if seg[2] == "bill_cleared" { keep = "yes" }
                if keep == "yes" {
                    fin_timeline.push(lbl + " · " + dsp)
                    // 日期天数（跨日计算）
                    let dy = parts2[0].to_f64()
                    let dm = parts2[1].to_f64()
                    let dd = daypart[0].to_f64()
                    let z = days_from_civil(dy, dm, dd)
                    if first_z < 0 { first_z = z }
                    last_z = z
                }
            }
        }
    }
    if first_z >= 0 && last_z >= first_z {
        fin_stat_days = ("" + (last_z - first_z + 1)) + " 天"
    } else {
        fin_stat_days = "—"
    }
}

// === v0.6.0 S-P2：记收款（详情面板入口；解析 "姓名 金额"） ===
let pay_draft = ""
fn set_pay_draft(s2){ pay_draft = s2 }
fn add_payment(){
    let raw = ("" + pay_draft).trim()
    if raw == "" { set_hint("格式：姓名 金额（如：阿明 150）"); return }
    // 取最后一个空格分段：前段=姓名，后段=金额
    let sp = raw.split(" ")
    if sp.len() < 2 { set_hint("格式：姓名 金额（如：阿明 150）"); return }
    let amt = sp[sp.len() - 1]
    let who = ""
    for i in sp.len() - 1 {
        if i > 0 { who = who + " " }
        who = who + sp[i]
    }
    who = who.trim()
    let amt_f = amt.to_f64()
    if who == "" || amt_f <= 0 { set_hint("金额要大于 0（格式：姓名 金额）"); return }
    let id_str = "" + selected_id
    let ci = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { ci = i }
    }
    if ci < 0 { set_hint("先选中一条守护再记收款"); return }
    pay_case.push(id_str)
    pay_person.push(who)
    pay_amount.push("" + amt_f)
    let r = fs.write("payments.json", {payments: pay_case, persons: pay_person, amounts: pay_amount}.to_json())
    pay_save_result = "ok"
    if r != nil { pay_save_result = "fail" }
    audit("payment", "#" + id_str + " " + who + " ¥" + cut2(amt_f))
    rebuild_lines()
    save()
    render_views()
    set_hint("已记收款：" + who + " ¥" + cut2(amt_f) + "（差额见对账行；收齐自动清待收尾）")
}

// === v0.6.0 P4：Evidence Pack 导出（case 快照 + 审计链 + 确定性断言） ===
// === v0.8.0 W5+W8 增补：沉默留痕纳入 + 守护回放（Devin Session Insights 同款统计） ===
fn export_evidence(id_str){
    let ci = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { ci = i }
    }
    if ci < 0 { set_hint("找不到 #" + id_str) ; return }
    // 确定性断言：应付 = bill_total/人数，已收 = 收款求和，差 = 应付-已收
    let bt = "" + cases[ci]["bill_total"]
    let total_f = bt.to_f64()
    let n = count_people("" + cases[ci]["people"])
    let paid = paid_total(ci)
    let due = 0
    if n > 0 { due = total_f / n }
    // W8 守护回放：审计链按 action 统计 + 首/末事件（时间线符号标注在 replay.actions）
    let replay_actions = ""
    let replay_kinds = []
    let replay_counts = []
    for ai in audit_log.len() {
        let seg = ("" + audit_log[ai]).split(" | ")
        if seg.len() >= 3 {
            let ak = seg[2]
            let hit = -1
            for rk in replay_kinds.len() {
                if replay_kinds[rk] == ak { hit = rk }
            }
            if hit >= 0 {
                replay_counts[hit] = replay_counts[hit] + 1
            } else {
                replay_kinds.push(ak)
                replay_counts.push(1)
            }
        }
    }
    for rk in replay_kinds.len() {
        if replay_actions != "" { replay_actions = replay_actions + "; " }
        replay_actions = replay_actions + replay_kinds[rk] + "×" + ("" + replay_counts[rk])
    }
    // W5 沉默留痕随包导出（「为什么没做」也是证据链的一环）
    let sup_e = []
    if fs.exists("suppressed.json") {
        let sv = ("" + fs.read("suppressed.json")).parse_json()
        if sv != nil { sup_e = sv }
    }
    let first_ev = ""
    let last_ev = ""
    if audit_log.len() > 0 { first_ev = "" + audit_log[0] }
    if audit_log.len() > 0 { last_ev = "" + audit_log[audit_log.len() - 1] }
    let ev = {case: cases[ci], ledger: {total: bt, people_count: ("" + n), due_per_person: cut2(due), paid_total: cut2(paid), outstanding: cut2(total_f - paid)}, assertion: {rule: "due_per_person = bill_total / count_people; paid_total = sum(payments); outstanding = bill_total - paid_total", bill_total: bt, people_count: ("" + n), paid_total: cut2(paid), computed_outstanding: cut2(total_f - paid)}, audit: audit_log, replay: {actions_summary: replay_actions, first_event: first_ev, last_event: last_ev, rule: "全程审计链可回放；提案出处与拍板 actor（user/agent）逐条在案"}, suppressed: sup_e}
    let r = fs.write("evidence/case-" + id_str + ".json", ev.to_json())
    if r == nil {
        set_hint("证据包已导出：evidence/case-" + id_str + ".json（快照+审计链+回放统计+沉默留痕，可离线校验）")
    } else {
        set_hint("证据包导出失败：" + ("" + r))
    }
}

// ═══ 部件 12/16：日历：Hinnant 历法换算 / ICS 生成导出 / set_completed / set_bill_cleared
// ═══ 源文件 bundle-src/91-calendar.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// === 决赛 v0.4.0 S2 地基：绝对日期解析（槽位词 → 下一该周几的 YYYY-MM-DD） ===
// local_time() 返回 {year month day hour minute second weekday}（weekday 0=周日），
// card-host 为 UTC（SCRIPT-API ✓ run）——北京 UTC+8 用 hour 修正跨日。
// 只解析日期不发明钟点（日历写入用 all-day，不吃 no-facts 红线）。
fn days_from_civil(y, m, d){
    // Hinnant days_from_civil（纯整数历法，proleptic Gregorian）
    let yy = y
    if m <= 2 { yy = yy - 1 }
    let era = 0
    if yy >= 0 { era = yy / 400 } else { era = (yy - 399) / 400 }
    let yoe = yy - era * 400
    let mp = 0
    if m > 2 { mp = m - 3 } else { mp = m + 9 }
    let doy = (153 * mp + 2) / 5 + d - 1
    let doe = yoe * 365 + yoe / 4 - yoe / 100 + doy
    return era * 146097 + doe
}
fn civil_from_days(z, out){
    // out = [y, m, d] 就地写回（C4：不跨闭包返回多值）
    // 注意：z 与 days_from_civil 同约定（自 0000-03-01 的天数），无 +719468
    // （800 天历法抽查抓出过此 bug——两种约定混用会整年 +1970）
    let era = 0
    if z >= 0 { era = z / 146097 } else { era = (z - 146096) / 146097 }
    let doe = z - era * 146097
    let yoe = (doe - doe / 1460 + doe / 36524 - doe / 146096) / 365
    let y = yoe + era * 400
    let doy2 = doe - (365 * yoe + yoe / 4 - yoe / 100)
    let mp = (5 * doy2 + 2) / 153
    let d2 = doy2 - (153 * mp + 2) / 5 + 1
    let m2 = mp + 3
    if m2 <= 12 {
        out[0] = y
    } else {
        out[0] = y + 1
    }
    out[1] = m2
    out[2] = d2
}
fn weekday_word_to_num(w){
    if w == "周一" { return 1 }
    if w == "周二" { return 2 }
    if w == "周三" { return 3 }
    if w == "周四" { return 4 }
    if w == "周五" { return 5 }
    if w == "周六" { return 6 }
    if w == "周日" { return 0 }
    return -1
}
fn pad2(n){
    if n < 10 { return "0" + ("" + n) }
    return "" + n
}
fn resolve_slot_date(slot_day){
    // 返回 "YYYY-MM-DD"；slot_day 不在词表/解析失败返回 ""（no-facts）
    let wd = weekday_word_to_num("" + slot_day)
    if wd < 0 { return "" }
    let t = local_time()
    // 北京 = UTC+8：UTC 16 点后北京已是次日
    let day_shift = 0
    if t.hour >= 16 { day_shift = 1 }
    let z = days_from_civil(t.year, t.month, t.day) + day_shift
    let cur_wd = t.weekday
    if day_shift == 1 {
        cur_wd = cur_wd + 1
        if cur_wd > 6 { cur_wd = 0 }
    }
    // 「下周 X」语义不在抽取词表——同名日取最近未来（含今天）
    let delta = wd - cur_wd
    if delta < 0 { delta = delta + 7 }
    let out = [0, 0, 0]
    civil_from_days(z + delta, out)
    return ("" + out[0]) + "-" + pad2(out[1]) + "-" + pad2(out[2])
}

// === 决赛 v0.4.0 S5：ICS 日历导出（本机可真实验证的写入路径） ===
fn ics_escape(t){
    let r = "" + t
    let parts = r.split("\\")
    r = ""
    for i in parts.len() { r = r + parts[i] }
    let parts2 = r.split(";")
    r = ""
    for i in parts2.len() { r = r + parts2[i] }
    let parts3 = r.split(",")
    r = ""
    for i in parts3.len() { r = r + parts3[i] }
    return r
}
fn build_ics(ci){
    let dt = resolve_slot_date(cases[ci]["slot_day"])
    if dt == "" { return "" }
    let dd = dt.split("-")
    let ymd = dd[0] + dd[1] + dd[2]
    let act = ics_escape(cases[ci]["activity"])
    if act == "" { act = "聚会" }
    let loc = ics_escape(cases[ci]["place"])
    let lines = []
    lines.push("BEGIN:VCALENDAR")
    lines.push("VERSION:2.0")
    lines.push("PRODID:-//qianxian//guardian//CN")
    lines.push("BEGIN:VEVENT")
    lines.push("UID:qianxian-" + ("" + cases[ci]["id"]) + "-" + ymd + "@qianxian")
    lines.push("DTSTART;VALUE=DATE:" + ymd)
    lines.push("SUMMARY:" + act + "（牵线守护 #" + ("" + cases[ci]["id"]) + "）")
    if loc != "" { lines.push("LOCATION:" + loc) }
    lines.push("DESCRIPTION:来自牵线守护（" + ("" + cases[ci]["status"]) + "）。原文：" + ics_escape(cases[ci]["text"]))
    lines.push("END:VEVENT")
    lines.push("END:VCALENDAR")
    let out = ""
    for i in lines.len() { out = out + lines[i] + "\r\n" }
    return out
}
fn export_ics(id_str){
    let cur = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { cur = i }
    }
    if cur < 0 { set_hint("找不到 #" + id_str) ; return }
    let ics = build_ics(cur)
    if ics == "" {
        set_hint("日历：#" + id_str + " 没有可解析的日期（slot 未抽取），未生成 ICS")
        return
    }
    let r = fs.write("calendar/qianxian-" + id_str + ".ics", ics)
    if r == nil {
        set_hint("日历：ICS 已生成 calendar/qianxian-" + id_str + ".ics（通用格式，可导入任意日历）")
    } else {
        set_hint("日历：ICS 生成失败（" + ("" + r) + "）")
    }
}

// === 决赛 v0.4.0 S4：完成态 + AA 收尾 ===
let state_save_result = "ok"
fn set_completed(id_str){
    let cur = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { cur = i }
    }
    if cur < 0 { set_hint("找不到 #" + id_str) ; return }
    if cases[cur]["status"] != "Confirmed" {
        set_hint("只有已确认的守护能标记完成（#" + id_str + " 现为 " + status_badge_text("" + cases[cur]["status"]) + "）")
        return
    }
    cases[cur]["status"] = "Completed"
    audit("complete", "#" + id_str + "（" + last_actor + "）")
    // 活动结束：冲突解除
    mark_conflicts()
    rebuild_lines()
    save()
    state_save_result = save_result
    render_views()
    if state_save_result == "fail" {
        set_hint("#" + id_str + " 已标记完成（保存失败，仅在内存）")
    } else {
        set_hint("#" + id_str + " 已标记完成——聚会圆满，AA 收齐后徽章自动清")
    }
}
fn set_bill_cleared(id_str){
    let cur = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { cur = i }
    }
    if cur < 0 { set_hint("找不到 #" + id_str) ; return }
    if ("" + cases[cur]["bill_total"]) == "" {
        set_hint("没记过 AA，无需收尾（#" + id_str + "）")
        return
    }
    if cases[cur]["bill_cleared"] == "yes" {
        set_hint("AA 已收齐过（#" + id_str + "）")
        return
    }
    cases[cur]["bill_cleared"] = "yes"
    audit("bill_cleared", "#" + id_str + "（人工收尾）")
    rebuild_lines()
    save()
    state_save_result = save_result
    render_views()
    if state_save_result == "fail" {
        set_hint("#" + id_str + " AA 已收齐（保存失败，仅在内存）")
    } else {
        set_hint("#" + id_str + " AA 已收齐——收尾完成")
    }
}

// ═══ 部件 13/16：群智收敛（WP3-A 降级路径）/ 结案分享到群 / 确认后动作（ICS+日历写入链）
// ═══ 源文件 bundle-src/92-converge.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// === 决赛 v0.4.0 S6：确认后动作（ICS 自动导出 + 群分享 + 提醒登记提示） ===
// v0.10.0 WP5：分享结案回顾到群（matrix.send_message 真发；数字全来自审计字段）
// === v0.10.0 WP3-A：群智收敛三动作（降级路径） ===
// ① 发投票到群：文字投票卡（matrix.send_message 真发）；非 Rinx 宿主诚实降级文案可复制。
// === v0.10.2 WP1：成员端「改投首选」（Outbox：app 写请求文件，伴生进程消费发信） ===
//   撤回语义=再发一条字母（归票 latest-wins 幂等，qx-converge 单测在案）。
fn member_revote(){
    let _w = fs.write("member-revote.json", {letter: "A", reason: "手动改投首选"}.to_json())
    if _w == nil {
        set_hint("改投请求已登记——伴生进程（qx-member-agent）下一轮发出；没跑伴生进程不会发（场外组件，诚实边界）")
    } else {
        set_hint("改投登记失败：" + ("" + _w))
    }
}

fn converge_slots_text(){
    return "A. 周六-上午    B. 周六-下午    C. 周六-晚上\n       D. 周日-上午    E. 周日-下午"
}
fn start_converge(){
    let ci = -1
    for i in cases.len() {
        if cases[i]["id"] == selected_id { ci = i }
    }
    if ci < 0 { set_hint("先选中一条守护再发投票"); return }
    let id_str = "" + cases[ci]["id"]
    let act = "" + cases[ci]["activity"]
    if act == "" { act = "聚会" }
    let place = "" + cases[ci]["place"]
    let ppl = "" + cases[ci]["people"]
    if ppl == "" { ppl = "（暂无名单——先加参与人再发投票更准确）" }
    let body = "📋 时间收敛投票：#" + id_str + " " + act + " · " + place
        + "\n候选时段（回复对应字母即投票）：\n" + converge_slots_text()
        + "\n回复如「A」或「AB」（多选按整票计）。参与人：" + ppl
        + "。\n当前已收到 0 票（成员回复后请组织者到牵线里点「刷新计票」）。"
    converge_case_id = id_str
    if host.has("matrix.send_message") {
        host.request("matrix.send_message", {body: body}, fn(r){
            if r.is_ok {
                set_hint("投票卡已发到群 ✓——成员回复字母后，回来点「刷新计票」")
                audit("converge_start", "#" + converge_case_id + "（文字投票卡）")
            } else {
                // 发送失败也要把文案交还用户（隐藏中的输入框在详情态不可见——hint 明示位置；
                //   列表态输入框可见即可复制；e2e/伴生进程可读 msg_input 取回同源文案）
                ui.msg_input.set_text(body)
                set_hint("发投票失败：" + r.error + "——投票文案已在输入框，复制转发到群即可")
            }
        })
    } else {
        // 诚实降级：无 matrix 服务→屏显文案供手动转发
        ui.msg_input.set_text(body)
        set_hint("本宿主无 matrix 服务——投票文案已填入输入框，复制转发到群即可（成员回复后回这里刷新计票）")
    }
    audit("converge_start", "#" + id_str + "（文字投票卡发起）")
    render_views()
}
// ② 刷新计票：读伴生进程写的 converge.json（进程读房间消息归票；无文件=提示先跑伴生进程）
fn refresh_converge(){
    if !fs.exists("converge.json") {
        set_hint("还没有计票数据——先跑伴生进程：python3 tools/qx-converge-bridge.py --room '<房间>' --jail <jail>（它会读群消息归票）")
        return
    }
    let v = ("" + fs.read("converge.json")).parse_json()
    if v == nil {
        set_hint("converge.json 解析失败（伴生进程写入中？稍后再试）")
        return
    }
    if converge_case_id == "" {
        converge_case_id = "" + v["case_id"]
    }
    if ("" + v["case_id"]) != converge_case_id {
        set_hint("计票文件属于另一场投票（#" + ("" + v["case_id"]) + "）——先完成那场或重新发起")
        return
    }
    converge_summary = "" + v["summary"]
    converge_winner = "" + v["winner"]
    converge_winner_slot = "" + v["winner_slot"]
    render_views()
    set_hint("计票：" + converge_summary)
}
// ③ 管家收敛：把计票注入 turn，让模型出 reschedule PLAN（白名单拍板链）
fn converge_butler(){
    if converge_winner_slot == "" {
        // 兜底：直接从 converge.json 读（重启后 converge_case_id 全局初值为空）
        if fs.exists("converge.json") {
            let v2 = ("" + fs.read("converge.json")).parse_json()
            if v2 != nil {
                converge_case_id = "" + v2["case_id"]
                converge_summary = "" + v2["summary"]
                converge_winner = "" + v2["winner"]
                converge_winner_slot = "" + v2["winner_slot"]
            }
        }
    }
    if converge_case_id == "" || converge_winner_slot == "" {
        set_hint("先「刷新计票」拿到票数分布（平票/零票时请人工定夺，不收敛）")
        return
    }
    let id_str = converge_case_id
    let ci = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { ci = i }
    }
    if ci < 0 { set_hint("找不到 #" + id_str); return }
    // 直接用确定性白名单构造提案（不经模型——计票收敛是纯确定性场景；
    //   「票数不足的时段」记沉默留痕）
    plan_op = "reschedule"
    plan_id = id_str
    let sd = converge_winner_slot.split("-")
    plan_day = sd[0]
    plan_part = sd[1]
    plan_summary = "按群投票收敛：#" + id_str + " 改到票数最高的 " + converge_winner_slot + "（" + converge_summary + "）"
    plan_lines = []
    plan_check = ""
    let old_disp = ("" + cases[ci]["slot_day"]) + "-" + ("" + cases[ci]["slot_part"])
    plan_lines.push("op：改期 ｜ 目标：#" + id_str + " " + ("" + cases[ci]["activity"]))
    plan_lines.push("时间：" + old_disp + " ──▶ " + converge_winner_slot + "（群投票收敛：" + converge_summary + "）")
    plan_lines.push("冲突预演：改后由拍板时全量重算")
    plan_check = "ok"
    plan_pending = "yes"
    // 沉默留痕：考虑过但票数不足的时段
    if fs.exists("suppressed.json") {
        let sv = ("" + fs.read("suppressed.json")).parse_json()
        if sv != nil {
            let arr = sv["entries"]
            if arr == nil { arr = [] }
            arr.push({ts: "", kind: "converge", detail: "#" + id_str + " 收敛到 " + converge_winner_slot + "——其余时段票数不足（" + converge_summary + "）"})
            fs.write("suppressed.json", {entries: arr}.to_json())
        }
    }
    audit("converge_plan", "#" + id_str + " → " + converge_winner_slot + "（" + converge_summary + "）")
    enter_chat()
    set_hint("管家已按群投票出提案——过目后点「拍板」")
}

// v0.10.1 WP4：回顾文案组稿抽出（matrix 群分享与邮件人审两通路同文）
fn fin_report_body(){
    let ci = -1
    for i in cases.len() {
        if cases[i]["id"] == selected_id { ci = i }
    }
    if ci < 0 { return "" }
    let id_str = "" + cases[ci]["id"]
    let act = "" + cases[ci]["activity"]
    if act == "" { act = "聚会" }
    let slot = ("" + cases[ci]["slot_day"]) + "-" + ("" + cases[ci]["slot_part"])
    let place = "" + cases[ci]["place"]
    return "🎉 聚会回顾：#" + id_str + " " + act + "（" + slot + " · " + place + "）已圆满收尾！"
        + "到场 " + fin_stat_people + "，人均 " + fin_stat_per + "，周期 " + fin_stat_days
        + "（数据由牵线守护从审计链导出）。"
}

// === v0.10.1 WP4：mail.review_send 人审发信通路（跨 app 调用=宿主评审面板，源码级核实）===
//   纪律：to 留空不编造地址——收件人由人在宿主作曲/评审面板里填（durable composer）。
//   降级：无邮件服务/平台不支持物理审批 → 真实错误透出 + 文案回输入框可复制。
fn mail_review_send(subject, body, tag){
    if !host.has("mail.review_send") {
        ui.msg_input.set_text(body)
        set_hint("本宿主无邮件服务——「" + tag + "」文案已填入输入框，复制后手动发送即可")
        render_views()
        return
    }
    host.request("mail.review_send", {account: "", to: "", subject: subject, body: body}, fn(r){
        if r.is_ok {
            set_hint(tag + "：已进入宿主邮件评审——物理确认后发出（收件人在评审面板填写）")
        } else {
            // 真实错误透出（如 Linux 宿主：平台不支持物理审批）+ 文案回输入框兜底
            ui.msg_input.set_text(body)
            set_hint(tag + "邮件链不可用：" + r.error + "——文案已在输入框，可手动发送")
            render_views()
        }
    })
}

// WP4：催收草稿邮件人审发出（读暂存草稿；名单永不公示纪律不变——to 由人评审时填）
fn butler_mail_dunning(){
    if dunning_draft == "" { set_hint("先让管家起草催收文案（说「催一下」即可）"); return }
    audit("mail_dunning", "#" + dunning_case_id)
    mail_review_send("聚会账目提醒（牵线守护）", dunning_draft, "催收邮件")
    dunning_draft = ""
    dunning_case_id = ""
}

fn mail_share_fin(){
    let body = fin_report_body()
    if body == "" { set_hint("先选中一条守护再分享"); return }
    audit("share_fin_mail", "")
    mail_review_send("聚会回顾（牵线守护）", body, "结案回顾邮件")
}

fn share_fin_report(){
    let body = fin_report_body()
    if body == "" { return }
    audit("share_fin", "")
    if host.has("matrix.send_message") {
        host.request("matrix.send_message", {body: body}, fn(r){
            if r.is_ok {
                set_hint("聚会回顾已分享到群 ✓")
            } else {
                set_hint("分享失败：" + r.error + "（回顾卡已在详情页，可手动复制转发）")
            }
        })
    } else {
        set_hint("本宿主无 matrix 服务，无法发群——回顾卡已在详情页，可手动复制转发")
    }
}

fn post_confirm_actions(id_str){
    // ① ICS 自动生成（本机可验证的日历写入路径）
    let cur = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { cur = i }
    }
    if cur >= 0 {
        let ics = build_ics(cur)
        if ics != "" {
            fs.write("calendar/qianxian-" + id_str + ".ics", ics)
        }
    }
    // ② 群分享（Rinx 宿主真发；card-host 无此服务 → 46b 诚实降级）
    if host.has("matrix.send_message") {
        let cur2 = -1
        for i in cases.len() {
            if "" + cases[i]["id"] == id_str { cur2 = i }
        }
        if cur2 >= 0 {
            let act = "" + cases[cur2]["activity"]
            if act == "" { act = "聚会" }
            let body = "✅ 牵线确认：#" + id_str + " " + act + "（" + ("" + cases[cur2]["slot_day"]) + "-" + ("" + cases[cur2]["slot_part"]) + "）· " + ("" + cases[cur2]["place"]) + " —— T-24h 提醒已登记"
            host.request("matrix.send_message", {body: body}, fn(r){
                if r.is_ok {
                    set_hint("群分享：已发送到授权房间 ✓（T-24h 提醒已登记）")
                } else {
                    // 46b 诚实可见性：透出真实失败原因，不吞错误
                    set_hint("群分享失败：" + r.error + " —— 提醒已在本机登记，ICS 已生成")
                }
            })
        }
    }
    // ③ 本机日历写入（v0.8.0：RC2 device_calendar 官方通路）。启发式：拍板确认后
    //    app 自动走「授权→选日历→原生面板写入」，人在原生面板上只做物理确认；
    //    events.create 由宿主原生 review 兜底，本 app 无任何静默写。Linux 宿主无此
    //    服务 → host.has 门检跳过（ICS 已在①生成，任何日历软件可导入，诚实降级）。
    if host.has("device_calendar") {
        calendar_write_case(id_str)
    }
}

// === v0.8.0：device_calendar 写链（RC2 官方协议；参数名/校验与
//    OctoSense crates/shell/src/device_calendar 逐字对齐） ===
// 链：permission.request（原生授权）→ calendars.list → 取第一个可写日历 →
//     calendars.select（原生 review，回 handle）→ events.create（原生面板物理确认，
//     all-day 事件 UTC 零点边界）。每一步失败都真实原因透出 + ICS 兜底提示。
let cal_write_id = ""
let cal_handle = ""
fn cal_degrade(stage, err){
    set_hint("本机日历：" + stage + "失败（" + err + "）——已生成 ICS，可导入任何日历软件")
}
fn calendar_write_case(id_str){
    cal_write_id = id_str
    cal_handle = ""
    let cur = -1
    for i in cases.len() {
        if "" + cases[i]["id"] == id_str { cur = i }
    }
    if cur < 0 { return }
    // all-day 事件需要绝对日期（no-facts：相对词对不上日历就不写，不发明）
    let td = "" + cases[cur]["target_date"]
    if td == "" {
        set_hint("本机日历：活动日期未解析到（" + ("" + cases[cur]["slot_day"]) + " 对不上具体日期）——已生成 ICS，可手动导入")
        return
    }
    host.request("device_calendar.permission.request", {}, fn(r){
        if !r.is_ok {
            cal_degrade("授权", r.error)
            return
        }
        // 非日历平台（Linux 桌面等）会回 supported:false——如实降级，不装成功
        if r.data != nil {
            if ("" + r.data["supported"]) == "false" {
                cal_degrade("本宿主", "此系统不支持日历读写（supported:false）")
                return
            }
        }
        host.request("device_calendar.calendars.list", {}, fn(r2){
            if !r2.is_ok {
                cal_degrade("读日历列表", r2.error)
                return
            }
            // 取第一个可写日历（ writable=false 只读不可建事件——服务端也会拒）
            let cid = ""
            if r2.data != nil {
                let cals = r2.data["calendars"]
                if cals != nil {
                    for ci2 in cals.len() {
                        if cid == "" {
                            if cals[ci2]["writable"] { cid = "" + cals[ci2]["id"] }
                        }
                    }
                }
            }
            if cid == "" {
                cal_degrade("选日历", "没有可写的系统日历")
                return
            }
            host.request("device_calendar.calendars.select", {calendar_id: cid}, fn(r3){
                if !r3.is_ok {
                    cal_degrade("选定日历", r3.error)
                    return
                }
                if r3.data == nil {
                    cal_degrade("选定日历", "未返回 handle")
                    return
                }
                cal_handle = "" + r3.data["handle"]
                if cal_handle == "" {
                    cal_degrade("选定日历", "handle 为空")
                    return
                }
                // 组装 all-day 事件（title ≤512 / UTC 零点边界 / 下一天零点为 end）
                let cur2 = -1
                for i2 in cases.len() {
                    if "" + cases[i2]["id"] == cal_write_id { cur2 = i2 }
                }
                if cur2 < 0 { return }
                let td2 = "" + cases[cur2]["target_date"]
                let dt = td2.split("-")
                if dt.len() != 3 {
                    cal_degrade("写入", "日期解析失败：" + td2)
                    return
                }
                let z = days_from_civil(dt[0].to_f64(), dt[1].to_f64(), dt[2].to_f64())
                // 本历法 z 以 0000-03-01 为原点（无 +719468 偏移）：Unix 纪元 1970-01-01
                // 的 z=719468 → start_ms = (z-719468)*86400000（all-day 的 UTC 零点）
                let start_ms = (z - 719468) * 86400000
                let act2 = "" + cases[cur2]["activity"]
                if act2 == "" { act2 = "聚会" }
                let title2 = "【牵线】#" + cal_write_id + " " + act2
                let loc2 = "" + cases[cur2]["place"]
                let notes2 = "聚会守护 #" + cal_write_id + "｜原文：" + trim_n("" + cases[cur2]["text"], 60) + "｜由牵线确认拍板后写入（原生面板人工确认）"
                host.request("device_calendar.events.create", {handle: cal_handle, event: {title: title2, start_ms: start_ms, end_ms: start_ms + 86400000, timezone: "UTC", all_day: true, location: loc2, notes: notes2}}, fn(r4){
                    if r4.is_ok {
                        audit("calendar_write", "#" + cal_write_id + " → 系统日历（原生面板确认）")
                        set_hint("本机日历：已写入系统日历 ✓（你在原生面板按了确认）——提醒与 ICS 同步在案")
                    } else {
                        cal_degrade("写入", r4.error)
                    }
                })
            })
        })
    })
}

// ═══ 部件 14/16：create_case_from_plan / json_field / publish_glance / 示例 / 导出 / 清空全部 / 启动 load
// ═══ 源文件 bundle-src/93-misc.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// 管家 create 提案的执行端：字段由提案给定（非本地猜测），空字段保持空（no-facts）；
// id 守卫与 build_case_from_text 同款；冲突走 mark_conflicts 全量重算
fn create_case_from_plan(){
    let max_existing_id = 0
    for i in cases.len() {
        let cid = cases[i]["id"]
        if cid > max_existing_id { max_existing_id = cid }
    }
    if seq <= max_existing_id { seq = max_existing_id + 1 }
    cases.push({"id": seq, "text": plan_src, "activity": plan_activity, "place": plan_place, "status": "Proposing", "people": plan_people, "bill_total": plan_bill, "receipt_activity": "", "receipt_place": "", "receipt_text": "", "receipt_done": "", "slot_day": plan_day, "slot_part": plan_part, "conflict": "no", "slot_init_asked": "", "bill_cleared": "no"})
    mark_conflicts()
    selected_id = seq
    ui.msg_input.set_text("")
    rebuild_lines()
    save()
    render_views()
}

// === #37 辅助：trim24 截到 ≤24 字 + json_field 提字段 ===
fn trim24(s){
    return trim_n(s, 24)
}
fn json_field(js, key){
    // 决赛 S4b 兼容修：同 plan_parse——index_of 不在宿主方法表，split 实现。
    //   协议保证扁平全字符串字段、值内禁双引号；兼容 "key":"v" 与 "key": "v" 两种间隔。
    let kq = "\"" + key + "\":\""
    let parts = js.split(kq)
    let rest = ""
    if parts.len() >= 2 {
        rest = parts[1]
    } else {
        let kq2 = "\"" + key + "\": \""
        let parts2 = js.split(kq2)
        if parts2.len() < 2 { return "" }
        rest = parts2[1]
    }
    // 值到下一个 " 结束（值内禁双引号，协议约束）
    let ends = rest.split("\"")
    if ends.len() < 1 { return "" }
    return ends[0]
}

// === #37 publish_glance：向 glance 屏发「今晚聚会 T-X 提醒」L0卡 ===
//   人触发（仅当 status==Confirmed 且当前时刻在约定时段前 5/30/60 分钟区间内）。
//   card-host 无 glance 服务时按"已降级本地规则"友好提示；glance capability 已在
//   manifest 封闭清单（#37 三件套②）。默认不主动调，仅"发布到 glance 屏"按钮触发。
// #40 hub 现实封闭清单无 glance，本函数在 card-host 永远降级；保留以备官方实现 glance 能力后启用
// === v0.10.1 WP3：守护灯速览卡（官方 glance.publish 现行契约，源码级核实）===
//   字段：card_id + title + source（L0 卡源）+ data + priority + open + notify
//   （calendar.notify 的 event_card_args 同款形状；agent 卡禁可执行 Splash——L0 安全）。
//   内容 = 守护灯确定性摘要（rebuild_lines 计数全局，与主页守护灯同一数据源，零模型参与）。
//   证据纪律：发布载荷先写 jail glance-last.json（Outbox 留证，R-37 一致性断言读它）。
//   降级：无 glance 服务 → 载荷仍落盘 + hint 明示（不假装已上屏）。
let GUARD_CARD = "# ledger qianxian.guard@0.1.0\n# level: L0\n# profile: ui/l0\n# 牵线守护灯速览卡：文案全走 ev 数据字段（sys.dataset 只认固定字段集，官方 check_card 校验在案）\nsource ev sys.dataset(fields: [title, as_of, metric1_label, metric1_value, metric2_label, metric2_value, subtitle, summary, url1])\nview root Surface(pad: .tight) {\n  Col(gap: 8) {\n    Row(gap: 8, align: .center) {\n      TextCaption(text: ev.subtitle, width: .fill)\n      TextCaption(value: ev.as_of)\n    }\n    TextTitle(text: ev.title, width: .fill)\n    Row(gap: 8) {\n      Tile(label: ev.metric1_label, value: ev.metric1_value)\n      Tile(label: ev.metric2_label, value: ev.metric2_value)\n    }\n    TextBody(text: ev.summary, width: .fill)\n  }\n}"

fn publish_glance(){
    // 任何低频按钮都视为"放弃取消/清空/AI 等待"
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    clear_pending_flag = "no"
    clear_pending_deadline = 0
    if ai_pending == "yes" {
        set_hint("AI 还在跑，等它回完再发守护灯卡")
        return
    }
    // 内容推导（确定性）：总计行 + 分指标；无异常如实写
    let tail_txt = "" + guard_n_tail
    let summary = "待拍板 " + ("" + guard_n_propose) + " · 冲突 " + ("" + guard_n_conflict) + " · 待收尾 " + tail_txt
    if guard_n_propose == 0 && guard_n_conflict == 0 && guard_n_tail == 0 {
        summary = "无异常——全部守护都在轨"
    }
    let payload = {
        card_id: "guard-light",
        title: "牵线 · 守护灯",
        source: GUARD_CARD,
        data: {ev: {
            app_label: "牵线 · 守护灯",
            open_label: "打开牵线",
            title: guard_title,
            as_of: "守护灯",
            metric1_label: "待拍板", metric1_value: "" + guard_n_propose,
            metric2_label: "冲 突", metric2_value: "" + guard_n_conflict,
            subtitle: "待收尾 " + tail_txt,
            summary: summary,
            url1: "app://qianxian"
        }},
        priority: 50,
        open: {app: "qianxian"},
        notify: false
    }
    // 证据留痕：不管宿主有没有 glance 服务，载荷先落盘（一致性断言/复核都读它）
    let _gw = fs.write("glance-last.json", payload.to_json())
    if !host.has("glance") {
        set_hint("本宿主无 glance 服务，速览卡未上屏——载荷已存 glance-last.json（内容即上屏语义）")
        return
    }
    host.request("glance.publish", payload, fn(r){
        if r.is_ok {
            set_hint("守护灯速览卡已发布到 glance 屏（" + guard_title + "）")
        } else {
            set_hint("glance 发布失败（" + r.error + "）——载荷已存 glance-last.json")
        }
    })
}

// === #14 新增：示例一键填充（演示友好） ===
// 输入框为空时供用户点；点完只填输入框、**不自动建守护**——
// 仍需用户主动点"建守护"，符合规范第 2 条"用户主动"原则。
fn fill_example(){
    // 任何非取消按钮都视为"放弃取消确认"
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    // 点示例按钮本身也放弃清空确认
    clear_pending_flag = "no"
    clear_pending_deadline = 0
    let cur = ui.msg_input.text()
    if cur != "" {
        // 输入框已有内容就不再覆盖，避免误丢用户手打的稿子
        set_hint("输入框已有内容，未替换；点「建守护」继续，或手动清空再点示例")
        return
    }
    ui.msg_input.set_text("周六上午去深圳湾骑车，大概两小时？")
    set_hint("已填示例到输入框（不自动建守护），点「建守护」继续")
}

// === #14 新增：导出数据（cases.json 原文屏显在 hint 区） ===
// 本 runtime 无法调起系统分享/把数据写到 jail 外（PRIVACY.md 同样承诺不出网），
// 故只能屏显：用户可长按/手动复制下方文本备份。文案必须说明「复制可备份」。
fn export_data(){
    // 任何非取消按钮都视为"放弃取消确认"
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    // 点导出按钮也放弃清空确认（互斥语义：先看清楚再考虑删）
    clear_pending_flag = "no"
    clear_pending_deadline = 0
    if !fs.exists("cases.json") {
        set_hint("暂无 cases.json（一条守护都没建），无可导出内容")
        return
    }
    let raw = fs.read("cases.json")
    // 原样屏显 + 引导用户复制备份。hint 区是单行 Label，长内容直接塞入会撑高；
    // 这里就是用单 Label 容纳多行文本，Splash Label 自身会自然换行。
    set_hint("—— cases.json 原文（复制可备份）——\n" + raw + "\n—— 复制以上文本即可备份 ——")
}

// === #14 新增：清空全部（两段式确认，复用 cancel_pending_flag 的 5s 机制） ===
// 第一次点：clear_pending_flag = "yes"，记下当前条数，按钮文案切到 hint 提示
//           "再点一次清空（5s）"；hint 明示将清空 N 条守护。
// 第二次点（5s 内）：fs.remove("cases.json") + 内存清空（cases=[]、seq=0、
//           selected_id=0、扁平数组全部清掉、rebuild_lines）+ hint 明示
//           "已清空 N 条守护"。超时 / 点别的按钮 → 放弃。
// 5s 后清空确认态的回收用 start_timeout(5.0, ...) —— 与 cancel_case 同源。
fn clear_all_data(){
    // 互斥：清空流程中放弃取消确认 + 撤销窗口（场景不重叠，避免 hint 互相覆盖）
    clear_cancel_pending("")
    undo_win_open = "no"
    undo_show_flag2 = "no"
    cancel_pending_flag = "no"
    let cur_n = cases.len()
    // 第二次点（已在确认态 + 5s 内） → 真正执行清空
    if clear_pending_flag == "yes" {
        // fs.remove 在文件不存在时返回错误值（非 nil/非 true）；按 #13 字符串标记约定
        // 判成败：消息字符串非空视为失败。注意：fs 也没有 rename，不要尝试先备份
        // 再删——本动作是用户主动清空，无需保留副本。
        // === #27：失败判定改严格——`rr != nil` 只排除了 nil，但 #13 实证过
        //   "" + rr 可能为空（rr 是 true/空字符串等）会被误判成功；要求 **字符串
        //   文本非空** 才算失败，与本文件其它 fs 调用（cycle_slot/save）同源。
        let removed_msg = ""
        if fs.exists("cases.json") {
            let rr = fs.remove("cases.json")
            if rr != nil {
                let m = "" + rr
                if m != "" { removed_msg = m }
            }
        }
        // 内存清空：扁平数组也要清，否则 on_render 闭包会读到旧 case_lines 等残留
        cases = []
        seq = 0
        selected_id = 0
        case_ids = []
        case_lines = []
        case_text_lines = []
        case_statuses = []
        case_selected = []
        case_badge_text = []
        case_receipt = []
        case_place_lines = []
        case_expanded = []
        case_activity_lines = []
        case_place_full = []
        case_status_text = []
        filtered_idxs = []
        filter_count_str = "0"
        filter_total_str = "0"
        matched_total_str = "0"
        current_query = ""
        rebuild_lines()
        render_views()
        clear_pending_flag = "no"
        clear_pending_deadline = 0
        if removed_msg != "" {
            // 内存已清、但 cases.json 还在盘上（下次启动会再读回）——明示失败，
            // 不让用户误以为数据真的删了
            set_hint("清空未完成：" + removed_msg)
        } else {
            set_hint("已清空 " + "" + clear_prev_count + " 条守护（cases.json 已移除，内存已重置）")
        }
        clear_prev_count = 0
        return
    }
    // 第一次点：进入待确认态（不执行任何数据变更）
    clear_pending_flag = "yes"
    clear_pending_deadline = 1
    clear_prev_count = cur_n
    // v0.9.0 WP1：两段窗 5s→8s——PLAN 卡路径人要读完危险提示再二次拍板（真机实测
    //   5s 不够，滚动定位+二次点击超窗 → 永远只挂在确认态）；与拒绝理由窗同源 8s。
    set_hint("再点一次「清空全部」才会真删 " + "" + cur_n + " 条守护（不可逆）；8 秒内点别的按钮可放弃")
    // 8 秒后超时 → 放弃确认态
    start_timeout(8.0, || {
        if clear_pending_flag == "yes" {
            clear_pending_flag = "no"
            clear_pending_deadline = 0
            clear_prev_count = 0
            set_hint("清空确认已过期（8s 内未再点），未删除任何数据")
        }
    })
}

start_timeout(0.05, || load())

// ═══ 部件 15/16：设计 token（HTML 附录 A 对照）与组件工厂 Card/Badge/SectionLabel
// ═══ 源文件 bundle-src/95-tokens.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
let ink = #x2b2722
let secondary = #x6e675e
let accent = #xc7402f

// === v0.10.2：真粗体 CJK 字族（像素级实测发现的关键修正）===
//   theme.font_bold 的 font_family 只有 latin 成员（IBMPlexSans-SemiBold），CJK 落到
//   LXGWWenKaiRegular —— 中文"粗体"一直是假粗。运行时内嵌 LXGWWenKaiBold.ttf
//   （makepad_widgets:resources/，探针实证可渲染、笔画明显加粗），显式接上。
//   用法与 theme.font_bold 同款：draw_text.text_style: font_bold_cjk{font_size: 9}
let font_bold_cjk = TextStyle{
    font_family: FontFamily{
        latin := FontMember{res: crate_resource("makepad_widgets:resources/IBMPlexSans-SemiBold.ttf") asc: -0.1 desc: 0.0}
        chinese := FontMember{res: crate_resource("makepad_widgets:resources/LXGWWenKaiBold.ttf") asc: 0.0 desc: 0.0}
        emoji := FontMember{res: crate_resource("makepad_widgets:resources/NotoColorEmoji.ttf") asc: 0.0 desc: 0.0}
    }
    line_spacing: 1.2
}

// 组件工厂：第一方 RoundedView/徽章范式（#7 落实）
// show_bg:true 是必填，否则 RoundedView 不绘背景
// #48 「红线」设计pass：纸白卡 + 发丝描边 + 暖投影（全部零布局尺寸变化）
let Card = RoundedView{width: Fill height: Fit flow: Down spacing: 8 padding: Inset{left: 12 right: 12 top: 12 bottom: 12}
    show_bg: true draw_bg.color: #xfffdfa draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xe9dfd2
    draw_bg.shadow_color: #x2b272212 draw_bg.shadow_radius: 8.0 draw_bg.shadow_offset: vec2(0.0, 1.0)}
// === v0.9.0 WP2 设计 token（HTML 规范附录 A 一一对应；splash 颜色必须字面量，
//     本区块是唯一权威对照处——改色先改这里再全文件替换） ===
//   canvas  暖纸   #xf7f2ec  页面底
//   surface 宣纸   #xfffdfa  卡面（Card 默认）
//   ink     墨色   #x2b2722  主文字/标题
//   secondary     #x6e675e  次要文字
//   faint         #xa89e91  更弱/占位/原文引行
//   line   发丝线  #xe9dfd2  分隔线/卡描边
//   accent 朱砂    #xc7402f  红线/主按钮/当前态（hover #xd0563f down #xa83424；晕环 #xc7402f2e）
//   jade   玉绿    #x2f7d4f  已确认/已清/✓（底 #xe8f3ec）
//   amber  琥珀    #xa87516  冲突/待收尾/欠（底 #xf7ebd3）
//   danger 赭石    #xa14d3c  取消/危险（底 #xf6e8e3）
//   neutral 灰泥   #xf1ece4  待拍板/中性 chip（字 #x6e675e）
//   thread-todo   #xe1d7ca  红线未到段
//   knot-todo     #xc9bfb2  未到结描边
//   圆角三档：卡 14 / chip 12 / 按钮 22（主按钮高 ≥44）
//   字阶：21 页题 / 15.5 卡题 / 14 键值 / 13 正文 / 12.5 元信息 / 11-12 chip
//   已知边界：运行时无删除线（diff 旧值用 faint+──▶ 承担）；无字距控制（分区标签
//   用「账 目 · AA」空格语义代替 letter-spacing）。
let Badge = RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 4 bottom: 4}
    show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 7.0}
let BadgeText = Label{text: "" draw_text.color: secondary draw_text.text_style: font_bold_cjk{font_size: 8}}
let TitleLine = Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 11}
let TextLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 9}
let ReceiptLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 8}

// === #9 新增：内联展开用的小字段标签（次级色粗体 13），照 #8 DetailSection 范式 ===
let SectionLabel = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style: font_bold_cjk{font_size: 9}}
let BodyLine = Label{width: Fill text: "" draw_text.color: ink draw_text.text_style.font_size: 10}
let MetaLine = Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 9}

// ═══ 部件 16/16：根 UI 树：home_chrome / composer / cap-line / case_list（卡片）/ detail_list / chat_list / action_row / home-foot
// ═══ 源文件 bundle-src/99-ui-tree.splash；bundle/main.splash 是 tools/qx-pack.sh 的拼接生成物，勿直接编辑。
// v0.10.1：根区 spacing 归零——HTML .screen 的纵向节奏（14/14/6/16）用显式 spacer 逐段还原，
//   统一 spacing 做不到逐段精确（复刻基准：research/kimi示例UI.html 屏 01）。
SolidView{width: Fill height: Fill flow: Down padding: Inset{left: 18 right: 18 top: 22 bottom: 16} spacing: 0 draw_bg.color: #xf7f2ec
    // === UI 方法论改版（App Flow card-ux skill：一屏一主行动 / 操作就近分组）===
    //   标题 21（HTML 规范 .app-head h2）：首屏纵向空间让给守护列表这一核心内容
    // v0.10.0：红线结品牌图标（附录 B 寓意：一根朱砂线绕成结，两端各牵一颗圆点——
    //   把人和人牵到一起）。Svg 控件引 bundle 资产 icon.svg（pdftools 同款 draw_svg 范式）。
    // v0.10.0：主页 chrome（标题区/输入行/守护灯卡/AI 行/hint）——聊天态整块隐藏
    //   （管家页有自己的标题区，主页这五块在聊天态是冗余）。
    // v0.10.0：主页 chrome 容器——on_render 条件渲染（照 case_list/detail_list 同款：
    //   命令式 set_visible 对复合 View 不可靠（#48b 同类坑），用 on_render 的
    //   ui_mode 分支才真正随模式切换显隐）。聊天态渲染 1px 占位（空分支硬约束）。
    // v0.10.0：主页展示块（标题区+守护灯卡）——on_render 条件渲染，聊天态整块隐藏
    //   （管家页有自己的标题区）。这两个块都是纯展示（无命令式 ui.x 引用），
    //   进 on_render 安全。输入行（msg_input）+AI 行+hint 有命令式引用，常驻根区。
    home_chrome := View{width: Fill height: Fit flow: Down spacing: 0 on_render: || {
        if ui_mode == "chat" {
            View{width: Fill height: 1}
        } else {
            // HTML .app-head：40px 结标 + 21px 标题 + 12px 副题（gap 12，副题 margin-top 3）
            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                Svg{width: 40 height: 40 animating: false draw_svg +: {svg: http_resource("{{assets}}/assets/icon.svg") color: #xc7402f}}
                View{width: Fill height: Fit flow: Down spacing: 3
                    Label{text: "牵线 · 聚会守护" draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 15}}
                    Label{width: Fill text: "把群消息丢给管家，盯到人人到场、账目清零" draw_text.color: secondary draw_text.text_style.font_size: 8 max_lines: 1}
                }
            }
            // .app-head margin-bottom:14
            View{width: Fill height: 14}
            // HTML .guard-bar：卡内两行——盾标+标题（13px bold）/ chips 行（真徽章，gap 6）。
            //   chips 读 guard_chip_text/guard_chip_kind 扁平数组（rebuild_lines 写入）。
            Card{padding: Inset{left: 14 right: 14 top: 11 bottom: 11} spacing: 0
                View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                    Svg{width: 17 height: 17 animating: false draw_svg +: {svg: http_resource("{{assets}}/assets/shield.svg") color: #x2f7d4f}}
                    View{width: Fill height: Fit flow: Down spacing: 6
                        Label{width: Fit text: guard_title draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 9}}
                        View{width: Fill height: Fit flow: Right spacing: 6
                            for gi in guard_chip_text.len() {
                                if guard_chip_kind[gi] == "danger" {
                                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                        show_bg: true draw_bg.color: #xfbdcd7 draw_bg.border_radius: 12.0
                                        Label{text: guard_chip_text[gi] draw_text.color: #xc23824 draw_text.text_style: font_bold_cjk{font_size: 8}}}
                                } else if guard_chip_kind[gi] == "amber" {
                                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                        show_bg: true draw_bg.color: #xf7ebd3 draw_bg.border_radius: 12.0
                                        Label{text: guard_chip_text[gi] draw_text.color: #xa87516 draw_text.text_style.font_size: 8}}
                                } else if guard_chip_kind[gi] == "jade" {
                                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                        show_bg: true draw_bg.color: #xe8f3ec draw_bg.border_radius: 12.0
                                        Label{text: guard_chip_text[gi] draw_text.color: #x2f7d4f draw_text.text_style.font_size: 8}}
                                } else {
                                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                        show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 12.0
                                        Label{text: guard_chip_text[gi] draw_text.color: #x6e675e draw_text.text_style.font_size: 8}}
                                }
                            }
                        }
                    }
                }
            }
            // .guard-bar margin-bottom:14（在 home_chrome 内收尾——聊天态整块隐藏，间隙随之消失）
            View{width: Fill height: 14}
        }
    }}
    // === 输入行（HTML .composer：卡面容器 + 透明 input；msg_input 命令式引用常驻） ===
    //   HTML：input 13px 透明底；按钮 min-height 38 / radius 19 / padding 0 22。
    composer := RoundedView{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
        padding: Inset{left: 14 right: 6 top: 6 bottom: 6}
        show_bg: true draw_bg.color: #xfffdfa draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xe9dfd2
        draw_bg.shadow_color: #x2b272212 draw_bg.shadow_radius: 8.0 draw_bg.shadow_offset: vec2(0.0, 1.0)
        msg_input := TextInput{width: Fill height: 38 empty_text: "粘贴群消息…"
            draw_bg +: {color: #fffdfa color_hover: #fffdfa color_focus: #fffdfa color_empty: #fffdfa border_radius: 10.0}
            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: #xa89e91 color_empty_hover: #xa89e91 text_style +: {font_size: 9}}}
        ButtonFlat{text: "交给管家" height: 38 padding: Inset{left: 22 right: 22} on_click: || butler_send()
            draw_bg +: {border_radius: 19.0 color: #xc7402f color_hover: #xd0563f color_down: #xa83424 border_size: 0.0}
            draw_text +: {color: #ffffff color_hover: #ffffff color_down: #xffffff text_style: font_bold_cjk{font_size: 9}}}
        ButtonFlat{text: "建守护" height: 38 padding: Inset{left: 22 right: 22} on_click: || add_case()
            draw_bg +: {border_radius: 19.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
            draw_text +: {color: accent color_hover: accent color_down: accent text_style: font_bold_cjk{font_size: 9}}}
    }
    // .composer margin-bottom:6
    View{width: Fill height: 6}
    // === HTML .cap-line：ⓘ 图标 + 11.5px faint，padding 0 4（ai_cap_label 命令式 set_text 常驻） ===
    cap_row := View{width: Fill height: Fit flow: Right spacing: 5 align: Align{y: 0.5} padding: Inset{left: 4 right: 4}
        Svg{width: 12 height: 12 animating: false draw_svg +: {svg: http_resource("{{assets}}/assets/info.svg") color: #xa89e91}}
        ai_cap_label := Label{width: Fill text: "AI 服务：探测中…"
            draw_text.color: #xa89e91 draw_text.text_style.font_size: 8}
    }
    hint := Label{width: Fill text: "" draw_text.color: secondary draw_text.text_style.font_size: 9}
    // .cap-line margin-bottom:16（hint 为空时高度 0，间隙不变）
    View{width: Fill height: 16}

    // v0.10.1：列表内 spacing 12（HTML .case-card margin-bottom:12）；
    //   筛选行→首卡 14 由筛选行后的 2px spacer 补足（12+2=14，HTML .filter-row margin-bottom:14）。
    case_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 12 on_render: || {
        // === #31f：详情模式分支（列表/详情互斥，同一 ScrollY 内无高度竞争）===
        if ui_mode == "detail" {
            // #48b：详情已拆到 detail_list（本视图只服务列表）；占位照 #5 范式
            View{width: Fill height: 1}
        } else {
        // === 灵动剪贴板探针：嗅探邀约胶囊 ===
        if scout_visible == "yes" {
            RoundedView{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                padding: Inset{left: 12 right: 8 top: 8 bottom: 8}
                show_bg: true draw_bg.color: #xfbf4e2 draw_bg.border_radius: 12.0
                draw_bg.border_size: 1.0 draw_bg.border_color: #xdca842
                Label{text: "📋 嗅探到邀约" draw_text.color: #xb87b14 draw_text.text_style: font_bold_cjk{font_size: 9}}
                Label{width: Fill text: scout_summary draw_text.color: #x4a4237 draw_text.text_style.font_size: 9}
                ButtonFlat{text: "一键采纳" height: 32 padding: Inset{left: 10 right: 10} on_click: || scout_adopt()
                    draw_bg +: {border_radius: 14.0 color: #xc7402f color_hover: #xd0563f color_down: #xa83424 border_size: 0.0}
                    draw_text +: {color: #ffffff color_hover: #ffffff color_down: #ffffff text_style: font_bold_cjk{font_size: 8.5}}}
                ButtonFlat{text: "✕" height: 28 width: 28 padding: Inset{left: 6 right: 6} on_click: || scout_dismiss()
                    draw_bg +: {border_radius: 14.0 color: #x00000000 color_hover: #xe8dfd1 color_down: #d5cbbe border_size: 0.0}
                    draw_text +: {color: #8c8275 color_hover: #2b2722 color_down: #2b2722 text_style: font_bold_cjk{font_size: 9}}}
            }
        }
        // === 突发异动主动打扰与抢救预案卡片（Proactive Crisis Resolver）===
        if crisis_open == "yes" {
            RoundedView{width: Fill height: Fit flow: Down spacing: 10
                padding: Inset{left: 14 right: 14 top: 12 bottom: 12}
                show_bg: true draw_bg.color: #xfdf0ed draw_bg.border_radius: 14.0
                draw_bg.border_size: 1.5 draw_bg.border_color: #xd25b43
                RoundedView{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    Label{text: "⛈️ 突发异变主动打扰" draw_text.color: #xc23824 draw_text.text_style: font_bold_cjk{font_size: 10.5}}
                    Label{width: Fill text: "建议尽快决断" draw_text.color: #x8a382c draw_text.text_style.font_size: 8.5}
                    ButtonFlat{text: "稍后再议" height: 26 padding: Inset{left: 8 right: 8} on_click: || crisis_dismiss()
                        draw_bg +: {border_radius: 8.0 color: #xf0dedb border_size: 0.0}
                        draw_text +: {color: #x8a382c text_style.font_size: 8}}
                }
                Label{width: Fill text: crisis_reason draw_text.color: #x4a2a22 draw_text.text_style.font_size: 9.5}
                RoundedView{width: Fill height: Fit flow: Down spacing: 8
                    ButtonFlat{width: Fill height: 38 padding: Inset{left: 12 right: 12} on_click: || crisis_adopt_a()
                        draw_bg +: {border_radius: 10.0 color: #xc7402f color_hover: #xd0563f color_down: #xa83424 border_size: 0.0}
                        draw_text +: {color: #ffffff text_style: font_bold_cjk{font_size: 9.0}}
                        text: crisis_opt_a_text}
                    ButtonFlat{width: Fill height: 38 padding: Inset{left: 12 right: 12} on_click: || crisis_adopt_b()
                        draw_bg +: {border_radius: 10.0 color: #x2f7d4f color_hover: #x3d9460 color_down: #x256540 border_size: 0.0}
                        draw_text +: {color: #ffffff text_style: font_bold_cjk{font_size: 9.0}}
                        text: crisis_opt_b_text}
                }
            }
        }
        // === 决赛 S3：待拍板提案横幅（管家出了提案、人还没拍板时出现在列表顶部）——
        //   原则不变：模型文本不参与动作接线，这里只是「去拍板」的指路条（静态 copy）；
        //   零渲染零占位（plan_pending=="no" 时留 1px，#5 空分支硬约束范式）。
        if plan_pending == "yes" {
            RoundedView{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
                show_bg: true draw_bg.color: #xfbe9e5 draw_bg.border_radius: 12.0
                Label{width: Fill text: "📋 管家有提案待拍板" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 9}}
                ButtonFlat{text: "去拍板" height: 36 padding: Inset{left: 12 right: 12} on_click: || enter_chat()
                    draw_bg +: {border_radius: 16.0 color: #xc7402f color_hover: #xd0563f color_down: #xa83424 border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}}
        }
        // === v0.10.2 WP1：成员端「替我投票」横幅（双实例牵线的成员侧回执之家）——
        //   伴生进程 qx-member-agent 自治投票后写 member-vote.json；此处只读显示 +
        //   「改投首选」Outbox 动作（写 member-revote.json，伴生进程消费发信）。
        if member_vote_flag == "yes" {
            RoundedView{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
                show_bg: true draw_bg.color: #xe8f3ec draw_bg.border_radius: 12.0
                Label{width: Fill text: member_vote_text draw_text.color: #x2f7d4f draw_text.text_style.font_size: 9}
                ButtonFlat{text: "改投首选" height: 32 padding: Inset{left: 10 right: 10} on_click: || member_revote()
                    draw_bg +: {border_radius: 16.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #x2f7d4f}
                    draw_text +: {color: #x2f7d4f color_hover: #x2f7d4f color_down: #x2f7d4f text_style: font_bold_cjk{font_size: 8}}}
            }
        }
        // v0.10.2：搜索框迁入「怎么用？」说明卡（见本文件尾部 howto 卡）——HTML 屏 01
        //   无此元素，主页逐元素对齐基准稿；功能保留，展开说明卡即可达（回归 R-12 同步适配）。
        // === #11 外环修：取消确认态变体（根组件 if 不随状态重算，必须放闭包内）===
        if cancel_pending_flag == "yes" {
            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                ButtonFlat{text: "确认取消（5s）" height: 44 padding: Inset{left: 14 right: 14} on_click: || cancel_case()
                    draw_bg +: {border_radius: 16.0 color: #xa14d3c color_hover: #x8f4335 color_down: #x7d382c border_size: 0.0}
                    draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
            }
        }
        // === #10 新增：筛选标签栏 + 计数（必须放 on_render 内：根组件属性不随状态重算，#8 实证） ===
        // 照第一方 news:301-306 写法：if t.id == tab {TabButtonActive{}} else {TabButton{}}
        // 计数照 ai-providers:45 "N models" 写法。Tab 是 GestureView on_tap 触发 set_filter。
        let cf_now = "" + current_filter
        View{width: Fill height: Fit flow: Right spacing: 7 align: Align{y: 0.5}
            // 标签 1：全部
            GestureView{on_tap: |x, y| set_filter("all") width: Fit height: Fit
                if cf_now == "all" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #x2b2722 draw_bg.border_radius: 14.0
                        Label{text: "全部" draw_text.color: #xf7f2ec draw_text.text_style: theme.font_bold{font_size: 8}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 14.0
                        Label{text: "全部" draw_text.color: secondary draw_text.text_style.font_size: 8}
                    }
                }
            }
            // 标签 2：待拍板
            GestureView{on_tap: |x, y| set_filter("Proposing") width: Fit height: Fit
                if cf_now == "Proposing" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #x2b2722 draw_bg.border_radius: 14.0
                        Label{text: "待拍板" draw_text.color: #xf7f2ec draw_text.text_style: theme.font_bold{font_size: 8}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 14.0
                        Label{text: "待拍板" draw_text.color: secondary draw_text.text_style.font_size: 8}
                    }
                }
            }
            // 标签 3：已确认
            GestureView{on_tap: |x, y| set_filter("Confirmed") width: Fit height: Fit
                if cf_now == "Confirmed" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #x2b2722 draw_bg.border_radius: 14.0
                        Label{text: "已确认" draw_text.color: #xf7f2ec draw_text.text_style: theme.font_bold{font_size: 8}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 14.0
                        Label{text: "已确认" draw_text.color: secondary draw_text.text_style.font_size: 8}
                    }
                }
            }
            // 标签 4：已完成（v0.4.0 S4：活动全生命周期到收尾）
            GestureView{on_tap: |x, y| set_filter("Completed") width: Fit height: Fit
                if cf_now == "Completed" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #x2b2722 draw_bg.border_radius: 14.0
                        Label{text: "完成" draw_text.color: #xf7f2ec draw_text.text_style: theme.font_bold{font_size: 8}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 14.0
                        Label{text: "完成" draw_text.color: secondary draw_text.text_style.font_size: 8}
                    }
                }
            }
            // 标签 5：已取消
            GestureView{on_tap: |x, y| set_filter("Cancelled") width: Fit height: Fit
                if cf_now == "Cancelled" {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #x2b2722 draw_bg.border_radius: 14.0
                        Label{text: "已取消" draw_text.color: #xf7f2ec draw_text.text_style: theme.font_bold{font_size: 8}}
                    }
                } else {
                    RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 5 bottom: 5}
                        show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 14.0
                        Label{text: "已取消" draw_text.color: secondary draw_text.text_style.font_size: 8}
                    }
                }
            }
            // 计数标签（照 ai-providers:45 "N models" 写法，靠右）
            // total = 0 时也显示"共 0 条"，不编造
            // v0.10.1：HTML 原文「共 3 / 3 条」（斜杠两侧空格）
            View{width: Fill height: 1}
            Label{width: Fit text: "共 " + filter_count_str + " / " + filter_total_str + " 条"
                draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
        }
        // .filter-row margin-bottom:14 = 列表 spacing 12 + 2px spacer
        View{width: Fill height: 2}

        // 空态分流（照 ai-providers:242-248 三分支）：本来没有 vs 筛选后没有，文案必须不同
        // 分支 A：本来就没有任何守护 —— 引导用户建第一条
        if cases.len() == 0 {
            // === #11 新增：首用引导卡 —— 只用 seq==0 判断（seq 只在 add_case 成功后 +1）。
            //   只要用户成功建过一条守护（seq>0），这张卡就永远消失；
            //   即使用户后来删了所有守护（cases.len()==0），也不再回到首用引导，
            //   只显示原本的"还没有聚会守护"通用空态。
            //   写在 on_render 闭包里（#8/#10 实证：根组件属性不随状态重算）。
            if seq == 0 {
                Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 20 bottom: 20} spacing: 8
                    Label{width: Fill text: "第一次用？把群消息丢给管家" draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 11}}
                    Label{width: Fill text: "管家分诊、查冲突、出提案——你只点「拍板」；改期/加人/记账跟管家说就行。" draw_text.color: secondary draw_text.text_style.font_size: 9}
                    View{width: Fill height: Fit flow: Right spacing: 10
                        ButtonFlat{text: "用示例试试" height: 44 padding: Inset{left: 14 right: 14} on_click: || fill_example()
                            draw_bg +: {border_radius: 20.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                            draw_text +: {color: accent color_hover: accent color_down: accent}}
                        ButtonFlat{text: "📋 嗅探邀约" height: 44 padding: Inset{left: 14 right: 14} on_click: || scout_button_click()
                            draw_bg +: {border_radius: 20.0 color: #xfbf4e2 color_hover: #f7ebd1 color_down: #eddcb7 border_size: 1.0 border_color: #xdca842}
                            draw_text +: {color: #xb87b14 color_hover: #a36b0f color_down: #a36b0f text_style: font_bold_cjk{font_size: 9}}}
                    }
                }
            }
            // === #36：「怎么用」说明卡已移出空列表分支 → 列表模式公共尾部（见下方）。
            //   #29 把 4 个低频键（改时间/AI解析/导出/清空全部）折叠进本卡后，
            //   卡却只在本空态分支渲染——「有守护在册」时四键全部不可达：
            //   清空全部永远删不到数据，演示剧本 8/18/19/20 步不可执行（#34 真机复验抓到）。
            //   UI 改版（card-ux：去重复）：首用引导卡在场（seq==0）时通用空态卡隐藏——
            //   两卡文案同为「从一条消息开始」，同屏重复。
            if seq > 0 {
                Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 28 bottom: 28} spacing: 6
                    Label{width: Fill text: "还没有守护" draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 11}}
                    Label{width: Fill text: "把群里那句聚会邀约贴进来，剩下的交给管家。\n（无 AI 服务时点「建守护」走本地规则兜底）" draw_text.color: secondary draw_text.text_style.font_size: 9}
                }
            }
            // 空分支兜底：永远留 1px 占位，防上帧残留（ai-providers:241 注释范式）
            View{width: Fill height: 1}
        // 分支 B：有守护但当前筛选下 0 条 —— 引导用户换筛选或建新条
        } else if filtered_idxs.len() == 0 {
            Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 28 bottom: 28} spacing: 6
                Label{width: Fill text: "这个筛选下还没有守护" draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 11}}
                Label{width: Fill text: "换个标签看看，或粘贴一条群消息开始（当前筛选：" + (if cf_now == "all" { "全部" } else if cf_now == "Proposing" { "待拍板" } else if cf_now == "Confirmed" { "已确认" } else if cf_now == "Completed" { "已完成" } else { "已取消" }) + "）。" draw_text.color: secondary draw_text.text_style.font_size: 9}
            }
            // 筛选空分支兜底：同样留 1px 占位
            View{width: Fill height: 1}
        } else {
            // === #9 新增：撤销条放在 on_render 内的 undo_bar View 中（根组件 if 不重算，#8 外环修） ===
            // 撤销条必须放在渲染闭包里——根组件属性只在首次定型，不随状态变。
            // undo_win_open 守卫防止 5s 定时器在用户已撤销后再次覆盖。
            if undo_win_open == "yes" {
                RoundedView{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                    padding: Inset{left: 12 right: 12 top: 8 bottom: 8}
                    show_bg: true draw_bg.color: #xfbe9e5 draw_bg.border_radius: 12.0
                    Label{width: Fill text: "撤销窗口已开（点下方按钮恢复）" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 9}}
                    ButtonFlat{text: "撤销取消" height: 44 padding: Inset{left: 14 right: 14} on_click: || undo_cancel()
                        draw_bg +: {border_radius: 16.0 color: #xc7402f color_hover: #xa83424 color_down: #x8f2b1d border_size: 0.0}
                        draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff}}
                }
            }

            // === #10 改造：列表循环改走 filtered_idxs，按当前筛选渲染 ===
            // v0.9.0 WP2 重构：三段式卡（标题行+chips / 元信息行 / 迷你红线）+ 冲突琥珀横幅
            //   + 原文引行（HTML 规范 01 屏）。红线四结：done=实心朱砂 / now=朱砂+晕环 /
            //   todo=描边空心；闭包内只有 if/else（无嵌套 for——pop_stack 红线）。
            for i in filtered_idxs.len() {
                let j = filtered_idxs[i]
                let cur_id = case_ids[j]
                // v0.10.1：元信息按 HTML .case-meta 拆段（gap 12 并列，不再用「·」串联）——
                //   段1「周六 · 上午」时段词加粗墨色；段2 地点（抽取到=加粗墨色/未抽取=灰）；
                //   段3 人数或「共 N 字」（N=原文字数，split("") 按字计——len() 是字节数，CJK 会 ×3）。
                //   真 bug 修复：空 people 落扁平数组时是「未填写」，直接 count_people 会算成 1 人。
                let _pl_disp = "" + case_place_lines[j]
                let _pl_got = "yes"
                if _pl_disp == "（未抽取到）" { _pl_disp = "地点未抽取"; _pl_got = "no" }
                let _ppl_raw = "" + case_people_line[j]
                let _np = 0
                if _ppl_raw != "未填写" { _np = count_people(_ppl_raw) }
                let _day = "" + case_slot_day[j]
                let _part = "" + case_slot_part[j]
                // 原文截断 24 字（split("") 尾部带 2 个空哨兵——len() 需减 2 才是真实字数；
                //   与 learned「循环上限钳 cs.len()-2」同源；校准后 font 8 字宽 ≈11.5px：24 字+「…」≈ 310 ≤ 342 单行不裁）
                let _full_text = "" + case_text_lines[j]
                let _fcparts = _full_text.split("")
                let _nchars = _fcparts.len() - 2
                if _nchars < 0 { _nchars = 0 }
                let _shown_text = "「" + _full_text + "」"
                if _nchars > 24 {
                    let _kept = ""
                    for _pi in _fcparts.len() {
                        if _pi >= 24 { break }
                        _kept = _kept + _fcparts[_pi]
                    }
                    _shown_text = "「" + _kept + "…」"
                }
                GestureView{width: Fill height: Fit on_tap: |x, y| on_tap_card(cur_id)
                    // HTML .case-card{padding:14px 14px 12px}；卡内节奏用 margin 逐段还原
                    // （meta margin-top:7 / thread 11+11 / banner 11 / quote 9），统一 spacing 做不到
                    Card{padding: Inset{left: 14 right: 14 top: 14 bottom: 12} spacing: 0
                        // ── 段一：标题行（左题右 chips，chips 独立行间距 5，HTML .case-badges）──
                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                            // 标题 Fit 优先占宽（不被 chips 挤压折行/截断）；chips 区 Fill 右对齐
                            Label{width: Fit text: case_lines[j] draw_text.color: ink draw_text.text_style: TextStyle{font_size: 11 font_family: FontFamily{
                                latin := FontMember{res: crate_resource("makepad_widgets:resources/IBMPlexSans-SemiBold.ttf") asc: -0.1 desc: 0.0}
                                chinese := FontMember{res: crate_resource("makepad_widgets:resources/LXGWWenKaiBold.ttf") asc: 0.0 desc: 0.0}
                            }} max_lines: 1}
                            View{width: Fill height: 1}
                            View{width: Fit height: Fit flow: Right spacing: 5 align: Align{y: 0.5}
                            // 状态 chip（neutral/jade/danger 按 HTML 语义；padding 3×10 radius 12）
                            if case_statuses[j] == "Confirmed" {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                    show_bg: true draw_bg.color: #xe8f3ec draw_bg.border_radius: 12.0
                                    Label{text: "已确认" draw_text.color: #x2f7d4f draw_text.text_style.font_size: 8}}
                            } else if case_statuses[j] == "Cancelled" {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                    show_bg: true draw_bg.color: #xf6e8e3 draw_bg.border_radius: 12.0
                                    Label{text: "已取消" draw_text.color: #xa14d3c draw_text.text_style.font_size: 8}}
                            } else if case_statuses[j] == "Completed" {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                    show_bg: true draw_bg.color: #xe8f3ec draw_bg.border_radius: 12.0
                                    Label{text: "已完成" draw_text.color: #x2f7d4f draw_text.text_style.font_size: 8}}
                            } else {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                    show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 12.0
                                    Label{text: "待拍板" draw_text.color: #x6e675e draw_text.text_style.font_size: 8}}
                            }
                            // 冲突 chip（琥珀，与待收尾同语义色；HTML 文案「⚡ 冲突」带空格）
                            if case_conflict[j] == "yes" {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                    show_bg: true draw_bg.color: #xf7ebd3 draw_bg.border_radius: 12.0
                                    Label{text: "⚡ 冲突" draw_text.color: #xa87516 draw_text.text_style.font_size: 8}}
                            }
                            // 待收尾 chip（有账未清且已确认/已完成）
                            if case_bill_total_str[j] != "" && case_bill_cleared[j] != "yes" {
                                if case_statuses[j] == "Confirmed" {
                                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                        show_bg: true draw_bg.color: #xf7ebd3 draw_bg.border_radius: 12.0
                                        Label{text: "待收尾" draw_text.color: #xa87516 draw_text.text_style.font_size: 8}}
                                }
                                if case_statuses[j] == "Completed" {
                                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 3 bottom: 3}
                                        show_bg: true draw_bg.color: #xf7ebd3 draw_bg.border_radius: 12.0
                                        Label{text: "待收尾" draw_text.color: #xa87516 draw_text.text_style.font_size: 8}}
                                }
                            }
                            }
                        }
                        // ── 段二：元信息行（HTML .case-meta：三段并列 gap 12；时段词/已抽取地点加粗墨色）──
                        View{width: Fill height: Fit flow: Right spacing: 12 margin: Inset{top: 7}
                            if _day == "" {
                                Label{width: Fit text: "时间未抽取" draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                            } else if _part == "" {
                                Label{width: Fit text: _day draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                            } else {
                                View{width: Fit height: Fit flow: Right spacing: 0
                                    Label{width: Fit text: _day + " · " draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                                    Label{width: Fit text: _part draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 8}}
                                }
                            }
                            if _pl_got == "yes" {
                                Label{width: Fit text: _pl_disp draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 8}}
                            } else {
                                Label{width: Fit text: _pl_disp draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                            }
                            if _np > 0 {
                                Label{width: Fit text: ("" + _np) + " 人" draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                            } else {
                                Label{width: Fit text: "共 " + ("" + _nchars) + " 字" draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                            }
                        }
                        // ── 段三：发丝线 + 迷你红线（带阶段标签；已取消不画线；HTML 规范 .case-thread）──
                        //   HTML：thread margin-top 11 + padding-top 11（发丝线上方 11、结/签在发丝线下 11）
                        if case_statuses[j] != "Cancelled" {
                            RoundedView{width: Fill height: 1 margin: Inset{top: 11} show_bg: true draw_bg.color: #xe9dfd2 draw_bg.border_radius: 0.5}
                            View{width: Fill height: Fit flow: Right align: Align{y: 0.0} margin: Inset{top: 11}
                                // 结 1（待拍板）
                                View{width: Fit height: Fit flow: Down spacing: 5 align: Align{x: 0.5}
                                    View{width: 15 height: 15 align: Align{x: 0.5 y: 0.5}
                                        if case_stage[j] > 0 {
                                            RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}
                                        } else {
                                            RoundedView{width: 15 height: 15 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg.color: #xc7402f2e draw_bg.border_radius: 7.5
                                                RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}}
                                        }
                                    }
                                    if case_stage[j] == 0 {
                                        Label{text: "待拍板" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                                    } else {
                                        Label{text: "待拍板" draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
                                    }
                                }
                                // 段 1
                                if case_stage[j] > 0 {
                                    RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f margin: Inset{top: 6.5} draw_bg.border_radius: 1.0}
                                } else {
                                    RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xe1d7ca margin: Inset{top: 6.5} draw_bg.border_radius: 1.0}
                                }
                                // 结 2（已确认）
                                View{width: Fit height: Fit flow: Down spacing: 5 align: Align{x: 0.5}
                                    View{width: 15 height: 15 align: Align{x: 0.5 y: 0.5}
                                        if case_stage[j] > 1 {
                                            RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}
                                        } else if case_stage[j] == 1 {
                                            RoundedView{width: 15 height: 15 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg.color: #xc7402f2e draw_bg.border_radius: 7.5
                                                RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}}
                                        } else {
                                            RoundedView{width: 6.5 height: 6.5 show_bg: true draw_bg.color: #fffdfa draw_bg.border_size: 1.5 draw_bg.border_color: #xc9bfb2 draw_bg.border_radius: 3.25}
                                        }
                                    }
                                    if case_stage[j] == 1 {
                                        Label{text: "已确认" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                                    } else {
                                        Label{text: "已确认" draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
                                    }
                                }
                                // 段 2
                                if case_stage[j] > 1 {
                                    RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f margin: Inset{top: 6.5} draw_bg.border_radius: 1.0}
                                } else {
                                    RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xe1d7ca margin: Inset{top: 6.5} draw_bg.border_radius: 1.0}
                                }
                                // 结 3（已完成）
                                View{width: Fit height: Fit flow: Down spacing: 5 align: Align{x: 0.5}
                                    View{width: 15 height: 15 align: Align{x: 0.5 y: 0.5}
                                        if case_stage[j] > 2 {
                                            RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}
                                        } else if case_stage[j] == 2 {
                                            RoundedView{width: 15 height: 15 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg.color: #xc7402f2e draw_bg.border_radius: 7.5
                                                RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}}
                                        } else {
                                            RoundedView{width: 6.5 height: 6.5 show_bg: true draw_bg.color: #fffdfa draw_bg.border_size: 1.5 draw_bg.border_color: #xc9bfb2 draw_bg.border_radius: 3.25}
                                        }
                                    }
                                    if case_stage[j] == 2 {
                                        Label{text: "已完成" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                                    } else {
                                        Label{text: "已完成" draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
                                    }
                                }
                                // 段 3
                                if case_stage[j] > 2 {
                                    RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f margin: Inset{top: 6.5} draw_bg.border_radius: 1.0}
                                } else {
                                    RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xe1d7ca margin: Inset{top: 6.5} draw_bg.border_radius: 1.0}
                                }
                                // 结 4（已收尾）
                                View{width: Fit height: Fit flow: Down spacing: 5 align: Align{x: 0.5}
                                    View{width: 15 height: 15 align: Align{x: 0.5 y: 0.5}
                                        if case_stage[j] > 3 {
                                            RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}
                                        } else if case_stage[j] == 3 {
                                            RoundedView{width: 15 height: 15 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg.color: #xc7402f2e draw_bg.border_radius: 7.5
                                                RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}}
                                        } else {
                                            RoundedView{width: 6.5 height: 6.5 show_bg: true draw_bg.color: #fffdfa draw_bg.border_size: 1.5 draw_bg.border_color: #xc9bfb2 draw_bg.border_radius: 3.25}
                                        }
                                    }
                                    if case_stage[j] == 3 {
                                        Label{text: "已收尾" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                                    } else {
                                        Label{text: "已收尾" draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
                                    }
                                }
                            }
                        }
                        // ── 冲突琥珀横幅（整条卡底部；HTML .conflict-banner：⚡图标+分段文本，
                        //   对方「#N·活动」加粗；margin-top 11 padding 8×11 radius 10）──
                        if case_conflict[j] == "yes" {
                            if case_statuses[j] != "Cancelled" {
                                RoundedView{width: Fill height: Fit flow: Right spacing: 4 align: Align{y: 0.5} margin: Inset{top: 11}
                                    padding: Inset{left: 9 right: 9 top: 8 bottom: 8}
                                    show_bg: true draw_bg.color: #xf7ebd3 draw_bg.border_radius: 10.0
                                    Label{width: Fit text: "⚡" draw_text.color: #xa87516 draw_text.text_style.font_size: 8}
                                    if case_conflict_other[j] != "" {
                                        Label{width: Fit text: "与" draw_text.color: #xa87516 draw_text.text_style.font_size: 8}
                                        Label{width: Fit text: case_conflict_other[j] draw_text.color: #xa87516 draw_text.text_style: font_bold_cjk{font_size: 8}}
                                        Label{width: Fill text: "同占「" + case_slot_day[j] + "-" + case_slot_part[j] + "」，改个时段即解开" draw_text.color: #xa87516 draw_text.text_style.font_size: 8 max_lines: 1}
                                    } else {
                                        Label{width: Fill text: "时间冲突，改个时段即解开" draw_text.color: #xa87516 draw_text.text_style.font_size: 8 max_lines: 1}
                                    }
                                }
                            }
                        }
                        // ── 原文引行（faint；HTML .case-quote margin-top 9）──
                        Label{width: Fill text: _shown_text draw_text.color: #xa89e91 draw_text.text_style.font_size: 8 margin: Inset{top: 9} max_lines: 1}
                    }
                }
            }
            // 非空分支兜底：留 1px 占位（ai-providers:241 注释范式）
            View{width: Fill height: 1}
        }
            // === #36：「怎么用」说明卡（自空列表分支移此）——
            //   写在 case_list.on_render 闭包里（根组件属性不随状态重算，#8 硬约束外环修）。
            //   显隐走 howto_show_flag（字符串标记，#13 实证布尔不可靠）："yes" 才渲染整张卡；
            //   折叠时只留 1px 占位，防上帧残留（ai-providers:241 兜底范式）。
            //   默认展开策略：未建过守护（seq==0）→ 第一次启动自动展开；
            //   建过守护（seq>0）→ 默认收起，不打扰老用户。点首屏底部「怎么用？」按钮可手动切。
            //   只读 howto_show_flag / seq 两个字符串/整数，不读 cases[i][...]（符合硬约束 #2）。
            //   #36 位置语义：列表模式三分支（空态/筛选空/有卡）共用此尾部，
            //   展开后滚动到底即达——#29 的低频键在有数据时重新可达。
            if howto_show_flag == "yes" {
                let q_now2 = "" + current_query
                Card{align: Align{x: 0.5} padding: Inset{left: 20 right: 20 top: 20 bottom: 20} spacing: 8
                    Label{width: Fill text: "怎么用？" draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 11}}
                    Label{width: Fill text: "粘贴群消息，点「交给管家」；管家出提案，你在提案卡上点「拍板」即落地。" draw_text.color: ink draw_text.text_style.font_size: 10}
                    Label{width: Fill text: "改期/加人/记账/取消直接跟管家说（如「改到周日下午」）；无 AI 服务的设备自动降级——点「建守护」走本地规则，功能完整。" draw_text.color: ink draw_text.text_style.font_size: 10}
                    // === #45 C 切片：app 不能自驱唤醒 agent（无 needs/triggers），
                    // 宿主「Ask 牵线」面板问我任何问题时，我会主动带出临期/待拍板提醒
                    // （详见 AGENT.md「主动提示行为」小节）。
                    Label{width: Fill text: "在宿主「Ask 牵线」面板可以问：「周六有什么安排？」——已确认的守护临期时我会主动提醒你" draw_text.color: ink draw_text.text_style.font_size: 10}
                    // === #29（外环派）：低频操作折叠区 ——
                    //   原 ai_row 的 4 个按钮（改时间 / AI 解析 / 导出数据 / 清空全部）
                    //   从根组件搬到「怎么用？」说明卡内,只在卡片展开时可见。
                    //   写在 on_render 闭包里,符合硬约束 #1(根组件属性不随状态重算,
                    //   闭包内可重渲染);on_click 直接调既有 fn(cycle_slot/enter_chat/
                    //   export_data/clear_all_data),无新逻辑、无新状态。
                    //   height: 44 与主区三键对齐,触控目标达 HIG 44pt 标准。
                    // === #12 搜索框（v0.10.2 迁入：主页对齐 HTML 基准，搜索归入说明卡）===
                    //   语义不变：on_change 实时 set_query；有词时显示「× 清空」。
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        TextInput{width: Fill height: 40 empty_text: "搜活动或地点，如：深圳湾"
                            text: q_now2
                            draw_bg +: {color: #fffdfa color_hover: #fffdfa color_focus: #fffdfa color_empty: #fffdfa border_radius: 12.0}
                            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: #xa89e91 color_empty_hover: #xa89e91 text_style +: {font_size: 9}}
                            on_change: |t| set_query("" + t)}
                        if q_now2 != "" {
                            GestureView{on_tap: |x, y| set_query("") height: 36
                                RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 6 bottom: 6}
                                    show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 16.0
                                    Label{text: "× 清空" draw_text.color: secondary draw_text.text_style.font_size: 9}
                                }
                            }
                        }
                    }
                    Label{width: Fill text: "低频操作（点下方按钮）" draw_text.color: secondary draw_text.text_style: font_bold_cjk{font_size: 9}}
                    // 复用 #11 AI 按钮弱化风格 + #14 灰底色,与主区三键视觉拉开层级
                    // （次级灰底 + accent/secondary 字,不抢眼）。
                    // #44 外环修：五键原单行 flow:Right 总宽 ~500px > 容器 ~380px，第 5 键
                    //   （清空全部）被布局丢弃出控件树——#37 加 glance 键后清空全部不可达
                    //   （回归 R-13 真机实锤：按钮不在 /snap 树）。拆两行根治。
                    View{width: Fill height: Fit flow: Right spacing: 6
                        ButtonFlat{text: "改时间（5 槽）" height: 44 padding: Inset{left: 10 right: 10} on_click: || cycle_slot("" + selected_id)
                            draw_bg +: {border_radius: 16.0 color: #xa35f00 color_hover: #x8f5400 color_down: #x7d4a00 border_size: 0.0}
                            draw_text +: {color: #ffffff color_hover: #ffffff color_down: #xffffff}}
                        ButtonFlat{text: "打开管家" height: 44 padding: Inset{left: 10 right: 10} on_click: || enter_chat()
                            draw_bg +: {border_radius: 16.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                            draw_text +: {color: accent color_hover: accent color_down: accent}}
                        ButtonFlat{text: "导出数据" height: 44 padding: Inset{left: 10 right: 10} on_click: || export_data()
                            draw_bg +: {border_radius: 16.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                            draw_text +: {color: secondary color_hover: secondary color_down: secondary}}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6
                        // === #37「发布到 glance 屏」按钮（人触发，与导出/清空同级灰底）===
                        ButtonFlat{text: "发布到 glance 屏" height: 44 padding: Inset{left: 10 right: 10} on_click: || publish_glance()
                            draw_bg +: {border_radius: 16.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                            draw_text +: {color: secondary color_hover: secondary color_down: secondary}}
                        ButtonFlat{text: "清空全部" height: 44 padding: Inset{left: 10 right: 10} on_click: || clear_all_data()
                            draw_bg +: {border_radius: 16.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                            draw_text +: {color: #xa14d3c color_hover: #xa14d3c color_down: #xa14d3c}}
                    }
                }
            } else {
                // 折叠时留 1px 占位（on_render 空分支硬约束 #5：至少一个子节点）
                View{width: Fill height: 1}
            }
        }
    }}
    // === #48b 外环修：详情/列表拆双 ScrollY——set_visible 互斥切换。单视图复用时
    //   滚动偏移不随内容切换复位（深位点卡详情在视口外，用户看到"点了没反应"，
    //   #48 复验真机实锤）；新建/重显的视图从 scroll=0 起步，天然复位。零尺寸变化。
    // 注：visible:false 不能写进声明——render() 会把声明源 re-apply 回视图（view.rs
    //   make_render_me 机制），把 set_visible(true) 覆盖回 false（#48b 实测踩坑）。
    //   初始隐藏改由 load() 里 set_visible(false) 命令式完成。
    detail_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
        if ui_mode == "detail" {
            let sel = -1
            for si in case_ids.len() {
                if case_ids[si] == ("" + selected_id) { sel = si; break }
            }
            if sel < 0 {
                Card{Label{width: Fill text: "还没有选中的守护——返回列表点选一条" draw_text.color: secondary}}
            } else {
                Card{
                    let slot_now = case_slot_day[sel] + "-" + case_slot_part[sel]
                    if slot_now == "-" { slot_now = "未抽取" }
                    // v0.9.0 WP2：详情分区化（HTML 规范 02 屏）
                    //   导航 → 标题+chips → 红线大卡 → 键值分区 → AA 对账表 → 回执 → 输入行 → 主按钮
                    ButtonFlat{text: "‹ 返回列表" height: 36 padding: Inset{left: 8 right: 8} on_click: || back_to_list()
                        draw_bg +: {border_radius: 12.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 0.0}
                        draw_text +: {color: #x6e675e color_hover: #x6e675e color_down: #x6e675e}}
                    // ── v0.10.0 WP5：结案报告卡（活动完成+账清=已收尾；生命周期句号）──
                    //   数据全来自审计字段/状态机；分享回顾经 matrix.send_message 真发
                    //   （无服务宿主诚实降级——透出真实错误）。
                    if fin_show == "yes" {
                        Card{show_bg: true draw_bg.color: #xfffdfa draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: #x2f7d4f
                            padding: Inset{left: 14 right: 14 top: 12 bottom: 12} spacing: 8
                            // 标题 + 已收尾徽章
                            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                                Label{width: Fill text: fin_title draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 11}}
                                RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                                    show_bg: true draw_bg.color: #xe8f3ec draw_bg.border_radius: 12.0
                                    Label{text: "已完成 · 已收尾" draw_text.color: #x2f7d4f draw_text.text_style.font_size: 8}}
                            }
                            // 全绿迷你红线（生命周期句号：四结全实心朱砂）
                            View{width: Fill height: Fit flow: Right align: Align{y: 0.5}
                                RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 1.0}
                                RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 1.0}
                                RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 1.0}
                                RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 4.0}
                            }
                            // 四统计（均分四列：数字+标签）
                            View{width: Fill height: Fit flow: Right
                                View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
                                    Label{text: fin_stat_people draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 12}}
                                    Label{text: "到场" draw_text.color: #x6e675e draw_text.text_style.font_size: 7}}
                                View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
                                    Label{text: fin_stat_per draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 12}}
                                    Label{text: "人均" draw_text.color: #x6e675e draw_text.text_style.font_size: 7}}
                                View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
                                    Label{text: fin_stat_weather draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 12}}
                                    Label{text: "当日天气" draw_text.color: #x6e675e draw_text.text_style.font_size: 7}}
                                View{width: Fill height: Fit flow: Down spacing: 2 align: Align{x: 0.5}
                                    Label{text: fin_stat_days draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 12}}
                                    Label{text: "周期天数" draw_text.color: #x6e675e draw_text.text_style.font_size: 7}}
                            }
                            // 状态变迁时间线（审计事件 + UTC+8 时间戳）
                            View{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{top: 8}
                                Label{text: "守护时间线" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                                for fi in fin_timeline.len() {
                                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                        RoundedView{width: 6 height: 6 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 3.0}
                                        Label{width: Fill text: fin_timeline[fi] draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                                    }
                                }
                            }
                            ButtonFlat{width: Fill text: "分享回顾到群" height: 44 on_click: || share_fin_report()
                                draw_bg +: {border_radius: 22.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                                draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f text_style: font_bold_cjk{font_size: 9}}}
                            ButtonFlat{width: Fill text: "邮件回顾（人审）" height: 44 on_click: || mail_share_fin()
                                draw_bg +: {border_radius: 22.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                                draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f text_style: font_bold_cjk{font_size: 9}}}
                        }
                    }
                    // ── 标题行：#N·活动 + 状态 chips（chips 紧跟标题，HTML 02 屏 .d-nav gap 8）──
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        Label{width: Fit text: case_lines[sel] draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 12}}
                        if case_statuses[sel] == "Confirmed" {
                            RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                                show_bg: true draw_bg.color: #xe8f3ec draw_bg.border_radius: 12.0
                                Label{text: "已确认" draw_text.color: #x2f7d4f draw_text.text_style.font_size: 8}}
                        } else if case_statuses[sel] == "Cancelled" {
                            RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                                show_bg: true draw_bg.color: #xf6e8e3 draw_bg.border_radius: 12.0
                                Label{text: "已取消" draw_text.color: #xa14d3c draw_text.text_style.font_size: 8}}
                        } else if case_statuses[sel] == "Completed" {
                            RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                                show_bg: true draw_bg.color: #xe8f3ec draw_bg.border_radius: 12.0
                                Label{text: "已完成" draw_text.color: #x2f7d4f draw_text.text_style.font_size: 8}}
                        } else {
                            RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                                show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 12.0
                                Label{text: "待拍板" draw_text.color: #x6e675e draw_text.text_style.font_size: 8}}
                        }
                        if case_bill_total_str[sel] != "" && case_bill_cleared[sel] != "yes" {
                            if case_statuses[sel] == "Confirmed" {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                                    show_bg: true draw_bg.color: #xf7ebd3 draw_bg.border_radius: 12.0
                                    Label{text: "待收尾" draw_text.color: #xa87516 draw_text.text_style.font_size: 8}}
                            }
                            if case_statuses[sel] == "Completed" {
                                RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 3 bottom: 3}
                                    show_bg: true draw_bg.color: #xf7ebd3 draw_bg.border_radius: 12.0
                                    Label{text: "待收尾" draw_text.color: #xa87516 draw_text.text_style.font_size: 8}}
                            }
                        }
                    }
                    // ── 红线大卡（带阶段标签；已取消不画）──
                    if case_statuses[sel] != "Cancelled" {
                        View{width: Fill height: Fit padding: Inset{left: 4 right: 4 top: 6 bottom: 2} flow: Right align: Align{y: 0.0}
                            View{width: Fit height: Fit flow: Down spacing: 5 align: Align{x: 0.5}
                                if case_stage[sel] > 0 {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 11 height: 11 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 5.5}}
                                } else {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 18 height: 18 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg.color: #xc7402f2e draw_bg.border_radius: 9.0 RoundedView{width: 11 height: 11 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 5.5}}}
                                }
                                if case_stage[sel] == 0 {
                                    Label{text: "待拍板" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                                } else {
                                    Label{text: "待拍板" draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
                                }
                            }
                            if case_stage[sel] > 1 {
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f margin: Inset{top: 10 right: 6} draw_bg.border_radius: 1.0}
                            } else {
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xe1d7ca margin: Inset{top: 10 right: 6} draw_bg.border_radius: 1.0}
                            }
                            View{width: Fit height: Fit flow: Down spacing: 5 align: Align{x: 0.5}
                                if case_stage[sel] > 1 {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 11 height: 11 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 5.5}}
                                } else if case_stage[sel] == 1 {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 18 height: 18 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg.color: #xc7402f2e draw_bg.border_radius: 9.0 RoundedView{width: 11 height: 11 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 5.5}}}
                                } else {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xfffdfa draw_bg.border_size: 1.5 draw_bg.border_color: #xc9bfb2 draw_bg.border_radius: 4.0}}
                                }
                                if case_stage[sel] == 1 {
                                    Label{text: "已确认" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                                } else {
                                    Label{text: "已确认" draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
                                }
                            }
                            if case_stage[sel] > 2 {
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f margin: Inset{top: 10 left: 6 right: 6} draw_bg.border_radius: 1.0}
                            } else {
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xe1d7ca margin: Inset{top: 10 left: 6 right: 6} draw_bg.border_radius: 1.0}
                            }
                            View{width: Fit height: Fit flow: Down spacing: 5 align: Align{x: 0.5}
                                if case_stage[sel] > 2 {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 11 height: 11 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 5.5}}
                                } else if case_stage[sel] == 2 {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 18 height: 18 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg.color: #xc7402f2e draw_bg.border_radius: 9.0 RoundedView{width: 11 height: 11 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 5.5}}}
                                } else {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xfffdfa draw_bg.border_size: 1.5 draw_bg.border_color: #xc9bfb2 draw_bg.border_radius: 4.0}}
                                }
                                if case_stage[sel] == 2 {
                                    Label{text: "已完成" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                                } else {
                                    Label{text: "已完成" draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
                                }
                            }
                            if case_stage[sel] > 3 {
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xc7402f margin: Inset{top: 10 left: 6 right: 6} draw_bg.border_radius: 1.0}
                            } else {
                                RoundedView{width: Fill height: 2 show_bg: true draw_bg.color: #xe1d7ca margin: Inset{top: 10 left: 6 right: 6} draw_bg.border_radius: 1.0}
                            }
                            View{width: Fit height: Fit flow: Down spacing: 5 align: Align{x: 0.5}
                                if case_stage[sel] > 3 {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 11 height: 11 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 5.5}}
                                } else if case_stage[sel] == 3 {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 18 height: 18 align: Align{x: 0.5 y: 0.5} show_bg: true draw_bg.color: #xc7402f2e draw_bg.border_radius: 9.0 RoundedView{width: 11 height: 11 show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 5.5}}}
                                } else {
                                    View{width: 22 height: 22 align: Align{x: 0.5 y: 0.5}
                                        RoundedView{width: 8 height: 8 show_bg: true draw_bg.color: #xfffdfa draw_bg.border_size: 1.5 draw_bg.border_color: #xc9bfb2 draw_bg.border_radius: 4.0}}
                                }
                                if case_stage[sel] == 3 {
                                    Label{text: "已收尾" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                                } else {
                                    Label{text: "已收尾" draw_text.color: #xa89e91 draw_text.text_style.font_size: 7}
                                }
                            }
                        }
                    }
                    // ── 键值分区（时间/地点/参与人/AA/原文）──
                    View{width: Fill height: Fit flow: Down
                        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5} padding: Inset{top: 6 bottom: 6}
                            Label{width: 56 text: "时 间" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                            Label{width: Fill text: slot_now draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 10}}}
                        RoundedView{width: Fill height: 1 show_bg: true draw_bg.color: #xe9dfd2 draw_bg.border_radius: 0.5}
                        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5} padding: Inset{top: 6 bottom: 6}
                            Label{width: 56 text: "地 点" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                            Label{width: Fill text: case_place_full[sel] draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 10}}}
                        RoundedView{width: Fill height: 1 show_bg: true draw_bg.color: #xe9dfd2 draw_bg.border_radius: 0.5}
                        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5} padding: Inset{top: 6 bottom: 6}
                            Label{width: 56 text: "参与人" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                            Label{width: Fill text: case_people_line[sel] draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 10}}}
                        RoundedView{width: Fill height: 1 show_bg: true draw_bg.color: #xe9dfd2 draw_bg.border_radius: 0.5}
                        View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5} padding: Inset{top: 6 bottom: 6}
                            Label{width: 56 text: "活 动" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                            Label{width: Fill text: case_activity_lines[sel] draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 10}}}
                        if case_bill_total_str[sel] != "" {
                            RoundedView{width: Fill height: 1 show_bg: true draw_bg.color: #xe9dfd2 draw_bg.border_radius: 0.5}
                            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5} padding: Inset{top: 6 bottom: 6}
                                Label{width: 56 text: "分 摊" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                                Label{width: Fill text: case_bill_split_text[sel] draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 10}}}
                        }
                    }
                    if case_receipt[sel].len() > 0 {
                        Label{width: Fill text: "回 执" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                        RoundedView{width: Fill height: Fit flow: Down spacing: 4 padding: Inset{left: 12 right: 12 top: 9 bottom: 9}
                            show_bg: true draw_bg.color: #xf7f2ec draw_bg.border_radius: 10.0
                            for _ri in case_receipt[sel].len() {
                                Label{width: Fill text: case_receipt[sel][_ri] draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                            }
                        }
                    }
                    // === v0.4.0 S5/S6 + v0.8.0 ③：日历 ICS 与提醒登记行（已确认态）===
                    if case_status_text[sel] == "已确认" {
                        Label{width: Fill text: "日历：ICS 已生成（calendar/qianxian-" + case_ids[sel] + ".ics）｜ 本机日历：确认时已尝试写入 ｜ 提醒：T-24h 已登记" draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                    }
                    // === v0.9.0 WP2：AA 对账表（HTML 规范 02 屏：成员|已付|状态 + 总计 + 恒等注脚）===
                    if ledger_head != "" {
                        SectionLabel{text: "账目 · " + ledger_head}
                        Card{padding: Inset{left: 14 right: 14 top: 10 bottom: 10} spacing: 7
                            // 表头
                            View{width: Fill height: Fit flow: Right spacing: 8
                                Label{width: 64 text: "成员" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                                Label{width: Fill text: "已付" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                                Label{width: Fill text: "应付" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                                Label{width: Fit text: "状态" draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                            }
                            // 行（闭包内 for+if/else 无嵌套 for——安全组合）
                            for li in ledger_name.len() {
                                View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                                    Label{width: 64 text: ledger_name[li] draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 9}}
                                    Label{width: Fill text: ledger_paid_show[li] draw_text.color: #x6e675e draw_text.text_style.font_size: 9}
                                    Label{width: Fill text: ledger_due_show[li] draw_text.color: #x6e675e draw_text.text_style.font_size: 9}
                                    if ledger_kind[li] == "due" {
                                        Label{width: Fit text: ledger_state[li] draw_text.color: #xa87516 draw_text.text_style: font_bold_cjk{font_size: 9}}
                                    } else {
                                        Label{width: Fit text: ledger_state[li] draw_text.color: #x2f7d4f draw_text.text_style: font_bold_cjk{font_size: 9}}
                                    }
                                }
                            }
                            // 总计行 + 恒等注脚
                            Label{width: Fill text: ledger_total_line draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 9}}
                            Label{width: Fill text: "✓ 按分取整 · 尾差由垫付最多者承担 · 总计恒等" draw_text.color: #x2f7d4f draw_text.text_style.font_size: 8}
                            if ledger_tip != "" {
                                RoundedView{width: Fill height: Fit padding: Inset{left: 11 right: 11 top: 8 bottom: 8}
                                    show_bg: true draw_bg.color: #xf1ece4 draw_bg.border_radius: 10.0
                                    Label{width: Fill text: ledger_tip draw_text.color: #x6e675e draw_text.text_style.font_size: 8}}
                            }
                            View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                                TextInput{width: Fill height: 40 empty_text: "收款：姓名 金额（如 阿明 150）"
                                    draw_bg +: {color: #xfffdfa color_hover: #fffdfa color_focus: #fffdfa color_empty: #fffdfa border_radius: 10.0}
                                    draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: #xa89e91 color_empty_hover: #xa89e91}
                                    on_change: |txt| set_pay_draft("" + txt)}
                                ButtonFlat{text: "记收款" height: 40 padding: Inset{left: 10 right: 10} on_click: || add_payment()
                                    draw_bg +: {border_radius: 13.0 color: #x2f7d4f color_hover: #x358a58 color_down: #x2d7a4a border_size: 0.0}
                                    draw_text +: {color: #xffffff color_hover: #ffffff color_down: #xffffff text_style: font_bold_cjk{font_size: 8}}}
                                ButtonFlat{text: "导出证据" height: 40 padding: Inset{left: 10 right: 10} on_click: || export_evidence("" + selected_id)
                                    draw_bg +: {border_radius: 13.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                                    draw_text +: {color: secondary color_hover: secondary color_down: secondary text_style: font_bold_cjk{font_size: 8}}}
                            }
                        }
                    }
                    // === v0.4.0 S4/S6：完成/收尾/分享（确认态；主按钮朱砂通栏）===
                    if case_status_text[sel] == "已确认" {
                        ButtonFlat{width: Fill text: "标记完成" height: 44 on_click: || set_completed("" + selected_id)
                            draw_bg +: {border_radius: 22.0 color: #xc7402f color_hover: #xd0563f color_down: #xa83424 border_size: 0.0}
                            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: font_bold_cjk{font_size: 9}}}
                        View{width: Fill height: Fit flow: Right spacing: 6
                            ButtonFlat{text: "AA 已收齐" height: 44 padding: Inset{left: 12 right: 12} on_click: || set_bill_cleared("" + selected_id)
                                draw_bg +: {border_radius: 22.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #x2f7d4f}
                                draw_text +: {color: #x2f7d4f color_hover: #x2f7d4f color_down: #x2f7d4f text_style: font_bold_cjk{font_size: 8}}}
                            ButtonFlat{text: "分享到群" height: 44 padding: Inset{left: 12 right: 12} on_click: || post_confirm_actions("" + selected_id)
                                draw_bg +: {border_radius: 22.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                                draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f text_style: font_bold_cjk{font_size: 8}}}
                        }

                    }
                    // === v0.10.0 WP3-A：群智收敛（确认态或已完成；降级路径明示）===
                    if case_status_text[sel] == "已确认" {
                        View{width: Fill height: Fit flow: Right spacing: 6
                            ButtonFlat{text: "发投票到群" height: 44 padding: Inset{left: 10 right: 10} on_click: || start_converge()
                                draw_bg +: {border_radius: 22.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                                draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f text_style: font_bold_cjk{font_size: 8}}}
                            ButtonFlat{text: "刷新计票" height: 44 padding: Inset{left: 10 right: 10} on_click: || refresh_converge()
                                draw_bg +: {border_radius: 22.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xa87516}
                                draw_text +: {color: #xa87516 color_hover: #xa87516 color_down: #xa87516 text_style: font_bold_cjk{font_size: 8}}}
                            ButtonFlat{text: "管家收敛" height: 44 padding: Inset{left: 10 right: 10} on_click: || converge_butler()
                                draw_bg +: {border_radius: 22.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #x2f7d4f}
                                draw_text +: {color: #x2f7d4f color_hover: #x2f7d4f color_down: #x2f7d4f text_style: font_bold_cjk{font_size: 8}}}
                        }
                        Label{width: Fill text: "群投票：文字卡形态（本宿主不支持活卡片原地更新）——协议一致，计票手动刷新" draw_text.color: #xa89e91 draw_text.text_style.font_size: 8}
                        if converge_summary != "" {
                            Label{width: Fill text: "📋 计票：" + converge_summary + (if converge_winner_slot != "" { " → 可收敛到 " + converge_winner_slot } else { "（平票/零票，请人工定夺）" }) draw_text.color: #x2f7d4f draw_text.text_style: font_bold_cjk{font_size: 8}}
                        }
                    }
                    if case_status_text[sel] == "已完成" {
                        View{width: Fill height: Fit flow: Right spacing: 6
                            ButtonFlat{text: "发投票到群" height: 44 padding: Inset{left: 10 right: 10} on_click: || start_converge()
                                draw_bg +: {border_radius: 22.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                                draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f text_style: font_bold_cjk{font_size: 8}}}
                            ButtonFlat{text: "刷新计票" height: 44 padding: Inset{left: 10 right: 10} on_click: || refresh_converge()
                                draw_bg +: {border_radius: 22.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xa87516}
                                draw_text +: {color: #xa87516 color_hover: #xa87516 color_down: #xa87516 text_style: font_bold_cjk{font_size: 8}}}
                            ButtonFlat{text: "管家收敛" height: 44 padding: Inset{left: 10 right: 10} on_click: || converge_butler()
                                draw_bg +: {border_radius: 22.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #x2f7d4f}
                                draw_text +: {color: #x2f7d4f color_hover: #x2f7d4f color_down: #x2f7d4f text_style: font_bold_cjk{font_size: 8}}}
                        }
                        Label{width: Fill text: "群投票：文字卡形态（本宿主不支持活卡片原地更新）——协议一致，计票手动刷新" draw_text.color: #xa89e91 draw_text.text_style.font_size: 8}
                        if converge_summary != "" {
                            Label{width: Fill text: "📋 计票：" + converge_summary + (if converge_winner_slot != "" { " → 可收敛到 " + converge_winner_slot } else { "（平票/零票，请人工定夺）" }) draw_text.color: #x2f7d4f draw_text.text_style: font_bold_cjk{font_size: 8}}
                        }
                    }
                    // 待拍板态：确认主按钮朱砂通栏（动作坞主行动按状态就位）
                    if case_status_text[sel] == "待拍板" {
                        ButtonFlat{width: Fill text: "确认这条守护" height: 44 on_click: || confirm_case()
                            draw_bg +: {border_radius: 22.0 color: #xc7402f color_hover: #xd0563f color_down: #xa83424 border_size: 0.0}
                            draw_text +: {color: #xffffff color_hover: #xffffff color_down: #xffffff text_style: font_bold_cjk{font_size: 9}}}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        TextInput{width: Fill height: 44 empty_text: "加参与人（逗号分隔）"
                            draw_bg +: {color: #fffdfa color_hover: #fffdfa color_focus: #fffdfa color_empty: #fffdfa border_radius: 10.0}
                            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: #xa89e91 color_empty_hover: #xa89e91}
                            on_change: |txt| set_people_draft("" + txt)}
                        ButtonFlat{text: "添加" height: 44 padding: Inset{left: 10 right: 10} on_click: || add_person("" + selected_id, people_draft)
                            draw_bg +: {border_radius: 13.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                            draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f text_style: font_bold_cjk{font_size: 8}}}
                    }
                    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{y: 0.5}
                        TextInput{width: Fill height: 44 empty_text: "记 AA 总额，如300（选填）"
                            draw_bg +: {color: #fffdfa color_hover: #fffdfa color_focus: #fffdfa color_empty: #fffdfa border_radius: 10.0}
                            draw_text +: {color: ink color_hover: ink color_focus: ink color_empty: #xa89e91 color_empty_hover: #xa89e91}
                            on_change: |txt| set_bill_draft("" + txt)}
                        ButtonFlat{text: "记一笔" height: 44 padding: Inset{left: 10 right: 10} on_click: || update_bill_total("" + selected_id, bill_draft)
                            draw_bg +: {border_radius: 13.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #x2f7d4f}
                            draw_text +: {color: #x2f7d4f color_hover: #x2f7d4f color_down: #x2f7d4f text_style: font_bold_cjk{font_size: 8}}}
                    }
                }
            }
        } else {
            View{width: Fill height: 1}
        }
    }}
    // === 决赛 S3：管家对话视图（第三 ScrollY，与 list/detail 同款互斥机制）——
    //   气泡 = 双扁平数组 chat_role/chat_text（on_render 只读字符串数组，#4/#5 硬约束）；
    //   me = 纸白卡右侧语义（前缀「我：」+纸白底），ai = 玉绿浅底「管家：」，sys = 居中灰小字；
    //   待拍板提案卡（plan_pending=="yes"）：朱砂描边卡 + plan_lines 逐行 + 拍板/放弃两键。
    //   按钮文案静态 copy——模型文本只进文本槽，动作接线全部走白名单 fn（评审红线）。
    //   visible 初始隐藏由 load() 命令式完成（#48b 同款：声明 visible:false 会被 re-apply）。
    chat_list := ScrollYView{width: Fill height: Fill flow: Down spacing: 10 on_render: || {
        if ui_mode == "chat" {
            // v0.10.0：管家页标题区（HTML 03 屏 .app-head：logo+「交给管家」+副题）；
            //   返回键降为次级 ghost 小字（HTML 里返回在标题区语义弱——出口仍明确但不抢戏）
            View{width: Fill height: Fit flow: Right spacing: 12 align: Align{y: 0.5}
                Svg{width: 40 height: 40 animating: false draw_svg +: {svg: http_resource("{{assets}}/assets/icon.svg") color: #xc7402f}}
                View{width: Fill height: Fit flow: Down spacing: 3
                    Label{text: "交给管家" draw_text.color: ink draw_text.text_style: font_bold_cjk{font_size: 15}}
                    Label{width: Fill text: "agent 提案 · 人拍板 · 白名单执行" draw_text.color: secondary draw_text.text_style.font_size: 8}
                }
                // 文案保留「回到守护列表」（回归 R-16/R-26/27/28/29 依赖此文案定位）
                ButtonFlat{text: "回到守护列表" height: 32 padding: Inset{left: 10 right: 10} on_click: || back_from_chat()
                    draw_bg +: {border_radius: 16.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                    draw_text +: {color: secondary color_hover: secondary color_down: secondary text_style: font_bold_cjk{font_size: 8}}}
            }
            for ci in chat_text.len() {
                let cr = "" + chat_role[ci]
                let ct = "" + chat_text[ci]
                if cr == "me" {
                    // HTML .bubble.user：右对齐 + 墨底 + 右下 4px 角（不对称圆角语义）
                    View{width: Fill height: Fit flow: Right align: Align{x: 1.0}
                        RoundedView{width: Fit height: Fit padding: Inset{left: 13 right: 13 top: 10 bottom: 10}
                            show_bg: true draw_bg.color: #x2b2722 draw_bg.border_radius: 14.0
                            Label{text: ct draw_text.color: #xf7f2ec draw_text.text_style.font_size: 9}
                        }
                    }
                } else if cr == "ai" {
                    // HTML .bubble.butler：左对齐 + 宣纸底+发丝描边 + 「管 家」朱砂小章 + 左下 4px 角
                    View{width: Fill height: Fit flow: Right align: Align{x: 0.0}
                        RoundedView{width: Fit height: Fit flow: Down spacing: 4 padding: Inset{left: 13 right: 13 top: 10 bottom: 10}
                            show_bg: true draw_bg.color: #xfffdfa draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xe9dfd2
                            Label{text: "管 家" draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 7}}
                            Label{text: ct draw_text.color: ink draw_text.text_style.font_size: 9}
                        }
                    }
                } else {
                    // sys：居中灰小字（HTML .plan-note 同款）
                    Label{width: Fill text: ct draw_text.color: #xa89e91 draw_text.text_style.font_size: 8 align: Align{x: 0.5}}
                }
            }
            // === v0.10.2：AI 通道降级快捷动作（死亡闩锁置位时可见）——
            //   降级不再是死路：本地规则一键落地 + 通道可手动重试。零渲染零占位语义：
            //   闩锁未置位时整个 if 不渲染（不挤占对话流）。
            if ai_dead == "yes" {
                View{width: Fill height: Fit flow: Right spacing: 8
                    ButtonFlat{width: Fill text: "用本地规则建守护" height: 40 on_click: || butler_local_fallback()
                        draw_bg +: {border_radius: 20.0 color: #xc7402f color_hover: #xd0563f color_down: #xa83424 border_size: 0.0}
                        draw_text +: {color: #ffffff color_hover: #ffffff color_down: #xffffff text_style: font_bold_cjk{font_size: 9}}}
                    ButtonFlat{width: Fit text: "重试 AI" height: 40 padding: Inset{left: 14 right: 14} on_click: || butler_retry_ai()
                        draw_bg +: {border_radius: 20.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                        draw_text +: {color: accent color_hover: accent color_down: accent}}
                }
            }
            // === v0.10.1 WP4：催收草稿邮件通路（有暂存草稿时可见）===
            if dunning_draft != "" {
                View{width: Fill height: Fit flow: Right spacing: 8
                    ButtonFlat{width: Fill text: "邮件人审发出催收草稿" height: 40 on_click: || butler_mail_dunning()
                        draw_bg +: {border_radius: 20.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                        draw_text +: {color: accent color_hover: accent color_down: accent text_style: font_bold_cjk{font_size: 9}}}
                }
            }
            // 待拍板提案卡（一次至多一个）——v0.9.0 WP2 精修（HTML 规范 03 屏）：
            //   op 头章（朱砂实底）+ 目标行；diff 行旧值 faint/新值朱砂加粗（运行时无
            //   删除线——faint 色 + ──▶ 箭头承担对比语义，记 evidence）；拍板主按钮。
            if plan_pending == "yes" {
                Card{show_bg: true draw_bg.color: #xfffdfa draw_bg.border_radius: 14.0 draw_bg.border_size: 1.0 draw_bg.border_color: #xc7402f
                    padding: Inset{left: 0 right: 0 top: 0 bottom: 0} spacing: 0
                    // ── 头章行：op 徽标 + 目标 ──
                    // HTML .plan-head：浅底 #FCF8F1 + border-bottom 发丝线分隔（上圆角继承卡片，下直角）
                    View{width: Fill height: Fit flow: Down spacing: 0
                        RoundedView{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                            padding: Inset{left: 14 right: 14 top: 11 bottom: 11}
                            show_bg: true draw_bg.color: #xfcf8f1
                            RoundedView{width: Fit height: Fit padding: Inset{left: 8 right: 8 top: 2 bottom: 3}
                                show_bg: true draw_bg.color: #xc7402f draw_bg.border_radius: 8.0
                                Label{text: plan_op_label(plan_op) draw_text.color: #xfffdfa draw_text.text_style: font_bold_cjk{font_size: 8}}
                            }
                            Label{width: Fill text: "管家提案 · 待拍板" draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                        }
                        // 发丝分隔线（HTML border-bottom:1px solid var(--line)）
                        RoundedView{width: Fill height: 1 show_bg: true draw_bg.color: #xe9dfd2 draw_bg.border_radius: 0.5}
                    }
                    View{width: Fill height: Fit flow: Down spacing: 6
                        padding: Inset{left: 14 right: 14 top: 10 bottom: 10}
                        BodyLine{text: plan_summary}
                        for pi in plan_lines.len() {
                            // HTML .diff-row：键列（44px，次要色粗体）+ 值列。diff 行（──▶）朱砂加粗；
                            // 「冲突预演：✓」玉绿 chip；「⚡」琥珀 chip。判别用 let 预提（闭包不写方法链进 if）。
                            if plan_lines[pi] != "" {
                                let _is_diff = plan_lines[pi].split("──▶").len() > 1
                                let _is_ok = plan_lines[pi].split("冲突预演：✓").len() > 1
                                let _is_warn = plan_lines[pi].split("⚡").len() > 1
                                let _has_key = plan_lines[pi].split("：").len() > 1
                                if _is_diff && _has_key {
                                    let _kv = plan_lines[pi].split("：")
                                    View{width: Fill height: Fit flow: Right spacing: 10 align: Align{y: 0.5}
                                        Label{width: 44 text: _kv[0] draw_text.color: #x6e675e draw_text.text_style: font_bold_cjk{font_size: 8}}
                                        Label{width: Fill text: _kv[1] draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 10}}
                                    }
                                } else if _is_ok {
                                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 4 bottom: 4}
                                        show_bg: true draw_bg.color: #xe8f3ec draw_bg.border_radius: 12.0
                                        Label{text: "✓ 冲突预演：改后无冲突" draw_text.color: #x2f7d4f draw_text.text_style.font_size: 8}}
                                } else if _is_warn {
                                    RoundedView{width: Fit height: Fit padding: Inset{left: 10 right: 10 top: 4 bottom: 4}
                                        show_bg: true draw_bg.color: #xf7ebd3 draw_bg.border_radius: 12.0
                                        Label{text: plan_lines[pi] draw_text.color: #xa87516 draw_text.text_style.font_size: 8}}
                                } else if _is_diff {
                                    Label{width: Fill text: plan_lines[pi] draw_text.color: #xc7402f draw_text.text_style: font_bold_cjk{font_size: 9}}
                                } else {
                                    TextLine{text: plan_lines[pi]}
                                }
                            }
                        }
                        if plan_check != "ok" {
                            TextLine{text: "⚠ " + plan_check}
                        }
                        // HTML .plan-actions：两键 flex:1 通栏 + border-top 发丝线分隔
                        RoundedView{width: Fill height: 1 show_bg: true draw_bg.color: #xe9dfd2 draw_bg.border_radius: 0.5}
                        View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                            ButtonFlat{width: Fill text: "拍板执行" height: 44 on_click: || butler_approve()
                                draw_bg +: {border_radius: 22.0 color: #xc7402f color_hover: #xd0563f color_down: #xa83424 border_size: 0.0}
                                draw_text +: {color: #ffffff color_hover: #ffffff color_down: #xffffff text_style: font_bold_cjk{font_size: 9}}}
                            // v0.8.0 W1：放弃 → 两段式理由快捷项（拒绝并改写；8 秒不选自动收回）
                            if decline_prompt != "yes" {
                                ButtonFlat{width: Fill text: "放弃" height: 44 on_click: || butler_decline()
                                    draw_bg +: {border_radius: 22.0 color: #fffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
                                    draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f}}
                            }
                        }
                        if decline_prompt == "yes" {
                            MetaLine{width: Fill text: "为什么放弃？理由会让管家下一轮改方案（8 秒内选，超时收回）"}
                            View{width: Fill height: Fit flow: Right spacing: 6
                                ButtonFlat{text: "时间不对" height: 36 padding: Inset{left: 10 right: 10} on_click: || decline_reason_time()
                                    draw_bg +: {border_radius: 13.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                                    draw_text +: {color: secondary color_hover: secondary color_down: secondary text_style: font_bold_cjk{font_size: 8}}}
                                ButtonFlat{text: "地点不对" height: 36 padding: Inset{left: 10 right: 10} on_click: || decline_reason_place()
                                    draw_bg +: {border_radius: 13.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                                    draw_text +: {color: secondary color_hover: secondary color_down: secondary text_style: font_bold_cjk{font_size: 8}}}
                                ButtonFlat{text: "理解错了" height: 36 padding: Inset{left: 10 right: 10} on_click: || decline_reason_intent()
                                    draw_bg +: {border_radius: 13.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                                    draw_text +: {color: secondary color_hover: secondary color_down: secondary text_style: font_bold_cjk{font_size: 8}}}
                                ButtonFlat{text: "我自己来" height: 36 padding: Inset{left: 10 right: 10} on_click: || decline_reason_self()
                                    draw_bg +: {border_radius: 13.0 color: #xf1ece4 color_hover: #xe7dfd3 color_down: #xd9cec0 border_size: 0.0}
                                    draw_text +: {color: secondary color_hover: secondary color_down: secondary text_style: font_bold_cjk{font_size: 8}}}
                            }
                        }
                        Label{width: Fill text: "拍板后走白名单动作 · 5 秒内可撤销 · 拒绝理由注入下轮——agent 从不直接改状态，它只能提案" draw_text.color: #xa89e91 draw_text.text_style.font_size: 8}
                    }
                }
            } else {
                View{width: Fill height: 1}
            }
            // === v0.8.0 W5：沉默留痕区（守护进程「考虑过但没说」的决策，回看可审计）===
            //   v0.10.0 对齐 HTML：分区标签（字距语义空格）+ 卡内留痕行（楷体圆点+文本）。
            SectionLabel{text: "沉 默 留 痕 · 管家考虑过但没说的事"}
            Card{padding: Inset{left: 14 right: 14 top: 4 bottom: 8} spacing: 0
                for si2 in suppressed_lines.len() {
                    View{width: Fill height: Fit flow: Right spacing: 8 align: Align{y: 0.5}
                        padding: Inset{top: 7 bottom: 7}
                        RoundedView{width: 6 height: 6 show_bg: true draw_bg.color: #xc9bfb2 draw_bg.border_radius: 3.0}
                        Label{width: Fill text: suppressed_lines[si2] draw_text.color: #x6e675e draw_text.text_style.font_size: 8}
                    }
                }
            }
            View{width: Fill height: 1}
        } else {
            View{width: Fill height: 1}
        }
    }}
    // #31f：根静态详情面板已删除——面板并入 case_list on_render 的 ui_mode="detail" 分支
    action_row := View{width: Fill height: Fit flow: Right spacing: 8 margin: Inset{top: 10}
        // === v0.9.0 WP2：动作坞降为次级行——主行动（确认/标记完成）按状态进详情闭包
        //   （朱砂通栏）；此处只留次级与危险操作，与 HTML 规范 02 屏 dock 一致。 ===
        // v0.10.2：补「改时间」——冲突横幅承诺「改个时段即解开」，此前详情页只有
        //   重新收敛（回 Proposing，不动槽位），真正改时段的入口埋在说明卡里（真缺口）。
        ButtonFlat{text: "改时间" height: 44 padding: Inset{left: 14 right: 14} on_click: || cycle_slot("" + selected_id)
            draw_bg +: {border_radius: 22.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
            draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f text_style: font_bold_cjk{font_size: 9}}}
        ButtonFlat{text: "重新收敛" height: 44 padding: Inset{left: 14 right: 14} on_click: || reschedule_case()
            draw_bg +: {border_radius: 22.0 color: #xfffdfa color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 1.0 border_color: #xc7402f}
            draw_text +: {color: #xc7402f color_hover: #xc7402f color_down: #xc7402f}}
        ButtonFlat{text: "取消守护" height: 44 padding: Inset{left: 14 right: 14} on_click: || cancel_case()
            draw_bg +: {border_radius: 22.0 color: #xfffdfa color_hover: #xf6e8e3 color_down: #xf6e8e3 border_size: 0.0}
            draw_text +: {color: #xa14d3c color_hover: #xa14d3c color_down: #xa14d3c}}
    }
    // === #29（外环派）：低频操作（改时间/AI解析/导出数据/清空全部）已从根组件第二行
    //   折叠进「怎么用？」说明卡——按钮升 44pt 后，根组件底部从 3 行 132pt 收缩到 2 行 88pt，
    //   主区只留高频三键（确认/重新收敛/取消 + 怎么用？开关），ScrollYView 不再被挤压溢出。
    // ai_row 兜底占位（1px），与 on_render 空分支的 #5 硬约束范式对齐（ai-providers:241）。
    View{width: Fill height: 1}
    // === #16 + #43（UI 改版合并）：「怎么用？」与「风格：X」并入一行文字按钮 ——
    //   两个低频入口不再各占一行，省出的纵向空间给守护列表这一核心内容。
    // v0.10.1：HTML .home-foot——居中 ghost 按钮，gap 6，padding 6 0 2。
    View{width: Fill height: Fit flow: Right spacing: 6 align: Align{x: 0.5} padding: Inset{top: 6 bottom: 2}
        ButtonFlat{text: "怎么用？" height: 36 padding: Inset{left: 12 right: 12} on_click: || toggle_howto()
            draw_bg +: {border_radius: 16.0 color: #xf7f2ec00 color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 0.0}
            draw_text +: {color: #x6e675e color_hover: #x6e675e color_down: #x6e675e text_style +: {font_size: 9}}}
        ButtonFlat{text: "📋 嗅探邀约" height: 36 padding: Inset{left: 10 right: 10} on_click: || scout_button_click()
            draw_bg +: {border_radius: 16.0 color: #xfbf4e2 color_hover: #f7ebd1 color_down: #eddcb7 border_size: 1.0 border_color: #xdca842}
            draw_text +: {color: #xb87b14 color_hover: #a36b0f color_down: #a36b0f text_style: font_bold_cjk{font_size: 8.5}}}
        ButtonFlat{text: "⛈️ 模拟突变" height: 36 padding: Inset{left: 10 right: 10} on_click: || crisis_demo_trigger()
            draw_bg +: {border_radius: 16.0 color: #xfdf0ed color_hover: #fcdbd5 color_down: #f8c3bb border_size: 1.0 border_color: #xd25b43}
            draw_text +: {color: #xc23824 color_hover: #a52816 color_down: #a52816 text_style: font_bold_cjk{font_size: 8.5}}}
        style_btn := ButtonFlat{text: "风格：" + style_label_for(receipt_style) height: 36 padding: Inset{left: 10 right: 10} on_click: || set_receipt_style()
            draw_bg +: {border_radius: 16.0 color: #xf7f2ec00 color_hover: #xf1ece4 color_down: #xe7dfd3 border_size: 0.0}
            draw_text +: {color: #x6e675e color_hover: #x6e675e color_down: #x6e675e text_style +: {font_size: 9}}}
    }
}
